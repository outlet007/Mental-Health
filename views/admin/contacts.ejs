<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindCare Admin</title>
  <%- include('../partials/head') %>
  <style>
    .tbl{width:100%;border-collapse:collapse}.tbl thead{background:#f8fafc}.tbl th{padding:10px 14px;text-align:left;font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #f1f5f9;white-space:nowrap}.tbl td{padding:12px 14px;font-size:14px;color:#334155;border-bottom:1px solid #f8fafc;vertical-align:middle}.tbl tbody tr:hover{background:#f8fafc}.tbl tbody tr:last-child td{border-bottom:none}
    .act-btn{display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;border:none;transition:all .15s;white-space:nowrap;text-decoration:none}
    .ab-primary{background:#05967e;color:#fff}.ab-primary:hover{background:#067866}
    .ab-secondary{background:#fff;color:#05967e;border:1px solid #a0f3e1}.ab-secondary:hover{background:#ecfdf9}
    .ab-ghost{background:transparent;color:#64748b}.ab-ghost:hover{background:#f1f5f9}
    .ab-danger{background:#ef4444;color:#fff}.ab-danger:hover{background:#dc2626}
    .ab-book{background:#3874FF;color:#fff}.ab-book:hover{opacity:.9}
    .inp{width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;color:#334155;outline:none;font-family:inherit;box-sizing:border-box}.inp:focus{border-color:#2dd4b4;box-shadow:0 0 0 3px rgba(45,212,180,.15)}
    .lbl{display:block;font-size:12px;font-weight:500;color:#64748b;margin-bottom:5px}
    .panel-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:40;display:none;backdrop-filter:blur(2px);opacity:0;transition:opacity .2s ease}.panel-overlay.open{opacity:1}
    .panel-drawer{position:fixed;top:50%;left:50%;width:calc(100% - 48px);max-width:500px;max-height:90vh;background:#fff;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.18);z-index:50;display:flex;flex-direction:column;transform:translate(-50%,-50%) scale(.94);opacity:0;transition:transform .22s cubic-bezier(.34,1.56,.64,1),opacity .18s ease;pointer-events:none}.panel-drawer.open{transform:translate(-50%,-50%) scale(1);opacity:1;pointer-events:auto}
    .counselor-card{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:12px;cursor:pointer;transition:all .15s}.counselor-card:hover{border-color:#2dd4b4;background:#ecfdf9}.counselor-card.selected{border-color:#05967e;background:#ecfdf9}
    .slot-btn{padding:7px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:12px;font-weight:500;color:#334155;cursor:pointer;background:#fff;transition:all .15s}.slot-btn:hover:not(:disabled){border-color:#2dd4b4;background:#ecfdf9;color:#065f46}.slot-btn.selected{border-color:#05967e;background:#05967e;color:#fff}.slot-btn:disabled{opacity:.4;cursor:not-allowed;text-decoration:line-through}
    .tab-btn{padding:12px 20px;font-size:13px;font-weight:500;color:#64748b;background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;transition:all .15s;white-space:nowrap;display:flex;align-items:center;gap:8px}
    .tab-btn.active{color:#05967e;border-bottom-color:#05967e;font-weight:600}
    .tab-count{padding:2px 8px;border-radius:99px;font-size:12px;font-weight:600}
  </style>
</head>
<body style="background:#f8fafc;margin:0;">
<%
  const sessionTypes = { online: true, phone: false, onsite: true, ...(appointmentSessionTypes || {}) }
  const enabledSessionTypeList = ['online', 'phone', 'onsite'].filter(type => sessionTypes[type])
  const defaultSessionType = enabledSessionTypeList[0] || 'online'
%>
<%- include('../partials/admin-sidebar') %>

<div style="margin-left:256px;min-height:100vh;display:flex;flex-direction:column;">

  <div style="height:56px;background:#fff;border-bottom:1px solid #f1f5f9;padding:0 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20;">
    <h1 style="font-size:15px;font-weight:600;color:#1e293b;margin:0;"><%= title %></h1>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:12px;color:#94a3b8;"><% const d=new Date(); %><%= d.toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %></span>
      <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;font-size:12px;font-weight:500;color:#475569;text-decoration:none;">
        <i data-lucide="external-link" style="width:13px;height:13px;"></i>
        ดูหน้าเว็บหลัก
      </a>
    </div>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.booked) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:12px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="calendar-check" style="width:16px;height:16px;flex-shrink:0;"></i> สร้างนัดหมายสำเร็จ — อัปเดตสถานะคำขอแล้ว</div>
    <% } if (query.updated) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#ecfeff;border:1px solid #a5f3fc;border-radius:12px;color:#155e75;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อัปเดตสถานะสำเร็จ</div>
    <% } if (query.error==='conflict') { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#fef2f2;border:1px solid #fca5a5;border-radius:12px;color:#991b1b;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> ช่วงเวลานี้ถูกจองแล้ว กรุณาเลือกเวลาอื่น</div>
    <% } %>

    <%
      const newFiltered       = contacts.filter(c => c.status === 'new').length
      const contactedFiltered = contacts.filter(c => c.status === 'contacted').length
      const convertedFiltered = contacts.filter(c => c.status === 'converted').length
      const closedFiltered    = contacts.filter(c => c.status === 'closed').length
    %>

    <!-- Status Cards -->
    <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:24px;">
      <div style="background:#fff;border:1px solid #fecaca;border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:16px;cursor:pointer;" onclick="switchTab('new')">
        <div style="width:44px;height:44px;border-radius:12px;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="inbox" style="width:22px;height:22px;color:rgb(239,68,68);"></i>
        </div>
        <div>
          <p style="margin:0;font-size:28px;font-weight:700;color:#1e293b;line-height:1;"><%= statusCounts.new %></p>
          <p style="margin:4px 0 0;font-size:12px;color:rgb(239,68,68);font-weight:500;">รอดำเนินการ</p>
        </div>
      </div>
      <div style="background:#fff;border:1px solid #bfdbfe;border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:16px;cursor:pointer;" onclick="switchTab('contacted')">
        <div style="width:44px;height:44px;border-radius:12px;background:#dbeafe;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="phone-call" style="width:22px;height:22px;color:#1e40af;"></i>
        </div>
        <div>
          <p style="margin:0;font-size:28px;font-weight:700;color:#1e293b;line-height:1;"><%= statusCounts.contacted %></p>
          <p style="margin:4px 0 0;font-size:12px;color:#1e40af;font-weight:500;">ติดต่อแล้ว</p>
        </div>
      </div>
      <div style="background:#fff;border:1px solid #a0f3e1;border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:16px;cursor:pointer;" onclick="switchTab('converted')">
        <div style="width:44px;height:44px;border-radius:12px;background:#d1fae5;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="check-circle-2" style="width:22px;height:22px;color:#059669;"></i>
        </div>
        <div>
          <p style="margin:0;font-size:28px;font-weight:700;color:#1e293b;line-height:1;"><%= statusCounts.converted %></p>
          <p style="margin:4px 0 0;font-size:12px;color:#065f46;font-weight:500;">นัดหมายแล้ว</p>
        </div>
      </div>
      <div style="background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:16px;cursor:pointer;" onclick="switchTab('closed')">
        <div style="width:44px;height:44px;border-radius:12px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="archive" style="width:22px;height:22px;color:#64748b;"></i>
        </div>
        <div>
          <p style="margin:0;font-size:28px;font-weight:700;color:#1e293b;line-height:1;"><%= statusCounts.closed %></p>
          <p style="margin:4px 0 0;font-size:12px;color:#64748b;font-weight:500;">ปิดแล้ว</p>
          <p style="margin:2px 0 0;font-size:12px;color:#94a3b8;">หมายเหตุ: ติดต่อไม่ได้ หรือยกเลิกคำขอ</p>
        </div>
      </div>
    </div>

    <!-- Search -->
    <form method="GET" style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;padding:14px 16px;margin-bottom:16px;display:flex;gap:10px;align-items:flex-end;">
      <div style="flex:1;">
        <label class="lbl">ค้นหา</label>
        <div style="position:relative;">
          <i data-lucide="search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#94a3b8;"></i>
          <input name="search" value="<%= query.search||'' %>" class="inp" style="padding-left:32px;" placeholder="ชื่อ, เบอร์, อีเมล">
        </div>
      </div>
      <div>
        <label class="lbl">เรื่องที่ต้องการความช่วยเหลือ</label>
        <select name="concern" class="inp" style="width:200px;">
          <option value="">ทั้งหมด</option>
          <% concernOptions.forEach(opt => { %>
          <option value="<%= opt %>" <%=query.concern===opt?'selected':''%>><%= opt %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="lbl">สถานะ</label>
        <select name="status" class="inp" style="width:170px;">
          <option value="">ทั้งหมด</option>
          <option value="new" <%=query.status==='new'?'selected':''%>>รอดำเนินการ</option>
          <option value="contacted" <%=query.status==='contacted'?'selected':''%>>ติดต่อแล้ว</option>
          <option value="converted" <%=query.status==='converted'?'selected':''%>>นัดหมายแล้ว</option>
          <option value="closed" <%=query.status==='closed'?'selected':''%>>ปิดแล้ว</option>
        </select>
      </div>
      <button type="submit" class="act-btn ab-primary"><i data-lucide="search" style="width:13px;height:13px;"></i> ค้นหา</button>
      <% if (query.search || query.status || query.concern) { %><a href="/admin/contacts" class="act-btn ab-ghost" style="text-decoration:none;">ล้าง</a><% } %>
    </form>

    <!-- Tab + Table card -->
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;overflow:hidden;">

      <!-- Tab bar -->
      <div style="display:flex;border-bottom:1px solid #f1f5f9;padding:0 8px;">
        <button class="tab-btn" id="tab-all" onclick="switchTab('all')">
          <i data-lucide="list" style="width:14px;height:14px;"></i>
          ทั้งหมด
          <span class="tab-count" style="background:#e2e8f0;color:#334155;" id="badge-all"><%= contacts.length %></span>
        </button>
        <button class="tab-btn active" id="tab-new" onclick="switchTab('new')">
          <i data-lucide="inbox" style="width:14px;height:14px;"></i>
          รอดำเนินการ
          <span class="tab-count" style="background:#fee2e2;color:rgb(239,68,68);" id="badge-new"><%= newFiltered %></span>
        </button>
        <button class="tab-btn" id="tab-contacted" onclick="switchTab('contacted')">
          <i data-lucide="phone-call" style="width:14px;height:14px;"></i>
          ติดต่อแล้ว
          <span class="tab-count" style="background:#dbeafe;color:#1e40af;" id="badge-contacted"><%= contactedFiltered %></span>
        </button>
        <button class="tab-btn" id="tab-converted" onclick="switchTab('converted')">
          <i data-lucide="check-circle-2" style="width:14px;height:14px;"></i>
          นัดหมายแล้ว
          <span class="tab-count" style="background:#d1fae5;color:#065f46;" id="badge-converted"><%= convertedFiltered %></span>
        </button>
        <button class="tab-btn" id="tab-closed" onclick="switchTab('closed')">
          <i data-lucide="archive" style="width:14px;height:14px;"></i>
          ปิดแล้ว
          <span class="tab-count" style="background:#f1f5f9;color:#64748b;" id="badge-closed"><%= closedFiltered %></span>
        </button>
      </div>

      <!-- Table -->
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th>ผู้ส่งคำขอ</th>
              <th>ข้อมูลติดต่อ</th>
              <th>เรื่องที่ต้องการความช่วยเหลือ</th>
              <th>รูปแบบ</th>
              <th>วันที่</th>
              <th>สถานะ</th>
              <th>การจัดการ</th>
              <th>จัดการคำขอเพื่อทำนัดหมาย</th>
            </tr>
          </thead>
          <tbody>
            <%
              const statusMap = {
                new:       {bg:'#fef3c7',color:'#92400e',label:'รอดำเนินการ'},
                contacted: {bg:'#dbeafe',color:'#1e40af',label:'ติดต่อแล้ว'},
                converted: {bg:'#d1fae5',color:'#065f46',label:'นัดหมายแล้ว'},
                closed:    {bg:'#f1f5f9',color:'#64748b',label:'ปิดแล้ว'},
              }
              const CONCERN_PALETTE = [
                {bg:'#ffedd5',color:'#9a3412'},
                {bg:'#ede9fe',color:'#5b21b6'},
                {bg:'#fce7f3',color:'#9d174d'},
                {bg:'#cffafe',color:'#155e75'},
                {bg:'#e0e7ff',color:'#3730a3'},
                {bg:'#f1f5f9',color:'#475569'},
              ]
              const CONCERN_FALLBACK = {bg:'#f1f5f9',color:'#475569'}
              const concernColorMap = {}
              concernOptions.forEach((opt, i) => { concernColorMap[opt] = CONCERN_PALETTE[i % CONCERN_PALETTE.length] })
            %>
            <% contacts.forEach(c => {
              const st  = statusMap[c.status] || statusMap.new
              const grp = c.status || 'new'
            %>
            <tr data-grp="<%= grp %>">
              <td>
                <div style="display:flex;align-items:center;gap:10px;">
                  <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#2dd4b4,#06b6d4);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0;"><%= c.name.slice(0,1) %></div>
                  <div>
                    <div style="font-weight:600;color:#1e293b;font-size:13px;"><%= c.name %></div>
                    <% if (c.studentId) { %><div style="font-size:12px;color:#64748b;font-weight:500;">รหัส: <%= c.studentId %></div><% } %>
                    <% if (c.note) { %><div style="font-size:12px;color:#94a3b8;font-style:italic;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= c.note %>"><%= c.note %></div><% } %>
                  </div>
                </div>
              </td>
              <td>
                <div style="font-size:13px;"><%= c.phone %></div>
                <% if (c.email) { %><div style="font-size:12px;color:#94a3b8;"><%= c.email %></div><% } %>
              </td>
              <td style="max-width:160px;">
                <% if (c.concern) {
                  const cc = concernColorMap[c.concern] || CONCERN_FALLBACK
                %>
                <span style="display:inline-block;padding:3px 10px;background:<%= cc.bg %>;color:<%= cc.color %>;border-radius:99px;font-size:12px;font-weight:500;white-space:normal;"><%= c.concern %></span>
                <% } else { %>
                <span style="font-size:12px;color:#cbd5e1;">—</span>
                <% } %>
              </td>
              <td>
                <% if (c.sessionType==='online') { %>
                <div style="display:flex;align-items:center;gap:4px;"><i data-lucide="video" style="width:13px;height:13px;color:#0891b2;"></i><span style="font-size:12px;color:#0891b2;">ออนไลน์</span></div>
                <% } else if (c.sessionType==='phone') { %>
                <div style="display:flex;align-items:center;gap:4px;"><i data-lucide="phone" style="width:13px;height:13px;color:#05967e;"></i><span style="font-size:12px;color:#05967e;">โทรศัพท์</span></div>
                <% } else { %>
                <div style="display:flex;align-items:center;gap:4px;"><i data-lucide="map-pin" style="width:13px;height:13px;color:#3874FF;"></i><span style="font-size:12px;color:#3874FF;">เข้ารับบริการด้วยตนเอง</span></div>
                <% } %>
              </td>
              <td style="font-size:12px;color:#64748b;white-space:nowrap;"><%= c.createdAt %></td>
              <td><span style="padding:3px 10px;background:<%= st.bg %>;color:<%= st.color %>;border-radius:99px;font-size:12px;font-weight:500;"><%= st.label %></span></td>
              <td>
                <div style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;">
                  <button class="act-btn ab-secondary edit-request-btn" data-rec="<%= JSON.stringify(c) %>" title="แก้ไขคำขอ">
                    <i data-lucide="file-pen" style="width:13px;height:13px;"></i> แก้ไขคำขอ
                  </button>
                  <button type="button" class="act-btn ab-danger delete-btn" data-action="/admin/contacts/<%= c.id %>/delete" data-name="คำขอของ <%= c.name %>" data-warning="คำขอนี้จะถูกลบออกจากระบบถาวร ไม่สามารถกู้คืนได้" title="ลบ">
                    <i data-lucide="trash-2" style="width:12px;height:12px;"></i>
                  </button>
                </div>
              </td>
              <td>
                <div style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;">
                  <button class="act-btn ab-secondary edit-btn" data-rec="<%= JSON.stringify(c) %>">
                    <i data-lucide="pencil" style="width:13px;height:13px;"></i> จัดการคำขอ
                  </button>
                  <% if (['new','contacted'].includes(c.status)) { %>
                  <button class="act-btn ab-book book-btn" data-rec="<%= JSON.stringify(c) %>" title="สร้างนัดหมาย">
                    <i data-lucide="calendar-plus" style="width:13px;height:13px;"></i> สร้างนัด
                  </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
            <tr id="emptyState" style="display:none;">
              <td colspan="8" style="text-align:center;padding:48px 16px;color:#94a3b8;">
                <i data-lucide="inbox" style="width:36px;height:36px;display:block;margin:0 auto 10px;opacity:.3;"></i>
                ไม่มีคำขอในหมวดนี้
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Overlay -->
<div id="overlay" class="panel-overlay" onclick="closeAll()"></div>

<!-- Panel: จัดการสถานะ -->
<div id="statusPanel" class="panel-drawer">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#05967e,#06b6d4);display:flex;align-items:center;justify-content:center;"><i data-lucide="clipboard-list" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#1e293b;">จัดการคำขอ</div>
        <div id="statusPanelSub" style="font-size:12px;color:#94a3b8;"></div>
      </div>
    </div>
    <button onclick="closeAll()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;padding:20px;">
    <form id="statusForm" method="POST" action="">
      <div id="statusInfoBox" style="padding:14px;background:#f8fafc;border-radius:12px;margin-bottom:20px;font-size:13px;display:grid;gap:6px;"></div>
      <div style="display:grid;gap:14px;">
        <div>
          <label class="lbl">สถานะ</label>
          <select name="status" id="f_status" class="inp">
            <option value="new">รอดำเนินการ</option>
            <option value="contacted">ติดต่อแล้ว</option>
            <option value="converted">นัดหมายแล้ว</option>
            <option value="closed">ปิดแล้ว</option>
          </select>
        </div>
        <div>
          <label class="lbl">บันทึกภายใน</label>
          <textarea name="note" id="f_note" rows="3" class="inp" style="resize:none;" placeholder="เช่น ติดต่อกลับเมื่อ 18 มิ.ย. ..."></textarea>
        </div>
      </div>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closeAll()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
    <button onclick="document.getElementById('statusForm').submit()" class="act-btn ab-primary" style="flex:1;justify-content:center;"><i data-lucide="save" style="width:14px;height:14px;"></i> บันทึก</button>
  </div>
</div>

<!-- Panel: แก้ไขคำขอ -->
<div id="editRequestPanel" class="panel-drawer">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#3874FF,#6366f1);display:flex;align-items:center;justify-content:center;"><i data-lucide="file-pen" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#1e293b;">แก้ไขคำขอเพื่อทำนัดหมาย</div>
        <div id="editRequestPanelSub" style="font-size:12px;color:#94a3b8;"></div>
      </div>
