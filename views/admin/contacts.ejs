          <input type="text" name="studentId" id="er_studentId" class="inp">
        </div>
        <div>
          <label class="lbl">เบอร์โทรศัพท์</label>
          <input type="text" name="phone" id="er_phone" class="inp" required>
        </div>
        <div>
          <label class="lbl">อีเมล</label>
          <input type="email" name="email" id="er_email" class="inp">
