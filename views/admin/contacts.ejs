<!-- ░░░ Delete confirm overlay ░░░ -->
<div id="deleteOverlay" class="panel-overlay" onclick="closeDeleteModal()"></div>
<div id="deletePanel" class="panel-drawer" style="max-width:420px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:36px;height:36px;border-radius:10px;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i data-lucide="trash-2" style="width:17px;height:17px;color:#ef4444;"></i>
      </div>
      <div style="font-size:14px;font-weight:600;color:#1e293b;">ยืนยันการลบ</div>
    </div>
    <button onclick="closeDeleteModal()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <form id="deleteForm" method="POST" action="" style="padding:20px;display:flex;flex-direction:column;gap:14px;">
    <div style="padding:12px 14px;background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;font-size:13px;color:#991b1b;display:flex;gap:8px;align-items:flex-start;">
      <i data-lucide="alert-triangle" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;"></i>
      <span id="deleteWarningText"></span>
    </div>
    <div>
      <label class="lbl">เหตุผลการลบ <span style="color:#ef4444;">*</span></label>
      <textarea name="reason" id="deleteReason" required rows="3" class="inp" style="resize:none;" placeholder="ระบุเหตุผลที่ต้องการลบข้อมูลนี้..."></textarea>
    </div>
    <div style="display:flex;gap:10px;">
      <button type="button" onclick="closeDeleteModal()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
      <button type="submit" class="act-btn ab-danger" style="flex:1;justify-content:center;"><i data-lucide="trash-2" style="width:14px;height:14px;"></i> ยืนยันลบ</button>
    </div>
  </form>
</div>

<script>
  // ── Delete confirm modal ─────────────────────────────────────────────────────
  function openDeleteModal(action, name, warning) {
    document.getElementById('deleteForm').action        = action
    document.getElementById('deleteReason').value       = ''
    document.getElementById('deleteWarningText').textContent = warning || ('ต้องการลบ "' + name + '" ใช่หรือไม่ การลบไม่สามารถกู้คืนได้')
    const ov = document.getElementById('deleteOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('deletePanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }
  function closeDeleteModal() {
    const ov = document.getElementById('deleteOverlay')
    ov.classList.remove('open')
    document.getElementById('deletePanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openDeleteModal(btn.dataset.action, btn.dataset.name, btn.dataset.warning)
    })
  })

  const SCHEDULES = <%- JSON.stringify(schedules) %>
  const CLIENTS = <%- JSON.stringify(clients) %>
  const COUNSELOR_COLORS = <%- JSON.stringify(counselorColors) %>
  const APPOINTMENTS = <%- JSON.stringify(appointments) %>
  const DEFAULT_SESSION_TYPE = '<%= defaultSessionType %>'
  let bCounselor = null, bTime = null

  // ── Concern (เรื่องที่ต้องการความช่วยเหลือ) pill badge ────────────────────────
  const CONCERN_OPTIONS = <%- JSON.stringify(concernOptions) %>
  const CONCERN_PALETTE_JS = [
    { bg:'#ffedd5', color:'#9a3412' },
    { bg:'#ede9fe', color:'#5b21b6' },
    { bg:'#fce7f3', color:'#9d174d' },
    { bg:'#cffafe', color:'#155e75' },
    { bg:'#e0e7ff', color:'#3730a3' },
    { bg:'#f1f5f9', color:'#475569' },
  ]
  const CONCERN_FALLBACK_JS = { bg:'#f1f5f9', color:'#475569' }
  const CONCERN_COLOR_MAP_JS = {}
  CONCERN_OPTIONS.forEach((opt, i) => { CONCERN_COLOR_MAP_JS[opt] = CONCERN_PALETTE_JS[i % CONCERN_PALETTE_JS.length] })
  function concernBadge(concern) {
    if (!concern) return ''
    const cc = CONCERN_COLOR_MAP_JS[concern] || CONCERN_FALLBACK_JS
    return `<span style="display:inline-block;padding:2px 8px;background:${cc.bg};color:${cc.color};border-radius:99px;font-size:12px;font-weight:500;">${esc(concern)}</span>`
  }

  function esc(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
  }

  // ── Tab switching ─────────────────────────────────────────────────────────────
  function switchTab(tab) {
    ['all','new','contacted','converted','closed'].forEach(s => {
      document.getElementById('tab-' + s).classList.toggle('active', tab === s)
    })
    let vis = 0
    document.querySelectorAll('tr[data-grp]').forEach(r => {
      const show = tab === 'all' || r.dataset.grp === tab
      r.style.display = show ? '' : 'none'
      if (show) vis++
    })
    document.getElementById('emptyState').style.display = vis === 0 ? '' : 'none'
  }

  // ── Status panel ──────────────────────────────────────────────────────────────
  function contactSessionTypeLabel(type) {
    if (type === 'phone') return 'โทรศัพท์'
    if (type === 'onsite') return 'เข้ารับบริการด้วยตนเอง'
    return 'ออนไลน์'
  }

  function toggleContactMeetingLinkField() {
    const selected = document.querySelector('#bookForm input[name="type"]:checked')
    const wrap = document.getElementById('contactMeetingLinkWrap')
    if (wrap) wrap.style.display = selected && selected.value === 'online' ? '' : 'none'
  }

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const c = JSON.parse(btn.dataset.rec)
      document.getElementById('statusPanelSub').textContent = c.name
      document.getElementById('statusForm').action          = '/admin/contacts/' + c.id + '/status'
      document.getElementById('f_status').value             = c.status || 'new'
      document.getElementById('f_note').value               = c.note   || ''
      const typeLabel = contactSessionTypeLabel(c.sessionType)
      const linkedAppt = (c.status === 'converted' && c.appointmentId)
        ? APPOINTMENTS.find(a => a.id === c.appointmentId)
        : null
      document.getElementById('statusInfoBox').innerHTML = `
        <div style="font-size:14px;font-weight:600;color:#3874FF;text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;">ข้อมูลคำขอเพื่อทำนัดหมาย</div>
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">ชื่อ</span><strong>${esc(c.name)}</strong></div>
        ${c.studentId?`<div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">รหัสนักศึกษา</span><span>${esc(c.studentId)}</span></div>`:''}
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">โทร</span><span>${esc(c.phone)}</span></div>
        ${c.email?`<div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">อีเมล</span><span>${esc(c.email)}</span></div>`:''}
        ${c.concern?`<div style="display:flex;gap:8px;align-items:center;"><span style="color:#94a3b8;min-width:80px;">เรื่อง</span>${concernBadge(c.concern)}</div>`:''}
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">รูปแบบ</span><span>${typeLabel}</span></div>
        ${linkedAppt ? `
        <div style="margin-top:6px;padding-top:10px;border-top:1px solid #e2e8f0;">
          <div style="font-size:14px;font-weight:600;color:#05967e;text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;">ข้อมูลนัดหมายที่สร้างแล้ว</div>
          <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">นักจิตวิทยา</span><span>${esc(linkedAppt.counselorName)}</span></div>
          <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">วันที่และเวลา</span><span>${esc(linkedAppt.date)} เวลา ${esc(linkedAppt.time)} น.</span></div>
        </div>` : ''}
      `
      openOverlay(); document.getElementById('statusPanel').classList.add('open')
    })
  })

  // ── Edit request panel ───────────────────────────────────────────────────────
  document.querySelectorAll('.edit-request-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const c = JSON.parse(btn.dataset.rec)
      document.getElementById('editRequestPanelSub').textContent = c.name
      document.getElementById('editRequestForm').action = '/admin/contacts/' + c.id + '/edit'
      document.getElementById('er_name').value      = c.name || ''
      document.getElementById('er_studentId').value = c.studentId || ''
      document.getElementById('er_phone').value     = c.phone || ''
      document.getElementById('er_email').value      = c.email || ''
      document.getElementById('er_concern').value    = c.concern || ''
      const editTypeInput = document.getElementById(c.sessionType === 'phone' ? 'er_typePhone' : (c.sessionType === 'onsite' ? 'er_typeOnsite' : 'er_typeOnline'))
      const editTypeFallback = document.querySelector('#editRequestForm input[name="sessionType"]')
      if (editTypeInput) editTypeInput.checked = true
      else if (editTypeFallback) editTypeFallback.checked = true
      openOverlay(); document.getElementById('editRequestPanel').classList.add('open')
    })
  })

  function submitEditRequest() {
    const form = document.getElementById('editRequestForm')
    if (!form.reportValidity()) return
    form.submit()
  }

  // ── Book panel ────────────────────────────────────────────────────────────────
  document.querySelectorAll('.book-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const c = JSON.parse(btn.dataset.rec)
      document.getElementById('bookPanelSub').textContent = 'สำหรับ ' + c.name
      document.getElementById('bookForm').action           = '/admin/contacts/' + c.id + '/book'
      const requestedType = c.sessionType || DEFAULT_SESSION_TYPE
      const bookTypeInput = document.getElementById(requestedType === 'phone' ? 'typePhone' : (requestedType === 'onsite' ? 'typeOnsite' : 'typeOnline'))
      const bookTypeFallback = document.querySelector('#bookForm input[name="type"]')
      if (bookTypeInput) bookTypeInput.checked = true
      else if (bookTypeFallback) bookTypeFallback.checked = true
      const meetingLinkInput = document.getElementById('contactMeetingLink')
      if (meetingLinkInput) meetingLinkInput.value = ''
      toggleContactMeetingLinkField()
      const typeLabel = contactSessionTypeLabel(c.sessionType)
      document.getElementById('contactSummary').innerHTML = `
        <div style="font-size:12px;font-weight:600;color:#64748b;margin-bottom:4px;text-transform:uppercase;letter-spacing:.05em;">ผู้ร้องขอ</div>
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">ชื่อ-นามสกุล</span><strong>${esc(c.name)}</strong></div>
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">รหัสนักศึกษา</span><span>${esc(c.studentId || '—')}</span></div>
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">เบอร์โทรศัพท์</span><span>${esc(c.phone || '—')}</span></div>
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">อีเมล</span><span>${esc(c.email || '—')}</span></div>
        ${c.concern?`<div style="display:flex;gap:8px;align-items:center;"><span style="color:#94a3b8;min-width:72px;">เรื่อง</span>${concernBadge(c.concern)}</div>`:''}
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">รูปแบบ</span><span>${typeLabel}</span></div>
      `

      // ── ตรวจสอบผู้รับบริการที่อาจเป็นคนเดียวกัน (ชื่อ + รหัสนักศึกษา ไม่ใช้เบอร์โทร/อีเมลเดี่ยวๆ) ──
      const normName = v => String(v || '').trim().toLowerCase().replace(/\s+/g, ' ')
      const matches = CLIENTS.map(cl => {
        const nameMatch      = normName(cl.name) === normName(c.name) && normName(c.name) !== ''
        const studentIdMatch = !!(c.studentId && cl.studentId && cl.studentId.trim() === c.studentId.trim())
        if (!nameMatch && !studentIdMatch) return null
        const reason = nameMatch && studentIdMatch ? 'ชื่อและรหัสนักศึกษาตรงกัน' : studentIdMatch ? 'รหัสนักศึกษาตรงกัน' : 'ชื่อตรงกัน'
        return { client: cl, reason }
      }).filter(Boolean)

      const matchSection = document.getElementById('clientMatchSection')
      const matchList     = document.getElementById('clientMatchList')
      if (matches.length) {
        matchList.innerHTML = matches.map(({ client, reason }) => {
          const clientAppts = APPOINTMENTS
            .filter(a => a.clientId === client.id)
            .sort((a, b) => b.date.localeCompare(a.date))
          const latestAppt = clientAppts[0]
          const cCol = latestAppt ? (COUNSELOR_COLORS[latestAppt.counselorId] || '#64748b') : null
          return `
          <label style="display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;background:#fff;">
            <input type="radio" name="existingClientId" value="${client.id}" required style="accent-color:#05967e;flex-shrink:0;margin-top:2px;">
            <div style="flex:1;min-width:0;display:grid;gap:2px;">
              <div style="font-size:13px;font-weight:600;color:#1e293b;">${esc(client.name)}</div>
              <div style="font-size:12px;color:#64748b;">รหัสนักศึกษา: ${esc(client.studentId || '—')}</div>
              <div style="font-size:12px;color:#64748b;">เบอร์โทรศัพท์: ${esc(client.phone || '—')}</div>
              <div style="font-size:12px;color:#64748b;">อีเมล: ${esc(client.email || '—')}</div>
              ${latestAppt ? `<div style="font-size:12px;color:#64748b;display:flex;align-items:center;gap:6px;margin-top:2px;">รับคำปรึกษาล่าสุด <span style="padding:2px 8px;background:${cCol}18;color:${cCol};border-radius:99px;font-size:11px;font-weight:600;">${esc(latestAppt.counselorName || '—')}</span></div>` : ''}
            </div>
            <span style="padding:2px 8px;background:#fef3c7;color:#92400e;border-radius:99px;font-size:11px;font-weight:600;white-space:nowrap;flex-shrink:0;">${reason}</span>
          </label>`
        }
        ).join('') + `
          <label style="display:flex;align-items:center;gap:10px;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;background:#fff;">
            <input type="radio" name="existingClientId" value="" required style="accent-color:#05967e;flex-shrink:0;">
            <div style="font-size:13px;font-weight:600;color:#1e293b;">ไม่ใช่คนเดียวกัน — สร้างผู้รับบริการใหม่</div>
          </label>`
        matchSection.style.display = 'block'
      } else {
        matchList.innerHTML = ''
        matchSection.style.display = 'none'
      }
      lucide.createIcons()

      bCounselor=null; bTime=null
      document.getElementById('bDateInput').disabled=true; document.getElementById('bDateInput').value=''
      document.getElementById('bDateHint').style.display='block'
      document.getElementById('bAvailableDays').style.display='none'
      document.getElementById('bSlotSection').style.display='none'
      document.getElementById('bApptSummary').style.display='none'
      document.querySelectorAll('.counselor-card').forEach(el=>el.classList.remove('selected'))
      document.querySelectorAll('input[name="counselorId"]').forEach(r=>r.checked=false)
      openOverlay(); document.getElementById('bookPanel').classList.add('open')
    })
  })

  function openOverlay() {
    const ov = document.getElementById('overlay')
    ov.style.display='block'; requestAnimationFrame(()=>ov.classList.add('open'))
    document.body.style.overflow='hidden'
  }
  function closeAll() {
    const ov = document.getElementById('overlay')
    ov.classList.remove('open')
    document.getElementById('statusPanel').classList.remove('open')
    document.getElementById('editRequestPanel').classList.remove('open')
    document.getElementById('bookPanel').classList.remove('open')
    document.body.style.overflow=''
    setTimeout(()=>{ov.style.display='none'},200)
  }
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAll()})

  // ── Booking form logic ────────────────────────────────────────────────────────
  function onBookCounselorChange(radio) {
    bCounselor={id:radio.value,duration:parseInt(radio.dataset.duration),name:radio.dataset.name}
    document.querySelectorAll('.counselor-card').forEach(el=>{
      const r=el.querySelector('input[name="counselorId"]')
      el.classList.toggle('selected',r&&r.value===radio.value)
    })
    document.getElementById('bDateInput').disabled=false; document.getElementById('bDateInput').value=''
    document.getElementById('bDateHint').style.display='none'
    const mySched = SCHEDULES.filter(s => s.counselorId===radio.value && s.isActive)
    document.getElementById('bDayBadges').innerHTML = mySched.map(s =>
      `<span style="padding:3px 10px; background:#dbeafe; color:#1e40af; border-radius:99px; font-size:12px;">${s.dayName} ${s.startTime}–${s.endTime}</span>`
    ).join('')
    document.getElementById('bAvailableDays').style.display='block'
    document.getElementById('bSlotSection').style.display='none'
    document.getElementById('bApptSummary').style.display='none'
    bTime=null; document.getElementById('bTimeInput').value=''
  }
  async function bLoadSlots() {
    const date=document.getElementById('bDateInput').value
    if (!date||!bCounselor) return
    document.getElementById('bSlotSection').style.display='none'
    document.getElementById('bSlotLoading').style.display='block'
    const resp=await fetch(`/admin/appointments/slots?counselorId=${bCounselor.id}&date=${date}`)
    const {slots}=await resp.json()
    document.getElementById('bSlotLoading').style.display='none'
    document.getElementById('bSlotSection').style.display='block'
    const grid=document.getElementById('bSlotGrid')
    const available=slots.filter(s=>s.available)
    if (!available.length){grid.innerHTML=`<div style="font-size:12px;color:#94a3b8;grid-column:1/-1;">${slots.length?'เวลาทั้งหมดถูกจองแล้วในวันนี้':'ไม่มีตารางเวลาในวันนี้'}</div>`;return}
    grid.innerHTML=available.map(s=>`<button type="button" class="slot-btn" onclick="bSelectSlot(this,'${s.time}')">${s.time}</button>`).join('')
  }
  function bSelectSlot(btn,time) {
    bTime=time; document.getElementById('bTimeInput').value=time
    document.querySelectorAll('#bSlotGrid .slot-btn').forEach(b=>b.classList.remove('selected'))
    btn.classList.add('selected')
    if (bCounselor) {
      const date=document.getElementById('bDateInput').value
      const ds=new Date(date).toLocaleDateString('th-TH',{weekday:'short',day:'numeric',month:'short',year:'numeric'})
      document.getElementById('bSummCounselor').textContent=bCounselor.name
      document.getElementById('bSummDateTime').textContent=`${ds} ${time} น.`
      document.getElementById('bApptSummary').style.display='block'
    }
  }
  function submitBook() {
    const form=document.getElementById('bookForm')
    if (!form.reportValidity()) return
    if (!bTime){alert('กรุณาเลือกเวลานัดหมาย');return}
    form.submit()
  }

  <%
    const validTabs = ['new','contacted','converted','closed']
    const initialTab = validTabs.includes(query.status) ? query.status : 'all'
  %>
  switchTab('<%= initialTab %>')
  lucide.createIcons()
</script>
</body>
</html>
