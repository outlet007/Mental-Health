<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindWell Admin</title>
  <%- include('../partials/head') %>
  <style>
    .tbl{width:100%;border-collapse:collapse}.tbl thead{background:#f8fafc}.tbl th{padding:10px 14px;text-align:left;font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #f1f5f9;white-space:nowrap}.tbl td{padding:12px 14px;font-size:14px;color:#334155;border-bottom:1px solid #f8fafc;vertical-align:middle}.tbl tbody tr:hover{background:#f8fafc}.tbl tbody tr:last-child td{border-bottom:none}
    .act-btn{display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;border:none;transition:all .15s;white-space:nowrap;text-decoration:none}
    .ab-primary{background:#05967e;color:#fff}.ab-primary:hover{background:#067866}
    .ab-secondary{background:#fff;color:#05967e;border:1px solid #a0f3e1}.ab-secondary:hover{background:#ecfdf9}
    .ab-ghost{background:transparent;color:#64748b}.ab-ghost:hover{background:#f1f5f9}
    .ab-danger{background:#ef4444;color:#fff}.ab-danger:hover{background:#dc2626}
    .ab-book{background:linear-gradient(135deg,#7c3aed,#6366f1);color:#fff}.ab-book:hover{opacity:.9}
    .inp{width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;color:#334155;outline:none;font-family:inherit;box-sizing:border-box}.inp:focus{border-color:#2dd4b4;box-shadow:0 0 0 3px rgba(45,212,180,.15)}
    .lbl{display:block;font-size:12px;font-weight:500;color:#64748b;margin-bottom:5px}
    .panel-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:40;display:none;backdrop-filter:blur(2px);opacity:0;transition:opacity .2s ease}.panel-overlay.open{opacity:1}
    .panel-drawer{position:fixed;top:50%;left:50%;width:calc(100% - 48px);max-width:500px;max-height:90vh;background:#fff;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.18);z-index:50;display:flex;flex-direction:column;transform:translate(-50%,-50%) scale(.94);opacity:0;transition:transform .22s cubic-bezier(.34,1.56,.64,1),opacity .18s ease;pointer-events:none}.panel-drawer.open{transform:translate(-50%,-50%) scale(1);opacity:1;pointer-events:auto}
    .counselor-card{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:12px;cursor:pointer;transition:all .15s}.counselor-card:hover{border-color:#2dd4b4;background:#ecfdf9}.counselor-card.selected{border-color:#05967e;background:#ecfdf9}
    .slot-btn{padding:7px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:12px;font-weight:500;color:#334155;cursor:pointer;background:#fff;transition:all .15s}.slot-btn:hover:not(:disabled){border-color:#2dd4b4;background:#ecfdf9;color:#065f46}.slot-btn.selected{border-color:#05967e;background:#05967e;color:#fff}.slot-btn:disabled{opacity:.4;cursor:not-allowed;text-decoration:line-through}
    .tab-btn{padding:12px 20px;font-size:13px;font-weight:500;color:#64748b;background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;transition:all .15s;white-space:nowrap;display:flex;align-items:center;gap:8px}
    .tab-btn.active{color:#05967e;border-bottom-color:#05967e;font-weight:600}
    .tab-count{padding:2px 8px;border-radius:99px;font-size:11px;font-weight:600}
  </style>
</head>
<body style="background:#f8fafc;margin:0;">
<%- include('../partials/admin-sidebar') %>

<div style="margin-left:256px;min-height:100vh;display:flex;flex-direction:column;">

  <div style="height:56px;background:#fff;border-bottom:1px solid #f1f5f9;padding:0 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20;">
    <h1 style="font-size:15px;font-weight:600;color:#1e293b;margin:0;"><%= title %></h1>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:12px;color:#94a3b8;"><% const d=new Date(); %><%= d.toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %></span>
      <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;font-size:12px;font-weight:500;color:#475569;text-decoration:none;">
        <i data-lucide="external-link" style="width:13px;height:13px;"></i>
        ดูหน้าเว็บหลัก
      </a>
    </div>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.booked) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:12px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="calendar-check" style="width:16px;height:16px;flex-shrink:0;"></i> สร้างนัดหมายสำเร็จ — อัปเดตสถานะคำขอแล้ว</div>
    <% } if (query.updated) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#ecfeff;border:1px solid #a5f3fc;border-radius:12px;color:#155e75;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อัปเดตสถานะสำเร็จ</div>
    <% } if (query.error==='conflict') { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#fef2f2;border:1px solid #fca5a5;border-radius:12px;color:#991b1b;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> ช่วงเวลานี้ถูกจองแล้ว กรุณาเลือกเวลาอื่น</div>
    <% } %>

    <%
      const pendingFiltered = contacts.filter(c => ['new','contacted'].includes(c.status)).length
      const doneFiltered    = contacts.filter(c => ['converted','closed'].includes(c.status)).length
    %>

    <!-- Status Cards -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
      <div style="background:#fff;border:1px solid #fde68a;border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:16px;cursor:pointer;" onclick="switchTab('pending')">
        <div style="width:44px;height:44px;border-radius:12px;background:#fef3c7;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="inbox" style="width:22px;height:22px;color:#d97706;"></i>
        </div>
        <div>
          <p style="margin:0;font-size:28px;font-weight:700;color:#1e293b;line-height:1;"><%= pendingCount %></p>
          <p style="margin:4px 0 0;font-size:12px;color:#92400e;font-weight:500;">รอดำเนินการ</p>
          <p style="margin:2px 0 0;font-size:11px;color:#94a3b8;">คำขอใหม่ที่ยังไม่ได้นัด</p>
        </div>
      </div>
      <div style="background:#fff;border:1px solid #a0f3e1;border-radius:16px;padding:20px 24px;display:flex;align-items:center;gap:16px;cursor:pointer;" onclick="switchTab('done')">
        <div style="width:44px;height:44px;border-radius:12px;background:#d1fae5;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <i data-lucide="check-circle-2" style="width:22px;height:22px;color:#059669;"></i>
        </div>
        <div>
          <p style="margin:0;font-size:28px;font-weight:700;color:#1e293b;line-height:1;"><%= doneCount %></p>
          <p style="margin:4px 0 0;font-size:12px;color:#065f46;font-weight:500;">ดำเนินการแล้ว</p>
          <p style="margin:2px 0 0;font-size:11px;color:#94a3b8;">นัดหมายแล้วหรือปิดแล้ว</p>
        </div>
      </div>
    </div>

    <!-- Search -->
    <form method="GET" style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;padding:14px 16px;margin-bottom:16px;display:flex;gap:10px;align-items:flex-end;">
      <div style="flex:1;">
        <label class="lbl">ค้นหา</label>
        <div style="position:relative;">
          <i data-lucide="search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#94a3b8;"></i>
          <input name="search" value="<%= query.search||'' %>" class="inp" style="padding-left:32px;" placeholder="ชื่อ, เบอร์, อีเมล">
        </div>
      </div>
      <button type="submit" class="act-btn ab-primary"><i data-lucide="search" style="width:13px;height:13px;"></i> ค้นหา</button>
      <% if (query.search) { %><a href="/admin/contacts" class="act-btn ab-ghost" style="text-decoration:none;">ล้าง</a><% } %>
    </form>

    <!-- Tab + Table card -->
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;overflow:hidden;">

      <!-- Tab bar -->
      <div style="display:flex;border-bottom:1px solid #f1f5f9;padding:0 8px;">
        <button class="tab-btn active" id="tab-pending" onclick="switchTab('pending')">
          <i data-lucide="inbox" style="width:14px;height:14px;"></i>
          รอดำเนินการ
          <span class="tab-count" style="background:#fef3c7;color:#92400e;" id="badge-pending"><%= pendingFiltered %></span>
        </button>
        <button class="tab-btn" id="tab-done" onclick="switchTab('done')">
          <i data-lucide="check-circle-2" style="width:14px;height:14px;"></i>
          ติดต่อและทำนัดหมายแล้ว
          <span class="tab-count" style="background:#d1fae5;color:#065f46;" id="badge-done"><%= doneFiltered %></span>
        </button>
      </div>

      <!-- Table -->
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th>ผู้ส่งคำขอ</th>
              <th>ข้อมูลติดต่อ</th>
              <th>เรื่องที่ต้องการ</th>
              <th>รูปแบบ</th>
              <th>วันที่</th>
              <th>สถานะ</th>
              <th>การจัดการ</th>
            </tr>
          </thead>
          <tbody>
            <%
              const statusMap = {
                new:       {bg:'#fef3c7',color:'#92400e',label:'รอดำเนินการ'},
                contacted: {bg:'#dbeafe',color:'#1e40af',label:'ติดต่อแล้ว'},
                converted: {bg:'#d1fae5',color:'#065f46',label:'นัดหมายแล้ว'},
                closed:    {bg:'#f1f5f9',color:'#64748b',label:'ปิดแล้ว'},
              }
            %>
            <% contacts.forEach(c => {
              const st  = statusMap[c.status] || statusMap.new
              const grp = ['new','contacted'].includes(c.status) ? 'pending' : 'done'
            %>
            <tr data-grp="<%= grp %>">
              <td>
                <div style="display:flex;align-items:center;gap:10px;">
                  <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#2dd4b4,#06b6d4);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0;"><%= c.name.slice(0,1) %></div>
                  <div>
                    <div style="font-weight:600;color:#1e293b;font-size:13px;"><%= c.name %></div>
                    <% if (c.note) { %><div style="font-size:11px;color:#94a3b8;font-style:italic;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= c.note %>"><%= c.note %></div><% } %>
                  </div>
                </div>
              </td>
              <td>
                <% if (c.studentId) { %><div style="font-size:11px;color:#64748b;font-weight:500;margin-bottom:2px;">รหัส: <%= c.studentId %></div><% } %>
                <div style="font-size:13px;"><%= c.phone %></div>
                <% if (c.email) { %><div style="font-size:11px;color:#94a3b8;"><%= c.email %></div><% } %>
              </td>
              <td style="max-width:140px;font-size:12px;color:#334155;"><%= c.concern || '—' %></td>
              <td>
                <% if (c.sessionType==='online') { %>
                <div style="display:flex;align-items:center;gap:4px;"><i data-lucide="video" style="width:13px;height:13px;color:#0891b2;"></i><span style="font-size:12px;color:#0891b2;">ออนไลน์</span></div>
                <% } else { %>
                <div style="display:flex;align-items:center;gap:4px;"><i data-lucide="map-pin" style="width:13px;height:13px;color:#05967e;"></i><span style="font-size:12px;color:#05967e;">เข้ารับบริการด้วยตนเอง</span></div>
                <% } %>
              </td>
              <td style="font-size:12px;color:#64748b;white-space:nowrap;"><%= c.createdAt %></td>
              <td><span style="padding:3px 10px;background:<%= st.bg %>;color:<%= st.color %>;border-radius:99px;font-size:11px;font-weight:500;"><%= st.label %></span></td>
              <td>
                <div style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;">
                  <% if (['new','contacted'].includes(c.status)) { %>
                  <button class="act-btn ab-book book-btn" data-rec="<%= JSON.stringify(c) %>" title="สร้างนัดหมาย">
                    <i data-lucide="calendar-plus" style="width:13px;height:13px;"></i> สร้างนัด
                  </button>
                  <% } %>
                  <button class="act-btn ab-secondary edit-btn" data-rec="<%= JSON.stringify(c) %>">
                    <i data-lucide="pencil" style="width:13px;height:13px;"></i> จัดการ
                  </button>
                  <form method="POST" action="/admin/contacts/<%= c.id %>/delete" onsubmit="return confirm('ลบคำขอของ <%= c.name %>?')" style="margin:0;">
                    <button type="submit" class="act-btn ab-danger"><i data-lucide="trash-2" style="width:12px;height:12px;"></i></button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
            <tr id="emptyState" style="display:none;">
              <td colspan="7" style="text-align:center;padding:48px 16px;color:#94a3b8;">
                <i data-lucide="inbox" style="width:36px;height:36px;display:block;margin:0 auto 10px;opacity:.3;"></i>
                ไม่มีคำขอในหมวดนี้
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Overlay -->
<div id="overlay" class="panel-overlay" onclick="closeAll()"></div>

<!-- Panel: จัดการสถานะ -->
<div id="statusPanel" class="panel-drawer">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#05967e,#06b6d4);display:flex;align-items:center;justify-content:center;"><i data-lucide="clipboard-list" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#1e293b;">จัดการคำขอ</div>
        <div id="statusPanelSub" style="font-size:11px;color:#94a3b8;"></div>
      </div>
    </div>
    <button onclick="closeAll()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;padding:20px;">
    <form id="statusForm" method="POST" action="">
      <div id="statusInfoBox" style="padding:14px;background:#f8fafc;border-radius:12px;margin-bottom:20px;font-size:13px;display:grid;gap:6px;"></div>
      <div style="display:grid;gap:14px;">
        <div>
          <label class="lbl">สถานะ</label>
          <select name="status" id="f_status" class="inp">
            <option value="new">รอดำเนินการ</option>
            <option value="contacted">ติดต่อแล้ว</option>
            <option value="converted">นัดหมายแล้ว</option>
            <option value="closed">ปิดแล้ว</option>
          </select>
        </div>
        <div>
          <label class="lbl">บันทึกภายใน</label>
          <textarea name="note" id="f_note" rows="3" class="inp" style="resize:none;" placeholder="เช่น ติดต่อกลับเมื่อ 18 มิ.ย. ..."></textarea>
        </div>
      </div>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closeAll()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
    <button onclick="document.getElementById('statusForm').submit()" class="act-btn ab-primary" style="flex:1;justify-content:center;"><i data-lucide="save" style="width:14px;height:14px;"></i> บันทึก</button>
  </div>
</div>

<!-- Panel: สร้างนัดหมาย -->
<div id="bookPanel" class="panel-drawer" style="max-width:560px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#7c3aed,#6366f1);display:flex;align-items:center;justify-content:center;"><i data-lucide="calendar-plus" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#1e293b;">สร้างนัดหมายใหม่</div>
        <div id="bookPanelSub" style="font-size:11px;color:#94a3b8;"></div>
      </div>
    </div>
    <button onclick="closeAll()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;">
    <form method="POST" id="bookForm" action="">
      <div id="contactSummary" style="margin:16px 20px 0;padding:12px 14px;background:#f8fafc;border-radius:12px;font-size:13px;display:grid;gap:5px;"></div>
      <!-- Step 1 -->
      <div style="padding:20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#7c3aed;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">1</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกนักจิตวิทยาให้คำปรึกษา</span>
        </div>
        <div style="display:grid;gap:8px;">
          <% counselors.forEach(c => { %>
          <label class="counselor-card" id="bcard_<%= c.id %>">
            <input type="radio" name="counselorId" value="<%= c.id %>" data-duration="<%= c.sessionDuration %>" data-name="<%= c.name %>" style="accent-color:#7c3aed;" onchange="onBookCounselorChange(this)" required>
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#2dd4b4,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0;"><%= c.avatar||c.name.slice(0,1) %></div>
            <div style="flex:1;min-width:0;"><div style="font-weight:600;font-size:13px;color:#1e293b;"><%= c.name %></div><div style="font-size:11px;color:#94a3b8;"><%= c.title %></div></div>
            <div style="font-size:11px;color:#94a3b8;flex-shrink:0;"><%= c.sessionDuration %> นาที</div>
          </label>
          <% }) %>
          <% if (!counselors.length) { %><div style="font-size:13px;color:#94a3b8;text-align:center;padding:16px;">ยังไม่มีนักจิตวิทยา</div><% } %>
        </div>
      </div>
      <!-- Step 2 -->
      <div style="padding:20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#7c3aed;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">2</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกวันที่และเวลา</span>
        </div>
        <div style="margin-bottom:12px;">
          <label class="lbl">วันที่นัดหมาย</label>
          <input type="date" name="date" id="bDateInput" min="<%= new Date().toISOString().split('T')[0] %>" class="inp" onchange="bLoadSlots()" required disabled>
          <div id="bDateHint" style="font-size:11px;color:#94a3b8;margin-top:5px;">กรุณาเลือกนักจิตวิทยาก่อน</div>
        </div>
        <div id="bSlotLoading" style="display:none;font-size:13px;color:#94a3b8;padding:6px 0;">กำลังโหลดช่วงเวลา...</div>
        <div id="bSlotSection" style="display:none;">
          <label class="lbl">เลือกเวลา *</label>
          <div id="bSlotGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:6px;"></div>
          <input type="hidden" name="time" id="bTimeInput" required>
        </div>
      </div>
      <!-- Step 3 -->
      <div style="padding:20px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#7c3aed;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">3</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">รูปแบบและหมายเหตุ</span>
        </div>
        <div style="display:grid;gap:12px;">
          <div>
            <label class="lbl">รูปแบบ</label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #a5f3fc;border-radius:10px;cursor:pointer;background:#ecfeff;">
                <input type="radio" name="type" value="online" id="typeOnline" checked style="accent-color:#0891b2;"><i data-lucide="video" style="width:14px;height:14px;color:#0891b2;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">ออนไลน์</span>
              </label>
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">
                <input type="radio" name="type" value="onsite" id="typeOnsite" style="accent-color:#05967e;"><i data-lucide="map-pin" style="width:14px;height:14px;color:#05967e;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">เข้ารับบริการด้วยตนเอง</span>
              </label>
            </div>
          </div>
          <div>
            <label class="lbl">หมายเหตุ (ถ้ามี)</label>
            <textarea name="note" rows="2" class="inp" style="resize:none;" placeholder="เช่น ครั้งแรก, ติดตามอาการ..."></textarea>
          </div>
          <div id="bApptSummary" style="display:none;padding:14px;background:#f3e8ff;border:1px solid #ddd6fe;border-radius:12px;">
            <div style="font-size:11px;font-weight:600;color:#64748b;margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em;">สรุปการนัดหมาย</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px;"><span style="color:#64748b;">นักจิตวิทยา</span><span id="bSummCounselor" style="font-weight:500;color:#1e293b;"></span></div>
            <div style="display:flex;justify-content:space-between;font-size:13px;"><span style="color:#64748b;">วันเวลา</span><span id="bSummDateTime" style="font-weight:500;color:#1e293b;"></span></div>
          </div>
        </div>
      </div>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closeAll()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
    <button onclick="submitBook()" class="act-btn ab-book" style="flex:1;justify-content:center;"><i data-lucide="calendar-check" style="width:14px;height:14px;"></i> ยืนยันนัดหมาย</button>
  </div>
</div>

<script>
  const SCHEDULES = <%- JSON.stringify(schedules) %>
  let bCounselor = null, bTime = null

  function esc(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
  }

  // ── Tab switching ─────────────────────────────────────────────────────────────
  function switchTab(tab) {
    document.getElementById('tab-pending').classList.toggle('active', tab==='pending')
    document.getElementById('tab-done').classList.toggle('active', tab==='done')
    let vis = 0
    document.querySelectorAll('tr[data-grp]').forEach(r => {
      const show = r.dataset.grp === tab
      r.style.display = show ? '' : 'none'
      if (show) vis++
    })
    document.getElementById('emptyState').style.display = vis === 0 ? '' : 'none'
  }

  // ── Status panel ──────────────────────────────────────────────────────────────
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const c = JSON.parse(btn.dataset.rec)
      document.getElementById('statusPanelSub').textContent = c.name
      document.getElementById('statusForm').action          = '/admin/contacts/' + c.id + '/status'
      document.getElementById('f_status').value             = c.status || 'new'
      document.getElementById('f_note').value               = c.note   || ''
      const typeLabel = c.sessionType==='online' ? 'ออนไลน์' : 'เข้ารับบริการด้วยตนเอง'
      document.getElementById('statusInfoBox').innerHTML = `
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">ชื่อ</span><strong>${esc(c.name)}</strong></div>
        ${c.studentId?`<div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">รหัสนักศึกษา</span><span>${esc(c.studentId)}</span></div>`:''}
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">โทร</span><span>${esc(c.phone)}</span></div>
        ${c.email?`<div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">อีเมล</span><span>${esc(c.email)}</span></div>`:''}
        ${c.concern?`<div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">เรื่อง</span><span>${esc(c.concern)}</span></div>`:''}
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:80px;">รูปแบบ</span><span>${typeLabel}</span></div>
      `
      openOverlay(); document.getElementById('statusPanel').classList.add('open')
    })
  })

  // ── Book panel ────────────────────────────────────────────────────────────────
  document.querySelectorAll('.book-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const c = JSON.parse(btn.dataset.rec)
      document.getElementById('bookPanelSub').textContent = 'สำหรับ ' + c.name
      document.getElementById('bookForm').action           = '/admin/contacts/' + c.id + '/book'
      if (c.sessionType==='onsite') { document.getElementById('typeOnsite').checked=true; document.getElementById('typeOnline').checked=false }
      else { document.getElementById('typeOnline').checked=true; document.getElementById('typeOnsite').checked=false }
      const typeLabel = c.sessionType==='online' ? 'ออนไลน์' : 'เข้ารับบริการด้วยตนเอง'
      document.getElementById('contactSummary').innerHTML = `
        <div style="font-size:11px;font-weight:600;color:#64748b;margin-bottom:4px;text-transform:uppercase;letter-spacing:.05em;">ผู้ร้องขอ</div>
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">ชื่อ</span><strong>${esc(c.name)}</strong></div>
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">โทร</span><span>${esc(c.phone)}</span></div>
        ${c.concern?`<div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">เรื่อง</span><span>${esc(c.concern)}</span></div>`:''}
        <div style="display:flex;gap:8px;"><span style="color:#94a3b8;min-width:72px;">รูปแบบ</span><span>${typeLabel}</span></div>
      `
      bCounselor=null; bTime=null
      document.getElementById('bDateInput').disabled=true; document.getElementById('bDateInput').value=''
      document.getElementById('bDateHint').style.display='block'
      document.getElementById('bSlotSection').style.display='none'
      document.getElementById('bApptSummary').style.display='none'
      document.querySelectorAll('.counselor-card').forEach(el=>el.classList.remove('selected'))
      document.querySelectorAll('input[name="counselorId"]').forEach(r=>r.checked=false)
      openOverlay(); document.getElementById('bookPanel').classList.add('open')
    })
  })

  function openOverlay() {
    const ov = document.getElementById('overlay')
    ov.style.display='block'; requestAnimationFrame(()=>ov.classList.add('open'))
    document.body.style.overflow='hidden'
  }
  function closeAll() {
    const ov = document.getElementById('overlay')
    ov.classList.remove('open')
    document.getElementById('statusPanel').classList.remove('open')
    document.getElementById('bookPanel').classList.remove('open')
    document.body.style.overflow=''
    setTimeout(()=>{ov.style.display='none'},200)
  }
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeAll()})

  // ── Booking form logic ────────────────────────────────────────────────────────
  function onBookCounselorChange(radio) {
    bCounselor={id:radio.value,duration:parseInt(radio.dataset.duration),name:radio.dataset.name}
    document.querySelectorAll('.counselor-card').forEach(el=>{
      const r=el.querySelector('input[name="counselorId"]')
      el.classList.toggle('selected',r&&r.value===radio.value)
    })
    document.getElementById('bDateInput').disabled=false; document.getElementById('bDateInput').value=''
    document.getElementById('bDateHint').style.display='none'
    document.getElementById('bSlotSection').style.display='none'
    document.getElementById('bApptSummary').style.display='none'
    bTime=null; document.getElementById('bTimeInput').value=''
  }
  async function bLoadSlots() {
    const date=document.getElementById('bDateInput').value
    if (!date||!bCounselor) return
    document.getElementById('bSlotSection').style.display='none'
    document.getElementById('bSlotLoading').style.display='block'
    const resp=await fetch(`/admin/appointments/slots?counselorId=${bCounselor.id}&date=${date}`)
    const {slots}=await resp.json()
    document.getElementById('bSlotLoading').style.display='none'
    document.getElementById('bSlotSection').style.display='block'
    const grid=document.getElementById('bSlotGrid')
    if (!slots.length){grid.innerHTML='<div style="font-size:12px;color:#94a3b8;grid-column:1/-1;">ไม่มีตารางเวลาในวันนี้</div>';return}
    grid.innerHTML=slots.map(s=>`<button type="button" class="slot-btn" onclick="bSelectSlot(this,'${s.time}')" ${!s.available?'disabled':''}>${s.time}</button>`).join('')
  }
  function bSelectSlot(btn,time) {
    bTime=time; document.getElementById('bTimeInput').value=time
    document.querySelectorAll('#bSlotGrid .slot-btn').forEach(b=>b.classList.remove('selected'))
    btn.classList.add('selected')
    if (bCounselor) {
      const date=document.getElementById('bDateInput').value
      const ds=new Date(date).toLocaleDateString('th-TH',{weekday:'short',day:'numeric',month:'short',year:'numeric'})
      document.getElementById('bSummCounselor').textContent=bCounselor.name
      document.getElementById('bSummDateTime').textContent=`${ds} ${time} น.`
      document.getElementById('bApptSummary').style.display='block'
    }
  }
  function submitBook() {
    const form=document.getElementById('bookForm')
    if (!form.reportValidity()) return
    if (!bTime){alert('กรุณาเลือกเวลานัดหมาย');return}
    form.submit()
  }

  switchTab('pending')
  lucide.createIcons()
</script>
</body>
</html>
