<!-- Panel: สร้างนัดหมาย -->
<div id="bookPanel" class="panel-drawer" style="max-width:560px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:#3874FF;display:flex;align-items:center;justify-content:center;"><i data-lucide="calendar-plus" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#1e293b;">สร้างนัดหมายใหม่</div>
        <div id="bookPanelSub" style="font-size:12px;color:#94a3b8;"></div>
      </div>
    </div>
    <button onclick="closeAll()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;">
    <form method="POST" id="bookForm" action="">
      <div id="contactSummary" style="margin:16px 20px 0;padding:12px 14px;background:#f8fafc;border-radius:12px;font-size:13px;display:grid;gap:5px;"></div>
      <div id="clientMatchSection" style="display:none;margin:16px 20px 0;padding:14px;background:#fffbeb;border:1px solid #fde68a;border-radius:12px;">
        <div style="font-size:12px;font-weight:600;color:#92400e;margin-bottom:10px;display:flex;align-items:center;gap:6px;">
          <i data-lucide="alert-triangle" style="width:14px;height:14px;flex-shrink:0;"></i>
          พบผู้รับบริการที่มีข้อมูลตรงกัน กรุณายืนยันว่าใช่คนเดียวกันหรือไม่
        </div>
        <div id="clientMatchList" style="display:grid;gap:8px;"></div>
      </div>
      <!-- Step 1 -->
      <div style="padding:20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#3874FF;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">1</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกนักจิตวิทยาให้คำปรึกษา</span>
        </div>
        <div style="display:grid;gap:8px;">
          <%
            const _DAY_ABBR = { 0:'อา', 1:'จ', 2:'อ', 3:'พ', 4:'พฤ', 5:'ศ', 6:'ส' }
            const _cDays = {}
            schedules.forEach(s => {
              if (!s.isActive) return
              if (!_cDays[s.counselorId]) _cDays[s.counselorId] = []
              if (!_cDays[s.counselorId].includes(s.dayOfWeek)) _cDays[s.counselorId].push(s.dayOfWeek)
            })
            Object.keys(_cDays).forEach(k => _cDays[k].sort((a,b) => a-b))
          %>
          <% counselors.forEach(c => { %>
          <label class="counselor-card" id="bcard_<%= c.id %>">
            <input type="radio" name="counselorId" value="<%= c.id %>" data-duration="<%= c.sessionDuration %>" data-name="<%= c.name %>" style="accent-color:#3874FF;" onchange="onBookCounselorChange(this)" required>
            <div style="width:36px;height:36px;border-radius:10px;overflow:hidden;background:#3874FF;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0;">
              <% if (c.photo) { %>
                <img data-counselor-profile-photo="<%= c.id %>" src="<%= c.photo %>" alt="<%= c.name %>" style="width:100%;height:100%;object-fit:cover;">
              <% } else { %>
                <%= c.avatar||c.name.slice(0,1) %>
              <% } %>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;flex-wrap:wrap;gap:3px;">
                <span style="font-weight:600;font-size:13px;color:#1e293b;"><%= c.name %></span>
                <% (_cDays[c.id] || []).forEach(dow => { %>
                <span style="width:20px;height:20px;border-radius:50%;background:#eaf1ff;border:1px solid #b9d0ff;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#3874FF;flex-shrink:0;" title="วัน<%= ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'][dow] %>">
                  <%= _DAY_ABBR[dow] %>
                </span>
                <% }) %>
              </div>
              <div style="font-size:12px;color:#94a3b8;"><%= c.title %></div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
              <div style="font-size:12px;font-weight:700;color:#3874FF;">นัดหมายรวม <%= counselorActiveCounts[c.id] || 0 %> นัด</div>
              <div style="font-size:12px;color:#94a3b8;"><%= c.sessionDuration %> นาที</div>
            </div>
          </label>
          <% }) %>
          <% if (!counselors.length) { %><div style="font-size:13px;color:#94a3b8;text-align:center;padding:16px;">ยังไม่มีนักจิตวิทยา</div><% } %>
        </div>
      </div>
      <!-- Step 2 -->
      <div style="padding:20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#3874FF;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">2</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกวันที่และเวลา</span>
        </div>
        <div style="margin-bottom:12px;">
          <label class="lbl">วันที่นัดหมาย</label>
          <input type="date" name="date" id="bDateInput" min="<%= new Date().toISOString().split('T')[0] %>" class="inp" onchange="bLoadSlots()" required disabled>
          <div id="bDateHint" style="font-size:12px;color:#94a3b8;margin-top:5px;">กรุณาเลือกนักจิตวิทยาก่อน</div>
        </div>
        <div id="bAvailableDays" style="display:none;margin-bottom:12px;">
          <div style="font-size:12px;font-weight:500;color:#64748b;margin-bottom:6px;">วันที่เปิดรับนัด</div>
          <div id="bDayBadges" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
        </div>
        <div id="bSlotLoading" style="display:none;font-size:13px;color:#94a3b8;padding:6px 0;">กำลังโหลดช่วงเวลา...</div>
        <div id="bSlotSection" style="display:none;">
          <label class="lbl">เลือกเวลา *</label>
          <div id="bSlotGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:6px;"></div>
          <input type="hidden" name="time" id="bTimeInput" required>
        </div>
      </div>
      <!-- Step 3 -->
      <div style="padding:20px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#3874FF;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">3</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">รูปแบบและหมายเหตุ</span>
        </div>
        <div style="display:grid;gap:12px;">
          <div>
            <label class="lbl">รูปแบบ</label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <% if (sessionTypes.online) { %>
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #a5f3fc;border-radius:10px;cursor:pointer;background:#ecfeff;">
                <input type="radio" name="type" value="online" id="typeOnline" <%= defaultSessionType === 'online' ? 'checked' : '' %> style="accent-color:#0891b2;" onchange="toggleContactMeetingLinkField()"><i data-lucide="video" style="width:14px;height:14px;color:#0891b2;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">ออนไลน์</span>
              </label>
              <% } %>
              <% if (sessionTypes.phone) { %>
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">
                <input type="radio" name="type" value="phone" id="typePhone" <%= defaultSessionType === 'phone' ? 'checked' : '' %> style="accent-color:#05967e;" onchange="toggleContactMeetingLinkField()"><i data-lucide="phone" style="width:14px;height:14px;color:#05967e;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">โทรศัพท์</span>
              </label>
              <% } %>
              <% if (sessionTypes.onsite) { %>
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">
                <input type="radio" name="type" value="onsite" id="typeOnsite" <%= defaultSessionType === 'onsite' ? 'checked' : '' %> style="accent-color:#3874FF;" onchange="toggleContactMeetingLinkField()"><i data-lucide="map-pin" style="width:14px;height:14px;color:#3874FF;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">เข้ารับบริการด้วยตนเอง</span>
              </label>
              <% } %>
            </div>
          </div>
          <div id="contactMeetingLinkWrap">
            <label class="lbl">ลิงก์สำหรับเข้าร่วมวิดีโอคอล</label>
            <input type="url" name="meetingLink" id="contactMeetingLink" class="inp" placeholder="Google Meet, Zoom, Microsoft Teams, LINE Meeting">
          </div>
          <div>
            <label class="lbl">หมายเหตุ (ถ้ามี)</label>
            <textarea name="note" rows="2" class="inp" style="resize:none;" placeholder="เช่น ครั้งแรก, ติดตามอาการ..."></textarea>
          </div>
          <div id="bApptSummary" style="display:none;padding:14px;background:#eaf1ff;border:1px solid #b9d0ff;border-radius:12px;">
            <div style="font-size:12px;font-weight:600;color:#64748b;margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em;">สรุปการนัดหมาย</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px;"><span style="color:#64748b;">นักจิตวิทยา</span><span id="bSummCounselor" style="font-weight:500;color:#1e293b;"></span></div>
            <div style="display:flex;justify-content:space-between;font-size:13px;"><span style="color:#64748b;">วันเวลา</span><span id="bSummDateTime" style="font-weight:500;color:#1e293b;"></span></div>
          </div>
        </div>
      </div>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closeAll()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
    <button onclick="submitBook()" class="act-btn ab-book" style="flex:1;justify-content:center;"><i data-lucide="calendar-check" style="width:14px;height:14px;"></i> ยืนยันนัดหมาย</button>
  </div>
