<style>
#cal-tooltip {
  position: fixed;
  z-index: 9999;
  background: #1e293b;
  color: #f8fafc;
  border-radius: 10px;
  padding: 10px 13px;
  font-size: 12px;
  line-height: 1.6;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.12s;
  max-width: 220px;
  box-shadow: 0 8px 24px rgba(0,0,0,.25);
  white-space: nowrap;
}
#cal-tooltip.visible { opacity: 1; }
#cal-tooltip .tt-label { font-size:10px; color:#94a3b8; font-weight:600; text-transform:uppercase; letter-spacing:.05em; margin-bottom:4px; }
#cal-tooltip .tt-row { display:flex; align-items:center; gap:6px; }
#cal-tooltip .tt-row + .tt-row { margin-top:3px; }
</style>
<div id="cal-tooltip" role="tooltip"></div>
<script>
(function () {
  const tip = document.getElementById('cal-tooltip')
  if (!tip) return

  function show(el, e) {
    const client   = el.dataset.client   || ''
    const time     = el.dataset.time     || ''
    const status   = el.dataset.status   || ''
    const type     = el.dataset.type     || ''
    const counselor = el.dataset.counselor || ''

    let html = `<div class="tt-label">นัดหมาย</div>`
    html += `<div class="tt-row"><strong>${client}</strong></div>`
    if (counselor) html += `<div class="tt-row" style="color:#94a3b8;">นักจิตวิทยา: ${counselor}</div>`
    if (time)   html += `<div class="tt-row" style="color:#7dd3fc;">🕐 ${time} น.</div>`
    if (type)   html += `<div class="tt-row" style="color:#a5b4fc;">${type === 'ออนไลน์' ? '📹' : '📍'} ${type}</div>`
    if (status) html += `<div class="tt-row" style="color:#86efac;">${status}</div>`

    tip.innerHTML = html
    tip.classList.add('visible')
    move(e)
  }

  function move(e) {
    const vw = window.innerWidth
    const vh = window.innerHeight
    let x = e.clientX + 14
    let y = e.clientY - 10
    tip.style.left = x + 'px'
    tip.style.top  = y + 'px'
    // flip left if near right edge
    if (x + tip.offsetWidth + 20 > vw) tip.style.left = (e.clientX - tip.offsetWidth - 14) + 'px'
    if (y + tip.offsetHeight + 10 > vh) tip.style.top  = (e.clientY - tip.offsetHeight - 6) + 'px'
  }

  function hide() { tip.classList.remove('visible') }

  document.addEventListener('mouseover', function (e) {
    const el = e.target.closest('.cal-appt')
    if (el) show(el, e)
  })
  document.addEventListener('mousemove', function (e) {
    if (tip.classList.contains('visible')) move(e)
  })
  document.addEventListener('mouseout', function (e) {
    if (e.target.closest && e.target.closest('.cal-appt') && !e.relatedTarget?.closest('.cal-appt')) hide()
  })
})()
</script>
<script>lucide.createIcons();</script>

