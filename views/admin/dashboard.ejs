<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindWell Admin</title>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50">

<%- include('../partials/admin-sidebar') %>

<div class="ml-64 min-h-screen flex flex-col">
  <header class="h-14 bg-white border-b border-slate-100 px-6 flex items-center justify-between sticky top-0 z-20">
    <h1 class="font-semibold text-slate-800"><%= title %></h1>
    <div class="flex items-center gap-3">
      <span class="text-xs text-slate-400">
        <% const d = new Date(); %>
        <%= d.toLocaleDateString('th-TH', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %>
      </span>
      <a href="/" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-medium text-slate-600 hover:text-brand-600 hover:border-brand-200 transition-colors">
        <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
        ดูหน้าเว็บหลัก
      </a>
    </div>
  </header>

  <main class="flex-1 p-6">

    <!-- Stat cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <div class="stat-card">
        <div class="w-10 h-10 rounded-xl bg-brand-100 flex items-center justify-center flex-shrink-0">
          <i data-lucide="user-check" class="w-5 h-5 text-brand-600"></i>
        </div>
        <div>
          <p class="text-2xl font-bold text-slate-800"><%= stats.totalCounselors %></p>
          <p class="text-xs text-slate-500">นักให้คำปรึกษา</p>
          <% if (stats.pendingApproval > 0) { %>
          <p class="text-xs text-amber-600 font-medium mt-0.5">รออนุมัติ <%= stats.pendingApproval %> คน</p>
          <% } %>
        </div>
      </div>
      <div class="stat-card">
        <div class="w-10 h-10 rounded-xl bg-ocean-100 flex items-center justify-center flex-shrink-0">
          <i data-lucide="users" class="w-5 h-5 text-ocean-600"></i>
        </div>
        <div>
          <p class="text-2xl font-bold text-slate-800"><%= stats.totalClients %></p>
          <p class="text-xs text-slate-500">ผู้รับบริการทั้งหมด</p>
          <p class="text-xs text-brand-600 font-medium mt-0.5">ใช้งานอยู่ <%= stats.activeClients %> คน</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center flex-shrink-0">
          <i data-lucide="calendar-check" class="w-5 h-5 text-purple-600"></i>
        </div>
        <div>
          <p class="text-2xl font-bold text-slate-800"><%= stats.totalAppointments %></p>
          <p class="text-xs text-slate-500">นัดหมายทั้งหมด</p>
          <p class="text-xs text-amber-600 font-medium mt-0.5">รอยืนยัน <%= stats.pendingAppointments %> รายการ</p>
        </div>
      </div>
      <a href="/admin/contacts" class="stat-card" style="text-decoration:none; cursor:pointer;">
        <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0">
          <i data-lucide="inbox" class="w-5 h-5 text-amber-600"></i>
        </div>
        <div>
          <p class="text-2xl font-bold text-slate-800"><%= stats.newContacts %></p>
          <p class="text-xs text-slate-500">คำขอรอดำเนินการ</p>
          <p class="text-xs text-brand-600 font-medium mt-0.5">คลิกเพื่อจัดการ</p>
        </div>
      </a>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Left column: calendar + recent appointments -->
      <div class="lg:col-span-2 flex flex-col gap-6">

        <!-- ── Weekly Calendar ── -->
        <div class="card">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-semibold text-slate-700 flex items-center gap-2">
              <i data-lucide="calendar-days" class="w-4 h-4 text-brand-500"></i>
              ตารางเวลานักให้คำปรึกษา
            </h2>
            <a href="/admin/schedules" class="text-xs text-brand-600 hover:underline">จัดการตาราง →</a>
          </div>

          <!-- Week navigation -->
          <%
            const CAL_MONTHS = ['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.']
            const ws = weekDays[0], we = weekDays[6]
            const calYear = parseInt(we.dateStr.split('-')[0]) + 543
            const calLabel = ws.dayNum + ' ' + CAL_MONTHS[ws.month - 1] + ' – ' + we.dayNum + ' ' + CAL_MONTHS[we.month - 1] + ' ' + calYear
          %>
          <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
            <a href="/admin?week=<%= prevWeekStr %>"
               style="display:inline-flex; align-items:center; padding:5px 12px; border-radius:6px; border:1px solid #e2e8f0; font-size:12px; color:#64748b; text-decoration:none; background:#fff; font-weight:500; transition:background 0.15s;"
               onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#fff'">
              ◀ ก่อนหน้า
            </a>
            <span style="font-size:13px; font-weight:700; color:#1e293b;"><%= calLabel %></span>
            <a href="/admin?week=<%= nextWeekStr %>"
               style="display:inline-flex; align-items:center; padding:5px 12px; border-radius:6px; border:1px solid #e2e8f0; font-size:12px; color:#64748b; text-decoration:none; background:#fff; font-weight:500; transition:background 0.15s;"
               onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#fff'">
              ถัดไป ▶
            </a>
          </div>

          <!-- Calendar grid -->
          <div style="overflow-x:auto; overflow-y:auto; max-height:340px; border:1px solid #e2e8f0; border-radius:8px;">
            <table style="width:100%; border-collapse:collapse; table-layout:fixed; min-width:480px;">
              <!-- Day headers -->
              <thead>
                <tr style="background:#f8fafc; position:sticky; top:0; z-index:2;">
                  <th style="width:42px; border-bottom:2px solid #e2e8f0; border-right:1px solid #e2e8f0;"></th>
                  <% weekDays.forEach(day => { %>
                  <th style="padding:6px 2px; text-align:center; border-bottom:2px solid #e2e8f0; border-left:1px solid #f1f5f9;">
                    <div style="font-size:10px; color:#94a3b8; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; line-height:1;"><%= day.dayNameShort %></div>
                    <div style="width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:3px auto 0; font-size:12px; font-weight:700; background:<%= day.isToday ? '#3b82f6' : 'transparent' %>; color:<%= day.isToday ? '#fff' : '#1e293b' %>; line-height:1;"><%= day.dayNum %></div>
                  </th>
                  <% }) %>
                </tr>
              </thead>

              <!-- Hour rows -->
              <tbody>
                <% HOURS.forEach((h, hi) => { %>
                <tr>
                  <td style="padding:0 6px 0 2px; text-align:right; color:#94a3b8; font-size:10px; vertical-align:top; padding-top:3px; border-right:1px solid #e2e8f0; border-top:<%= hi > 0 ? '1px solid #f1f5f9' : 'none' %>; white-space:nowrap; background:#fafbfc;">
                    <%= String(h).padStart(2,'0') %>:00
                  </td>
                  <% calendarGrid[hi].forEach((cell, di) => {
                    // detect if this is the first slot of a counselor's block
                    const isStart = (s) => {
                      if (hi === 0) return true
                      const ph = HOURS[hi - 1]
                      return !(parseInt(s.startTime.split(':')[0]) <= ph && parseInt(s.endTime.split(':')[0]) > ph)
                    }
                  %>
                  <td style="border-left:1px solid #f1f5f9; border-top:<%= hi > 0 ? '1px solid #f8fafc' : 'none' %>; height:44px; vertical-align:top; padding:2px; overflow:hidden;">
                    <% cell.schedules.forEach(s => {
                      const clr = counselorColors[s.counselorId] || { color:'#6366f1', light:'#e0e7ff' }
                      const cDisplayName = (counselorMap[s.counselorId] || {}).name || s.counselorId
                      const showLabel = isStart(s)
                    %>
                    <div title="<%= cDisplayName %> (<%= s.startTime %>–<%= s.endTime %>)"
                         style="background:<%= clr.light %>; border-left:2px solid <%= clr.color %>; border-radius:2px; padding:<%= showLabel ? '2px 3px' : '0' %>; margin-bottom:1px; height:<%= showLabel ? 'auto' : '7px' %>; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:9px; color:<%= clr.color %>; font-weight:600; line-height:1.4;">
                      <% if (showLabel) { %><%= cDisplayName.split(' ')[0] || cDisplayName %><% } %>
                    </div>
                    <% }) %>
                    <% cell.appointments.forEach(a => {
                      const APT_BORDER = { pending:'#f59e0b', confirmed:'#3b82f6', completed:'#10b981' }
                      const APT_BG     = { pending:'#fef9c3', confirmed:'#eff6ff', completed:'#f0fdf4' }
                      const bdClr = APT_BORDER[a.status] || '#6366f1'
                      const bgClr = APT_BG[a.status] || '#f5f3ff'
                    %>
                    <div title="<%= a.clientName %> (<%= a.time %>)"
                         style="background:<%= bgClr %>; border-left:2px solid <%= bdClr %>; border-radius:2px; padding:2px 3px; margin-bottom:1px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:9px; color:#334155; font-weight:600; line-height:1.4;">
                      📅 <%= a.clientName %>
                    </div>
                    <% }) %>
                  </td>
                  <% }) %>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- Legend -->
          <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:10px; padding-top:10px; border-top:1px solid #f1f5f9;">
            <span style="font-size:10px; color:#94a3b8; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;">คำอธิบาย</span>
            <%
              const legendCounselors = Object.keys(counselorColors).map(id => ({
                id,
                color: counselorColors[id].color,
                light: counselorColors[id].light,
                name: (counselorMap[id] || {}).name || id
              }))
            %>
            <% legendCounselors.forEach(c => { %>
            <div style="display:flex; align-items:center; gap:5px; font-size:11px; color:#475569;">
              <div style="width:12px; height:12px; border-radius:2px; background:<%= c.light %>; border-left:3px solid <%= c.color %>; flex-shrink:0;"></div>
              <%= c.name %>
            </div>
            <% }) %>
            <div style="display:flex; align-items:center; gap:5px; font-size:11px; color:#475569;">
              <div style="width:12px; height:12px; border-radius:2px; background:#fef9c3; border-left:3px solid #f59e0b; flex-shrink:0;"></div>
              นัดหมาย
            </div>
          </div>
        </div>

        <!-- ── Recent appointments ── -->
        <div class="card">
          <div class="flex items-center justify-between mb-5">
            <h2 class="font-semibold text-slate-700 flex items-center gap-2">
              <i data-lucide="calendar-clock" class="w-4 h-4 text-brand-500"></i>
              นัดหมายล่าสุด
            </h2>
            <a href="/admin/appointments" class="text-xs text-brand-600 hover:underline">ดูทั้งหมด →</a>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-slate-100">
                  <th class="table-th">ผู้รับบริการ</th>
                  <th class="table-th">นักให้คำปรึกษา</th>
                  <th class="table-th">วันที่</th>
                  <th class="table-th">สถานะ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <% recentAppointments.forEach(a => { %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="table-td font-medium text-slate-800"><%= a.clientName %></td>
                  <td class="table-td text-slate-500 text-xs"><%= a.counselorName %></td>
                  <td class="table-td text-slate-500 text-xs"><%= a.date %> <%= a.time %></td>
                  <td class="table-td">
                    <% const badge = { pending:'badge-yellow', confirmed:'badge-blue', completed:'badge-green', cancelled:'badge-red' } %>
                    <% const label = { pending:'รอยืนยัน', confirmed:'ยืนยันแล้ว', completed:'เสร็จสิ้น', cancelled:'ยกเลิก' } %>
                    <span class="<%= badge[a.status] %>"><%= label[a.status] %></span>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

      </div><!-- /left column -->

      <!-- Right column: quick actions + stats -->
      <div class="space-y-4">
        <div class="card">
          <h2 class="font-semibold text-slate-700 mb-4 flex items-center gap-2">
            <i data-lucide="zap" class="w-4 h-4 text-brand-500"></i>
            เมนูด่วน
          </h2>
          <div class="space-y-2">
            <a href="/admin/counselors?status=pending" class="flex items-center gap-3 p-3 rounded-xl bg-amber-50 hover:bg-amber-100 transition-colors">
              <i data-lucide="user-check" class="w-4 h-4 text-amber-600"></i>
              <div>
                <p class="text-sm font-medium text-amber-800">อนุมัตินักให้คำปรึกษา</p>
                <p class="text-xs text-amber-600">รออนุมัติ <%= stats.pendingApproval %> คน</p>
              </div>
            </a>
            <a href="/admin/appointments?status=pending" class="flex items-center gap-3 p-3 rounded-xl bg-brand-50 hover:bg-brand-100 transition-colors">
              <i data-lucide="calendar-clock" class="w-4 h-4 text-brand-600"></i>
              <div>
                <p class="text-sm font-medium text-brand-800">ยืนยันนัดหมาย</p>
                <p class="text-xs text-brand-600">รอยืนยัน <%= stats.pendingAppointments %> รายการ</p>
              </div>
            </a>
            <a href="/admin/schedules" class="flex items-center gap-3 p-3 rounded-xl bg-ocean-50 hover:bg-ocean-100 transition-colors">
              <i data-lucide="clock" class="w-4 h-4 text-ocean-600"></i>
              <div>
                <p class="text-sm font-medium text-ocean-800">จัดการตารางเวลา</p>
                <p class="text-xs text-ocean-600">ตั้งค่าความพร้อมของนักให้คำปรึกษา</p>
              </div>
            </a>
          </div>
        </div>

        <div class="card">
          <h2 class="font-semibold text-slate-700 mb-3 flex items-center gap-2">
            <i data-lucide="bar-chart-2" class="w-4 h-4 text-brand-500"></i>
            สรุปสถิติ
          </h2>
          <div class="space-y-3">
            <div class="flex justify-between items-center text-sm">
              <span class="text-slate-500">อัตราการยืนยัน</span>
              <span class="font-semibold text-slate-700">78%</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5">
              <div class="bg-brand-500 h-1.5 rounded-full" style="width:78%"></div>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="text-slate-500">ความพึงพอใจ</span>
              <span class="font-semibold text-slate-700">96%</span>
            </div>
            <div class="w-full bg-slate-100 rounded-full h-1.5">
              <div class="bg-ocean-500 h-1.5 rounded-full" style="width:96%"></div>
            </div>
          </div>
        </div>
      </div><!-- /right column -->

    </div><!-- /grid -->

  </main>
</div>

<script>lucide.createIcons();</script>
</body>
</html>
