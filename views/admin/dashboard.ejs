    const fallback = document.createElement('p')
    fallback.style.cssText = 'font-size:12px;color:#94a3b8;margin:10px 0 0;line-height:1.5;'
    fallback.textContent = 'ไม่สามารถโหลดกราฟได้ กรุณาตรวจสอบการเชื่อมต่อแล้วรีเฟรชหน้าอีกครั้ง'
    ctx.insertAdjacentElement('afterend', fallback)
    return
  }

  new ChartCtor(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label: 'รอยืนยัน', data: pending, borderColor: '#f59e0b', backgroundColor: 'rgba(245,158,11,.12)', pointBackgroundColor: '#f59e0b', pointBorderColor: '#fff', pointRadius: 3, pointHoverRadius: 5, borderWidth: 2, tension: 0.35, fill: false },
        { label: 'ยืนยันแล้ว', data: confirmed, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,.12)', pointBackgroundColor: '#3b82f6', pointBorderColor: '#fff', pointRadius: 3, pointHoverRadius: 5, borderWidth: 2, tension: 0.35, fill: false },
        { label: 'เสร็จสิ้น', data: completed, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,.12)', pointBackgroundColor: '#10b981', pointBorderColor: '#fff', pointRadius: 3, pointHoverRadius: 5, borderWidth: 2, tension: 0.35, fill: false },
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { position: 'bottom', labels: { font: { size: 11, family: "'Noto Sans Thai', sans-serif" }, boxWidth: 12, padding: 10, usePointStyle: true } },
        tooltip: { bodyFont: { family: "'Noto Sans Thai', sans-serif" }, titleFont: { family: "'Noto Sans Thai', sans-serif" } }
      },
      scales: {
        x: { ticks: { font: { size: 10 }, maxRotation: 0 }, grid: { display: false } },
        y: { beginAtZero: true, ticks: { precision: 0, font: { size: 10 } }, grid: { color: '#f1f5f9' } }
      }
    }
  })
})()
</script>
