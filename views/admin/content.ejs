        <span style="margin-left:auto;font-size:12px;font-weight:400;color:#94a3b8;">สีจะแสดงเป็น overlay บนรูปภาพ — ปรับ Opacity เพื่อให้เห็นรูปได้</span>
      </div>

      <form method="POST" action="/admin/content/backgrounds" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div style="display:grid;gap:0;">
          <% _bgSections.forEach((s, idx) => {
            const bg = _bgs[s.key] || {}
          %>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;padding:16px 0;<%= idx > 0 ? 'border-top:1px solid #f1f5f9;' : '' %>">

            <!-- Section label -->
            <div style="grid-column:1 / -1;display:flex;align-items:center;gap:8px;padding-top:4px;">
              <div style="width:22px;height:22px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i data-lucide="<%= s.icon %>" style="width:12px;height:12px;color:#64748b;"></i>
              </div>
              <span style="font-size:13px;font-weight:600;color:#1e293b;"><%= s.label %></span>
            </div>

            <!-- Color picker -->
            <div>
              <label class="lbl">สีพื้นหลัง (overlay บนรูป)</label>
              <div style="display:flex;align-items:center;gap:8px;">
                <input type="color" id="cpicker_<%= s.key %>"
                  value="<%= bg.color || '#ffffff' %>"
                  style="width:38px;height:36px;border:1.5px solid #e2e8f0;border-radius:8px;cursor:pointer;padding:2px;flex-shrink:0;"
                  oninput="document.getElementById('ctext_<%= s.key %>').value=this.value">
                <input type="text" id="ctext_<%= s.key %>" name="color_<%= s.key %>" class="inp"
                  value="<%= bg.color || '' %>" placeholder="#ffffff"
                  style="width:90px;"
                  oninput="if(/^#[0-9A-Fa-f]{6}$/.test(this.value))document.getElementById('cpicker_<%= s.key %>').value=this.value">
                <button type="button" onclick="document.getElementById('ctext_<%= s.key %>').value='';document.getElementById('cpicker_<%= s.key %>').value='#ffffff';"
                  style="padding:6px 10px;font-size:12px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;color:#94a3b8;cursor:pointer;white-space:nowrap;">
                  ล้างสี
                </button>
              </div>
              <!-- Opacity slider -->
              <div style="margin-top:8px;display:flex;align-items:center;gap:8px;">
                <span style="font-size:12px;color:#64748b;white-space:nowrap;">Opacity:</span>
                <input type="range" id="oprange_<%= s.key %>" name="opacity_<%= s.key %>"
                  min="0" max="1" step="0.05"
                  value="<%= typeof bg.opacity === 'number' ? bg.opacity : 1 %>"
                  style="flex:1;accent-color:#8b5cf6;height:4px;cursor:pointer;"
                  oninput="document.getElementById('opval_<%= s.key %>').textContent=Math.round(this.value*100)+'%'">
                <span id="opval_<%= s.key %>" style="font-size:12px;font-weight:700;color:#1e293b;width:34px;text-align:right;">
                  <%= typeof bg.opacity === 'number' ? Math.round(bg.opacity * 100) : 100 %>%
                </span>
              </div>

              <!-- Text colors per element -->
              <div style="margin-top:10px;">
                <label class="lbl">สีข้อความ</label>
                <div style="display:flex;flex-direction:column;gap:10px;">
                  <% const _tc = bg.textColors || {};
                     const _hexRe = /^#[0-9A-Fa-f]{6}$/;
                     s.fields.forEach(function(fd) {
                       const _tcVal = _hexRe.test(_tc[fd.f] || '') ? _tc[fd.f] : '';
                       const _tcPick = _tcVal || '#1e293b';
                     %>
                  <div>
                    <span style="font-size:12px;font-weight:600;color:#64748b;display:block;margin-bottom:4px;"><%= fd.l %></span>
                    <div style="display:flex;align-items:center;gap:5px;">
                      <input type="color" id="tcpicker_<%= s.key %>_<%= fd.f %>"
                        value="<%= _tcPick %>"
                        style="width:32px;height:28px;border:1.5px solid #e2e8f0;border-radius:6px;cursor:pointer;padding:2px;flex-shrink:0;"
                        oninput="document.getElementById('tctext_<%= s.key %>_<%= fd.f %>').value=this.value">
                      <input type="text" id="tctext_<%= s.key %>_<%= fd.f %>" name="textColor_<%= s.key %>_<%= fd.f %>" class="inp"
                        value="<%= _tcVal %>" placeholder="ค่าเริ่มต้น"
                        style="flex:1;min-width:0;font-size:12px;"
                        oninput="if(/^#[0-9A-Fa-f]{6}$/.test(this.value))document.getElementById('tcpicker_<%= s.key %>_<%= fd.f %>').value=this.value">
                      <button type="button"
                        onclick="document.getElementById('tctext_<%= s.key %>_<%= fd.f %>').value='';document.getElementById('tcpicker_<%= s.key %>_<%= fd.f %>').value='#1e293b';"
                        style="padding:4px 7px;font-size:12px;border:1px solid #e2e8f0;border-radius:6px;background:#fff;color:#94a3b8;cursor:pointer;flex-shrink:0;">x</button>
                    </div>
                  </div>
                  <% }) %>
                  <% if (!s.fields.length) { %>
                  <span style="font-size:12px;color:#cbd5e1;">- ไม่มีข้อความให้ปรับสีในส่วนนี้ -</span>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Image upload -->
            <div>
              <label class="lbl">รูปภาพพื้นหลัง</label>
              <div id="curimgbox_<%= s.key %>" style="display:<%= bg.image ? 'flex' : 'none' %>;align-items:center;gap:8px;margin-bottom:8px;padding:8px 10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">
                <img src="<%= bg.image || '' %>" style="width:56px;height:36px;object-fit:cover;border-radius:5px;border:1px solid #e2e8f0;flex-shrink:0;">
                <span style="font-size:12px;color:#64748b;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= bg.image ? bg.image.split('/').pop() : '' %></span>
                <label style="display:flex;align-items:center;gap:4px;font-size:12px;color:#ef4444;cursor:pointer;flex-shrink:0;white-space:nowrap;">
                  <input type="checkbox" name="clear_<%= s.key %>" style="accent-color:#ef4444;"> ลบรูป
                </label>
              </div>
              <div class="file-btn-wrap"><input type="file" name="img_<%= s.key %>" accept="image/jpeg,image/png,image/webp,image/gif" onchange="previewBgImage(this,'<%= s.key %>')"><span class="file-btn"><i data-lucide="image-plus" style="width:14px;height:14px;"></i> เลือกรูป</span></div>
              <div id="newimgbox_<%= s.key %>" style="display:none;align-items:center;gap:8px;margin-top:8px;padding:8px 10px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;">
                <img style="width:56px;height:36px;object-fit:cover;border-radius:5px;border:1px solid #bbf7d0;flex-shrink:0;">
                <span style="font-size:12px;color:#16a34a;font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">รูปใหม่ที่เลือก (ยังไม่บันทึก)</span>
              </div>
              <!-- Image opacity slider -->
              <div style="margin-top:8px;display:flex;align-items:center;gap:8px;">
                <span style="font-size:12px;color:#64748b;white-space:nowrap;">Opacity รูป:</span>
                <input type="range" id="imoprange_<%= s.key %>" name="imgOpacity_<%= s.key %>"
                  min="0" max="1" step="0.05"
                  value="<%= typeof bg.imgOpacity === 'number' ? bg.imgOpacity : 1 %>"
                  style="flex:1;accent-color:#0891b2;height:4px;cursor:pointer;"
                  oninput="document.getElementById('imopval_<%= s.key %>').textContent=Math.round(this.value*100)+'%'">
                <span id="imopval_<%= s.key %>" style="font-size:12px;font-weight:700;color:#1e293b;width:34px;text-align:right;">
                  <%= typeof bg.imgOpacity === 'number' ? Math.round(bg.imgOpacity * 100) : 100 %>%
                </span>
              </div>

              <!-- Motion controls -->
              <div style="margin-top:10px;padding:10px;border:1px solid #e2e8f0;border-radius:10px;background:#fff;display:grid;gap:8px;">
                <label style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#475569;">
                  <input type="hidden" name="motionEnabled_<%= s.key %>" value="off">
                  <input type="checkbox" name="motionEnabled_<%= s.key %>" value="on" <%= bg.motionEnabled === false ? '' : 'checked' %> style="accent-color:#8b5cf6;">
                  เปิด motion (รูปเคลื่อนไหว)
                </label>
                <div style="display:flex;align-items:center;gap:14px;font-size:12px;color:#475569;">
                  <label style="display:flex;align-items:center;gap:5px;cursor:pointer;">
                    <input type="radio" name="motionStyle_<%= s.key %>" value="zoom" <%= bg.motionStyle === 'float' ? '' : 'checked' %> style="accent-color:#8b5cf6;" onchange="document.getElementById('mvscalerow_<%= s.key %>').style.display=''">
                    ซูมเข้า-ออก
                  </label>
                  <label style="display:flex;align-items:center;gap:5px;cursor:pointer;">
                    <input type="radio" name="motionStyle_<%= s.key %>" value="float" <%= bg.motionStyle === 'float' ? 'checked' : '' %> style="accent-color:#8b5cf6;" onchange="document.getElementById('mvscalerow_<%= s.key %>').style.display='none'">
                    ลอยขึ้น-ลง
                  </label>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span style="font-size:12px;color:#64748b;white-space:nowrap;">ระยะเวลา:</span>
                  <input type="range" id="mvdur_<%= s.key %>" name="motionDuration_<%= s.key %>" min="8" max="90" step="1"
                    value="<%= typeof bg.motionDuration === 'number' ? bg.motionDuration : 38 %>"
                    style="flex:1;accent-color:#8b5cf6;height:4px;cursor:pointer;"
                    oninput="document.getElementById('mvdurval_<%= s.key %>').textContent=this.value+'s'">
                  <span id="mvdurval_<%= s.key %>" style="font-size:12px;font-weight:700;color:#1e293b;width:34px;text-align:right;">
                    <%= typeof bg.motionDuration === 'number' ? bg.motionDuration : 38 %>s
                  </span>
                </div>
                <div id="mvscalerow_<%= s.key %>" style="display:<%= bg.motionStyle === 'float' ? 'none' : '' %>;align-items:center;gap:8px;">
                  <span style="font-size:12px;color:#64748b;white-space:nowrap;">ระดับ zoom:</span>
                  <input type="range" id="mvscale_<%= s.key %>" name="motionScale_<%= s.key %>" min="1" max="1.35" step="0.01"
                    value="<%= typeof bg.motionScale === 'number' ? bg.motionScale : 1.12 %>"
                    style="flex:1;accent-color:#ec4899;height:4px;cursor:pointer;"
                    oninput="document.getElementById('mvscaleval_<%= s.key %>').textContent=this.value+'x'">
                  <span id="mvscaleval_<%= s.key %>" style="font-size:12px;font-weight:700;color:#1e293b;width:42px;text-align:right;">
                    <%= typeof bg.motionScale === 'number' ? bg.motionScale : 1.12 %>x
                  </span>
                </div>
              </div>
              <!-- End motion controls -->

              <!-- Blend slider -->
              <div style="margin-top:10px;padding:10px;border:1px solid #e2e8f0;border-radius:10px;background:#fff;display:grid;gap:8px;">
                <label class="lbl" style="margin-bottom:0;">Blend edge</label>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span style="font-size:12px;color:#64748b;white-space:nowrap;">Size:</span>
                  <input type="range" id="blend_<%= s.key %>" name="blend_<%= s.key %>" min="0" max="220" step="5"
                    value="<%= typeof bg.blend === 'number' ? bg.blend : 0 %>"
                    style="flex:1;accent-color:#14b8a6;height:4px;cursor:pointer;"
                    oninput="document.getElementById('blendval_<%= s.key %>').textContent=this.value+'px'">
                  <span id="blendval_<%= s.key %>" style="font-size:12px;font-weight:700;color:#1e293b;width:46px;text-align:right;">
                    <%= typeof bg.blend === 'number' ? bg.blend : 0 %>px
                  </span>
                </div>
                <div style="display:flex;align-items:center;gap:8px;">
                  <span style="font-size:12px;color:#64748b;white-space:nowrap;">Color:</span>
                  <input type="color" id="blendpicker_<%= s.key %>"
                    value="<%= /^#[0-9A-Fa-f]{6}$/.test(bg.blendColor || '') ? bg.blendColor : (bg.color || '#ffffff') %>"
                    style="width:34px;height:30px;border:1.5px solid #e2e8f0;border-radius:7px;cursor:pointer;padding:2px;flex-shrink:0;"
                    oninput="document.getElementById('blendcolor_<%= s.key %>').value=this.value">
                  <input type="text" id="blendcolor_<%= s.key %>" name="blendColor_<%= s.key %>" class="inp"
                    value="<%= bg.blendColor || '' %>" placeholder="#ffffff"
                    style="flex:1;min-width:0;font-size:12px;"
                    oninput="if(/^#[0-9A-Fa-f]{6}$/.test(this.value))document.getElementById('blendpicker_<%= s.key %>').value=this.value">
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>

        <div style="margin-top:16px;display:flex;justify-content:flex-end;">
          <button type="submit" class="act-btn ab-primary">
            <i data-lucide="save" style="width:14px;height:14px;"></i> บันทึกพื้นหลัง
          </button>
        </div>
      </form>
    </div>

    </div>
    </div>

  </div>
</div>

<script>
  // Each card on this page is its own independent <form>; saving one card
  // reloads the whole page, which silently discards unsubmitted edits sitting
  // in the other cards. Warn before that happens.
  ;(function () {
    const dirtyForms = new Set()
    function markDirty(target) {
      const form = target && target.closest && target.closest('form')
      if (form) dirtyForms.add(form)
    }
    document.addEventListener('input', e => markDirty(e.target))
    document.addEventListener('change', e => markDirty(e.target))
    document.querySelectorAll('form').forEach(form => {
      form.addEventListener('submit', () => dirtyForms.delete(form))
    })
    window.addEventListener('beforeunload', e => {
      if (dirtyForms.size > 0) {
        e.preventDefault()
        e.returnValue = ''
      }
    })
    window._markContentFormDirty = markDirty
  })()

  function cardLang(section, lang) {
    ['th', 'en'].forEach(l => {
      const panel = document.getElementById(section + '-' + l)
      const btn   = document.getElementById(section + '-btn-' + l)
      if (panel) panel.style.display = (l === lang) ? '' : 'none'
      if (btn) {
        btn.className = 'lang-btn ' + (l === lang ? 'lang-btn-active' : 'lang-btn-inactive')
      }
    })
  }

  function addFaq(listId, isEn) {
    const list = document.getElementById(listId)
    const div  = document.createElement('div')
    div.className = 'faq-item'
    div.innerHTML = isEn ? `
      <button type="button" class="remove-faq" onclick="removeFaq(this)">
        <i data-lucide="x" style="width:14px;height:14px;"></i>
      </button>
      <div style="display:grid;gap:8px;">
        <div>
          <label class="lbl">Question <span class="lang-badge lang-badge-en">English</span></label>
          <input type="text" name="faq_q" class="inp">
        </div>
        <div>
          <label class="lbl">Answer</label>
          <textarea name="faq_a" class="inp" rows="2" style="resize:none;"></textarea>
        </div>
      </div>` : `
      <button type="button" class="remove-faq" onclick="removeFaq(this)">
        <i data-lucide="x" style="width:14px;height:14px;"></i>
      </button>
      <div style="display:grid;gap:8px;">
        <div>
          <label class="lbl">คำถาม <span class="lang-badge lang-badge-th">ภาษาไทย</span></label>
          <input type="text" name="faq_q" class="inp">
        </div>
        <div>
          <label class="lbl">คำตอบ</label>
          <textarea name="faq_a" class="inp" rows="2" style="resize:none;"></textarea>
        </div>
      </div>`
    list.appendChild(div)
    lucide.createIcons()
    _markContentFormDirty(list)
  }

  function removeFaq(btn) {
    _markContentFormDirty(btn)
    btn.closest('.faq-item').remove()
  }

  function previewBgImage(input, key) {
    const box = document.getElementById('newimgbox_' + key)
    const img = box ? box.querySelector('img') : null
    const file = input.files && input.files[0]
    if (!box || !img || !file) {
      if (box) box.style.display = 'none'
      return
    }
    img.src = URL.createObjectURL(file)
    box.style.display = 'flex'
    const clearBox = document.getElementById('curimgbox_' + key)
    if (clearBox) {
      const clearCheckbox = clearBox.querySelector('input[type="checkbox"]')
      if (clearCheckbox) clearCheckbox.checked = false
    }
  }

  lucide.createIcons()
</script>
</body>
</html>
