        <div class="text-color-panel"><div class="text-color-title">Features text colors</div><div class="text-color-grid"><%- colorControl('features', 'heading', 'Heading color', 'features_heading_en') %><%- colorControl('features', 'subtext', 'Subtext and bullet color', 'features_subtext_en') %></div></div>
        <div style="display:flex;justify-content:flex-end;"><button type="submit" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> Save Why Choose (EN)</button></div>
