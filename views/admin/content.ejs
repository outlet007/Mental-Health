<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindCare Admin</title>
  <%- include('../partials/head') %>
  <style>
    .inp { width:100%; padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:13px; color:#334155; outline:none; font-family:inherit; box-sizing:border-box; }
    .inp:focus { border-color:#2dd4b4; box-shadow:0 0 0 3px rgba(45,212,180,.15); }
    .lbl { display:block; font-size:12px; font-weight:500; color:#64748b; margin-bottom:5px; }
    .file-btn-wrap { position:relative; display:inline-flex; }
    .file-btn-wrap input[type=file] { position:absolute; inset:0; width:100%; height:100%; opacity:0; cursor:pointer; }
    .file-btn { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; border:1.5px solid #e2e8f0; background:#f8fafc; font-size:12px; font-weight:600; color:#334155; white-space:nowrap; pointer-events:none; }
    .file-btn-wrap:hover .file-btn { background:#f1f5f9; border-color:#cbd5e1; }
    .section-card { background:#fff; border:1px solid #f1f5f9; border-radius:16px; padding:24px; margin-bottom:24px; }
    .section-title { font-size:14px; font-weight:600; color:#1e293b; display:flex; align-items:center; gap:8px; margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid #f1f5f9; }
    .act-btn { display:inline-flex; align-items:center; gap:4px; padding:8px 16px; border-radius:10px; font-size:13px; font-weight:500; cursor:pointer; border:none; transition:all .15s; white-space:nowrap; }
    .ab-primary { background:#05967e; color:#fff; }
    .ab-primary:hover { background:#067866; }
    .ab-ghost { background:transparent; color:#64748b; border:1px solid #e2e8f0; }
    .ab-ghost:hover { background:#f1f5f9; }
    .faq-item { border:1.5px solid #e2e8f0; border-radius:12px; padding:14px; position:relative; }
    .remove-faq { position:absolute; top:10px; right:10px; background:none; border:none; cursor:pointer; color:#94a3b8; padding:4px; border-radius:6px; }
    .remove-faq:hover { background:#fef2f2; color:#ef4444; }
    .lang-toggle { display:flex; border:1.5px solid #e2e8f0; border-radius:8px; overflow:hidden; margin-left:auto; flex-shrink:0; }
    .lang-btn { padding:4px 14px; font-size:12px; font-weight:700; border:none; cursor:pointer; transition:all .15s; letter-spacing:.02em; }
    .lang-btn-active { background:#05967e; color:#fff; }
    .lang-btn-inactive { background:transparent; color:#94a3b8; }
    .lang-badge { display:inline-flex; align-items:center; gap:4px; font-size:10px; font-weight:600; padding:2px 8px; border-radius:9999px; margin-left:8px; }
    .lang-badge-th { background:#fff3cd; color:#7c5500; border:1px solid #fde68a; }
    .lang-badge-en { background:#dbeafe; color:#1d4ed8; border:1px solid #93c5fd; }
    .text-color-panel { margin-top:10px; padding:12px; border:1px solid #e2e8f0; border-radius:12px; background:#f8fafc; }
    .text-color-title { font-size:12px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.05em; margin-bottom:10px; }
    .text-color-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; }
    .text-color-row { display:flex; align-items:center; gap:6px; min-width:0; }
    .text-color-picker { width:32px; height:30px; border:1.5px solid #e2e8f0; border-radius:7px; cursor:pointer; padding:2px; flex-shrink:0; }
    .text-color-input { flex:1; min-width:0; padding:7px 9px; font-size:12px; }
    .text-color-clear { padding:6px 8px; font-size:12px; border:1px solid #e2e8f0; border-radius:7px; background:#fff; color:#94a3b8; cursor:pointer; flex-shrink:0; }
  </style>
</head>
<body style="background:#f8fafc; margin:0;">
<%- include('../partials/admin-sidebar') %>

<%
  const en = content.en || {}
  const enHero = en.hero || {}
  const enCounselors = en.counselors || {}
  const enFeatures = en.features || {}
  const enBook = en.book || {}
  const enFaqs = en.faqs || []
  const enContact = en.contact || {}

  // Determine which tabs to auto-open based on ?saved=
  const savedKey = query.saved || ''
  const autoEnHero     = savedKey === 'hero-en'
  const autoEnSections = savedKey === 'sections-en'
  const autoEnCounselors = savedKey === 'counselors-en' || savedKey === 'sections-en'
  const autoEnFeatures = savedKey === 'features-en'
  const autoEnContact = savedKey === 'contact-info-en' || savedKey === 'contact-en' || savedKey === 'sections-en'
  const autoEnFaqs     = savedKey === 'faqs-en'
  const _contentBgs = content.backgrounds || {}
  function tcVal(section, field) {
    const bg = _contentBgs[section] || {}
    const colors = bg.textColors || {}
    return colors[field] || ''
  }
  function colorControl(section, field, label, uid) {
    const value = tcVal(section, field)
    const pickerId = 'tcp_' + uid
    const textId = 'tct_' + uid
    const pickerValue = /^#[0-9A-Fa-f]{6}$/.test(value) ? value : '#1e293b'
    return '<div>' +
      '<label class="lbl">' + label + '</label>' +
      '<div class="text-color-row">' +
        '<input type="color" id="' + pickerId + '" class="text-color-picker" value="' + pickerValue + '" oninput="document.getElementById(\'' + textId + '\').value=this.value">' +
        '<input type="text" id="' + textId + '" name="textColor_' + section + '_' + field + '" class="inp text-color-input" value="' + value + '" placeholder="ค่าเริ่มต้น" oninput="if(/^#[0-9A-Fa-f]{6}$/.test(this.value))document.getElementById(\'' + pickerId + '\').value=this.value">' +
        '<button type="button" class="text-color-clear" onclick="document.getElementById(\'' + textId + '\').value=\'\';document.getElementById(\'' + pickerId + '\').value=\'#1e293b\';">ล้าง</button>' +
      '</div>' +
    '</div>'
  }
  function photoField(fieldName, label, currentImage) {
    return '<div>' +
      '<label class="lbl">' + label + '</label>' +
      '<div id="curimgbox_' + fieldName + '" style="display:' + (currentImage ? 'flex' : 'none') + ';align-items:center;gap:8px;margin-bottom:8px;padding:8px 10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">' +
        '<img src="' + (currentImage || '') + '" style="width:56px;height:56px;object-fit:cover;border-radius:5px;border:1px solid #e2e8f0;flex-shrink:0;">' +
        '<span style="font-size:12px;color:#64748b;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + (currentImage ? currentImage.split('/').pop() : '') + '</span>' +
        '<label style="display:flex;align-items:center;gap:4px;font-size:12px;color:#ef4444;cursor:pointer;flex-shrink:0;white-space:nowrap;">' +
          '<input type="checkbox" name="clear_' + fieldName + '" style="accent-color:#ef4444;"> ลบรูป' +
        '</label>' +
      '</div>' +
      '<div class="file-btn-wrap"><input type="file" name="' + fieldName + '" accept="image/jpeg,image/png,image/webp,image/gif" onchange="previewBgImage(this,\'' + fieldName + '\')"><span class="file-btn"><i data-lucide="image-plus" style="width:14px;height:14px;"></i> เลือกรูป</span></div>' +
      '<div id="newimgbox_' + fieldName + '" style="display:none;align-items:center;gap:8px;margin-top:8px;padding:8px 10px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;">' +
        '<img style="width:56px;height:56px;object-fit:cover;border-radius:5px;border:1px solid #bbf7d0;flex-shrink:0;">' +
        '<span style="font-size:12px;color:#16a34a;font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">รูปใหม่ที่เลือก (ยังไม่บันทึก)</span>' +
      '</div>' +
    '</div>'
  }
  function motionField(key, cur) {
    cur = cur || {}
    const enabled = cur[key + 'MotionEnabled'] !== false
    const style = cur[key + 'MotionStyle'] === 'float' ? 'float' : 'zoom'
    const duration = typeof cur[key + 'MotionDuration'] === 'number' ? cur[key + 'MotionDuration'] : 38
    const scale = typeof cur[key + 'MotionScale'] === 'number' ? cur[key + 'MotionScale'] : 1.12
    return '<div style="padding:10px;border:1px solid #e2e8f0;border-radius:10px;background:#fff;display:grid;gap:8px;">' +
      '<label style="display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#475569;">' +
        '<input type="hidden" name="' + key + 'MotionEnabled" value="off">' +
        '<input type="checkbox" name="' + key + 'MotionEnabled" value="on" ' + (enabled ? 'checked' : '') + ' style="accent-color:#8b5cf6;">' +
        'เปิด motion (object กรอบ เคลื่อนไหว)' +
      '</label>' +
      '<div style="display:flex;align-items:center;gap:14px;font-size:12px;color:#475569;">' +
        '<label style="display:flex;align-items:center;gap:5px;cursor:pointer;">' +
          '<input type="radio" name="' + key + 'MotionStyle" value="zoom" ' + (style === 'float' ? '' : 'checked') + ' style="accent-color:#8b5cf6;" onchange="document.getElementById(\'mvscalerow_' + key + '\').style.display=\'\'">' +
          'ซูมเข้า-ออก' +
        '</label>' +
        '<label style="display:flex;align-items:center;gap:5px;cursor:pointer;">' +
          '<input type="radio" name="' + key + 'MotionStyle" value="float" ' + (style === 'float' ? 'checked' : '') + ' style="accent-color:#8b5cf6;" onchange="document.getElementById(\'mvscalerow_' + key + '\').style.display=\'none\'">' +
          'ลอยขึ้น-ลง' +
        '</label>' +
      '</div>' +
      '<div style="display:flex;align-items:center;gap:8px;">' +
        '<span style="font-size:12px;color:#64748b;white-space:nowrap;">ระยะเวลา:</span>' +
        '<input type="range" id="mvdur_' + key + '" name="' + key + 'MotionDuration" min="8" max="90" step="1" value="' + duration + '" style="flex:1;accent-color:#8b5cf6;height:4px;cursor:pointer;" oninput="document.getElementById(\'mvdurval_' + key + '\').textContent=this.value+\'s\'">' +
        '<span id="mvdurval_' + key + '" style="font-size:12px;font-weight:700;color:#1e293b;width:34px;text-align:right;">' + duration + 's</span>' +
      '</div>' +
      '<div id="mvscalerow_' + key + '" style="display:' + (style === 'float' ? 'none' : '') + ';align-items:center;gap:8px;">' +
        '<span style="font-size:12px;color:#64748b;white-space:nowrap;">ระดับ zoom:</span>' +
        '<input type="range" id="mvscale_' + key + '" name="' + key + 'MotionScale" min="1" max="1.35" step="0.01" value="' + scale + '" style="flex:1;accent-color:#ec4899;height:4px;cursor:pointer;" oninput="document.getElementById(\'mvscaleval_' + key + '\').textContent=this.value+\'x\'">' +
        '<span id="mvscaleval_' + key + '" style="font-size:12px;font-weight:700;color:#1e293b;width:42px;text-align:right;">' + scale + 'x</span>' +
      '</div>' +
    '</div>'
  }
%>

<div style="margin-left:256px; min-height:100vh; display:flex; flex-direction:column;">

  <div style="height:56px; background:#fff; border-bottom:1px solid #f1f5f9; padding:0 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20;">
    <h1 style="font-size:15px; font-weight:600; color:#1e293b; margin:0;"><%= title %></h1>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:12px;color:#94a3b8;"><%= new Date().toLocaleDateString('th-TH',{year:'numeric',month:'long',day:'numeric'}) %></span>
      <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;font-size:12px;font-weight:500;color:#334155;text-decoration:none;transition:background .15s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#f8fafc'">
        <i data-lucide="external-link" style="width:13px;height:13px;"></i> ดูหน้าเว็บไซต์
      </a>
    </div>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.saved) { %>
    <div style="margin-bottom:20px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:12px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;"></i>
      <% if (query.saved === 'backgrounds') { %> บันทึกพื้นหลัง Section สำเร็จ
      <% } else { %> บันทึกการเปลี่ยนแปลงสำเร็จ <% } %>
    </div>
    <% } %>

    <!-- ── Logo & Favicon ── -->
    <% const branding = content.branding || {} %>
    <div class="section-card">
      <div class="section-title">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;">
          <i data-lucide="image" style="width:14px;height:14px;color:#fff;"></i>
        </div>
        โลโก้และไอคอนเว็บไซต์
      </div>
      <form method="POST" action="/admin/content/branding" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;">
          <div>
            <%- photoField('headerLogoImage', 'โลโก้ที่เมนูบนสุด (Header)', branding.headerLogoImage) %>
            <p class="field-help" style="font-size:12px;color:#94a3b8;margin:6px 0 0;">ไม่ตั้งค่า = ใช้ไอคอนหัวใจ + ข้อความ "MindCare" เหมือนเดิม</p>
          </div>
          <div>
            <%- photoField('footerLogoImage', 'โลโก้ที่ Footer', branding.footerLogoImage) %>
            <p class="field-help" style="font-size:12px;color:#94a3b8;margin:6px 0 0;">พื้นหลัง footer เป็นสีเข้ม แนะนำใช้โลโก้เวอร์ชันขาว/สว่าง แยกจากโลโก้ header</p>
          </div>
          <div>
            <%- photoField('faviconImage', 'Favicon (ไอคอนแท็บเบราว์เซอร์)', branding.faviconImage) %>
            <p class="field-help" style="font-size:12px;color:#94a3b8;margin:6px 0 0;">แนะนำไฟล์สี่เหลี่ยมจัตุรัส เช่น 512×512px (PNG/ICO/SVG)</p>
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end;margin-top:16px;">
          <button type="submit" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> บันทึก</button>
        </div>
      </form>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;">
    <div>

    <!-- ── Hero Section ── -->
    <div class="section-card">
      <div class="section-title">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#05967e,#06b6d4);display:flex;align-items:center;justify-content:center;">
          <i data-lucide="layout" style="width:14px;height:14px;color:#fff;"></i>
        </div>
        Hero — ส่วนหัวของหน้าเว็บ
        <div class="lang-toggle" style="margin-left:auto;">
          <button type="button" class="lang-btn <%= autoEnHero ? 'lang-btn-inactive' : 'lang-btn-active' %>" id="hero-btn-th" onclick="cardLang('hero','th')">TH</button>
          <button type="button" class="lang-btn <%= autoEnHero ? 'lang-btn-active' : 'lang-btn-inactive' %>" id="hero-btn-en" onclick="cardLang('hero','en')">EN</button>
        </div>
      </div>

      <!-- TH -->
      <div id="hero-th" style="display:<%= autoEnHero ? 'none' : '' %>;">
        <form method="POST" action="/admin/content/hero" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div style="display:grid;gap:14px;">
            <div>
              <label class="lbl">ข้อความ Badge <span class="lang-badge lang-badge-th">ภาษาไทย</span></label>
              <input type="text" name="badge" class="inp" value="<%= content.hero.badge %>">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">หัวข้อหลัก บรรทัด 1</label>
                <input type="text" name="heading1" class="inp" value="<%= content.hero.heading1 %>">
              </div>
              <div>
                <label class="lbl">หัวข้อหลัก บรรทัด 2 (Gradient)</label>
                <input type="text" name="heading2" class="inp" value="<%= content.hero.heading2 %>">
              </div>
            </div>
            <div>
              <label class="lbl">คำอธิบาย</label>
              <textarea name="subtext" class="inp" rows="2" style="resize:none;"><%= content.hero.subtext %></textarea>
            </div>
            <div>
              <label class="lbl">รูปภาพหลัก (แทนที่รูป/ไอคอนฝั่งขวาของ Hero ทั้งหมด แบบเต็มพื้นที่)</label>
              <div id="curimgbox_herovisual" style="display:<%= content.hero.visualImage ? 'flex' : 'none' %>;align-items:center;gap:8px;margin-bottom:8px;padding:8px 10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">
                <img src="<%= content.hero.visualImage || '' %>" style="width:56px;height:56px;object-fit:cover;border-radius:5px;border:1px solid #e2e8f0;flex-shrink:0;">
                <span style="font-size:12px;color:#64748b;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= content.hero.visualImage ? content.hero.visualImage.split('/').pop() : '' %></span>
                <label style="display:flex;align-items:center;gap:4px;font-size:12px;color:#ef4444;cursor:pointer;flex-shrink:0;white-space:nowrap;">
                  <input type="checkbox" name="clearVisualImage" style="accent-color:#ef4444;"> ลบรูป (ใช้ไอคอนเริ่มต้น)
                </label>
              </div>
              <div class="file-btn-wrap"><input type="file" name="heroVisualImage" accept="image/jpeg,image/png,image/webp,image/gif" onchange="previewBgImage(this,'herovisual')"><span class="file-btn"><i data-lucide="image-plus" style="width:14px;height:14px;"></i> เลือกรูป</span></div>
              <div id="newimgbox_herovisual" style="display:none;align-items:center;gap:8px;margin-top:8px;padding:8px 10px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;">
                <img style="width:56px;height:56px;object-fit:cover;border-radius:5px;border:1px solid #bbf7d0;flex-shrink:0;">
                <span style="font-size:12px;color:#16a34a;font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">รูปใหม่ที่เลือก (ยังไม่บันทึก)</span>
              </div>
            </div>
            <div class="text-color-panel">
              <div class="text-color-title">สีข้อความที่แสดงบนหน้าเว็บ</div>
              <div class="text-color-grid">
                <%- colorControl('hero', 'heading', 'สีหัวข้อ', 'hero_heading_th') %>
                <%- colorControl('hero', 'subtext', 'สีคำอธิบาย', 'hero_subtext_th') %>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">ปุ่มหลัก</label>
                <input type="text" name="ctaMain" class="inp" value="<%= content.hero.ctaMain %>">
              </div>
              <div>
                <label class="lbl">ปุ่มรอง</label>
                <input type="text" name="ctaSub" class="inp" value="<%= content.hero.ctaSub %>">
              </div>
            </div>
          </div>
          <div style="margin-top:16px;display:flex;justify-content:flex-end;">
            <button type="submit" class="act-btn ab-primary">
              <i data-lucide="save" style="width:14px;height:14px;"></i> บันทึก Hero (TH)
            </button>
          </div>
        </form>
      </div>

      <!-- EN -->
      <div id="hero-en" style="display:<%= autoEnHero ? '' : 'none' %>;">
        <form method="POST" action="/admin/content/hero-en"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <div style="display:grid;gap:14px;">
            <div>
              <label class="lbl">Badge text <span class="lang-badge lang-badge-en">English</span></label>
              <input type="text" name="badge" class="inp" value="<%= enHero.badge || '' %>">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">Main heading line 1</label>
                <input type="text" name="heading1" class="inp" value="<%= enHero.heading1 || '' %>">
              </div>
              <div>
                <label class="lbl">Main heading line 2 (Gradient)</label>
                <input type="text" name="heading2" class="inp" value="<%= enHero.heading2 || '' %>">
              </div>
            </div>
            <div>
              <label class="lbl">Description</label>
              <textarea name="subtext" class="inp" rows="2" style="resize:none;"><%= enHero.subtext || '' %></textarea>
            </div>
            <div class="text-color-panel">
              <div class="text-color-title">Text colors on website</div>
              <div class="text-color-grid">
                <%- colorControl('hero', 'heading', 'Heading color', 'hero_heading_en') %>
                <%- colorControl('hero', 'subtext', 'Description color', 'hero_subtext_en') %>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">Primary button</label>
                <input type="text" name="ctaMain" class="inp" value="<%= enHero.ctaMain || '' %>">
              </div>
