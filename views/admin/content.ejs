        <div><label class="lbl">Footer description</label><textarea name="contactDescription" class="inp" rows="3" style="resize:none;"><%= enContact.description || 'Mental health counseling appointment system — connecting those who need help with trusted experts.' %></textarea></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div><label class="lbl">Footer LINE text</label><input type="text" name="contactLineLabel" class="inp" value="<%= enContact.lineLabel || 'LINE @bucare' %>"></div>
          <div><label class="lbl">Footer LINE URL</label><input type="url" name="contactLineUrl" class="inp" value="<%= enContact.lineUrl || (content.contact && content.contact.lineUrl) || 'https://page.line.me/bucare?openQrModal=true' %>"></div>
        </div>
        <div><label class="lbl">Footer office hours</label><textarea name="contactHours" class="inp" rows="2" style="resize:none;"><%= enContact.hours || '' %></textarea></div>
        <div style="display:flex;justify-content:flex-end;"><button type="submit" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> Save Footer (EN)</button></div>
      </form>
      </div>
