<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindCare Admin</title>
  <%- include('../partials/head') %>
  <style>
    .inp { width:100%; padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:13px; color:#334155; outline:none; font-family:inherit; box-sizing:border-box; }
    .inp:focus { border-color:#2dd4b4; box-shadow:0 0 0 3px rgba(45,212,180,.15); }
    .lbl { display:block; font-size:12px; font-weight:500; color:#64748b; margin-bottom:5px; }
    .section-card { background:#fff; border:1px solid #f1f5f9; border-radius:16px; padding:24px; margin-bottom:24px; }
    .section-title { font-size:14px; font-weight:600; color:#1e293b; display:flex; align-items:center; gap:8px; margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid #f1f5f9; }
    .act-btn { display:inline-flex; align-items:center; gap:4px; padding:8px 16px; border-radius:10px; font-size:13px; font-weight:500; cursor:pointer; border:none; transition:all .15s; white-space:nowrap; }
    .ab-primary { background:#05967e; color:#fff; }
    .ab-primary:hover { background:#067866; }
    .ab-ghost { background:transparent; color:#64748b; border:1px solid #e2e8f0; }
    .ab-ghost:hover { background:#f1f5f9; }
    .faq-item { border:1.5px solid #e2e8f0; border-radius:12px; padding:14px; position:relative; }
    .remove-faq { position:absolute; top:10px; right:10px; background:none; border:none; cursor:pointer; color:#94a3b8; padding:4px; border-radius:6px; }
    .remove-faq:hover { background:#fef2f2; color:#ef4444; }
    .lang-toggle { display:flex; border:1.5px solid #e2e8f0; border-radius:8px; overflow:hidden; margin-left:auto; flex-shrink:0; }
    .lang-btn { padding:4px 14px; font-size:12px; font-weight:700; border:none; cursor:pointer; transition:all .15s; letter-spacing:.02em; }
    .lang-btn-active { background:#05967e; color:#fff; }
    .lang-btn-inactive { background:transparent; color:#94a3b8; }
    .lang-badge { display:inline-flex; align-items:center; gap:4px; font-size:10px; font-weight:600; padding:2px 8px; border-radius:9999px; margin-left:8px; }
    .lang-badge-th { background:#fff3cd; color:#7c5500; border:1px solid #fde68a; }
    .lang-badge-en { background:#dbeafe; color:#1d4ed8; border:1px solid #93c5fd; }
    .text-color-panel { margin-top:10px; padding:12px; border:1px solid #e2e8f0; border-radius:12px; background:#f8fafc; }
    .text-color-title { font-size:12px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.05em; margin-bottom:10px; }
    .text-color-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; }
    .text-color-row { display:flex; align-items:center; gap:6px; min-width:0; }
    .text-color-picker { width:32px; height:30px; border:1.5px solid #e2e8f0; border-radius:7px; cursor:pointer; padding:2px; flex-shrink:0; }
    .text-color-input { flex:1; min-width:0; padding:7px 9px; font-size:12px; }
    .text-color-clear { padding:6px 8px; font-size:12px; border:1px solid #e2e8f0; border-radius:7px; background:#fff; color:#94a3b8; cursor:pointer; flex-shrink:0; }
  </style>
</head>
<body style="background:#f8fafc; margin:0;">
<%- include('../partials/admin-sidebar') %>

<%
  const en = content.en || {}
  const enHero = en.hero || {}
  const enCounselors = en.counselors || {}
  const enFeatures = en.features || {}
  const enBook = en.book || {}
  const enFaqs = en.faqs || []
  const enContact = en.contact || {}

  // Determine which tabs to auto-open based on ?saved=
  const savedKey = query.saved || ''
  const autoEnHero     = savedKey === 'hero-en'
  const autoEnSections = savedKey === 'sections-en'
  const autoEnCounselors = savedKey === 'counselors-en' || savedKey === 'sections-en'
  const autoEnFeatures = savedKey === 'features-en'
  const autoEnContact = savedKey === 'contact-info-en' || savedKey === 'contact-en' || savedKey === 'sections-en'
  const autoEnFaqs     = savedKey === 'faqs-en'
  const _contentBgs = content.backgrounds || {}
  function tcVal(section, field) {
    const bg = _contentBgs[section] || {}
    const colors = bg.textColors || {}
    return colors[field] || ''
  }
  function colorControl(section, field, label, uid) {
    const value = tcVal(section, field)
    const pickerId = 'tcp_' + uid
    const textId = 'tct_' + uid
    const pickerValue = /^#[0-9A-Fa-f]{6}$/.test(value) ? value : '#1e293b'
    return '<div>' +
      '<label class="lbl">' + label + '</label>' +
      '<div class="text-color-row">' +
        '<input type="color" id="' + pickerId + '" class="text-color-picker" value="' + pickerValue + '" oninput="document.getElementById(\'' + textId + '\').value=this.value">' +
        '<input type="text" id="' + textId + '" name="textColor_' + section + '_' + field + '" class="inp text-color-input" value="' + value + '" placeholder="ค่าเริ่มต้น" oninput="if(/^#[0-9A-Fa-f]{6}$/.test(this.value))document.getElementById(\'' + pickerId + '\').value=this.value">' +
        '<button type="button" class="text-color-clear" onclick="document.getElementById(\'' + textId + '\').value=\'\';document.getElementById(\'' + pickerId + '\').value=\'#1e293b\';">ล้าง</button>' +
      '</div>' +
    '</div>'
  }
%>

<div style="margin-left:256px; min-height:100vh; display:flex; flex-direction:column;">

  <div style="height:56px; background:#fff; border-bottom:1px solid #f1f5f9; padding:0 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20;">
    <h1 style="font-size:15px; font-weight:600; color:#1e293b; margin:0;"><%= title %></h1>
    <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#05967e;text-decoration:none;">
      <i data-lucide="external-link" style="width:13px;height:13px;"></i> ดูหน้าเว็บไซต์
    </a>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.saved) { %>
    <div style="margin-bottom:20px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:12px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;"></i>
      <% if (query.saved === 'backgrounds') { %> บันทึกพื้นหลัง Section สำเร็จ
      <% } else { %> บันทึกการเปลี่ยนแปลงสำเร็จ <% } %>
    </div>
    <% } %>

    <!-- Email / SMTP Status -->
    <div class="section-card" style="border-color:#e0e7ff;">
      <div class="section-title">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;">
          <i data-lucide="mail" style="width:14px;height:14px;color:#fff;"></i>
        </div>
        ระบบแจ้งเตือนอีเมล
      </div>

      <% if (query.emailSent) { %>
      <div style="margin-bottom:16px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:10px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;">
        <i data-lucide="check-circle" style="width:15px;height:15px;flex-shrink:0;"></i>
        ส่งอีเมลทดสอบสำเร็จ — ตรวจสอบ inbox ของคุณ
      </div>
      <% } else if (query.emailError) { %>
      <div style="margin-bottom:16px;padding:12px 16px;background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;color:#991b1b;font-size:13px;display:flex;align-items:center;gap:8px;">
        <i data-lucide="alert-circle" style="width:15px;height:15px;flex-shrink:0;"></i>
        ส่งไม่สำเร็จ: <%= query.emailError === 'missing' ? 'กรุณากรอกอีเมลปลายทาง' : decodeURIComponent(query.emailError) %>
      </div>
      <% } %>

      <% const smtpConfigured = process.env && process.env.SMTP_USER && process.env.SMTP_USER !== 'your-email@gmail.com' %>
      <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;background:<%= smtpConfigured ? '#ecfdf9' : '#fef9c3' %>;border:1px solid <%= smtpConfigured ? '#a0f3e1' : '#fde68a' %>;border-radius:10px;margin-bottom:16px;">
        <i data-lucide="<%= smtpConfigured ? 'check-circle' : 'alert-triangle' %>" style="width:16px;height:16px;color:<%= smtpConfigured ? '#05967e' : '#92400e' %>;flex-shrink:0;"></i>
        <div>
          <% if (smtpConfigured) { %>
          <span style="font-size:13px;font-weight:600;color:#065f46;">SMTP พร้อมใช้งาน</span>
          <span style="font-size:12px;color:#64748b;margin-left:8px;">(<%= process.env.SMTP_USER %>)</span>
          <% } else { %>
          <span style="font-size:13px;font-weight:600;color:#92400e;">SMTP ยังไม่ได้ตั้งค่า</span>
          <span style="font-size:12px;color:#64748b;margin-left:8px;">แก้ไขไฟล์ <code style="background:#fff;padding:1px 6px;border-radius:4px;font-family:monospace;">.env</code> เพื่อเปิดใช้งาน</span>
          <% } %>
        </div>
      </div>

      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:14px 16px;margin-bottom:16px;">
        <p style="margin:0 0 10px;font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em;">ตัวแปรใน .env ที่ต้องตั้งค่า</p>
        <pre style="margin:0;font-size:12px;color:#334155;font-family:monospace;line-height:1.8;overflow-x:auto;">SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=MindCare
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_BCC=   <span style="color:#94a3b8;"># optional สำเนาทุกอีเมล</span></pre>
        <p style="margin:10px 0 0;font-size:12px;color:#94a3b8;">Gmail: ใช้ App Password จาก <a href="https://myaccount.google.com/apppasswords" target="_blank" style="color:#6366f1;">myaccount.google.com/apppasswords</a> (ต้องเปิด 2-Step Verification)</p>
      </div>

      <form method="POST" action="/admin/content/test-email" style="display:flex;gap:10px;align-items:flex-end;">
        <div style="flex:1;">
          <label class="lbl">ส่งอีเมลทดสอบไปที่</label>
          <input type="email" name="to" class="inp" placeholder="your@email.com" required value="<%= process.env.SMTP_USER || '' %>">
        </div>
        <button type="submit" class="act-btn" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;padding:9px 18px;border-radius:10px;font-size:13px;font-weight:500;cursor:pointer;border:none;white-space:nowrap;flex-shrink:0;">
          <i data-lucide="send" style="width:13px;height:13px;"></i> ส่งทดสอบ
        </button>
      </form>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;">
    <div>

    <!-- ── Hero Section ── -->
    <div class="section-card">
      <div class="section-title">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#05967e,#06b6d4);display:flex;align-items:center;justify-content:center;">
          <i data-lucide="layout" style="width:14px;height:14px;color:#fff;"></i>
        </div>
        Hero — ส่วนหัวของหน้าเว็บ
        <div class="lang-toggle" style="margin-left:auto;">
          <button type="button" class="lang-btn <%= autoEnHero ? 'lang-btn-inactive' : 'lang-btn-active' %>" id="hero-btn-th" onclick="cardLang('hero','th')">TH</button>
          <button type="button" class="lang-btn <%= autoEnHero ? 'lang-btn-active' : 'lang-btn-inactive' %>" id="hero-btn-en" onclick="cardLang('hero','en')">EN</button>
        </div>
      </div>

      <!-- TH -->
      <div id="hero-th" style="display:<%= autoEnHero ? 'none' : '' %>;">
        <form method="POST" action="/admin/content/hero">
          <div style="display:grid;gap:14px;">
            <div>
              <label class="lbl">ข้อความ Badge <span class="lang-badge lang-badge-th">ภาษาไทย</span></label>
              <input type="text" name="badge" class="inp" value="<%= content.hero.badge %>">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">หัวข้อหลัก บรรทัด 1</label>
                <input type="text" name="heading1" class="inp" value="<%= content.hero.heading1 %>">
              </div>
              <div>
                <label class="lbl">หัวข้อหลัก บรรทัด 2 (Gradient)</label>
                <input type="text" name="heading2" class="inp" value="<%= content.hero.heading2 %>">
              </div>
            </div>
            <div>
              <label class="lbl">คำอธิบาย</label>
              <textarea name="subtext" class="inp" rows="2" style="resize:none;"><%= content.hero.subtext %></textarea>
            </div>
            <div class="text-color-panel">
              <div class="text-color-title">สีข้อความที่แสดงบนหน้าเว็บ</div>
              <div class="text-color-grid">
                <%- colorControl('hero', 'heading', 'สีหัวข้อ', 'hero_heading_th') %>
                <%- colorControl('hero', 'subtext', 'สีคำอธิบาย', 'hero_subtext_th') %>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">ปุ่มหลัก</label>
                <input type="text" name="ctaMain" class="inp" value="<%= content.hero.ctaMain %>">
              </div>
              <div>
                <label class="lbl">ปุ่มรอง</label>
                <input type="text" name="ctaSub" class="inp" value="<%= content.hero.ctaSub %>">
              </div>
            </div>
          </div>
          <div style="margin-top:16px;display:flex;justify-content:flex-end;">
            <button type="submit" class="act-btn ab-primary">
              <i data-lucide="save" style="width:14px;height:14px;"></i> บันทึก Hero (TH)
            </button>
          </div>
        </form>
      </div>

      <!-- EN -->
      <div id="hero-en" style="display:<%= autoEnHero ? '' : 'none' %>;">
        <form method="POST" action="/admin/content/hero-en">
          <div style="display:grid;gap:14px;">
            <div>
              <label class="lbl">Badge text <span class="lang-badge lang-badge-en">English</span></label>
              <input type="text" name="badge" class="inp" value="<%= enHero.badge || '' %>">
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">Main heading line 1</label>
                <input type="text" name="heading1" class="inp" value="<%= enHero.heading1 || '' %>">
              </div>
              <div>
                <label class="lbl">Main heading line 2 (Gradient)</label>
                <input type="text" name="heading2" class="inp" value="<%= enHero.heading2 || '' %>">
              </div>
            </div>
            <div>
              <label class="lbl">Description</label>
              <textarea name="subtext" class="inp" rows="2" style="resize:none;"><%= enHero.subtext || '' %></textarea>
            </div>
            <div class="text-color-panel">
              <div class="text-color-title">Text colors on website</div>
              <div class="text-color-grid">
                <%- colorControl('hero', 'heading', 'Heading color', 'hero_heading_en') %>
                <%- colorControl('hero', 'subtext', 'Description color', 'hero_subtext_en') %>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label class="lbl">Primary button</label>
                <input type="text" name="ctaMain" class="inp" value="<%= enHero.ctaMain || '' %>">
              </div>
              <div>
                <label class="lbl">Secondary button</label>
                <input type="text" name="ctaSub" class="inp" value="<%= enHero.ctaSub || '' %>">
              </div>
            </div>
          </div>
          <div style="margin-top:16px;display:flex;justify-content:flex-end;">
            <button type="submit" class="act-btn ab-primary">
              <i data-lucide="save" style="width:14px;height:14px;"></i> Save Hero (EN)
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Section Copy: Counselors -->
    <div class="section-card">
      <div class="section-title">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#0891b2,#6366f1);display:flex;align-items:center;justify-content:center;"><i data-lucide="users" style="width:14px;height:14px;color:#fff;"></i></div>
        ข้อความ Section: นักจิตวิทยา / ผู้ให้คำปรึกษา
        <div class="lang-toggle" style="margin-left:auto;">
          <button type="button" class="lang-btn <%= autoEnCounselors ? 'lang-btn-inactive' : 'lang-btn-active' %>" id="counselors-btn-th" onclick="cardLang('counselors','th')">TH</button>
          <button type="button" class="lang-btn <%= autoEnCounselors ? 'lang-btn-active' : 'lang-btn-inactive' %>" id="counselors-btn-en" onclick="cardLang('counselors','en')">EN</button>
        </div>
      </div>
      <div id="counselors-th" style="display:<%= autoEnCounselors ? 'none' : '' %>;">
      <form method="POST" action="/admin/content/counselors" style="display:grid;gap:12px;">
        <div style="font-size:12px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;">ภาษาไทย</div>
        <div><label class="lbl">หัวข้อ Section นักจิตวิทยา</label><input type="text" name="counselorsHeading" class="inp" value="<%= content.counselors.heading %>"></div>
        <div><label class="lbl">คำอธิบาย Section นักจิตวิทยา</label><input type="text" name="counselorsSubtext" class="inp" value="<%= content.counselors.subtext %>"></div>
        <div class="text-color-panel"><div class="text-color-title">สีข้อความ Section นักจิตวิทยา</div><div class="text-color-grid"><%- colorControl('counselors', 'heading', 'สีหัวข้อ', 'counselors_heading_th') %><%- colorControl('counselors', 'subtext', 'สีคำอธิบาย', 'counselors_subtext_th') %></div></div>
        <div style="display:flex;justify-content:flex-end;"><button type="submit" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> บันทึกนักจิตวิทยา (TH)</button></div>
      </form>
      </div>
      <div id="counselors-en" style="display:<%= autoEnCounselors ? '' : 'none' %>;">
      <form method="POST" action="/admin/content/counselors-en" style="display:grid;gap:12px;">
        <div style="font-size:12px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;">English</div>
        <div><label class="lbl">Counselors section heading</label><input type="text" name="counselorsHeading" class="inp" value="<%= enCounselors.heading || '' %>"></div>
        <div><label class="lbl">Counselors section subtext</label><input type="text" name="counselorsSubtext" class="inp" value="<%= enCounselors.subtext || '' %>"></div>
        <div class="text-color-panel"><div class="text-color-title">Counselors text colors</div><div class="text-color-grid"><%- colorControl('counselors', 'heading', 'Heading color', 'counselors_heading_en') %><%- colorControl('counselors', 'subtext', 'Subtext color', 'counselors_subtext_en') %></div></div>
        <div style="display:flex;justify-content:flex-end;"><button type="submit" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> Save Counselors (EN)</button></div>
      </form>
      </div>
    </div>

    <!-- Section Copy: Features -->
    <div class="section-card">
      <div class="section-title">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#8b5cf6,#06b6d4);display:flex;align-items:center;justify-content:center;"><i data-lucide="star" style="width:14px;height:14px;color:#fff;"></i></div>
        ข้อความ Section: ทำไมต้องเลือก MindCare
        <div class="lang-toggle" style="margin-left:auto;">
          <button type="button" class="lang-btn <%= autoEnFeatures ? 'lang-btn-inactive' : 'lang-btn-active' %>" id="features-btn-th" onclick="cardLang('features','th')">TH</button>
          <button type="button" class="lang-btn <%= autoEnFeatures ? 'lang-btn-active' : 'lang-btn-inactive' %>" id="features-btn-en" onclick="cardLang('features','en')">EN</button>
        </div>
      </div>
      <div id="features-th" style="display:<%= autoEnFeatures ? 'none' : '' %>;">
      <form method="POST" action="/admin/content/features" style="display:grid;gap:12px;">
        <div style="font-size:12px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;">ภาษาไทย</div>
        <div><label class="lbl">หัวข้อ Section ทำไมต้องเลือก MindCare</label><input type="text" name="featuresHeading" class="inp" value="<%= (content.features && content.features.heading) || 'ทำไมต้องเลือก MindCare?' %>"></div>
        <div><label class="lbl">คำอธิบาย Section ทำไมต้องเลือก MindCare</label><textarea name="featuresSubtext" class="inp" rows="2" style="resize:none;"><%= (content.features && content.features.subtext) || '' %></textarea></div>
        <div style="display:grid;gap:8px;"><label class="lbl">รายการเหตุผล / bullet ใน Section นี้</label><% ((content.features && content.features.items) || []).forEach((item, idx) => { %><input type="text" name="featureText" class="inp" value="<%= item %>" placeholder="เหตุผลข้อ <%= idx + 1 %>"><% }) %><% if (!content.features || !content.features.items || !content.features.items.length) { %><% [1,2,3,4,5].forEach((idx) => { %><input type="text" name="featureText" class="inp" placeholder="เหตุผลข้อ <%= idx %>"><% }) %><% } %></div>
        <div class="text-color-panel"><div class="text-color-title">สีข้อความ Section ทำไมต้องเลือก MindCare</div><div class="text-color-grid"><%- colorControl('features', 'heading', 'สีหัวข้อ', 'features_heading_th') %><%- colorControl('features', 'subtext', 'สีคำอธิบายและรายการเหตุผล', 'features_subtext_th') %></div></div>
