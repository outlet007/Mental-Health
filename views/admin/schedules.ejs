<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindCare Admin</title>
  <%- include('../partials/head') %>
  <style>
    .tbl { width:100%; border-collapse:collapse; }
    .tbl thead { background:#f8fafc; }
    .tbl th { padding:10px 14px; text-align:left; font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:.05em; border-bottom:1px solid #f1f5f9; white-space:nowrap; }
    .tbl td { padding:13px 14px; font-size:14px; color:#334155; border-bottom:1px solid #f8fafc; vertical-align:middle; }
    .tbl tbody tr:hover { background:#f8fafc; }
    .tbl tbody tr:last-child td { border-bottom:none; }
    .act-btn { display:inline-flex; align-items:center; gap:4px; padding:5px 10px; border-radius:8px; font-size:12px; font-weight:500; cursor:pointer; border:none; transition:all .15s; text-decoration:none; white-space:nowrap; }
    .ab-primary   { background:#05967e; color:#fff; }
    .ab-primary:hover { background:#067866; }
    .ab-secondary { background:#fff; color:#05967e; border:1px solid #a0f3e1; }
    .ab-secondary:hover { background:#ecfdf9; }
    .ab-ghost     { background:transparent; color:#64748b; }
    .ab-ghost:hover { background:#f1f5f9; }
    .ab-danger    { background:#ef4444; color:#fff; }
    .ab-danger:hover { background:#dc2626; }
    .panel-overlay { position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:40; display:none; backdrop-filter:blur(2px); opacity:0; transition:opacity .2s ease; }
    .panel-overlay.open { opacity:1; }
    .panel-drawer  { position:fixed; top:50%; left:50%; width:calc(100% - 48px); max-width:480px; max-height:90vh; background:#fff; border-radius:20px; box-shadow:0 20px 60px rgba(0,0,0,.18); z-index:50; display:flex; flex-direction:column; transform:translate(-50%,-50%) scale(.94); opacity:0; transition:transform .22s cubic-bezier(.34,1.56,.64,1), opacity .18s ease; pointer-events:none; }
    .panel-drawer.open { transform:translate(-50%,-50%) scale(1); opacity:1; pointer-events:auto; }
    .inp { width:100%; padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:13px; color:#334155; outline:none; font-family:inherit; box-sizing:border-box; }
    .inp:focus { border-color:#2dd4b4; box-shadow:0 0 0 3px rgba(45,212,180,.15); }
    .lbl { display:block; font-size:12px; font-weight:500; color:#64748b; margin-bottom:5px; }
    .view-btn { display:inline-flex; align-items:center; gap:5px; padding:6px 14px; border-radius:8px; font-size:12px; font-weight:500; cursor:pointer; border:1.5px solid #e2e8f0; background:#fff; color:#64748b; text-decoration:none; transition:all .15s; }
    .view-btn:hover { border-color:#2dd4b4; color:#05967e; }
    .view-btn.active { border-color:#05967e; background:#ecfdf9; color:#05967e; }
    .day-tab { display:inline-flex; align-items:center; padding:6px 14px; border-radius:8px; font-size:12px; font-weight:500; cursor:pointer; border:1.5px solid #e2e8f0; background:#fff; color:#64748b; text-decoration:none; transition:all .15s; }
    .day-tab:hover { border-color:#2dd4b4; color:#05967e; }
    .day-tab.active { border-color:#6366f1; background:#eef2ff; color:#4338ca; }
    .cal-cell { border:1px solid #f1f5f9; padding:6px; min-height:72px; vertical-align:top; font-size:12px; }
    .cal-cell.today { background:#eff6ff; }
    .cal-cell.other { background:#fafafa; }
    .c-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin:1px 2px; }
    .c-chip { display:inline-flex; align-items:center; gap:4px; padding:2px 7px; border-radius:99px; font-size:10px; font-weight:500; margin:1px; white-space:nowrap; }
  </style>
</head>
<body style="background:#f8fafc; margin:0;">
<%- include('../partials/admin-sidebar') %>

<div style="margin-left:256px; min-height:100vh; display:flex; flex-direction:column;">

  <!-- Header -->
  <div style="height:56px; background:#fff; border-bottom:1px solid #f1f5f9; padding:0 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20;">
    <h1 style="font-size:15px; font-weight:600; color:#1e293b; margin:0;"><%= title %></h1>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:12px; color:#94a3b8;">
        <% const d=new Date(); %><%= d.toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %>
      </span>
      <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;font-size:12px;font-weight:500;color:#475569;text-decoration:none;">
        <i data-lucide="external-link" style="width:13px;height:13px;"></i>
        ดูหน้าเว็บหลัก
      </a>
    </div>
  </div>

  <% if (session && session.userType === 'counselor') { %>
  <div style="padding:20px 24px 0;">
    <%- include('../partials/counselor-welcome-banner') %>
  </div>
  <% } %>

  <!-- Action Bar -->
  <div style="padding:14px 24px; background:#fff; border-bottom:2px solid #f1f5f9; display:flex; justify-content:flex-end;">
    <button onclick="openPanel('create')" style="display:inline-flex; align-items:center; gap:10px; padding:11px 22px; background:linear-gradient(135deg,#05967e,#06b6d4); color:#fff; border:none; border-radius:12px; font-size:14px; font-weight:600; cursor:pointer; box-shadow:0 2px 8px rgba(5,150,126,.30); transition:all .15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(5,150,126,.45)';this.style.transform='translateY(-1px)'" onmouseout="this.style.boxShadow='0 2px 8px rgba(5,150,126,.30)';this.style.transform='translateY(0)'">
      <i data-lucide="calendar-plus" style="width:18px;height:18px;"></i>
      + เพิ่มตารางเวลา
    </button>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.saved) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#ecfdf9; border:1px solid #a0f3e1; border-radius:12px; color:#065f46; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> บันทึกตารางเวลาสำเร็จ
    </div>
    <% } if (query.deleted) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#fef2f2; border:1px solid #fca5a5; border-radius:12px; color:#991b1b; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="trash-2" style="width:16px;height:16px;flex-shrink:0;"></i> ลบตารางเวลาแล้ว
    </div>
    <% } %>

    <!-- ── Filter Bar ───────────────────────────────────────────────── -->
    <div style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; padding:14px 16px; margin-bottom:16px; display:flex; flex-wrap:wrap; align-items:center; gap:12px;">

      <!-- Counselor filter -->
      <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:200px;">
        <i data-lucide="user" style="width:14px;height:14px;color:#94a3b8;flex-shrink:0;"></i>
        <select id="filterCounselor" class="inp" style="max-width:260px;" onchange="applyFilter()">
          <% if (!isCounselorUser) { %>
          <option value="" <%=filterCId===''?'selected':''%>>นักจิตวิทยาให้คำปรึกษาทั้งหมด</option>
          <% } %>
          <% counselors.forEach(c => { %>
          <option value="<%= c.id %>" <%=filterCId===c.id?'selected':''%>><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- View toggle -->
      <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
        <a href="<%= buildUrl({view:'week'}) %>" class="view-btn <%= view==='week'?'active':'' %>">
          <i data-lucide="layout-list" style="width:13px;height:13px;"></i> รายสัปดาห์
        </a>
        <a href="<%= buildUrl({view:'day'}) %>" class="view-btn <%= view==='day'?'active':'' %>">
          <i data-lucide="calendar-days" style="width:13px;height:13px;"></i> รายวัน
        </a>
        <a href="<%= buildUrl({view:'month'}) %>" class="view-btn <%= view==='month'?'active':'' %>">
          <i data-lucide="calendar" style="width:13px;height:13px;"></i> รายเดือน
        </a>
      </div>

    </div>

    <%
      // Helper: build URL preserving current filters
      function buildUrl(overrides) {
        const p = {
          counselorId: filterCId,
          view,
          dayOfWeek: selectedDay,
          year: monthData.year,
          month: monthData.month,
        }
        Object.assign(p, overrides)
        const qs = Object.entries(p)
          .filter(([, v]) => v !== '' && v !== null && v !== undefined)
          .map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&')
        return '/admin/schedules?' + qs
      }
      const returnQuery = `counselorId=${encodeURIComponent(filterCId)}&view=${view}&dayOfWeek=${selectedDay}&year=${monthData.year}&month=${monthData.month}`
    %>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- VIEW: รายสัปดาห์ (week)                                        -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <% if (view === 'week') { %>

    <%
      const weeklyCounselor = filterCId ? counselorMap[filterCId] : null
    %>
    <!-- The same grouped-by-day grid is used for all and individual filters. -->
    <div data-weekly-schedule-grid="true" style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; overflow:hidden;">
      <div style="padding:14px 16px; border-bottom:1px solid #f1f5f9;">
        <span style="font-size:13px; font-weight:600; color:#334155;">ตารางเวลารายสัปดาห์ — <%= weeklyCounselor ? weeklyCounselor.name : 'นักจิตวิทยาให้คำปรึกษาทั้งหมด' %></span>
      </div>
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th style="width:110px;">วัน</th>
              <th>นักจิตวิทยาให้คำปรึกษาและเวลา</th>
            </tr>
          </thead>
          <tbody>
            <% weekGrid.forEach(row => { %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:8px;">
                  <div style="width:32px;height:32px;border-radius:8px;background:#f8fafc;border:1px solid #e2e8f0;display:flex;align-items:center;justify-content:center;">
                    <i data-lucide="calendar-days" style="width:14px;height:14px;color:#64748b;"></i>
                  </div>
                  <span style="font-weight:600;color:#1e293b;font-size:14px;"><%= row.dayName %></span>
                </div>
              </td>
              <td>
                <% if (row.entries.length === 0) { %>
                <span style="font-size:12px;color:#cbd5e1;">— ไม่มีตารางเวลา —</span>
                <% } else { %>
                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                  <% row.entries.forEach(e => { %>
                  <%
                    const col = counselorColors[e.counselorId] || '#64748b'
                    const cInfo = e.counselor
                  %>
                  <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:10px;border:1.5px solid <%= col %>20;background:<%= col %>10;">
                    <div style="width:20px;height:20px;border-radius:5px;background:<%= col %>;display:flex;align-items:center;justify-content:center;color:#fff;font-size:9px;font-weight:700;flex-shrink:0;overflow:hidden;">
                      <% if (cInfo && cInfo.photo) { %>
                        <img data-counselor-profile-photo="<%= cInfo.id %>" src="<%= cInfo.photo %>" alt="<%= cInfo.name %>" style="width:100%;height:100%;object-fit:cover;">
                      <% } else { %>
                        <%= cInfo ? cInfo.avatar : '?' %>
                      <% } %>
                    </div>
                    <div>
                      <div style="font-size:12px;font-weight:600;color:<%= col %>;line-height:1.2;"><%= cInfo ? cInfo.name : e.counselorId %></div>
                      <div style="font-size:10px;color:#64748b;"><%= e.startTime %>–<%= e.endTime %>
                        <% if (!e.isActive) { %><span style="color:#f59e0b;"> (ปิด)</span><% } %>
                      </div>
                    </div>
                  </div>
                  <% }) %>
                </div>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- VIEW: รายวัน (day)                                             -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <% } else if (view === 'day') { %>

    <!-- Day selector tabs -->
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;padding:14px 16px;margin-bottom:16px;display:flex;flex-wrap:wrap;gap:8px;">
      <% ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'].forEach((name, i) => { %>
      <a href="<%= buildUrl({view:'day', dayOfWeek: i}) %>"
         class="day-tab <%= selectedDay === i ? 'active' : '' %>">
        <%= name %>
        <%
          const cnt = weekGrid[i].entries.length
          if (cnt > 0) {
        %>
        <span style="padding:1px 6px;border-radius:99px;font-size:10px;font-weight:600;background:<%= selectedDay===i?'#6366f1':'#f1f5f9' %>;color:<%= selectedDay===i?'#fff':'#64748b' %>;"><%= cnt %></span>
        <% } %>
      </a>
      <% }) %>
    </div>

    <!-- Day schedule table -->
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;overflow:hidden;">
      <div style="padding:14px 16px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
        <span style="font-size:13px;font-weight:600;color:#334155;">
          วัน<%= ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'][selectedDay] %>
          — นักจิตวิทยาให้คำปรึกษาที่มีตาราง
        </span>
        <span style="font-size:12px;color:#94a3b8;"><%= daySchedules.length %> คน</span>
      </div>
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th>นักจิตวิทยาให้คำปรึกษา</th><th>เวลาเริ่ม</th><th>เวลาสิ้นสุด</th><th>ช่วงเวลา</th><th>สถานะ</th>
              <% if (!isCounselorUser) { %><th>การจัดการ</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% daySchedules.forEach(s => { %>
            <% const [sh,sm]=s.startTime.split(':').map(Number); const [eh,em]=s.endTime.split(':').map(Number); const totalMin=(eh*60+em)-(sh*60+sm) %>
            <% const col = counselorColors[s.counselorId] || '#64748b' %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:8px;">
                  <div style="width:32px;height:32px;border-radius:8px;background:<%= col %>20;display:flex;align-items:center;justify-content:center;color:<%= col %>;font-size:12px;font-weight:700;overflow:hidden;">
                    <% if (s.counselor && s.counselor.photo) { %>
                      <img data-counselor-profile-photo="<%= s.counselor.id %>" src="<%= s.counselor.photo %>" alt="<%= s.counselor.name %>" style="width:100%;height:100%;object-fit:cover;">
                    <% } else { %>
                      <%= s.counselor ? s.counselor.avatar : '?' %>
                    <% } %>
                  </div>
                  <div>
                    <div style="font-size:14px;font-weight:600;color:#1e293b;"><%= s.counselor ? s.counselor.name : s.counselorId %></div>
                    <div style="font-size:12px;color:#94a3b8;"><%= s.counselor ? s.counselor.title : '' %></div>
                  </div>
                </div>
              </td>
              <td><span style="font-weight:500;font-size:14px;color:#1e293b;"><%= s.startTime %></span></td>
              <td><span style="font-weight:500;font-size:14px;color:#1e293b;"><%= s.endTime %></span></td>
              <td><span style="font-size:12px;color:#64748b;"><% if(totalMin>=60){%><%= Math.floor(totalMin/60) %> ชม.<% if(totalMin%60){%> <%= totalMin%60 %> นาที<% } %><% }else{%><%= totalMin %> นาที<% } %></span></td>
              <td>
                <% if (s.isActive) { %>
                <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;background:#d1fae5;color:#065f46;border-radius:99px;font-size:12px;font-weight:500;">
                  <span style="width:6px;height:6px;border-radius:50%;background:#10b981;display:inline-block;"></span> เปิดรับนัด
                </span>
                <% } else { %>
                <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;background:#f1f5f9;color:#64748b;border-radius:99px;font-size:12px;font-weight:500;">
                  <span style="width:6px;height:6px;border-radius:50%;background:#94a3b8;display:inline-block;"></span> ปิดพักตัว
                </span>
                <% } %>
              </td>
              <% if (!isCounselorUser) { %>
              <td>
                <div style="display:flex;align-items:center;gap:6px;">
                  <button class="act-btn ab-secondary edit-btn" data-rec="<%= JSON.stringify(s) %>">
                    <i data-lucide="pencil" style="width:13px;height:13px;"></i> แก้ไข
                  </button>
                  <button type="button" class="act-btn ab-danger delete-btn"
                          data-action="/admin/schedules/delete"
                          data-name="slot <%= s.dayName %> <%= s.startTime %>–<%= s.endTime %> ของ <%= s.counselor ? s.counselor.name : '' %>"
                          data-warning="ตารางเวลานี้จะถูกลบถาวร ผู้รับบริการจะไม่สามารถจองคิวช่วงเวลานี้ได้อีก"
                          data-extra='<%- JSON.stringify({id: s.id, returnQuery: returnQuery}) %>'>
                    <i data-lucide="trash-2" style="width:13px;height:13px;"></i>
                  </button>
                </div>
              </td>
              <% } %>
            </tr>
            <% }) %>
            <% if (daySchedules.length === 0) { %>
            <tr><td colspan="6" style="text-align:center;padding:48px 16px;color:#94a3b8;">
              <i data-lucide="calendar-x" style="width:36px;height:36px;display:block;margin:0 auto 10px;opacity:.3;"></i>
              ไม่มีนักจิตวิทยาให้คำปรึกษาที่มีตารางเวลาในวันนี้
            </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!-- VIEW: รายเดือน (month)                                         -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <% } else if (view === 'month') { %>

    <!-- Month navigation -->
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;padding:14px 20px;margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;">
      <a href="<%= buildUrl({view:'month', year:monthData.prevYear, month:monthData.prevMonth}) %>"
         class="act-btn ab-ghost" style="border:1px solid #e2e8f0;">
        <i data-lucide="chevron-left" style="width:14px;height:14px;"></i> ก่อนหน้า
      </a>
      <span style="font-size:14px;font-weight:600;color:#1e293b;">
        <%= monthData.monthName %> <%= monthData.year + 543 %>
      </span>
      <a href="<%= buildUrl({view:'month', year:monthData.nextYear, month:monthData.nextMonth}) %>"
         class="act-btn ab-ghost" style="border:1px solid #e2e8f0;">
        ถัดไป <i data-lucide="chevron-right" style="width:14px;height:14px;"></i>
      </a>
    </div>

    <!-- Color legend -->
    <% if (counselors.length > 0) { %>
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;padding:12px 16px;margin-bottom:16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;">
      <span style="font-size:12px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;">นักจิตวิทยาให้คำปรึกษา:</span>
      <% counselors.forEach(c => { %>
      <% const col = counselorColors[c.id] || '#64748b' %>
      <div style="display:inline-flex;align-items:center;gap:5px;">
        <span style="width:10px;height:10px;border-radius:50%;background:<%= col %>;display:inline-block;flex-shrink:0;"></span>
        <span style="font-size:12px;color:#334155;"><%= c.name %></span>
      </div>
      <% }) %>
    </div>
    <% } %>

    <!-- Calendar grid -->
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;overflow:hidden;">
      <table data-table-pagination="ignore" style="width:100%;border-collapse:collapse;">
        <thead>
          <tr>
            <% ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'].forEach(d => { %>
            <th style="padding:10px 6px;font-size:12px;font-weight:600;color:#64748b;text-align:center;border-bottom:1px solid #f1f5f9;text-transform:uppercase;letter-spacing:.05em;"><%= d %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% monthData.weeks.forEach(week => { %>
          <tr>
            <% week.forEach(cell => { %>
            <td class="cal-cell <%= cell && cell.isToday ? 'today' : '' %> <%= !cell ? 'other' : '' %>" style="width:14.28%;">
              <% if (cell) { %>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;">
                <span style="font-size:12px;font-weight:<%= cell.isToday?'700':'500' %>;color:<%= cell.isToday?'#fff':'#334155' %>;background:<%= cell.isToday?'#3b82f6':'transparent' %>;width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <%= cell.day %>
                </span>
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:2px;">
                <% cell.entries.forEach(e => { %>
                <% const col = counselorColors[e.counselorId] || '#64748b' %>
                <span class="c-chip" style="background:<%= col %>18;color:<%= col %>;">
                  <% if (e.counselor && e.counselor.photo) { %>
                    <img data-counselor-profile-photo="<%= e.counselor.id %>" src="<%= e.counselor.photo %>" alt="<%= e.counselor.name %>" style="width:14px;height:14px;border-radius:50%;object-fit:cover;">
                  <% } else { %>
                    <span class="c-dot" style="background:<%= col %>;width:6px;height:6px;border-radius:50%;"></span>
                    <%= e.counselor ? e.counselor.avatar : '?' %>
                  <% } %>
                </span>
                <% }) %>
              </div>
              <% } %>
            </td>
            <% }) %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% } %> <!-- end view branch -->

  </div>
</div>

<!-- Overlay -->
<div id="overlay" class="panel-overlay" onclick="closePanel()"></div>

<!-- Panel Modal -->
<div id="panel" class="panel-drawer">
  <div style="padding:16px 20px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:10px;">
      <div style="width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,#05967e,#06b6d4); display:flex; align-items:center; justify-content:center;">
        <i id="panelIcon" data-lucide="calendar-plus" style="width:15px;height:15px;color:#fff;"></i>
      </div>
      <div>
        <div id="panelTitle" style="font-size:14px; font-weight:600; color:#1e293b;">เพิ่มตารางเวลา</div>
        <div id="panelSub"   style="font-size:12px; color:#94a3b8;">กำหนดวันและเวลารับนัด</div>
      </div>
    </div>
    <button onclick="closePanel()" style="background:none; border:none; cursor:pointer; padding:6px; border-radius:8px; color:#94a3b8;">
      <i data-lucide="x" style="width:18px;height:18px;"></i>
    </button>
  </div>

  <div style="flex:1; overflow-y:auto; padding:24px;">
    <form id="panelForm" method="POST" action="/admin/schedules/save"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="id" id="f_scheduleId">
      <input type="hidden" name="returnQuery" value="<%= returnQuery %>">
      <div style="display:grid; gap:18px;">

        <div>
          <label class="lbl">นักจิตวิทยาให้คำปรึกษา *</label>
          <select name="counselorId" id="f_counselorId" class="inp" required>
            <% counselors.forEach(c => { %>
            <option value="<%= c.id %>" <%=c.id===selected?'selected':''%>><%= c.name %></option>
            <% }) %>
          </select>
        </div>

        <input type="hidden" name="dayOfWeek" id="f_dayOfWeek" value="">
        <input type="hidden" name="dayOfWeeks" id="f_dayOfWeeks" value="[]">
        <div id="createDayPicker">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px;">
            <label class="lbl" style="margin:0;">วันที่ต้องการเพิ่ม *</label>
            <span style="font-size:11px;color:#94a3b8;">เลือกได้หลายวัน</span>
          </div>
          <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;">
            <% ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'].forEach((name,i) => { %>
            <label style="display:flex;align-items:center;gap:7px;padding:9px 10px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;font-size:12px;color:#475569;background:#fff;">
              <input type="checkbox" class="schedule-day-checkbox" value="<%= i %>" style="accent-color:#05967e;">
              <span><%= name %></span>
            </label>
            <% }) %>
          </div>
        </div>
        <div id="editDayPicker" style="display:none;">
          <label class="lbl">วัน *</label>
          <select id="f_editDayOfWeek" class="inp">
            <% ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'].forEach((name,i) => { %>
            <option value="<%= i %>"><%= name %></option>
            <% }) %>
          </select>
        </div>
        <div id="dayWarning" style="display:none; padding:8px 12px; background:#fef2f2; border:1px solid #fca5a5; border-radius:8px; font-size:12px; color:#991b1b;">
          <i data-lucide="alert-triangle" style="width:12px;height:12px;display:inline;margin-right:4px;"></i>
          <span id="dayWarningText">กรุณาเลือกอย่างน้อย 1 วัน</span>
        </div>
        <input type="hidden" name="timeRanges" id="f_timeRanges" value="[]">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
          <label class="lbl" style="margin:0;">ช่วงเวลา *</label>
          <button type="button" id="addTimeRangeButton" onclick="addTimeRange()" class="act-btn ab-secondary">
            <i data-lucide="plus" style="width:13px;height:13px;"></i> เพิ่มช่วงเวลา
          </button>
        </div>
        <div id="timeRangesContainer" style="display:grid;gap:12px;"></div>
        <div>
          <label class="lbl">สถานะการรับนัด</label>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <label style="display:flex; align-items:flex-start; gap:10px; padding:12px; border:1.5px solid #a0f3e1; border-radius:10px; cursor:pointer; background:#ecfdf9;">
              <input type="radio" name="isActive" value="true" id="r_open" checked style="margin-top:2px; accent-color:#05967e;">
              <div>
                <div style="font-size:13px; font-weight:500; color:#1e293b;">เปิดรับนัด</div>
                <div style="font-size:12px; color:#64748b;">ผู้รับบริการจองได้</div>
              </div>
            </label>
            <label style="display:flex; align-items:flex-start; gap:10px; padding:12px; border:1.5px solid #e2e8f0; border-radius:10px; cursor:pointer;">
              <input type="radio" name="isActive" value="false" id="r_close" style="margin-top:2px; accent-color:#64748b;">
              <div>
                <div style="font-size:13px; font-weight:500; color:#1e293b;">ปิดพักตัว</div>
                <div style="font-size:12px; color:#64748b;">ไม่รับนัดชั่วคราว</div>
              </div>
            </label>
          </div>
        </div>

      </div>
    </form>
  </div>

  <div style="padding:16px 20px; border-top:1px solid #f1f5f9; display:flex; gap:10px;">
    <button onclick="closePanel()" class="act-btn ab-ghost" style="flex:1;justify-content:center;border:1px solid #e2e8f0;">ยกเลิก</button>
    <button onclick="submitPanel()" class="act-btn ab-primary" style="flex:1;justify-content:center;">
      <i data-lucide="save" style="width:14px;height:14px;"></i>
      <span id="submitLabel">บันทึกตารางเวลา</span>
    </button>
  </div>
</div>

<!-- ░░░ Delete confirm overlay ░░░ -->
<div id="deleteOverlay" class="panel-overlay" onclick="closeDeleteModal()"></div>
<div id="deletePanel" class="panel-drawer" style="max-width:420px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:36px;height:36px;border-radius:10px;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i data-lucide="trash-2" style="width:17px;height:17px;color:#ef4444;"></i>
      </div>
      <div style="font-size:14px;font-weight:600;color:#1e293b;">ยืนยันการลบ</div>
    </div>
    <button onclick="closeDeleteModal()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <form id="deleteForm" method="POST" action="" style="padding:20px;display:flex;flex-direction:column;gap:14px;"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div style="padding:12px 14px;background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;font-size:13px;color:#991b1b;display:flex;gap:8px;align-items:flex-start;">
      <i data-lucide="alert-triangle" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;"></i>
      <span id="deleteWarningText"></span>
    </div>
    <div>
      <label class="lbl">เหตุผลการลบ <span style="color:#ef4444;">*</span></label>
      <textarea name="reason" id="deleteReason" required rows="3" class="inp" style="resize:none;" placeholder="ระบุเหตุผลที่ต้องการลบข้อมูลนี้..."></textarea>
    </div>
    <div style="display:flex;gap:10px;">
      <button type="button" onclick="closeDeleteModal()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
      <button type="submit" class="act-btn ab-danger" style="flex:1;justify-content:center;"><i data-lucide="trash-2" style="width:14px;height:14px;"></i> ยืนยันลบ</button>
    </div>
  </form>
</div>

<script>
  // ── Delete confirm modal ─────────────────────────────────────────────────────
  function openDeleteModal(action, name, warning, extraFields) {
    const form = document.getElementById('deleteForm')
    form.action = action
    document.getElementById('deleteReason').value = ''
    document.getElementById('deleteWarningText').textContent = warning || ('ต้องการลบ "' + name + '" ใช่หรือไม่ การลบไม่สามารถกู้คืนได้')
    form.querySelectorAll('.dyn-field').forEach(el => el.remove())
    if (extraFields) {
      Object.entries(extraFields).forEach(([k, v]) => {
        const inp = document.createElement('input')
        inp.type = 'hidden'; inp.name = k; inp.value = v; inp.className = 'dyn-field'
        form.insertBefore(inp, form.firstChild)
      })
    }
    const ov = document.getElementById('deleteOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('deletePanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }
  function closeDeleteModal() {
    const ov = document.getElementById('deleteOverlay')
    ov.classList.remove('open')
    document.getElementById('deletePanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const extra = btn.dataset.extra ? JSON.parse(btn.dataset.extra) : null
      openDeleteModal(btn.dataset.action, btn.dataset.name, btn.dataset.warning, extra)
    })
  })

  const ALL_SCHEDULES  = <%- JSON.stringify(weekGrid.flatMap(r => r.entries)) %>
  const SELECTED_ID    = '<%- selected %>'
  const IS_COUNSELOR   = <%- isCounselorUser ? 'true' : 'false' %>

  // Counselor filter dropdown → reload page
  function applyFilter() {
    const cId  = document.getElementById('filterCounselor').value
    const view = new URLSearchParams(location.search).get('view') || 'week'
    const dow  = new URLSearchParams(location.search).get('dayOfWeek') || '1'
    const yr   = new URLSearchParams(location.search).get('year') || ''
    const mo   = new URLSearchParams(location.search).get('month') || ''
    let url = `/admin/schedules?view=${view}&counselorId=${encodeURIComponent(cId)}&dayOfWeek=${dow}`
    if (yr) url += `&year=${yr}`
    if (mo) url += `&month=${mo}`
    location.href = url
  }

  let schedulePanelMode = 'create'
  const SCHEDULE_DAY_NAMES = ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์']

  function toMinutes(value) {
    const parts = String(value || '').split(':').map(Number)
    return parts.length === 2 ? parts[0] * 60 + parts[1] : NaN
  }

  function formatMinutes(total) {
    if (!Number.isFinite(total) || total <= 0) return '⚠ เวลาสิ้นสุดต้องมากกว่าเวลาเริ่ม'
    const hours = Math.floor(total / 60)
    const minutes = total % 60
    return hours ? `${hours} ชั่วโมง${minutes ? ' ' + minutes + ' นาที' : ''}` : `${minutes} นาที`
  }

  function splitTime(value) {
    const [hour = '00', minute = '00'] = String(value || '00:00').split(':')
    return { hour: hour.padStart(2, '0'), minute: minute.padStart(2, '0') }
  }

  function timeOptions(size, selected) {
    return Array.from({ length: size }, (_, index) => {
      const value = String(index).padStart(2, '0')
      return `<option value="${value}"${value === selected ? ' selected' : ''}>${value}</option>`
    }).join('')
  }

  function combineTime(row, prefix) {
    const hour = row.querySelector(`[data-field="${prefix}Hour"]`).value
    const minute = row.querySelector(`[data-field="${prefix}Minute"]`).value
    return `${hour}:${minute}`
  }

  function readTimeRanges() {
    return [...document.querySelectorAll('.time-range-row')].map(row => ({
      startTime: combineTime(row, 'start'),
      endTime: combineTime(row, 'end'),
    }))
  }
  function readSelectedDays() {
    if (schedulePanelMode === 'edit') {
      const day = parseInt(document.getElementById('f_editDayOfWeek').value)
      return Number.isInteger(day) ? [day] : []
    }
    return [...document.querySelectorAll('.schedule-day-checkbox:checked')]
      .map(input => parseInt(input.value))
      .filter(Number.isInteger)
  }
  function renderTimeRanges(ranges) {
    const container = document.getElementById('timeRangesContainer')
    container.innerHTML = ranges.map((range, index) => {
      const start = splitTime(range.startTime)
      const end = splitTime(range.endTime)
      return `
      <div class="time-range-row" style="padding:14px;border:1.5px solid #e2e8f0;border-radius:12px;background:#fff;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;">
          <span style="font-size:12px;font-weight:700;color:#475569;">ช่วงเวลาที่ ${index + 1}</span>
          ${schedulePanelMode === 'create' && ranges.length > 1 ? `<button type="button" onclick="removeTimeRange(${index})" class="act-btn ab-ghost" style="color:#ef4444;padding:4px 8px;"><i data-lucide="trash-2" style="width:13px;height:13px;"></i> ลบ</button>` : ''}
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label class="lbl">เวลาเริ่ม (24 ชั่วโมง) *</label>
            <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;">
              <select data-field="startHour" class="inp" aria-label="ชั่วโมงเริ่ม">${timeOptions(24, start.hour)}</select>
              <span aria-hidden="true" style="font-weight:700;color:#64748b;">:</span>
              <select data-field="startMinute" class="inp" aria-label="นาทีเริ่ม">${timeOptions(60, start.minute)}</select>
            </div>
          </div>
          <div>
            <label class="lbl">เวลาสิ้นสุด (24 ชั่วโมง) *</label>
            <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;">
              <select data-field="endHour" class="inp" aria-label="ชั่วโมงสิ้นสุด">${timeOptions(24, end.hour)}</select>
              <span aria-hidden="true" style="font-weight:700;color:#64748b;">:</span>
              <select data-field="endMinute" class="inp" aria-label="นาทีสิ้นสุด">${timeOptions(60, end.minute)}</select>
            </div>
          </div>
        </div>
        <div data-duration style="font-size:12px;color:#05967e;font-weight:600;margin-top:8px;"></div>
      </div>`
    }).join('')
    container.querySelectorAll('select[data-field]').forEach(select => {
      select.addEventListener('change', updateTimeRanges)
    })
    updateTimeRanges()
    lucide.createIcons()
  }
  function addTimeRange() {
    const ranges = readTimeRanges()
    const previousEnd = ranges.at(-1)?.endTime || '09:00'
    const nextStartMinutes = toMinutes(previousEnd)
    const nextEndMinutes = Number.isFinite(nextStartMinutes) ? Math.min(nextStartMinutes + 60, 1439) : 600
    const nextEnd = `${String(Math.floor(nextEndMinutes / 60)).padStart(2, '0')}:${String(nextEndMinutes % 60).padStart(2, '0')}`
    ranges.push({ startTime: previousEnd, endTime: nextEnd })
    renderTimeRanges(ranges)
  }

  function removeTimeRange(index) {
    const ranges = readTimeRanges()
    ranges.splice(index, 1)
    renderTimeRanges(ranges.length ? ranges : [{ startTime: '09:00', endTime: '10:00' }])
  }

  function setTimeRangeWarning(message) {
    const warning = document.getElementById('dayWarning')
    document.getElementById('dayWarningText').textContent = message || ''
    warning.style.display = message ? 'block' : 'none'
    if (message) lucide.createIcons()
  }

  function updateTimeRanges() {
    const counselorId = document.getElementById('f_counselorId').value
    const days = readSelectedDays()
    const currentId = document.getElementById('f_scheduleId').value
    const ranges = readTimeRanges()
    let warning = ''

    document.querySelectorAll('.time-range-row').forEach((row, index) => {
      const start = toMinutes(ranges[index].startTime)
      const end = toMinutes(ranges[index].endTime)
      row.querySelector('[data-duration]').textContent = formatMinutes(end - start)
    })

    if (!days.length) warning = 'กรุณาเลือกอย่างน้อย 1 วัน'

    for (let index = 0; index < ranges.length && !warning; index++) {
      const start = toMinutes(ranges[index].startTime)
      const end = toMinutes(ranges[index].endTime)
      if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start) {
        warning = `ช่วงเวลาที่ ${index + 1}: เวลาสิ้นสุดต้องมากกว่าเวลาเริ่ม`
        break
      }
      for (let other = 0; other < index; other++) {
        const otherStart = toMinutes(ranges[other].startTime)
        const otherEnd = toMinutes(ranges[other].endTime)
        if (start < otherEnd && otherStart < end) {
          warning = `ช่วงเวลาที่ ${index + 1} ทับซ้อนกับช่วงเวลาที่ ${other + 1}`
          break
        }
      }
    }

    for (const day of days) {
      for (let index = 0; index < ranges.length && !warning; index++) {
        const start = toMinutes(ranges[index].startTime)
        const end = toMinutes(ranges[index].endTime)
        const savedConflict = ALL_SCHEDULES.some(slot =>
          slot.id !== currentId &&
          slot.counselorId === counselorId &&
          Number(slot.dayOfWeek) === day &&
          start < toMinutes(slot.endTime) &&
          toMinutes(slot.startTime) < end
        )
        if (savedConflict) warning = `${SCHEDULE_DAY_NAMES[day]} ช่วงเวลาที่ ${index + 1} ทับซ้อนกับตารางเวลาที่มีอยู่แล้ว`
      }
      if (warning) break
    }

    document.getElementById('f_dayOfWeeks').value = JSON.stringify(days)
    document.getElementById('f_dayOfWeek').value = days[0] ?? ''
    document.getElementById('f_timeRanges').value = JSON.stringify(ranges)
    setTimeRangeWarning(warning)
    return !warning && days.length > 0 && ranges.length > 0
  }
  function openPanel(mode, data) {
    schedulePanelMode = mode
    document.getElementById('panelForm').reset()
    document.getElementById('f_scheduleId').value = ''
    document.getElementById('r_open').checked = true
    document.getElementById('addTimeRangeButton').style.display = mode === 'create' ? 'inline-flex' : 'none'
    document.getElementById('createDayPicker').style.display = mode === 'create' ? '' : 'none'
    document.getElementById('editDayPicker').style.display = mode === 'edit' ? '' : 'none'
    document.querySelectorAll('.schedule-day-checkbox').forEach(input => { input.checked = false })

    if (mode === 'create') {
      document.getElementById('panelTitle').textContent = 'เพิ่มตารางเวลา'
      document.getElementById('panelSub').textContent = 'เลือกหลายวันและเพิ่มช่วงเวลาเดียวกันได้ในครั้งเดียว'
      document.getElementById('panelIcon').setAttribute('data-lucide', 'calendar-plus')
      document.getElementById('submitLabel').textContent = 'บันทึกตารางเวลา'
      document.getElementById('f_counselorId').value = SELECTED_ID
      if (data && data.dayOfWeek !== undefined) {
        const selectedDay = document.querySelector('.schedule-day-checkbox[value="' + data.dayOfWeek + '"]')
        if (selectedDay) selectedDay.checked = true
      }
      renderTimeRanges([{ startTime: '09:00', endTime: '10:00' }])
    } else {
      document.getElementById('panelTitle').textContent = 'แก้ไขตารางเวลา'
      document.getElementById('panelSub').textContent = data.dayName
      document.getElementById('panelIcon').setAttribute('data-lucide', 'pencil')
      document.getElementById('submitLabel').textContent = 'บันทึกการแก้ไข'
      document.getElementById('f_scheduleId').value = data.id
      document.getElementById('f_counselorId').value = data.counselorId
      document.getElementById('f_editDayOfWeek').value = data.dayOfWeek
      document.getElementById(data.isActive ? 'r_open' : 'r_close').checked = true
      renderTimeRanges([{ startTime: data.startTime, endTime: data.endTime }])
    }

    const ov = document.getElementById('overlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('panel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }

  function closePanel() {
    const ov = document.getElementById('overlay')
    ov.classList.remove('open')
    document.getElementById('panel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }

  function submitPanel() {
    const form = document.getElementById('panelForm')
    if (!updateTimeRanges()) return
    if (form.reportValidity()) form.submit()
  }

  document.querySelectorAll('.schedule-day-checkbox').forEach(input => input.addEventListener('change', updateTimeRanges))
  document.getElementById('f_editDayOfWeek').addEventListener('change', updateTimeRanges)
  document.getElementById('f_counselorId').addEventListener('change', updateTimeRanges)
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openPanel('edit', JSON.parse(btn.dataset.rec)))
  })
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel() })

  lucide.createIcons()
</script>
</body>
</html>
