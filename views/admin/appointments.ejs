<script>
  const SCHEDULES = <%- JSON.stringify(schedules) %>
  const CLIENTS   = <%- JSON.stringify(clients) %>
  let selectedCounselor = null
  let selectedTime      = null

  function openPanel() {
    const ov = document.getElementById('overlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => { ov.classList.add('open') })
    document.getElementById('panel').classList.add('open')
    document.body.style.overflow = 'hidden'
  }
  function closePanel() {
    const ov = document.getElementById('overlay')
    ov.classList.remove('open')
    document.getElementById('panel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  document.addEventListener('keydown', e => { if(e.key==='Escape') { closePanel(); closeViewPanel(); closeEditPanel(); closeCompletePanel(); closeEditNotePanel() } })

  function onCounselorChange(radio) {
    selectedCounselor = { id:radio.value, duration:parseInt(radio.dataset.duration), name:radio.dataset.name }
    document.querySelectorAll('.counselor-card').forEach(el => {
      const r = el.querySelector('input')
      el.classList.toggle('selected', r && r.value===radio.value)
    })
    const di = document.getElementById('dateInput')
    di.disabled = false
    di.value = ''
    document.getElementById('dateHint').style.display = 'none'
    const mySched = SCHEDULES.filter(s => s.counselorId===radio.value && s.isActive)
    document.getElementById('dayBadges').innerHTML = mySched.map(s =>
      `<span style="padding:3px 10px; background:#dbeafe; color:#1e40af; border-radius:99px; font-size:11px;">${s.dayName} ${s.startTime}–${s.endTime}</span>`
    ).join('')
    document.getElementById('availableDays').style.display = 'block'
    resetSlots()
    document.getElementById('apptSummary').style.display = 'none'
  }

  async function loadSlots() {
    const date = document.getElementById('dateInput').value
    if (!date || !selectedCounselor) return
    resetSlots()
    document.getElementById('slotLoading').style.display = 'block'
    const resp = await fetch(`/admin/appointments/slots?counselorId=${selectedCounselor.id}&date=${date}`)
    const { slots } = await resp.json()
    document.getElementById('slotLoading').style.display = 'none'
    document.getElementById('slotSection').style.display = 'block'
    const grid = document.getElementById('slotGrid')
    const msg  = document.getElementById('slotMsg')
    if (!slots.length) {
      msg.textContent = 'นักให้คำปรึกษาไม่มีตารางเวลาในวันนี้'
      msg.style.display = 'block'
      return
    }
    grid.innerHTML = slots.map(s => `
      <button type="button" class="slot-btn" onclick="selectSlot(this,'${s.time}')" ${!s.available?'disabled':''}>
        ${s.time}
      </button>`
    ).join('')
  }

  function selectSlot(btn, time) {
    selectedTime = time
    document.getElementById('timeInput').value = time
    document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('selected'))
    btn.classList.add('selected')
    updateSummary()
  }

  function resetSlots() {
    selectedTime = null
    document.getElementById('timeInput').value = ''
    document.getElementById('slotGrid').innerHTML = ''
    document.getElementById('slotSection').style.display = 'none'
    document.getElementById('slotMsg').style.display = 'none'
  }

  function updateSummary() {
    if (!selectedCounselor || !selectedTime) return
    const date = document.getElementById('dateInput').value
    if (!date) return
    const dateStr = new Date(date).toLocaleDateString('th-TH', { weekday:'short', day:'numeric', month:'short', year:'numeric' })
    document.getElementById('summCounselor').textContent = selectedCounselor.name
    document.getElementById('summDateTime').textContent  = `${dateStr} ${selectedTime} น.`
    document.getElementById('apptSummary').style.display  = 'block'
  }

  function submitForm() {
    const form = document.getElementById('createForm')
    if (!form.reportValidity()) return
    if (!selectedTime) { alert('กรุณาเลือกเวลานัดหมาย'); return }
    form.submit()
  }

  // ── View Panel ───────────────────────────────────────────────
  const STATUS_LABELS = { pending:'รอยืนยัน', confirmed:'ยืนยันแล้ว', completed:'เสร็จสิ้น', cancelled:'ยกเลิก' }
  const STATUS_COLORS = {
    pending:   { bg:'#fef3c7', color:'#92400e' },
    confirmed: { bg:'#dbeafe', color:'#1e40af' },
    completed: { bg:'#d1fae5', color:'#065f46' },
    cancelled: { bg:'#fee2e2', color:'#991b1b' },
  }

  function openViewPanel(a) {
    const client = CLIENTS.find(c => c.id === a.clientId) || {}
    document.getElementById('viewPanelSub').textContent = `#${a.id}`
    document.getElementById('v_clientName').textContent      = a.clientName
    document.getElementById('v_clientStudentId').textContent = client.studentId || '-'
    document.getElementById('v_clientPhone').textContent     = client.phone     || '-'
    document.getElementById('v_clientEmail').textContent     = client.email     || '-'
    document.getElementById('v_counselorName').textContent = a.counselorName
    document.getElementById('v_date').textContent = a.date
    document.getElementById('v_time').textContent = a.time + ' น.'
    document.getElementById('v_type').textContent = a.type === 'online' ? 'ออนไลน์' : 'เข้ารับบริการด้วยตนเอง'
    document.getElementById('v_duration').textContent = (a.duration || 60) + ' นาที'
    const sc = STATUS_COLORS[a.status] || { bg:'#f1f5f9', color:'#64748b' }
    document.getElementById('v_status').innerHTML =
      `<span style="display:inline-block;padding:4px 12px;background:${sc.bg};color:${sc.color};border-radius:99px;font-size:12px;font-weight:500;">${STATUS_LABELS[a.status] || a.status}</span>`
    const noteWrap = document.getElementById('v_noteWrap')
    if (a.note) {
      document.getElementById('v_note').textContent = a.note
      noteWrap.style.display = 'block'
    } else {
      noteWrap.style.display = 'none'
    }
    const cnWrap = document.getElementById('v_counselorNoteWrap')
    if (a.counselorNote) {
      document.getElementById('v_counselorNote').textContent = a.counselorNote
      cnWrap.style.display = 'block'
    } else {
      cnWrap.style.display = 'none'
    }
    const ov = document.getElementById('viewOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => { ov.classList.add('open') })
    document.getElementById('viewPanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }

  function closeViewPanel() {
    const ov = document.getElementById('viewOverlay')
    ov.classList.remove('open')
    document.getElementById('viewPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }

  // ── Edit Panel ───────────────────────────────────────────────
  function openEditPanel(a) {
    document.getElementById('editPanelSub').textContent = `${a.clientName} — ${a.date}`
    document.getElementById('editForm').action = '/admin/appointments/' + a.id + '/edit'
    document.getElementById('e_date').value   = a.date   || ''
    document.getElementById('e_time').value   = a.time   || ''
    document.getElementById('e_status').value = a.status || 'pending'
    document.getElementById('e_note').value   = a.note   || ''
    document.getElementById(a.type === 'onsite' ? 'e_onsite' : 'e_online').checked = true
    const ov = document.getElementById('editOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => { ov.classList.add('open') })
    document.getElementById('editPanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }

  function closeEditPanel() {
    const ov = document.getElementById('editOverlay')
    ov.classList.remove('open')
    document.getElementById('editPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }

  function submitEditPanel() {
    document.getElementById('editForm').submit()
  }

  // ── Edit Note Panel ───────────────────────────────────────────────
  function openEditNotePanel(id, note) {
    document.getElementById('editNoteForm').action = '/admin/appointments/' + id + '/edit-note'
    document.getElementById('editNoteInput').value = note || ''
    const ov = document.getElementById('editNoteOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => { ov.classList.add('open') })
    document.getElementById('editNotePanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
    setTimeout(() => { document.getElementById('editNoteInput').focus() }, 220)
  }
  function closeEditNotePanel() {
    const ov = document.getElementById('editNoteOverlay')
    ov.classList.remove('open')
    document.getElementById('editNotePanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  function submitEditNotePanel() {
    document.getElementById('editNoteForm').submit()
  }

  // ── Complete Panel ────────────────────────────────────────────────
  function openCompletePanel(id) {
    document.getElementById('completeForm').action = '/admin/appointments/' + id + '/complete'
    document.getElementById('counselorNoteInput').value = ''
    const ov = document.getElementById('completeOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => { ov.classList.add('open') })
    document.getElementById('completePanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
    setTimeout(() => { document.getElementById('counselorNoteInput').focus() }, 220)
  }
  function closeCompletePanel() {
    const ov = document.getElementById('completeOverlay')
    ov.classList.remove('open')
    document.getElementById('completePanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  function submitCompletePanel() {
    const ta = document.getElementById('counselorNoteInput')
    if (!ta.value.trim()) { ta.focus(); return }
    document.getElementById('completeForm').submit()
  }

  lucide.createIcons()
</script>
</body>
</html>
