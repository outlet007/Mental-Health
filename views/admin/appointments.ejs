<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindWell Admin</title>
  <%- include('../partials/head') %>
  <style>
    .tbl { width:100%; border-collapse:collapse; }
    .tbl thead { background:#f8fafc; }
    .tbl th { padding:10px 14px; text-align:left; font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:.05em; border-bottom:1px solid #f1f5f9; white-space:nowrap; }
    .tbl td { padding:12px 14px; font-size:14px; color:#334155; border-bottom:1px solid #f8fafc; vertical-align:middle; }
    .tbl tbody tr:hover { background:#f8fafc; }
    .tbl tbody tr:last-child td { border-bottom:none; }
    .act-btn { display:inline-flex; align-items:center; gap:4px; padding:5px 10px; border-radius:8px; font-size:12px; font-weight:500; cursor:pointer; border:none; transition:all .15s; text-decoration:none; white-space:nowrap; }
    .ab-primary   { background:#05967e; color:#fff; }
    .ab-primary:hover   { background:#067866; }
    .ab-secondary { background:#fff; color:#05967e; border:1px solid #a0f3e1; }
    .ab-secondary:hover { background:#ecfdf9; }
    .ab-ghost     { background:transparent; color:#64748b; }
    .ab-ghost:hover     { background:#f1f5f9; }
    .ab-danger    { background:#ef4444; color:#fff; }
    .ab-danger:hover    { background:#dc2626; }
    .ab-warn      { background:#f59e0b; color:#fff; }
    .ab-warn:hover      { background:#d97706; }
    .panel-overlay { position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:40; display:none; backdrop-filter:blur(2px); opacity:0; transition:opacity .2s ease; }
    .panel-overlay.open { opacity:1; }
    .panel-drawer  { position:fixed; top:50%; left:50%; width:calc(100% - 48px); max-width:560px; max-height:90vh; background:#fff; border-radius:20px; box-shadow:0 20px 60px rgba(0,0,0,.18); z-index:50; display:flex; flex-direction:column; transform:translate(-50%,-50%) scale(.94); opacity:0; transition:transform .22s cubic-bezier(.34,1.56,.64,1), opacity .18s ease; pointer-events:none; }
    .panel-drawer.open { transform:translate(-50%,-50%) scale(1); opacity:1; pointer-events:auto; }
    .inp { width:100%; padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:13px; color:#334155; outline:none; font-family:inherit; box-sizing:border-box; }
    .inp:focus { border-color:#2dd4b4; box-shadow:0 0 0 3px rgba(45,212,180,.15); }
    .lbl { display:block; font-size:12px; font-weight:500; color:#64748b; margin-bottom:5px; }
    .counselor-card { display:flex; align-items:center; gap:10px; padding:12px; border:1.5px solid #e2e8f0; border-radius:12px; cursor:pointer; transition:all .15s; }
    .counselor-card:hover { border-color:#2dd4b4; background:#ecfdf9; }
    .counselor-card.selected { border-color:#05967e; background:#ecfdf9; }
    .slot-btn { padding:8px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:12px; font-weight:500; color:#334155; cursor:pointer; background:#fff; transition:all .15s; }
    .slot-btn:hover:not(:disabled) { border-color:#2dd4b4; background:#ecfdf9; color:#065f46; }
    .slot-btn.selected { border-color:#05967e; background:#05967e; color:#fff; }
    .slot-btn:disabled { opacity:.4; cursor:not-allowed; text-decoration:line-through; }
  </style>
</head>
<body style="background:#f8fafc; margin:0;">
<%- include('../partials/admin-sidebar') %>

<div style="margin-left:256px; min-height:100vh; display:flex; flex-direction:column;">

  <!-- Header -->
  <div style="height:56px; background:#fff; border-bottom:1px solid #f1f5f9; padding:0 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20;">
    <h1 style="font-size:15px; font-weight:600; color:#1e293b; margin:0;"><%= title %></h1>
    <span style="font-size:12px; color:#94a3b8;">
      <% const d=new Date(); %><%= d.toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %>
    </span>
  </div>

  <!-- Action Bar -->
  <div style="padding:14px 24px; background:#fff; border-bottom:2px solid #f1f5f9; display:flex; justify-content:flex-end;">
    <button onclick="openPanel()" style="display:inline-flex; align-items:center; gap:10px; padding:11px 22px; background:linear-gradient(135deg,#05967e,#06b6d4); color:#fff; border:none; border-radius:12px; font-size:14px; font-weight:600; cursor:pointer; box-shadow:0 2px 8px rgba(5,150,126,.30); transition:all .15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(5,150,126,.45)';this.style.transform='translateY(-1px)'" onmouseout="this.style.boxShadow='0 2px 8px rgba(5,150,126,.30)';this.style.transform='translateY(0)'">
      <i data-lucide="calendar-plus" style="width:18px;height:18px;"></i>
      + สร้างนัดหมาย
    </button>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.created) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#ecfdf9; border:1px solid #a0f3e1; border-radius:12px; color:#065f46; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> สร้างนัดหมายสำเร็จ
    </div>
    <% } if (query.error==='conflict') { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#fef2f2; border:1px solid #fca5a5; border-radius:12px; color:#991b1b; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> ช่วงเวลานี้ถูกจองแล้ว กรุณาเลือกเวลาอื่น
    </div>
    <% } if (query.updated) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#ecfeff; border:1px solid #a5f3fc; border-radius:12px; color:#155e75; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อัปเดตนัดหมายสำเร็จ
    </div>
    <% } if (query.deleted) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#fef2f2; border:1px solid #fca5a5; border-radius:12px; color:#991b1b; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="trash-2" style="width:16px;height:16px;flex-shrink:0;"></i> ลบนัดหมายแล้ว
    </div>
    <% } %>

    <!-- Filter -->
    <form method="GET" style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; padding:16px; margin-bottom:16px; display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end;">
      <div style="flex:1; min-width:200px;">
        <label class="lbl">ค้นหา</label>
        <div style="position:relative;">
          <i data-lucide="search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#94a3b8;"></i>
          <input name="search" value="<%= query.search||'' %>" class="inp" style="padding-left:32px;" placeholder="ชื่อผู้รับบริการ หรือนักให้คำปรึกษา">
        </div>
      </div>
      <div>
        <label class="lbl">นักให้คำปรึกษา</label>
        <select name="counselorId" class="inp" style="width:180px;">
          <option value="">ทั้งหมด</option>
          <% counselors.forEach(c => { %><option value="<%= c.id %>" <%=query.counselorId===c.id?'selected':''%>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="lbl">สถานะ</label>
        <select name="status" class="inp" style="width:140px;">
          <option value="">ทั้งหมด</option>
          <option value="pending"   <%=query.status==='pending'?'selected':''%>>รอยืนยัน</option>
          <option value="confirmed" <%=query.status==='confirmed'?'selected':''%>>ยืนยันแล้ว</option>
          <option value="completed" <%=query.status==='completed'?'selected':''%>>เสร็จสิ้น</option>
          <option value="cancelled" <%=query.status==='cancelled'?'selected':''%>>ยกเลิก</option>
        </select>
      </div>
      <div>
        <label class="lbl">รูปแบบ</label>
        <select name="type" class="inp" style="width:120px;">
          <option value="">ทั้งหมด</option>
          <option value="online" <%=query.type==='online'?'selected':''%>>ออนไลน์</option>
          <option value="onsite" <%=query.type==='onsite'?'selected':''%>>เข้ารับบริการด้วยตนเอง</option>
        </select>
      </div>
      <button type="submit" class="act-btn ab-primary">
        <i data-lucide="filter" style="width:13px;height:13px;"></i> กรอง
      </button>
      <a href="/admin/appointments" class="act-btn ab-ghost">ล้าง</a>
    </form>

    <!-- Table -->
    <div style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; overflow:hidden;">
      <div style="padding:14px 16px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:13px; font-weight:600; color:#334155;">รายการนัดหมาย</span>
        <span style="font-size:12px; color:#94a3b8;">ทั้งหมด <%= appointments.length %> รายการ</span>
      </div>
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th>ผู้รับบริการ</th>
              <th>นักให้คำปรึกษา</th>
              <th>วันที่ / เวลา</th>
              <th>รูปแบบ</th>
              <th>ระยะเวลา</th>
              <th>สถานะ</th>
              <th>การจัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% appointments.forEach(a => {
              const statusColor = {
                pending:   {bg:'#fef3c7', color:'#92400e'},
                confirmed: {bg:'#dbeafe', color:'#1e40af'},
                completed: {bg:'#d1fae5', color:'#065f46'},
                cancelled: {bg:'#fee2e2', color:'#991b1b'},
              }[a.status] || {bg:'#f1f5f9', color:'#64748b'}
              const statusLabel = {
                pending:'รอยืนยัน', confirmed:'ยืนยันแล้ว', completed:'เสร็จสิ้น', cancelled:'ยกเลิก'
              }[a.status] || a.status
            %>
            <tr>
              <td>
                <div style="font-weight:500; color:#1e293b; font-size:14px;"><%= a.clientName %></div>
              </td>
              <td>
                <div style="font-size:14px; color:#334155;"><%= a.counselorName %></div>
              </td>
              <td>
                <div style="font-size:14px; font-weight:500; color:#1e293b;"><%= a.date %></div>
                <div style="font-size:11px; color:#94a3b8;"><%= a.time %> น.</div>
              </td>
              <td>
                <% if(a.type==='online') { %>
                <div style="display:flex; align-items:center; gap:4px;">
                  <i data-lucide="video" style="width:13px;height:13px;color:#0891b2;"></i>
                  <span style="font-size:12px; color:#0891b2;">ออนไลน์</span>
                </div>
                <% } else { %>
                <div style="display:flex; align-items:center; gap:4px;">
                  <i data-lucide="map-pin" style="width:13px;height:13px;color:#05967e;"></i>
                  <span style="font-size:12px; color:#05967e;">เข้ารับบริการด้วยตนเอง</span>
                </div>
                <% } %>
              </td>
              <td style="font-size:12px; color:#64748b;"><%= a.duration %> นาที</td>
              <td>
                <span style="padding:3px 10px; background:<%= statusColor.bg %>; color:<%= statusColor.color %>; border-radius:99px; font-size:11px; font-weight:500;">
                  <%= statusLabel %>
                </span>
              </td>
              <td>
                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                  <%/* ดูข้อมูล — ทุก role เห็น */%>
                  <button data-apt="<%= JSON.stringify(a) %>" onclick="openViewPanel(JSON.parse(this.dataset.apt))" class="act-btn ab-ghost" title="ดูข้อมูล">
                    <i data-lucide="eye" style="width:13px;height:13px;"></i> ดูข้อมูล
                  </button>

                  <%/* แก้ไข — เฉพาะ admin */%>
                  <% if (userType !== 'counselor') { %>
                  <button data-apt="<%= JSON.stringify(a) %>" onclick="openEditPanel(JSON.parse(this.dataset.apt))" class="act-btn ab-secondary" title="แก้ไข">
                    <i data-lucide="pencil" style="width:13px;height:13px;"></i> แก้ไข
                  </button>
                  <% } %>

                  <%/* ยืนยัน — pending ทุก role */%>
                  <% if (a.status === 'pending') { %>
                  <form method="POST" action="/admin/appointments/<%= a.id %>/confirm" style="margin:0;">
                    <button type="submit" class="act-btn ab-primary">
                      <i data-lucide="check" style="width:12px;height:12px;"></i> ยืนยัน
                    </button>
                  </form>
                  <% } %>

                  <%/* ปฏิเสธ — pending ทุก role */%>
                  <% if (a.status === 'pending') { %>
                  <form method="POST" action="/admin/appointments/<%= a.id %>/cancel"
                        onsubmit="return confirm('ปฏิเสธนัดหมายนี้?')" style="margin:0;">
                    <button type="submit" class="act-btn ab-danger">
                      <i data-lucide="x" style="width:12px;height:12px;"></i> ปฏิเสธ
                    </button>
                  </form>
                  <% } %>

                  <%/* เสร็จสิ้น — เฉพาะ confirmed + counselor */%>
                  <% if (a.status === 'confirmed' && userType === 'counselor') { %>
                  <button onclick="openCompletePanel('<%= a.id %>')" class="act-btn ab-secondary">
                    <i data-lucide="check-check" style="width:12px;height:12px;"></i> เสร็จสิ้น
                  </button>
                  <% } %>

                  <%/* แก้ไขหมายเหตุ — เฉพาะ completed + counselor */%>
                  <% if (a.status === 'completed' && userType === 'counselor') { %>
                  <button data-id="<%= a.id %>" data-note="<%= a.counselorNote || '' %>" onclick="openEditNotePanel(this.dataset.id, this.dataset.note)" class="act-btn ab-warn" title="แก้ไขหมายเหตุการให้คำปรึกษา">
                    <i data-lucide="file-pen" style="width:12px;height:12px;"></i> แก้ไขหมายเหตุ
                  </button>
                  <% } %>

                  <%/* ลบ — เฉพาะ admin */%>
                  <% if (userType !== 'counselor') { %>
                  <form method="POST" action="/admin/appointments/<%= a.id %>/delete"
                        onsubmit="return confirm('ลบนัดหมายนี้ถาวร?')" style="margin:0;">
                    <button type="submit" class="act-btn ab-danger" title="ลบ">
                      <i data-lucide="trash-2" style="width:13px;height:13px;"></i>
                    </button>
                  </form>
                  <% } %>
                </div>
                <% if(a.note) { %>
                <div style="font-size:11px; color:#94a3b8; margin-top:3px; font-style:italic; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= a.note %>">
                  "<%= a.note %>"
                </div>
                <% } %>
              </td>
            </tr>
            <% }) %>
            <% if (appointments.length===0) { %>
            <tr><td colspan="8" style="text-align:center; padding:48px 16px; color:#94a3b8;">
              <i data-lucide="calendar-x" style="width:36px;height:36px;display:block;margin:0 auto 10px;opacity:.3;"></i>
              ไม่พบนัดหมายที่ตรงกับเงื่อนไข
            </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Overlay -->
<div id="overlay" class="panel-overlay" onclick="closePanel()"></div>

<!-- Slide-over: สร้างนัดหมาย -->
<div id="panel" class="panel-drawer">
  <div style="padding:16px 20px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:10px;">
      <div style="width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,#05967e,#06b6d4); display:flex; align-items:center; justify-content:center;">
        <i data-lucide="calendar-plus" style="width:15px;height:15px;color:#fff;"></i>
      </div>
      <div>
        <div style="font-size:14px; font-weight:600; color:#1e293b;">สร้างนัดหมายใหม่</div>
        <div style="font-size:11px; color:#94a3b8;">กรอกข้อมูลให้ครบทุกขั้นตอน</div>
      </div>
    </div>
    <button onclick="closePanel()" style="background:none; border:none; cursor:pointer; padding:6px; border-radius:8px; color:#94a3b8;">
      <i data-lucide="x" style="width:18px;height:18px;"></i>
    </button>
  </div>

  <div style="flex:1; overflow-y:auto;">
    <form method="POST" action="/admin/appointments/create" id="createForm">

      <!-- STEP 1 -->
      <div style="padding:20px; border-bottom:1px solid #f8fafc;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
          <div style="width:22px; height:22px; border-radius:50%; background:#05967e; color:#fff; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">1</div>
          <span style="font-size:13px; font-weight:600; color:#1e293b;">เลือกนักให้คำปรึกษา</span>
        </div>
        <div style="display:grid; gap:8px;" id="counselorList">
          <% counselors.forEach(c => { %>
          <label class="counselor-card" id="card_<%= c.id %>">
            <input type="radio" name="counselorId" value="<%= c.id %>"
                   data-duration="<%= c.sessionDuration %>" data-name="<%= c.name %>"
                   style="accent-color:#05967e;" onchange="onCounselorChange(this)" required>
            <div style="width:38px; height:38px; border-radius:10px; background:linear-gradient(135deg,#2dd4b4,#0ea5e9); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:13px; flex-shrink:0;">
              <%= c.avatar %>
            </div>
            <div style="flex:1; min-width:0;">
              <div style="font-weight:600; font-size:13px; color:#1e293b;"><%= c.name %></div>
              <div style="font-size:11px; color:#94a3b8;"><%= c.title %></div>
              <div style="display:flex; flex-wrap:wrap; gap:3px; margin-top:4px;">
                <% c.specialties.slice(0,2).forEach(s => { %>
                <span style="padding:1px 8px; background:#dbeafe; color:#1e40af; border-radius:99px; font-size:10px;"><%= s %></span>
                <% }) %>
              </div>
            </div>
            <div style="text-align:right; flex-shrink:0;">
              <div style="font-size:12px; color:#94a3b8;"><%= c.sessionDuration %> นาที/ครั้ง</div>
            </div>
          </label>
          <% }) %>
        </div>
      </div>

      <!-- STEP 2 -->
      <div style="padding:20px; border-bottom:1px solid #f8fafc;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
          <div style="width:22px; height:22px; border-radius:50%; background:#05967e; color:#fff; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">2</div>
          <span style="font-size:13px; font-weight:600; color:#1e293b;">เลือกวันที่และเวลา</span>
        </div>

        <div style="margin-bottom:14px;">
          <label class="lbl">วันที่นัดหมาย</label>
          <input type="date" name="date" id="dateInput"
                 min="<%= new Date().toISOString().split('T')[0] %>"
                 class="inp" onchange="loadSlots()" required disabled>
          <div id="dateHint" style="font-size:11px; color:#94a3b8; margin-top:5px;">
            กรุณาเลือกนักให้คำปรึกษาก่อน
          </div>
        </div>

        <div id="availableDays" style="display:none; margin-bottom:14px;">
          <div style="font-size:11px; font-weight:500; color:#64748b; margin-bottom:6px;">วันที่เปิดรับนัด</div>
          <div id="dayBadges" style="display:flex; flex-wrap:wrap; gap:6px;"></div>
        </div>

        <div id="slotLoading" style="display:none; font-size:13px; color:#94a3b8; padding:8px 0;">
          กำลังโหลดช่วงเวลา...
        </div>

        <div id="slotSection" style="display:none;">
          <label class="lbl">เลือกเวลา *</label>
          <div id="slotGrid" style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:6px;"></div>
          <input type="hidden" name="time" id="timeInput" required>
          <div id="slotMsg" style="display:none; font-size:11px; color:#94a3b8; margin-top:6px;"></div>
        </div>
      </div>

      <!-- STEP 3 -->
      <div style="padding:20px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
          <div style="width:22px; height:22px; border-radius:50%; background:#05967e; color:#fff; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0;">3</div>
          <span style="font-size:13px; font-weight:600; color:#1e293b;">ข้อมูลเพิ่มเติม</span>
        </div>

        <div style="display:grid; gap:14px;">
          <div>
            <label class="lbl">ผู้รับบริการ *</label>
            <select name="clientId" class="inp" required>
              <option value="">— เลือกผู้รับบริการ —</option>
              <% clients.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %> (<%= c.email %>)</option>
              <% }) %>
            </select>
          </div>

          <div>
