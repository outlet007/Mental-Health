<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindCare Admin</title>
  <%- include('../partials/head') %>
  <style>
    .inp{width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;color:#334155;outline:none;font-family:inherit;box-sizing:border-box;background:#fff}.inp:focus{border-color:#2dd4b4;box-shadow:0 0 0 3px rgba(45,212,180,.15)}.lbl{display:block;font-size:12px;font-weight:600;color:#64748b;margin-bottom:5px}.section-card{background:#fff;border:1px solid #f1f5f9;border-radius:16px;padding:24px;margin-bottom:24px}.section-title{font-size:14px;font-weight:700;color:#1e293b;display:flex;align-items:center;gap:8px;margin-bottom:20px;padding-bottom:14px;border-bottom:1px solid #f1f5f9}.act-btn{display:inline-flex;align-items:center;gap:5px;padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;border:none;transition:all .15s;white-space:nowrap}.ab-primary{background:#05967e;color:#fff}.ab-primary:hover{background:#067866}.lang-toggle{display:flex;border:1.5px solid #e2e8f0;border-radius:8px;overflow:hidden;margin-left:auto;flex-shrink:0}.lang-btn{padding:4px 14px;font-size:12px;font-weight:800;border:none;cursor:pointer;transition:all .15s;letter-spacing:.02em}.lang-btn-active{background:#05967e;color:#fff}.lang-btn-inactive{background:transparent;color:#94a3b8}.lang-badge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;padding:2px 8px;border-radius:9999px;margin-left:8px}.lang-badge-th{background:#fff3cd;color:#7c5500;border:1px solid #fde68a}.lang-badge-en{background:#dbeafe;color:#1d4ed8;border:1px solid #93c5fd}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.registration-layout{display:grid;gap:16px}.form-frame{border:1px solid #e2e8f0;border-radius:14px;background:#fff;padding:16px;box-shadow:0 1px 2px rgba(15,23,42,.03)}.form-frame-soft{background:#f8fafc}.form-frame-header{display:flex;align-items:flex-start;gap:10px;margin-bottom:14px}.form-frame-icon{width:30px;height:30px;border-radius:10px;background:#ecfdf9;color:#05967e;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto}.form-frame-title{font-size:13px;font-weight:800;color:#1e293b;margin:0 0 2px}.form-frame-note{font-size:12px;color:#94a3b8;margin:0;line-height:1.45}.public-form-shape{border:1px solid #d9f5ef;border-radius:18px;background:linear-gradient(180deg,#ffffff,#f8fffd);padding:16px;display:grid;gap:14px}.public-form-heading-frame{border:1px solid #e2e8f0;border-radius:14px;background:#fff;padding:14px}.form-group-title{font-size:12px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;margin:0 0 12px}.option-list{display:grid;gap:8px}.option-row{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center}.option-row.is-dragging{opacity:.55}.drag-handle{width:36px;height:36px;border:1px solid #e2e8f0;border-radius:10px;background:#f8fafc;color:#64748b;display:inline-flex;align-items:center;justify-content:center;cursor:grab}.drag-handle:active{cursor:grabbing}.drag-handle:hover{background:#ecfdf9;color:#05967e;border-color:#a0f3e1}.icon-btn{width:36px;height:36px;border:1px solid #e2e8f0;border-radius:10px;background:#fff;color:#94a3b8;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s}.icon-btn:hover{background:#fef2f2;color:#ef4444;border-color:#fecaca}.ab-ghost{background:#fff;color:#05967e;border:1px solid #a0f3e1}.ab-ghost:hover{background:#ecfdf9}@media(max-width:768px){.admin-main{margin-left:0!important}.field-grid{grid-template-columns:1fr}.section-card{padding:18px}.form-frame{padding:14px}}
  </style>
</head>
<body style="background:#f8fafc;margin:0;">
<%- include('../partials/admin-sidebar') %>
<%
  const en = content.en || {}
  const book = content.book || {}
  const enBook = en.book || {}
  const savedKey = query.saved || ''
  const autoEnRegistration = savedKey === 'en'
  const concernDefaults = ['ความวิตกกังวล / ความเครียด', 'ภาวะซึมเศร้า', 'ปัญหาความสัมพันธ์', 'ปัญหาครอบครัว', 'ความเศร้าโศก / การสูญเสีย', 'อื่นๆ']
  const enConcernDefaults = ['Anxiety / Stress', 'Depression', 'Relationship Issues', 'Family Problems', 'Grief / Loss', 'Other']
  const concernItems = Array.isArray(book.concernOptions) && book.concernOptions.length ? book.concernOptions : concernDefaults
  const enConcernItems = Array.isArray(enBook.concernOptions) && enBook.concernOptions.length ? enBook.concernOptions : enConcernDefaults
  const formTexts = book.formTexts || {}
  const enFormTexts = enBook.formTexts || {}
  function val(obj, key, fallback) { return obj[key] || fallback }
  function isWideField(key) { return ['successText', 'typeLabel', 'pdpaHeading', 'pdpaText'].includes(key) }
  const thFields = [
    ['successHeading', 'หัวข้อเมื่อส่งคำขอสำเร็จ', 'ส่งคำขอสำเร็จแล้ว!'],
    ['successText', 'ข้อความเมื่อส่งคำขอสำเร็จ', 'ทีมงานจะติดต่อกลับหาคุณภายใน 1 วันทำการ<br>ขอบคุณที่ไว้วางใจ MindCare'],
    ['nameLabel', 'Label: ชื่อ-นามสกุล', 'ชื่อ-นามสกุล'],
    ['namePlaceholder', 'Placeholder: ชื่อ-นามสกุล', 'กรอกชื่อของคุณ'],
    ['studentIdLabel', 'Label: รหัสนักศึกษา', 'รหัสนักศึกษา'],
    ['studentIdPlaceholder', 'Placeholder: รหัสนักศึกษา', 'เช่น 1680123456'],
    ['phoneLabel', 'Label: เบอร์โทรศัพท์', 'เบอร์โทรศัพท์'],
    ['phonePlaceholder', 'Placeholder: เบอร์โทรศัพท์', '08X-XXX-XXXX'],
    ['emailLabel', 'Label: อีเมล', 'อีเมล'],
    ['emailPlaceholder', 'Placeholder: อีเมล', 'your@email.com'],
    ['concernLabel', 'Label: เรื่องที่ต้องการความช่วยเหลือ', 'คุณต้องการความช่วยเหลือเรื่องอะไร?'],
    ['typeLabel', 'Label: รูปแบบที่ต้องการ', 'รูปแบบที่ต้องการ'],
    ['onlineLabel', 'ตัวเลือก: ออนไลน์', 'ออนไลน์'],
    ['onsiteLabel', 'ตัวเลือก: เข้ารับบริการด้วยตนเอง', 'เข้ารับบริการด้วยตนเอง'],
    ['pdpaHeading', 'หัวข้อ PDPA', 'การยินยอมเปิดเผยข้อมูล'],
    ['pdpaText', 'ข้อความ PDPA', 'ข้าพเจ้า ตกลงและยินยอมให้มหาวิทยาลัยเก็บรวบรวม ใช้ ประมวลผล และเปิดเผยข้อมูลส่วนบุคคลของข้าพเจ้า ทั้งที่ปรากฏในเอกสารฉบับนี้ หรือที่มหาวิทยาลัยรวบรวมจากบุคคลอื่น เพื่อวัตถุประสงค์ในการนัดพบแพทย์ หรือเพื่อใช้ประโยชน์ในกิจการของมหาวิทยาลัย ทั้งนี้ข้าพเจ้ารับทราบ ตกลงและยินยอมว่า มหาวิทยาลัยมีสิทธิ์เก็บรวบรวม ใช้ประมวลผลและเปิดเผยข้อมูลส่วนบุคคลของข้าพเจ้า โดยเป็นไปตามนโยบายคุ้มครองข้อมูลส่วนบุคคลของมหาวิทยาลัย ที่ประกาศใช้ในปัจจุบันหรืออาจเปลี่ยนแปลงแก้ไขในภายหลัง รายละเอียดปรากฏตาม นโยบายคุ้มครองข้อมูลส่วนบุคคล ในเว็บไซต์'],
    ['pdpaCheckbox', 'ข้อความ checkbox PDPA', 'ข้าพเจ้าได้อ่านและยอมรับการยินยอมเปิดเผยข้อมูลแล้ว'],
    ['submitLabel', 'ข้อความปุ่มส่งฟอร์ม', 'ส่งคำขอจองนัดหมาย'],
  ]
  const enFields = [
    ['successHeading', 'Success heading', 'Request Sent Successfully!'],
    ['successText', 'Success text', 'Our team will contact you within 1 business day.<br>Thank you for trusting MindCare.'],
    ['nameLabel', 'Label: Full name', 'Full Name'],
    ['namePlaceholder', 'Placeholder: Full name', 'Enter your name'],
    ['studentIdLabel', 'Label: Student ID', 'Student ID'],
    ['studentIdPlaceholder', 'Placeholder: Student ID', 'e.g. 1680123456'],
    ['phoneLabel', 'Label: Phone number', 'Phone Number'],
    ['phonePlaceholder', 'Placeholder: Phone number', '08X-XXX-XXXX'],
    ['emailLabel', 'Label: Email', 'Email'],
    ['emailPlaceholder', 'Placeholder: Email', 'your@email.com'],
    ['concernLabel', 'Label: Concern', 'What would you like help with?'],
    ['typeLabel', 'Label: Preferred format', 'Preferred Format'],
    ['onlineLabel', 'Option: Online', 'Online'],
    ['onsiteLabel', 'Option: In person', 'In-person'],
    ['pdpaHeading', 'PDPA heading', 'Data Disclosure Consent'],
    ['pdpaText', 'PDPA text', "I agree and consent to the University collecting, using, processing, and disclosing my personal information — both appearing in this document and gathered from other persons — for the purpose of scheduling medical appointments or for University operations. I acknowledge that the University has the right to collect, use, process, and disclose my personal data in accordance with the University's Personal Data Protection Policy as currently published or as may be amended in the future. Details are available in the Personal Data Protection Policy on the website."],
    ['pdpaCheckbox', 'PDPA checkbox text', 'I have read and accept the data disclosure consent.'],
    ['submitLabel', 'Submit button text', 'Submit Registration Request'],
  ]
%>
<div class="admin-main" style="margin-left:256px;min-height:100vh;display:flex;flex-direction:column;">
  <div style="height:56px;background:#fff;border-bottom:1px solid #f1f5f9;padding:0 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20;">
    <h1 style="font-size:15px;font-weight:700;color:#1e293b;margin:0;"><%= title %></h1>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:12px;color:#94a3b8;"><%= new Date().toLocaleDateString('th-TH',{year:'numeric',month:'long',day:'numeric'}) %></span>
      <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;border-radius:8px;border:1px solid #e2e8f0;background:#f8fafc;font-size:12px;font-weight:500;color:#334155;text-decoration:none;transition:background .15s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#f8fafc'">
        <i data-lucide="external-link" style="width:13px;height:13px;"></i> ดูหน้าเว็บไซต์
      </a>
    </div>
  </div>
  <main style="padding:24px;max-width:1120px;width:100%;box-sizing:border-box;">
    <% if (query.saved) { %>
    <div style="margin-bottom:20px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:12px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="check-circle" style="width:16px;height:16px;"></i> บันทึกการเปลี่ยนแปลงสำเร็จ</div>
    <% } %>
    <div class="section-card">
      <div class="section-title">
        <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#05967e,#06b6d4);display:flex;align-items:center;justify-content:center;"><i data-lucide="clipboard-list" style="width:14px;height:14px;color:#fff;"></i></div>
        ลงทะเบียนขอรับบริการ — จัดการฟอร์ม
        <div class="lang-toggle">
          <button type="button" class="lang-btn <%= autoEnRegistration ? 'lang-btn-inactive' : 'lang-btn-active' %>" id="registration-btn-th" onclick="cardLang('registration','th')">TH</button>
          <button type="button" class="lang-btn <%= autoEnRegistration ? 'lang-btn-active' : 'lang-btn-inactive' %>" id="registration-btn-en" onclick="cardLang('registration','en')">EN</button>
        </div>
      </div>
      <div id="registration-th" style="display:<%= autoEnRegistration ? 'none' : '' %>;">
        <form method="POST" action="/admin/registration-form" style="display:grid;gap:14px;">
          <div class="registration-layout" data-registration-layout="th">
            <div class="form-frame form-frame-soft" data-layout-frame="registration-section-copy-th">
              <div class="form-frame-header">
                <div class="form-frame-icon"><i data-lucide="type" style="width:15px;height:15px;"></i></div>
                <div>
                  <p class="form-frame-title">ส่วนหัวบนหน้าเว็บ</p>
                  <p class="form-frame-note">แยกหัวข้อและคำอธิบายที่แสดงอยู่เหนือกล่องฟอร์มบนหน้าเว็บ</p>
                </div>
              </div>
              <div class="field-grid">
                <div><label class="lbl">หัวข้อ section <span class="lang-badge lang-badge-th">ภาษาไทย</span></label><input type="text" name="bookHeading" class="inp" value="<%= book.heading || '' %>"></div>
                <div><label class="lbl">คำอธิบายใต้หัวข้อ section</label><textarea name="bookSubtext" class="inp" rows="2" style="resize:vertical;"><%= book.subtext || '' %></textarea></div>
              </div>
            </div>
            <div class="public-form-shape" data-layout-frame="registration-public-form-th">
              <div class="public-form-heading-frame" data-layout-frame="registration-form-heading-th">
                <div class="form-frame-header">
                  <div class="form-frame-icon"><i data-lucide="file-text" style="width:15px;height:15px;"></i></div>
                  <div>
                    <p class="form-frame-title">หัวข้อในกล่องฟอร์ม</p>
                    <p class="form-frame-note">ส่วนนี้ตรงกับหัวข้อด้านบนของ form บนหน้าเว็บ</p>
                  </div>
                </div>
                <label class="lbl">หัวข้อในกล่องฟอร์ม</label><input type="text" name="bookFormHeading" class="inp" value="<%= book.formHeading || '' %>">
              </div>
              <div class="form-frame" data-layout-frame="registration-form-fields-th">
                <div class="form-frame-header">
                  <div class="form-frame-icon"><i data-lucide="panel-top" style="width:15px;height:15px;"></i></div>
                  <div>
                    <p class="form-frame-title">ข้อความภายในฟอร์ม</p>
                    <p class="form-frame-note">Labels, placeholders, สถานะสำเร็จ/ผิดพลาด, PDPA และปุ่มส่งฟอร์ม</p>
                  </div>
                </div>
                <div class="field-grid">
            <% thFields.forEach(([key, label, fallback]) => { %>
              <div style="<%= isWideField(key) ? 'grid-column:1/-1;' : '' %>">
                <label class="lbl"><%= label %></label>
                <% if (key === 'successText' || key === 'pdpaText') { %>
                  <textarea name="formText_<%= key %>" class="inp" rows="<%= key === 'pdpaText' ? 5 : 2 %>" style="resize:vertical;"><%= val(formTexts, key, fallback) %></textarea>
                <% } else { %>
                  <input type="text" name="formText_<%= key %>" class="inp" value="<%= val(formTexts, key, fallback) %>">
                <% } %>
              </div>
              <% if (key === 'concernLabel') { %>
              <div class="form-frame" data-layout-frame="registration-concern-options-th" style="grid-column:1/-1;">
                <div class="form-frame-header">
                  <div class="form-frame-icon"><i data-lucide="list-plus" style="width:15px;height:15px;"></i></div>
                  <div>
                    <p class="form-frame-title">Dropdown: คุณต้องการความช่วยเหลือเรื่องอะไร?</p>
                    <p class="form-frame-note">จัดลำดับตัวเลือกตามที่ผู้รับบริการจะเห็นใน form</p>
                  </div>
                </div>
          <div id="registration-concern-list-th" class="option-list">
            <% concernItems.forEach((item, idx) => { %>
              <div class="option-row" data-option-row="bookConcernOption" data-drag-row="bookConcernOption" draggable="true" ondragstart="handleConcernDragStart(event)" ondragover="handleConcernDragOver(event)" ondrop="handleConcernDrop(event)" ondragend="handleConcernDragEnd(event)">
                <button type="button" class="drag-handle" data-drag-handle="true" aria-label="ลากเพื่อสลับลำดับ"><i data-lucide="grip-vertical" style="width:16px;height:16px;"></i></button>
                <input type="text" name="bookConcernOption" class="inp" value="<%= item %>" placeholder="ตัวเลือกข้อ <%= idx + 1 %>">
                <button type="button" class="icon-btn" aria-label="ลบตัวเลือก" onclick="removeConcernOption(this)"><i data-lucide="trash-2" style="width:15px;height:15px;"></i></button>
              </div>
            <% }) %>
          </div>
          <button type="button" class="act-btn ab-ghost" onclick="addConcernOption('registration-concern-list-th','bookConcernOption','ตัวเลือกข้อ')"><i data-lucide="plus" style="width:14px;height:14px;"></i> เพิ่มตัวเลือก</button>
              </div>
              <% } %>
            <% }) %>
          </div>
              </div>
            </div>
          </div>
          <div style="display:flex;justify-content:flex-end;"><button type="submit" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> บันทึกฟอร์ม (TH)</button></div>
        </form>
      </div>
      <div id="registration-en" style="display:<%= autoEnRegistration ? '' : 'none' %>;">
        <form method="POST" action="/admin/registration-form/en" style="display:grid;gap:14px;">
          <div class="registration-layout" data-registration-layout="en">
            <div class="form-frame form-frame-soft" data-layout-frame="registration-section-copy-en">
              <div class="form-frame-header">
                <div class="form-frame-icon"><i data-lucide="type" style="width:15px;height:15px;"></i></div>
                <div>
                  <p class="form-frame-title">Website section copy</p>
                  <p class="form-frame-note">Separate the public heading and description that appear above the form card.</p>
                </div>
              </div>
              <div class="field-grid">
                <div><label class="lbl">Section heading <span class="lang-badge lang-badge-en">English</span></label><input type="text" name="bookHeading" class="inp" value="<%= enBook.heading || '' %>"></div>
                <div><label class="lbl">Section description</label><textarea name="bookSubtext" class="inp" rows="2" style="resize:vertical;"><%= enBook.subtext || '' %></textarea></div>
              </div>
            </div>
            <div class="public-form-shape" data-layout-frame="registration-public-form-en">
              <div class="public-form-heading-frame" data-layout-frame="registration-form-heading-en">
                <div class="form-frame-header">
                  <div class="form-frame-icon"><i data-lucide="file-text" style="width:15px;height:15px;"></i></div>
                  <div>
                    <p class="form-frame-title">Form card heading</p>
                    <p class="form-frame-note">This matches the heading shown at the top of the public form card.</p>
                  </div>
                </div>
                <label class="lbl">Form heading</label><input type="text" name="bookFormHeading" class="inp" value="<%= enBook.formHeading || '' %>">
              </div>
              <div class="form-frame" data-layout-frame="registration-form-fields-en">
                <div class="form-frame-header">
                  <div class="form-frame-icon"><i data-lucide="panel-top" style="width:15px;height:15px;"></i></div>
                  <div>
                    <p class="form-frame-title">Form text</p>
                    <p class="form-frame-note">Labels, placeholders, success/error states, PDPA copy, and submit button text.</p>
                  </div>
                </div>
                <div class="field-grid">
            <% enFields.forEach(([key, label, fallback]) => { %>
              <div style="<%= isWideField(key) ? 'grid-column:1/-1;' : '' %>">
                <label class="lbl"><%= label %></label>
                <% if (key === 'successText' || key === 'pdpaText') { %>
                  <textarea name="formText_<%= key %>" class="inp" rows="<%= key === 'pdpaText' ? 5 : 2 %>" style="resize:vertical;"><%= val(enFormTexts, key, fallback) %></textarea>
                <% } else { %>
                  <input type="text" name="formText_<%= key %>" class="inp" value="<%= val(enFormTexts, key, fallback) %>">
                <% } %>
              </div>
              <% if (key === 'concernLabel') { %>
              <div class="form-frame" data-layout-frame="registration-concern-options-en" style="grid-column:1/-1;">
                <div class="form-frame-header">
                  <div class="form-frame-icon"><i data-lucide="list-plus" style="width:15px;height:15px;"></i></div>
                  <div>
                    <p class="form-frame-title">Dropdown: What would you like help with?</p>
                    <p class="form-frame-note">Order the options exactly as service users will see them.</p>
                  </div>
                </div>
          <div id="registration-concern-list-en" class="option-list">
            <% enConcernItems.forEach((item, idx) => { %>
              <div class="option-row" data-option-row="bookConcernOptionEn" data-drag-row="bookConcernOptionEn" draggable="true" ondragstart="handleConcernDragStart(event)" ondragover="handleConcernDragOver(event)" ondrop="handleConcernDrop(event)" ondragend="handleConcernDragEnd(event)">
                <button type="button" class="drag-handle" data-drag-handle="true" aria-label="Drag to reorder"><i data-lucide="grip-vertical" style="width:16px;height:16px;"></i></button>
                <input type="text" name="bookConcernOptionEn" class="inp" value="<%= item %>" placeholder="Option <%= idx + 1 %>">
                <button type="button" class="icon-btn" aria-label="Remove option" onclick="removeConcernOption(this)"><i data-lucide="trash-2" style="width:15px;height:15px;"></i></button>
              </div>
            <% }) %>
          </div>
          <button type="button" class="act-btn ab-ghost" onclick="addConcernOption('registration-concern-list-en','bookConcernOptionEn','Option')"><i data-lucide="plus" style="width:14px;height:14px;"></i> Add option</button>
              </div>
              <% } %>
            <% }) %>
          </div>
              </div>
            </div>
          </div>
          <div style="display:flex;justify-content:flex-end;"><button type="submit" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> Save form (EN)</button></div>
        </form>
      </div>
    </div>
  </main>
</div>
<script>
function cardLang(section, lang) {
  ['th', 'en'].forEach(l => {
    const panel = document.getElementById(section + '-' + l)
    const btn = document.getElementById(section + '-btn-' + l)
    if (panel) panel.style.display = (l === lang) ? '' : 'none'
    if (btn) btn.className = 'lang-btn ' + (l === lang ? 'lang-btn-active' : 'lang-btn-inactive')
  })
}
function addConcernOption(listId, inputName, placeholderPrefix) {
  const list = document.getElementById(listId)
  const row = document.createElement('div')
  const nextIndex = list.querySelectorAll('[data-option-row]').length + 1
  row.className = 'option-row'
  row.setAttribute('data-option-row', inputName)
  row.setAttribute('data-drag-row', inputName)
  row.setAttribute('draggable', 'true')
  row.setAttribute('ondragstart', 'handleConcernDragStart(event)')
  row.setAttribute('ondragover', 'handleConcernDragOver(event)')
  row.setAttribute('ondrop', 'handleConcernDrop(event)')
  row.setAttribute('ondragend', 'handleConcernDragEnd(event)')
  row.innerHTML = '<button type="button" class="drag-handle" data-drag-handle="true" aria-label="Drag to reorder"><i data-lucide="grip-vertical" style="width:16px;height:16px;"></i></button>' +
    '<input type="text" name="' + inputName + '" class="inp" value="" placeholder="' + placeholderPrefix + ' ' + nextIndex + '">' +
    '<button type="button" class="icon-btn" aria-label="Remove option" onclick="removeConcernOption(this)"><i data-lucide="trash-2" style="width:15px;height:15px;"></i></button>'
  list.appendChild(row)
  const input = row.querySelector('input')
  if (input) input.focus()
  lucide.createIcons()
}
function removeConcernOption(button) {
  const row = button.closest('[data-option-row]')
  if (row) row.remove()
}
let draggedConcernRow = null
function handleConcernDragStart(event) {
  draggedConcernRow = event.currentTarget
  draggedConcernRow.classList.add('is-dragging')
  event.dataTransfer.effectAllowed = 'move'
  event.dataTransfer.setData('text/plain', draggedConcernRow.getAttribute('data-drag-row') || '')
}
function handleConcernDragOver(event) {
  event.preventDefault()
  event.dataTransfer.dropEffect = 'move'
}
function handleConcernDrop(event) {
  event.preventDefault()
  const targetRow = event.currentTarget
  moveConcernRow(draggedConcernRow, targetRow)
}
function handleConcernDragEnd(event) {
  event.currentTarget.classList.remove('is-dragging')
  draggedConcernRow = null
}
function moveConcernRow(sourceRow, targetRow) {
  if (!sourceRow || !targetRow || sourceRow === targetRow) return
  if (sourceRow.parentElement !== targetRow.parentElement) return
  const rows = Array.from(targetRow.parentElement.querySelectorAll('[data-drag-row]'))
  const sourceIndex = rows.indexOf(sourceRow)
  const targetIndex = rows.indexOf(targetRow)
  if (sourceIndex < targetIndex) {
    targetRow.after(sourceRow)
  } else {
    targetRow.before(sourceRow)
  }
}
lucide.createIcons()
</script>
</body>
</html>
