        <label class="lbl">&#x0E02;&#x0E49;&#x0E2D;&#x0E04;&#x0E27;&#x0E32;&#x0E21;&#x0E41;&#x0E08;&#x0E49;&#x0E07;&#x0E1C;&#x0E39;&#x0E49;&#x0E23;&#x0E31;&#x0E1A;&#x0E1A;&#x0E23;&#x0E34;&#x0E01;&#x0E32;&#x0E23; (&#x0E44;&#x0E17;&#x0E22;)</label>
        <label class="lbl">Client notice text (English)</label>
