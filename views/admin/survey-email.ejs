  <div style="padding:16px 24px;border-top:1px solid #f1f5f9;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;">
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <button type="submit" form="tplForm" id="tplPreviewBtn" class="act-btn ab-secondary"><i data-lucide="eye" style="width:14px;height:14px;"></i> ดูตัวอย่าง</button>
      <button type="submit" form="tplForm" id="tplPreviewOnlineBtn" class="act-btn ab-secondary" style="display:none;"><i data-lucide="eye" style="width:14px;height:14px;"></i> ดูตัวอย่าง (ออนไลน์)</button>
      <button type="submit" form="tplForm" id="tplPreviewPhoneBtn" class="act-btn ab-secondary" style="display:none;"><i data-lucide="eye" style="width:14px;height:14px;"></i> &#x0E14;&#x0E39;&#x0E15;&#x0E31;&#x0E27;&#x0E2D;&#x0E22;&#x0E48;&#x0E32;&#x0E07; (&#x0E42;&#x0E17;&#x0E23;&#x0E28;&#x0E31;&#x0E1E;&#x0E17;&#x0E4C;)</button>
      <button type="submit" form="tplForm" id="tplPreviewOnsiteBtn" class="act-btn ab-secondary" style="display:none;"><i data-lucide="eye" style="width:14px;height:14px;"></i> ดูตัวอย่าง (เข้ารับบริการ)</button>
    </div>
    <button type="submit" form="tplForm" id="tplSaveBtn" class="act-btn ab-primary"><i data-lucide="save" style="width:14px;height:14px;"></i> บันทึกข้อความ</button>
  </div>
</div>
<script>
  var TYPES_WITH_CLOSING_VARIANTS = <%- JSON.stringify(typesWithClosingVariants) %>
  var TYPES_WITH_ACCESS_DETAILS = <%- JSON.stringify(typesWithAccessDetails) %>
  var ACCESS_DETAIL_FIELDS = {
    online_title: 'onlineTitle',
    online_link_label: 'onlineLinkLabel',
    phone_title: 'phoneTitle',
    phone_counselor_phone_label: 'phoneCounselorPhoneLabel',
    phone_client_notice_label: 'phoneClientNoticeLabel',
    phone_client_notice_text: 'phoneClientNoticeText'
  }

  function fillAccessDetailFields(tpl, defaults) {
    Object.keys(ACCESS_DETAIL_FIELDS).forEach(function(field) {
      var key = ACCESS_DETAIL_FIELDS[field]
      ;['th', 'en'].forEach(function(lang) {
        var input = document.getElementById('tpl_access_' + field + '_' + lang)
        input.value = (tpl.accessDetails && tpl.accessDetails[lang] && tpl.accessDetails[lang][key]) || ''
        input.placeholder = (defaults.accessDetails && defaults.accessDetails[lang] && defaults.accessDetails[lang][key]) || ''
      })
    })
  }

  function openTplPanel(type, label, tpl, defaults) {
    document.getElementById('tplPanelTitle').textContent = 'แก้ไขข้อความ: ' + label
    document.getElementById('tplForm').action = '/admin/survey-email/templates/' + type
    document.getElementById('tpl_title').value = (tpl.title && tpl.title.th) || ''
    document.getElementById('tpl_greeting_th').value = (tpl.greeting && tpl.greeting.th) || ''
    document.getElementById('tpl_greeting_en').value = (tpl.greeting && tpl.greeting.en) || ''
    document.getElementById('tpl_title').placeholder = (defaults.title && defaults.title.th) || ''
    document.getElementById('tpl_greeting_th').placeholder = (defaults.greeting && defaults.greeting.th) || ''
    document.getElementById('tpl_greeting_en').placeholder = (defaults.greeting && defaults.greeting.en) || ''

    var isVariant = TYPES_WITH_CLOSING_VARIANTS.indexOf(type) !== -1
    var hasAccessDetails = TYPES_WITH_ACCESS_DETAILS.indexOf(type) !== -1
    var useAppointmentPreviews = isVariant || hasAccessDetails
    document.getElementById('tpl_closing_simple').style.display = isVariant ? 'none' : 'block'
    document.getElementById('tpl_closing_variant').style.display = isVariant ? 'block' : 'none'
    document.getElementById('tpl_access_details').style.display = hasAccessDetails ? 'block' : 'none'
    document.getElementById('tplPreviewBtn').style.display = useAppointmentPreviews ? 'none' : 'inline-flex'
    document.getElementById('tplPreviewOnlineBtn').style.display = useAppointmentPreviews ? 'inline-flex' : 'none'
    document.getElementById('tplPreviewPhoneBtn').style.display = useAppointmentPreviews ? 'inline-flex' : 'none'
    document.getElementById('tplPreviewOnsiteBtn').style.display = useAppointmentPreviews ? 'inline-flex' : 'none'
    if (hasAccessDetails) fillAccessDetailFields(tpl, defaults)

    if (isVariant) {
      document.getElementById('tpl_closing_online_th').value = (tpl.closing && tpl.closing.th && tpl.closing.th.online) || ''
      document.getElementById('tpl_closing_online_en').value = (tpl.closing && tpl.closing.en && tpl.closing.en.online) || ''
      document.getElementById('tpl_closing_phone_th').value = (tpl.closing && tpl.closing.th && tpl.closing.th.phone) || ''
      document.getElementById('tpl_closing_phone_en').value = (tpl.closing && tpl.closing.en && tpl.closing.en.phone) || ''
      document.getElementById('tpl_closing_onsite_th').value = (tpl.closing && tpl.closing.th && tpl.closing.th.onsite) || ''
      document.getElementById('tpl_closing_onsite_en').value = (tpl.closing && tpl.closing.en && tpl.closing.en.onsite) || ''
      document.getElementById('tpl_closing_online_th').placeholder = (defaults.closing && defaults.closing.th && defaults.closing.th.online) || ''
      document.getElementById('tpl_closing_online_en').placeholder = (defaults.closing && defaults.closing.en && defaults.closing.en.online) || ''
      document.getElementById('tpl_closing_phone_th').placeholder = (defaults.closing && defaults.closing.th && defaults.closing.th.phone) || ''
      document.getElementById('tpl_closing_phone_en').placeholder = (defaults.closing && defaults.closing.en && defaults.closing.en.phone) || ''
      document.getElementById('tpl_closing_onsite_th').placeholder = (defaults.closing && defaults.closing.th && defaults.closing.th.onsite) || ''
      document.getElementById('tpl_closing_onsite_en').placeholder = (defaults.closing && defaults.closing.en && defaults.closing.en.onsite) || ''
      document.getElementById('tplPreviewOnlineBtn').setAttribute('formaction', '/admin/survey-email/preview/' + type + '?apptType=online')
      document.getElementById('tplPreviewOnlineBtn').setAttribute('formtarget', '_blank')
      document.getElementById('tplPreviewPhoneBtn').setAttribute('formaction', '/admin/survey-email/preview/' + type + '?apptType=phone')
      document.getElementById('tplPreviewPhoneBtn').setAttribute('formtarget', '_blank')
      document.getElementById('tplPreviewOnsiteBtn').setAttribute('formaction', '/admin/survey-email/preview/' + type + '?apptType=onsite')
      document.getElementById('tplPreviewOnsiteBtn').setAttribute('formtarget', '_blank')
    } else {
      document.getElementById('tpl_closing_th').value = (tpl.closing && tpl.closing.th) || ''
      document.getElementById('tpl_closing_en').value = (tpl.closing && tpl.closing.en) || ''
      document.getElementById('tpl_closing_th').placeholder = (defaults.closing && defaults.closing.th) || ''
      document.getElementById('tpl_closing_en').placeholder = (defaults.closing && defaults.closing.en) || ''
      document.getElementById('tplPreviewBtn').setAttribute('formaction', '/admin/survey-email/preview/' + type)
      document.getElementById('tplPreviewBtn').setAttribute('formtarget', '_blank')
    }

    if (hasAccessDetails && !isVariant) {
      document.getElementById('tplPreviewOnlineBtn').setAttribute('formaction', '/admin/survey-email/preview/' + type + '?apptType=online')
      document.getElementById('tplPreviewOnlineBtn').setAttribute('formtarget', '_blank')
      document.getElementById('tplPreviewPhoneBtn').setAttribute('formaction', '/admin/survey-email/preview/' + type + '?apptType=phone')
      document.getElementById('tplPreviewPhoneBtn').setAttribute('formtarget', '_blank')
      document.getElementById('tplPreviewOnsiteBtn').setAttribute('formaction', '/admin/survey-email/preview/' + type + '?apptType=onsite')
      document.getElementById('tplPreviewOnsiteBtn').setAttribute('formtarget', '_blank')
    }

    const ov = document.getElementById('tplOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('tplPanel').classList.add('open')
    document.body.style.overflow = 'hidden'
  }

  function closeTplPanel() {
    const ov = document.getElementById('tplOverlay')
    ov.classList.remove('open')
    document.getElementById('tplPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }

  document.querySelectorAll('.edit-template-btn').forEach(btn => {
    btn.addEventListener('click', () => openTplPanel(btn.dataset.type, btn.dataset.label, JSON.parse(btn.dataset.tpl), JSON.parse(btn.dataset.default)))
  })
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeTplPanel() })
  lucide.createIcons()
</script>
</body>
</html>
