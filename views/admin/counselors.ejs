<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindCare Admin</title>
  <%- include('../partials/head') %>
  <style>
    .tbl { width:100%; border-collapse:collapse; }
    .tbl thead { background:#f8fafc; }
    .tbl th { padding:10px 14px; text-align:left; font-size:12px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:.05em; border-bottom:1px solid #f1f5f9; white-space:nowrap; }
    .tbl td { padding:12px 14px; font-size:14px; color:#334155; border-bottom:1px solid #f8fafc; vertical-align:middle; }
    .tbl tbody tr:hover { background:#f8fafc; }
    .tbl tbody tr:last-child td { border-bottom:none; }
    .act-btn { display:inline-flex; align-items:center; gap:4px; padding:5px 10px; border-radius:8px; font-size:12px; font-weight:500; cursor:pointer; border:none; transition:all .15s; white-space:nowrap; text-decoration:none; }
    .ab-primary   { background:#05967e; color:#fff; }
    .ab-primary:hover   { background:#067866; }
    .ab-secondary { background:#fff; color:#05967e; border:1px solid #a0f3e1; }
    .ab-secondary:hover { background:#ecfdf9; }
    .ab-ghost     { background:transparent; color:#64748b; }
    .ab-ghost:hover     { background:#f1f5f9; }
    .ab-danger    { background:#ef4444; color:#fff; }
    .ab-danger:hover    { background:#dc2626; }
    .ab-warn      { background:#f59e0b; color:#fff; }
    .ab-warn:hover      { background:#d97706; }
    .panel-overlay { position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:40; display:none; backdrop-filter:blur(2px); opacity:0; transition:opacity .2s ease; }
    .panel-overlay.open { opacity:1; }
    .panel-drawer  { position:fixed; top:50%; left:50%; width:calc(100% - 48px); max-width:520px; max-height:90vh; background:#fff; border-radius:20px; box-shadow:0 20px 60px rgba(0,0,0,.18); z-index:50; display:flex; flex-direction:column; transform:translate(-50%,-50%) scale(.94); opacity:0; transition:transform .22s cubic-bezier(.34,1.56,.64,1), opacity .18s ease; pointer-events:none; }
    .panel-drawer.open { transform:translate(-50%,-50%) scale(1); opacity:1; pointer-events:auto; }
    .inp { width:100%; padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:13px; color:#334155; outline:none; font-family:inherit; box-sizing:border-box; }
    .inp:focus { border-color:#2dd4b4; box-shadow:0 0 0 3px rgba(45,212,180,.15); }
    .lbl { display:block; font-size:12px; font-weight:500; color:#64748b; margin-bottom:5px; }
    .check-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .check-card { display:flex; align-items:center; gap:10px; padding:10px 12px; border:1.5px solid #e2e8f0; border-radius:10px; cursor:pointer; font-size:13px; color:#334155; background:#fff; transition:all .15s; }
    .check-card:hover { border-color:#2dd4b4; background:#ecfdf9; }
    .check-card input { accent-color:#05967e; }
    .check-flag { width:24px; height:18px; border-radius:4px; overflow:hidden; flex-shrink:0; box-shadow:0 0 0 1px rgba(148,163,184,.35); }
  </style>
</head>
<body style="background:#f8fafc; margin:0;">
<%- include('../partials/admin-sidebar') %>

<div style="margin-left:256px; min-height:100vh; display:flex; flex-direction:column;">

  <!-- Header -->
  <div style="height:56px; background:#fff; border-bottom:1px solid #f1f5f9; padding:0 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20;">
    <h1 style="font-size:15px; font-weight:600; color:#1e293b; margin:0;"><%= title %></h1>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:12px; color:#94a3b8;">
        <% const d=new Date(); %><%= d.toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %>
      </span>
      <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;font-size:12px;font-weight:500;color:#475569;text-decoration:none;">
        <i data-lucide="external-link" style="width:13px;height:13px;"></i>
        ดูหน้าเว็บหลัก
      </a>
    </div>
  </div>

  <!-- Action Bar -->
  <div style="padding:14px 24px; background:#fff; border-bottom:2px solid #f1f5f9; display:flex; justify-content:flex-end;">
    <button onclick="openPanel('create')" style="display:inline-flex; align-items:center; gap:10px; padding:11px 22px; background:linear-gradient(135deg,#05967e,#06b6d4); color:#fff; border:none; border-radius:12px; font-size:14px; font-weight:600; cursor:pointer; box-shadow:0 2px 8px rgba(5,150,126,.30); transition:all .15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(5,150,126,.45)';this.style.transform='translateY(-1px)'" onmouseout="this.style.boxShadow='0 2px 8px rgba(5,150,126,.30)';this.style.transform='translateY(0)'">
      <i data-lucide="user-plus" style="width:18px;height:18px;"></i>
      + เพิ่มนักจิตวิทยาให้คำปรึกษา
    </button>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.created) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#ecfdf9; border:1px solid #a0f3e1; border-radius:12px; color:#065f46; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> เพิ่มนักจิตวิทยาให้คำปรึกษาสำเร็จ
    </div>
    <% } if (query.updated) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#ecfeff; border:1px solid #a5f3fc; border-radius:12px; color:#155e75; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อัปเดตข้อมูลสำเร็จ
    </div>
    <% } if (query.error==='duplicate_email') { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#fef2f2; border:1px solid #fca5a5; border-radius:12px; color:#991b1b; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อีเมลนี้มีในระบบแล้ว
    </div>
    <% } %>

    <!-- Filter -->
    <form method="GET" style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; padding:16px; margin-bottom:16px; display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end;">
      <div style="flex:1; min-width:200px;">
        <label class="lbl">ค้นหา</label>
        <div style="position:relative;">
          <i data-lucide="search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#94a3b8;"></i>
          <input name="search" value="<%= query.search||'' %>" class="inp" style="padding-left:32px;" placeholder="ชื่อ, อีเมล, ความเชี่ยวชาญ">
        </div>
      </div>
      <div>
        <label class="lbl">สถานะ</label>
        <select name="status" class="inp" style="width:140px;">
          <option value="">ทั้งหมด</option>
          <option value="active"   <%=query.status==='active'?'selected':''%>>ใช้งาน</option>
          <option value="inactive" <%=query.status==='inactive'?'selected':''%>>ระงับ</option>
          <option value="pending"  <%=query.status==='pending'?'selected':''%>>รออนุมัติ</option>
        </select>
      </div>
      <button type="submit" class="act-btn ab-primary">
        <i data-lucide="filter" style="width:13px;height:13px;"></i> กรอง
      </button>
      <a href="/admin/counselors" class="act-btn ab-ghost" style="text-decoration:none;">ล้าง</a>
    </form>

    <!-- Table -->
    <div style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; overflow:hidden;">
      <div style="padding:14px 16px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:13px; font-weight:600; color:#334155;">รายชื่อนักจิตวิทยาให้คำปรึกษา</span>
        <span style="font-size:12px; color:#94a3b8;">ทั้งหมด <%= counselors.length %> คน</span>
      </div>
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th>นักจิตวิทยาให้คำปรึกษา</th>
              <th>ชื่อผู้ใช้</th>
              <th>ความเชี่ยวชาญ</th>
              <th>เวลา/ครั้ง</th>
              <th>ความพึงพอใจ</th>
              <th>สถานะ</th>
              <th>การจัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% counselors.forEach(c => { %>
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap:10px;">
                  <div style="width:38px; height:38px; border-radius:10px; overflow:hidden; flex-shrink:0;">
                    <% if (c.photo) { %>
                    <img src="<%= c.photo %>" alt="<%= c.name %>" style="width:100%; height:100%; object-fit:cover;">
                    <% } else { %>
                    <div style="width:100%; height:100%; background:linear-gradient(135deg,#2dd4b4,#06b6d4); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:13px;">
                      <%= c.avatar %>
                    </div>
                    <% } %>
                  </div>
                  <div>
                    <div style="font-weight:600; color:#1e293b; font-size:13px;"><%= c.name %></div>
                    <div style="font-size:12px; color:#94a3b8;"><%= c.title %></div>
                    <div style="font-size:12px; color:#94a3b8;"><%= c.email %></div>
                  </div>
                </div>
              </td>
              <td>
                <% if (c.username) { %>
                <span style="font-size:13px;font-weight:500;color:#1e293b;"><%= c.username %></span>
                <% } else { %>
                <span style="font-size:12px;color:#cbd5e1;">ยังไม่กำหนด</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex; flex-wrap:wrap; gap:4px;">
                  <% c.specialties.slice(0,2).forEach(s => { %>
                  <span style="padding:2px 8px; background:#ecfeff; color:#0e7490; border-radius:99px; font-size:12px; font-weight:500;"><%= s %></span>
                  <% }) %>
                  <% if(c.specialties.length>2){ %><span style="padding:2px 8px; background:#f1f5f9; color:#64748b; border-radius:99px; font-size:12px;">+<%= c.specialties.length-2 %></span><% } %>
                </div>
                <div style="font-size:12px; color:#94a3b8; margin-top:3px;"><%= (c.languages||[]).join(', ') %></div>
              </td>
              <td style="color:#64748b;"><%= c.sessionDuration %> นาที</td>
              <td>
                <% const _ss = surveyStats[c.id] %>
                <% if (_ss && _ss.count > 0) {
                     const _avg = (_ss.sum / _ss.count).toFixed(1)
                     const _rounded = Math.max(1, Math.min(5, Math.round(_ss.sum / _ss.count)))
                     const _icons = {5:'smile-plus',4:'smile',3:'meh',2:'frown',1:'circle-alert'}
                     const _bg = {5:'#eefbf8',4:'#f5fae9',3:'#fff8df',2:'#fff1e8',1:'#fff0f3'}
                     const _color = {5:'#159f91',4:'#9db64b',3:'#d8b545',2:'#d88a55',1:'#d85b6c'}
                %>
                <div style="display:flex;align-items:center;gap:6px;">
                  <span style="width:26px;height:26px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;background:<%= _bg[_rounded] %>;color:<%= _color[_rounded] %>;border:1px solid <%= _bg[_rounded] %>;flex-shrink:0;">
                    <i data-lucide="<%= _icons[_rounded] %>" style="width:15px;height:15px;"></i>
                  </span>
                  <span style="font-weight:700;font-size:13px;color:#1e293b;"><%= _avg %></span>
                  <span style="font-size:12px;color:#94a3b8;">(<%= _ss.count %>)</span>
                </div>
                <% } else { %>
                <span style="font-size:12px;color:#cbd5e1;">ยังไม่มีข้อมูล</span>
                <% } %>
              </td>
              <td>
                <% if (!c.isApproved) { %>
                  <span style="padding:3px 10px; background:#fef3c7; color:#92400e; border-radius:99px; font-size:12px; font-weight:500;">รออนุมัติ</span>
                <% } else if (c.status==='active') { %>
                  <span style="padding:3px 10px; background:#d1fae5; color:#065f46; border-radius:99px; font-size:12px; font-weight:500;">ใช้งาน</span>
                <% } else { %>
                  <span style="padding:3px 10px; background:#fee2e2; color:#991b1b; border-radius:99px; font-size:12px; font-weight:500;">ระงับ</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">

                  <button class="act-btn ab-secondary edit-btn" data-rec="<%= JSON.stringify(c) %>" title="แก้ไขข้อมูล">
                    <i data-lucide="pencil" style="width:13px;height:13px;"></i> แก้ไข
                  </button>

                  <form method="POST" action="/admin/counselors/<%= c.id %>/delete"
                        onsubmit="return confirm('ลบ <%= c.name %> ออกจากระบบ?')" style="margin:0;">
                    <button type="submit" class="act-btn ab-danger" title="ลบ">
                      <i data-lucide="trash-2" style="width:12px;height:12px;"></i>
                    </button>
                  </form>

                  <% if (!c.isApproved) { %>
                  <form method="POST" action="/admin/counselors/<%= c.id %>/approve" style="margin:0;">
                    <button type="submit" class="act-btn ab-primary">
                      <i data-lucide="check" style="width:12px;height:12px;"></i> อนุมัติ
                    </button>
                  </form>
                  <% } else { %>
                  <form method="POST" action="/admin/counselors/<%= c.id %>/toggle-status" style="margin:0;">
                    <button type="submit" class="act-btn <%= c.status==='active'?'ab-warn':'ab-secondary' %>">
                      <i data-lucide="<%= c.status==='active'?'pause':'play' %>" style="width:12px;height:12px;"></i>
                      <%= c.status==='active'?'ระงับ':'เปิดใช้' %>
                    </button>
                  </form>
                  <% } %>

                </div>
              </td>
            </tr>
            <% }) %>
            <% if (counselors.length===0) { %>
            <tr><td colspan="7" style="text-align:center; padding:48px; color:#94a3b8;">
              <i data-lucide="user-x" style="width:36px;height:36px;display:block;margin:0 auto 8px;opacity:.4;"></i>
              ไม่พบข้อมูลนักจิตวิทยาให้คำปรึกษา
            </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Overlay -->
<div id="overlay" class="panel-overlay" onclick="closePanel()"></div>

<!-- Slide-over Panel -->
<div id="panel" class="panel-drawer">
  <div style="padding:16px 20px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:10px;">
      <div style="width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,#0fb89a,#06b6d4); display:flex; align-items:center; justify-content:center;">
        <i id="panelIcon" data-lucide="user-plus" style="width:15px;height:15px;color:#fff;"></i>
      </div>
      <div>
        <div id="panelTitle" style="font-size:14px; font-weight:600; color:#1e293b;">เพิ่มนักจิตวิทยาให้คำปรึกษา</div>
        <div id="panelSub"   style="font-size:12px; color:#94a3b8;">กรอกข้อมูลให้ครบถ้วน</div>
      </div>
    </div>
    <button onclick="closePanel()" style="background:none; border:none; cursor:pointer; padding:6px; border-radius:8px; color:#94a3b8;">
      <i data-lucide="x" style="width:18px;height:18px;"></i>
    </button>
  </div>

  <div style="flex:1; overflow-y:auto;">
    <form id="panelForm" method="POST" action="/admin/counselors/create" enctype="multipart/form-data">

      <!-- Photo Upload -->
      <div style="padding:20px; border-bottom:1px solid #f8fafc;">
        <div style="font-size:12px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:14px;">รูปถ่าย</div>
        <div style="display:flex; align-items:center; gap:16px;">
          <div id="photo-preview" style="width:68px; height:68px; border-radius:50%; overflow:hidden; background:linear-gradient(135deg,#2dd4b4,#06b6d4); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
            <span id="photo-initials" style="color:#fff; font-weight:700; font-size:20px;">?</span>
            <img id="photo-img" src="" alt="" style="display:none; width:100%; height:100%; object-fit:cover;">
          </div>
          <div style="flex:1;">
            <label class="lbl">เลือกรูปถ่าย</label>
            <input type="file" name="photo" id="f_photo" accept="image/jpeg,image/png,image/webp" class="inp" style="padding:6px;" onchange="previewPhoto(this)">
            <p style="font-size:12px; color:#94a3b8; margin:4px 0 0;">JPG, PNG, WEBP · ไม่เกิน 5MB</p>
          </div>
        </div>
      </div>

      <div style="padding:20px; border-bottom:1px solid #f8fafc;">
        <div style="font-size:12px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:14px;">ข้อมูลส่วนตัว</div>
        <div style="display:grid; gap:12px;">
          <div>
            <label class="lbl">ชื่อ-นามสกุล *</label>
            <input type="text" name="name" id="f_name" class="inp" required placeholder="ดร.สมชาย ใจดี">
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div>
              <label class="lbl">ตำแหน่ง / คุณวุฒิ *</label>
              <input type="text" name="title" id="f_title" class="inp" required placeholder="นักจิตวิทยาคลินิก">
            </div>
            <div>
              <label class="lbl">เบอร์โทรศัพท์</label>
              <input type="tel" name="phone" id="f_phone" class="inp" placeholder="08X-XXX-XXXX">
            </div>
          </div>
          <div>
            <label class="lbl">อีเมล *</label>
            <input type="email" name="email" id="f_email" class="inp" required placeholder="name@MindCare.th">
          </div>
          <div>
            <label class="lbl">ประวัติย่อ</label>
            <textarea name="bio" id="f_bio" rows="3" class="inp" style="resize:none;" placeholder="ประสบการณ์และความเชี่ยวชาญ..."></textarea>
          </div>
        </div>
      </div>

      <div style="padding:20px; border-bottom:1px solid #f8fafc;">
        <div style="font-size:12px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:14px;">ความเชี่ยวชาญ</div>
        <div style="display:grid; gap:12px;">
          <div>
            <label class="lbl">ความเชี่ยวชาญ <span style="font-weight:400; color:#94a3b8;">(คั่นด้วยจุลภาค)</span></label>
            <input type="text" name="specialties" id="f_specialties" class="inp" placeholder="ความวิตกกังวล, ภาวะซึมเศร้า, ความสัมพันธ์">
          </div>
          <div>
            <label class="lbl">ภาษาที่สื่อสารได้</label>
            <div class="check-grid" id="f_languages">
              <label class="check-card">
                <input type="checkbox" name="languages" value="ไทย" data-lang="thai">
                <svg class="check-flag" viewBox="0 0 24 18" aria-hidden="true">
                  <rect width="24" height="18" fill="#da291c"></rect>
                  <rect y="3" width="24" height="12" fill="#fff"></rect>
                  <rect y="6" width="24" height="6" fill="#2d2a4a"></rect>
                </svg>
                <span>ไทย</span>
              </label>
              <label class="check-card">
                <input type="checkbox" name="languages" value="อังกฤษ" data-lang="english">
                <svg class="check-flag" viewBox="0 0 60 36" aria-hidden="true">
                  <rect width="60" height="36" fill="#012169"></rect>
                  <path d="M0 0l60 36M60 0L0 36" stroke="#fff" stroke-width="7"></path>
                  <path d="M0 0l60 36M60 0L0 36" stroke="#c8102e" stroke-width="4"></path>
                  <path d="M30 0v36M0 18h60" stroke="#fff" stroke-width="12"></path>
                  <path d="M30 0v36M0 18h60" stroke="#c8102e" stroke-width="7"></path>
                </svg>
                <span>อังกฤษ</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div style="padding:20px; border-bottom:1px solid #f8fafc;">
        <div style="font-size:12px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:14px;">ระยะเวลาต่อครั้ง</div>
        <div>
          <label class="lbl">ระยะเวลา</label>
          <select name="sessionDuration" id="f_sessionDuration" class="inp">
            <option value="30">30 นาที</option>
            <option value="45">45 นาที</option>
            <option value="60" selected>60 นาที</option>
            <option value="90">90 นาที</option>
          </select>
        </div>
      </div>

      <!-- Login credentials -->
      <div style="padding:20px; border-bottom:1px solid #f8fafc;">
        <div style="font-size:12px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:14px;">ข้อมูลการเข้าสู่ระบบ</div>
        <div style="display:grid; gap:12px;">
          <div>
            <label class="lbl" id="unameLbl">ชื่อผู้ใช้</label>
            <input type="text" name="username" id="f_username" class="inp" placeholder="เช่น dr.somchai">
          </div>
          <div>
            <label class="lbl" id="pwdLabel">รหัสผ่าน</label>
            <input type="password" name="password" id="f_password" class="inp" placeholder="กรอกรหัสผ่าน">
          </div>
        </div>
        <p style="font-size:12px; color:#94a3b8; margin:10px 0 0;">กรอกเพื่อให้นักจิตวิทยาให้คำปรึกษาเข้าใช้งานระบบหลังบ้านได้</p>
      </div>

      <div id="approveSection" style="padding:20px;">
        <div style="font-size:12px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:14px;">สถานะการอนุมัติ</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <label style="display:flex; align-items:flex-start; gap:10px; padding:12px; border:1.5px solid #a0f3e1; border-radius:10px; cursor:pointer; background:#ecfdf9;">
            <input type="radio" name="isApproved" value="true" checked style="margin-top:2px; accent-color:#05967e;">
            <div>
              <div style="font-size:13px; font-weight:500; color:#1e293b;">อนุมัติทันที</div>
              <div style="font-size:12px; color:#64748b;">แสดงในหน้าค้นหา</div>
            </div>
          </label>
          <label style="display:flex; align-items:flex-start; gap:10px; padding:12px; border:1.5px solid #e2e8f0; border-radius:10px; cursor:pointer;">
            <input type="radio" name="isApproved" value="false" style="margin-top:2px; accent-color:#f59e0b;">
            <div>
              <div style="font-size:13px; font-weight:500; color:#1e293b;">รออนุมัติ</div>
              <div style="font-size:12px; color:#64748b;">ซ่อนจากหน้าค้นหา</div>
            </div>
          </label>
        </div>
      </div>

    </form>
  </div>

  <div style="padding:16px 20px; border-top:1px solid #f1f5f9; display:flex; gap:10px;">
    <button onclick="closePanel()" class="act-btn ab-secondary" style="flex:1; justify-content:center;">ยกเลิก</button>
    <button onclick="submitPanel()" class="act-btn ab-primary" style="flex:1; justify-content:center;">
      <i data-lucide="save" style="width:14px;height:14px;"></i>
      <span id="submitLabel">บันทึก</span>
    </button>
  </div>
</div>

<script>
  const ALL_COUNSELORS = <%- JSON.stringify(allCounselors) %>

  function resetPhotoPreview(avatar, photoUrl) {
    const img = document.getElementById('photo-img')
    const initials = document.getElementById('photo-initials')
    if (photoUrl) {
      img.src = photoUrl
      img.style.display = 'block'
      initials.style.display = 'none'
    } else {
      img.src = ''
      img.style.display = 'none'
      initials.textContent = avatar || '?'
      initials.style.display = 'block'
    }
  }

  function previewPhoto(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader()
      reader.onload = e => {
        document.getElementById('photo-img').src = e.target.result
        document.getElementById('photo-img').style.display = 'block'
        document.getElementById('photo-initials').style.display = 'none'
      }
      reader.readAsDataURL(input.files[0])
    }
  }

  function normalizeLang(value) {
    return String(value || '').trim().toLowerCase()
  }
  function setLanguageChecks(languages) {
    const selected = (languages || []).map(normalizeLang)
    document.querySelectorAll('input[name="languages"]').forEach(input => {
      const value = normalizeLang(input.value)
      const key = normalizeLang(input.dataset.lang)
      input.checked = selected.includes(value) ||
        (key === 'thai' && selected.some(v => v === 'thai' || v === 'th' || v === 'ไทย')) ||
        (key === 'english' && selected.some(v => v === 'english' || v === 'en' || v === 'อังกฤษ'))
    })
  }

  function openPanel(mode, data) {
    document.getElementById('panelForm').reset()
    document.getElementById('approveSection').style.display = mode==='create' ? '' : 'none'
    if (mode==='create') {
      document.getElementById('panelTitle').textContent = 'เพิ่มนักจิตวิทยาให้คำปรึกษา'
      document.getElementById('panelSub').textContent   = 'กรอกข้อมูลให้ครบถ้วน'
      document.getElementById('panelIcon').setAttribute('data-lucide','user-plus')
      document.getElementById('submitLabel').textContent = 'เพิ่มนักจิตวิทยาให้คำปรึกษา'
      document.getElementById('panelForm').action = '/admin/counselors/create'
      document.getElementById('f_username').value     = ''
      document.getElementById('f_password').value     = ''
      document.getElementById('f_password').placeholder = 'กรอกรหัสผ่าน'
      document.getElementById('pwdLabel').textContent   = 'รหัสผ่าน'
      resetPhotoPreview('?', null)
    } else {
      document.getElementById('panelTitle').textContent = 'แก้ไขข้อมูล'
      document.getElementById('panelSub').textContent   = data.name
      document.getElementById('panelIcon').setAttribute('data-lucide','pencil')
      document.getElementById('submitLabel').textContent = 'บันทึกการแก้ไข'
      document.getElementById('panelForm').action = '/admin/counselors/'+data.id+'/edit'
      document.getElementById('f_name').value            = data.name||''
      document.getElementById('f_title').value           = data.title||''
      document.getElementById('f_email').value           = data.email||''
      document.getElementById('f_phone').value           = data.phone||''
      document.getElementById('f_bio').value             = data.bio||''
      document.getElementById('f_specialties').value     = (data.specialties||[]).join(', ')
      setLanguageChecks(data.languages||[])
      document.getElementById('f_sessionDuration').value = String(data.sessionDuration||60)
      document.getElementById('f_username').value        = data.username||''
      document.getElementById('f_password').value        = ''
      document.getElementById('f_password').placeholder  = 'ปล่อยว่างถ้าไม่ต้องการเปลี่ยน'
      document.getElementById('pwdLabel').textContent      = 'รหัสผ่านใหม่'
      resetPhotoPreview(data.avatar, data.photo||null)
    }
    lucide.createIcons()
    const ov = document.getElementById('overlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => { ov.classList.add('open') })
    document.getElementById('panel').classList.add('open')
    document.body.style.overflow = 'hidden'
  }
  function closePanel() {
    const ov = document.getElementById('overlay')
    ov.classList.remove('open')
    document.getElementById('panel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  function submitPanel() {
    const f=document.getElementById('panelForm')
    if(f.reportValidity()) f.submit()
  }
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openPanel('edit', JSON.parse(btn.dataset.rec)))
  })
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') closePanel() })
  lucide.createIcons()
</script>
</body>
</html>
