    <form id="transferForm" method="POST" action="">
      <div id="transferRows" style="display:grid;gap:10px;"></div>
      <p id="transferEmpty" style="display:none;font-size:13px;color:#94a3b8;text-align:center;padding:24px 0;">ไม่มีนัดหมายที่รอยืนยัน/ยืนยันแล้วสำหรับผู้รับบริการคนนี้</p>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closeTransfer()" class="act-btn ab-ghost" style="flex:1;justify-content:center;border:1px solid #e2e8f0;">ยกเลิก</button>
    <button id="transferSubmitBtn" onclick="submitTransfer()" class="act-btn ab-primary" style="flex:1;justify-content:center;">
