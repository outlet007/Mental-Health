<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindWell Admin</title>
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    .tbl { width:100%; border-collapse:collapse; }
    .tbl thead { background:#f8fafc; }
    .tbl th { padding:10px 14px; text-align:left; font-size:11px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:.05em; border-bottom:1px solid #f1f5f9; white-space:nowrap; }
    .tbl td { padding:12px 14px; font-size:13px; color:#334155; border-bottom:1px solid #f8fafc; vertical-align:middle; }
    .tbl tbody tr:hover { background:#f8fafc; }
    .tbl tbody tr:last-child td { border-bottom:none; }
    .act-btn { display:inline-flex; align-items:center; gap:4px; padding:5px 10px; border-radius:8px; font-size:12px; font-weight:500; cursor:pointer; border:none; transition:all .15s; text-decoration:none; white-space:nowrap; }
    .ab-primary  { background:#05967e; color:#fff; }
    .ab-primary:hover  { background:#067866; }
    .ab-secondary{ background:#fff; color:#05967e; border:1px solid #a0f3e1; }
    .ab-secondary:hover{ background:#ecfdf9; }
    .ab-ghost    { background:transparent; color:#64748b; }
    .ab-ghost:hover    { background:#f1f5f9; }
    .ab-danger   { background:#ef4444; color:#fff; }
    .ab-danger:hover   { background:#dc2626; }
    .panel-overlay { position:fixed; inset:0; background:rgba(0,0,0,.35); z-index:40; display:none; }
    .panel-drawer  { position:fixed; top:0; right:0; height:100%; width:100%; max-width:460px; background:#fff; box-shadow:-4px 0 32px rgba(0,0,0,.12); z-index:50; display:flex; flex-direction:column; transform:translateX(100%); transition:transform .25s ease; }
    .panel-drawer.open { transform:translateX(0); }
    .inp { width:100%; padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:13px; color:#334155; outline:none; font-family:inherit; box-sizing:border-box; }
    .inp:focus { border-color:#2dd4b4; box-shadow:0 0 0 3px rgba(45,212,180,.15); }
    .lbl { display:block; font-size:12px; font-weight:500; color:#64748b; margin-bottom:5px; }
  </style>
</head>
<body style="background:#f8fafc; margin:0;">
<%- include('../partials/admin-sidebar') %>

<div style="margin-left:256px; min-height:100vh; display:flex; flex-direction:column;">

  <!-- Header -->
  <div style="height:56px; background:#fff; border-bottom:1px solid #f1f5f9; padding:0 24px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20;">
    <h1 style="font-size:15px; font-weight:600; color:#1e293b; margin:0;"><%= title %></h1>
    <div style="display:flex; align-items:center; gap:12px;">
      <span style="font-size:12px; color:#94a3b8;">
        <% const d=new Date(); %><%= d.toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %>
      </span>
      <button onclick="openPanel('create')" class="act-btn ab-primary">
        <i data-lucide="user-plus" style="width:14px;height:14px;"></i>
        เพิ่มผู้รับบริการ
      </button>
    </div>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.created) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#ecfdf9; border:1px solid #a0f3e1; border-radius:12px; color:#065f46; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> เพิ่มผู้รับบริการสำเร็จ
    </div>
    <% } if (query.updated) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#ecfeff; border:1px solid #a5f3fc; border-radius:12px; color:#155e75; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อัปเดตข้อมูลสำเร็จ
    </div>
    <% } if (query.deleted) { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#f8fafc; border:1px solid #cbd5e1; border-radius:12px; color:#475569; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="trash-2" style="width:16px;height:16px;flex-shrink:0;"></i> ลบผู้รับบริการออกจากระบบแล้ว
    </div>
    <% } if (query.error==='duplicate_email') { %>
    <div style="margin-bottom:16px; padding:12px 16px; background:#fef2f2; border:1px solid #fca5a5; border-radius:12px; color:#991b1b; font-size:13px; display:flex; align-items:center; gap:8px;">
      <i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อีเมลนี้มีในระบบแล้ว กรุณาใช้อีเมลอื่น
    </div>
    <% } %>

    <!-- Filter -->
    <form method="GET" style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; padding:16px; margin-bottom:16px; display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end;">
      <div style="flex:1; min-width:200px;">
        <label class="lbl">ค้นหา</label>
        <div style="position:relative;">
          <i data-lucide="search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#94a3b8;"></i>
          <input name="search" value="<%= query.search||'' %>" class="inp" style="padding-left:32px;" placeholder="ชื่อ, อีเมล, เบอร์โทร">
        </div>
      </div>
      <div>
        <label class="lbl">สถานะ</label>
        <select name="status" class="inp" style="width:150px;">
          <option value="">ทั้งหมด</option>
          <option value="active"   <%=query.status==='active'?'selected':''%>>ใช้งาน</option>
          <option value="inactive" <%=query.status==='inactive'?'selected':''%>>ไม่ได้ใช้งาน</option>
        </select>
      </div>
      <button type="submit" class="act-btn ab-primary">
        <i data-lucide="filter" style="width:13px;height:13px;"></i> กรอง
      </button>
      <a href="/admin/clients" class="act-btn ab-ghost">ล้าง</a>
    </form>

    <!-- Table -->
    <div style="background:#fff; border:1px solid #f1f5f9; border-radius:16px; overflow:hidden;">
      <div style="padding:14px 16px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:13px; font-weight:600; color:#334155;">รายชื่อผู้รับบริการ</span>
        <span style="font-size:12px; color:#94a3b8;">ทั้งหมด <%= clients.length %> คน</span>
      </div>
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th>ผู้รับบริการ</th>
              <th>ข้อมูลติดต่อ</th>
              <th>อายุ / เพศ</th>
              <th>จำนวนครั้ง</th>
              <th>รับบริการล่าสุด</th>
              <th>สถานะ</th>
              <th>การจัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% clients.forEach(c => { %>
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap:10px;">
                  <div style="width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,#06b6d4,#05967e); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:12px; flex-shrink:0;">
                    <%= c.name.slice(-2) %>
                  </div>
                  <div>
                    <div style="font-weight:600; color:#1e293b; font-size:13px;"><%= c.name %></div>
                    <div style="font-size:11px; color:#94a3b8;">ลงทะเบียน <%= c.registeredAt %></div>
                  </div>
                </div>
              </td>
              <td>
                <div style="font-size:13px; color:#334155;"><%= c.email %></div>
                <div style="font-size:11px; color:#94a3b8;"><%= c.phone %></div>
              </td>
              <td style="font-size:13px;"><%= c.age %> ปี / <%= c.gender %></td>
              <td>
                <div style="display:flex; align-items:center; gap:5px;">
                  <i data-lucide="calendar-check" style="width:13px;height:13px;color:#05967e;"></i>
                  <span style="font-weight:600; font-size:14px; color:#1e293b;"><%= c.totalSessions %></span>
                  <span style="font-size:11px; color:#94a3b8;">ครั้ง</span>
                </div>
              </td>
              <td style="font-size:12px; color:#64748b;"><%= c.lastSession || '—' %></td>
              <td>
                <% if (c.status==='active') { %>
                  <span style="padding:3px 10px; background:#d1fae5; color:#065f46; border-radius:99px; font-size:11px; font-weight:500;">ใช้งาน</span>
                <% } else { %>
                  <span style="padding:3px 10px; background:#fee2e2; color:#991b1b; border-radius:99px; font-size:11px; font-weight:500;">ไม่ได้ใช้งาน</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex; align-items:center; gap:6px;">
                  <a href="/admin/clients/<%= c.id %>" class="act-btn ab-ghost" title="ดูข้อมูล">
                    <i data-lucide="eye" style="width:13px;height:13px;"></i> ดู
                  </a>
                  <button onclick="openPanel('edit', <%- JSON.stringify(c) %>)" class="act-btn ab-secondary" title="แก้ไข">
                    <i data-lucide="pencil" style="width:13px;height:13px;"></i> แก้ไข
                  </button>
                  <form method="POST" action="/admin/clients/<%= c.id %>/delete"
                        onsubmit="return confirm('ลบ <%= c.name %> ออกจากระบบ?\nข้อมูลจะหายถาวร')" style="margin:0;">
                    <button type="submit" class="act-btn ab-danger" title="ลบ">
                      <i data-lucide="trash-2" style="width:13px;height:13px;"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if (clients.length===0) { %>
            <tr><td colspan="7" style="text-align:center; padding:48px 16px; color:#94a3b8;">
              <i data-lucide="users" style="width:36px;height:36px;display:block;margin:0 auto 10px;opacity:.3;"></i>
              ไม่พบข้อมูลผู้รับบริการ
            </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Overlay -->
<div id="overlay" class="panel-overlay" onclick="closePanel()"></div>

<!-- Slide-over Panel -->
<div id="panel" class="panel-drawer">
  <div style="padding:16px 20px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:10px;">
      <div style="width:32px; height:32px; border-radius:8px; background:linear-gradient(135deg,#06b6d4,#05967e); display:flex; align-items:center; justify-content:center;">
        <i id="panelIcon" data-lucide="user-plus" style="width:15px;height:15px;color:#fff;"></i>
      </div>
      <div>
        <div id="panelTitle" style="font-size:14px; font-weight:600; color:#1e293b;">เพิ่มผู้รับบริการ</div>
        <div id="panelSub"   style="font-size:11px; color:#94a3b8;">กรอกข้อมูลให้ครบถ้วน</div>
      </div>
    </div>
    <button onclick="closePanel()" style="background:none; border:none; cursor:pointer; padding:6px; border-radius:8px; color:#94a3b8;">
      <i data-lucide="x" style="width:18px;height:18px;"></i>
    </button>
  </div>

  <div style="flex:1; overflow-y:auto; padding:20px;">
    <form id="panelForm" method="POST" action="/admin/clients/create">
      <div style="display:grid; gap:16px;">

        <div>
          <label class="lbl">ชื่อ-นามสกุล *</label>
          <input type="text" name="name" id="f_name" class="inp" required placeholder="นายสมชาย ใจดี">
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          <div>
            <label class="lbl">อายุ</label>
            <input type="number" name="age" id="f_age" class="inp" min="1" max="120" placeholder="25">
          </div>
          <div>
            <label class="lbl">เพศ</label>
            <select name="gender" id="f_gender" class="inp">
              <option value="ชาย">ชาย</option>
              <option value="หญิง">หญิง</option>
              <option value="ไม่ระบุ">ไม่ระบุ</option>
            </select>
          </div>
        </div>

        <div>
          <label class="lbl">อีเมล *</label>
          <input type="email" name="email" id="f_email" class="inp" required placeholder="example@email.com">
        </div>

        <div>
          <label class="lbl">เบอร์โทรศัพท์</label>
          <input type="tel" name="phone" id="f_phone" class="inp" placeholder="08X-XXX-XXXX">
        </div>

        <div>
          <label class="lbl">สถานะบัญชี</label>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <label style="display:flex; align-items:flex-start; gap:10px; padding:12px; border:1.5px solid #a0f3e1; border-radius:10px; cursor:pointer; background:#ecfdf9;">
              <input type="radio" name="status" value="active" id="r_active" checked style="margin-top:2px; accent-color:#05967e;">
              <div>
                <div style="font-size:13px; font-weight:500; color:#1e293b;">ใช้งาน</div>
                <div style="font-size:11px; color:#64748b;">เข้าสู่ระบบได้</div>
              </div>
            </label>
            <label style="display:flex; align-items:flex-start; gap:10px; padding:12px; border:1.5px solid #e2e8f0; border-radius:10px; cursor:pointer;">
              <input type="radio" name="status" value="inactive" id="r_inactive" style="margin-top:2px; accent-color:#ef4444;">
              <div>
                <div style="font-size:13px; font-weight:500; color:#1e293b;">ไม่ได้ใช้งาน</div>
                <div style="font-size:11px; color:#64748b;">ระงับชั่วคราว</div>
              </div>
            </label>
          </div>
        </div>

      </div>
    </form>
  </div>

  <div style="padding:16px 20px; border-top:1px solid #f1f5f9; display:flex; gap:10px;">
    <button onclick="closePanel()" class="act-btn ab-secondary" style="flex:1; justify-content:center;">ยกเลิก</button>
    <button onclick="submitPanel()" class="act-btn ab-primary" style="flex:1; justify-content:center;">
      <i data-lucide="save" style="width:14px;height:14px;"></i>
      <span id="submitLabel">บันทึก</span>
    </button>
  </div>
</div>

<script>
  function openPanel(mode, data) {
    document.getElementById('panelForm').reset()
    if (mode === 'create') {
      document.getElementById('panelTitle').textContent = 'เพิ่มผู้รับบริการ'
      document.getElementById('panelSub').textContent   = 'กรอกข้อมูลให้ครบถ้วน'
      document.getElementById('panelIcon').setAttribute('data-lucide', 'user-plus')
      document.getElementById('submitLabel').textContent = 'เพิ่มผู้รับบริการ'
      document.getElementById('panelForm').action = '/admin/clients/create'
      document.getElementById('r_active').checked = true
    } else {
      document.getElementById('panelTitle').textContent = 'แก้ไขข้อมูล'
      document.getElementById('panelSub').textContent   = data.name
      document.getElementById('panelIcon').setAttribute('data-lucide', 'pencil')
      document.getElementById('submitLabel').textContent = 'บันทึกการแก้ไข'
      document.getElementById('panelForm').action = '/admin/clients/' + data.id + '/edit'
      document.getElementById('f_name').value  = data.name  || ''
      document.getElementById('f_email').value = data.email || ''
      document.getElementById('f_phone').value = data.phone || ''
      document.getElementById('f_age').value   = data.age   || ''
      document.getElementById('f_gender').value = data.gender || 'ไม่ระบุ'
      document.getElementById(data.status === 'active' ? 'r_active' : 'r_inactive').checked = true
    }
    lucide.createIcons()
    document.getElementById('overlay').style.display = 'block'
    document.getElementById('panel').classList.add('open')
    document.body.style.overflow = 'hidden'
  }
  function closePanel() {
    document.getElementById('overlay').style.display = 'none'
    document.getElementById('panel').classList.remove('open')
    document.body.style.overflow = ''
  }
  function submitPanel() {
    const f = document.getElementById('panelForm')
    if (f.reportValidity()) f.submit()
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel() })
  lucide.createIcons()
</script>
</body>
</html>
