<!-- ░░░ Delete confirm overlay ░░░ -->
<div id="deleteOverlay" class="panel-overlay" onclick="closeDeleteModal()"></div>
<div id="deletePanel" class="panel-drawer" style="max-width:420px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:36px;height:36px;border-radius:10px;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i data-lucide="trash-2" style="width:17px;height:17px;color:#ef4444;"></i>
      </div>
      <div style="font-size:14px;font-weight:600;color:#1e293b;">ยืนยันการลบ</div>
    </div>
    <button onclick="closeDeleteModal()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <form id="deleteForm" method="POST" action="" style="padding:20px;display:flex;flex-direction:column;gap:14px;">
    <div style="padding:12px 14px;background:#fef2f2;border:1px solid #fca5a5;border-radius:10px;font-size:13px;color:#991b1b;display:flex;gap:8px;align-items:flex-start;">
      <i data-lucide="alert-triangle" style="width:16px;height:16px;flex-shrink:0;margin-top:1px;"></i>
      <span id="deleteWarningText"></span>
    </div>
    <div>
      <label class="lbl">เหตุผลการลบ <span style="color:#ef4444;">*</span></label>
      <textarea name="reason" id="deleteReason" required rows="3" class="inp" style="resize:none;" placeholder="ระบุเหตุผลที่ต้องการลบข้อมูลนี้..."></textarea>
    </div>
    <div style="display:flex;gap:10px;">
      <button type="button" onclick="closeDeleteModal()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
      <button type="submit" class="act-btn ab-danger" style="flex:1;justify-content:center;"><i data-lucide="trash-2" style="width:14px;height:14px;"></i> ยืนยันลบ</button>
    </div>
  </form>
</div>

<script>
  const ALL_APPOINTMENTS = <%- JSON.stringify(appointments) %>
  const SCHEDULES        = <%- JSON.stringify(schedules) %>
  const COUNSELORS       = <%- JSON.stringify(counselors) %>
  const COUNSELOR_COLORS = <%- JSON.stringify(counselorColors) %>
  const IS_COUNSELOR_VIEW = <%- isCounselorView ? 'true' : 'false' %>

  // ── Concern (เรื่องที่ต้องการความช่วยเหลือ) pill badge ────────────────────────
  const CONCERN_OPTIONS = <%- JSON.stringify(concernOptions) %>
  const CONCERN_PALETTE = [
    { bg:'#ffedd5', color:'#9a3412' },
    { bg:'#ede9fe', color:'#5b21b6' },
    { bg:'#fce7f3', color:'#9d174d' },
    { bg:'#cffafe', color:'#155e75' },
    { bg:'#e0e7ff', color:'#3730a3' },
    { bg:'#f1f5f9', color:'#475569' },
  ]
  const CONCERN_FALLBACK = { bg:'#f1f5f9', color:'#475569' }
  const CONCERN_COLOR_MAP = {}
  CONCERN_OPTIONS.forEach((opt, i) => { CONCERN_COLOR_MAP[opt] = CONCERN_PALETTE[i % CONCERN_PALETTE.length] })
  function concernBadge(concern) {
    if (!concern) return ''
    const cc = CONCERN_COLOR_MAP[concern] || CONCERN_FALLBACK
    return `<span style="display:inline-block;padding:2px 8px;background:${cc.bg};color:${cc.color};border-radius:99px;font-size:12px;font-weight:500;">${concern}</span>`
  }

  // ── Delete confirm modal ─────────────────────────────────────────────────────
  function openDeleteModal(action, name, warning) {
    document.getElementById('deleteForm').action        = action
    document.getElementById('deleteReason').value       = ''
    document.getElementById('deleteWarningText').textContent = warning || ('ต้องการลบ "' + name + '" ใช่หรือไม่ การลบไม่สามารถกู้คืนได้')
    const ov = document.getElementById('deleteOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('deletePanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }
  function closeDeleteModal() {
    const ov = document.getElementById('deleteOverlay')
    ov.classList.remove('open')
    document.getElementById('deletePanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openDeleteModal(btn.dataset.action, btn.dataset.name, btn.dataset.warning)
    })
  })

  const GENDER_LABEL = { male:'ชาย', female:'หญิง', unspecified:'ไม่ระบุเพศ' }
  const STATUS_LABEL = { pending:'รอยืนยัน', confirmed:'ยืนยันแล้ว', completed:'เสร็จสิ้น', cancelled:'ยกเลิก' }
  const STATUS_COLOR = {
    pending:   {bg:'#fef3c7',color:'#92400e'},
    confirmed: {bg:'#dbeafe',color:'#1e40af'},
    completed: {bg:'#d1fae5',color:'#065f46'},
    cancelled: {bg:'#fee2e2',color:'#991b1b'},
  }

  // ── Detail modal ──────────────────────────────────────────────────────────────
  let detailClient = null

  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id
      openDetail(id)
    })
  })

  function openDetail(id) {
    const rowBtn  = document.querySelector(`.book-client-btn[data-rec]`)
    // find client data from book-client-btn with matching id
    let client = null
    document.querySelectorAll('.book-client-btn').forEach(b => {
      const c = JSON.parse(b.dataset.rec)
      if (c.id === id) client = c
    })
    if (!client) return
    detailClient = client

    document.getElementById('detailAvatar').textContent = client.name.slice(-2)
    document.getElementById('detailName').textContent   = client.name
    document.getElementById('detailStudentId').textContent = 'รหัสนักศึกษา ' + (client.studentId || '—')

    const statusLabel = client.status === 'active' ? 'ใช้งาน' : 'ไม่ได้ใช้งาน'
    document.getElementById('detailInfoGrid').innerHTML = [
      ['อีเมล',       client.email  || '—'],
      ['โทรศัพท์',   client.phone  || '—'],
      ['อายุ',        (client.age   || '—') + ' ปี'],
      ['เพศ',         GENDER_LABEL[client.gender] || client.gender || 'ไม่ระบุเพศ'],
      ['สถานะ',       statusLabel],
      ['ลงทะเบียน',  client.registeredAt || '—'],
    ].map(([k,v]) => `
      <div>
        <div style="font-size:12px;color:#94a3b8;margin-bottom:2px;">${k}</div>
        <div style="font-size:13px;color:#1e293b;font-weight:500;">${v}</div>
      </div>`
    ).join('')

    const appts = ALL_APPOINTMENTS
      .filter(a => a.clientId === id)
      .sort((a, b) => b.date.localeCompare(a.date))

    document.getElementById('detailApptCount').textContent = appts.length + ' ครั้ง'

    if (appts.length === 0) {
      document.getElementById('detailApptList').innerHTML =
        '<div style="text-align:center;padding:24px;color:#94a3b8;font-size:13px;">ยังไม่มีประวัติการนัดหมาย</div>'
    } else {
      document.getElementById('detailApptList').innerHTML = appts.map((a, i) => {
        const sc  = STATUS_COLOR[a.status] || {bg:'#f1f5f9',color:'#64748b'}
        const sl  = STATUS_LABEL[a.status] || a.status
        const cCol = COUNSELOR_COLORS[a.counselorId] || '#64748b'
        const typeLabel = a.type === 'online' ? 'ออนไลน์' : 'เข้ารับบริการด้วยตนเอง'
        return `
          <div class="appt-row" onclick="toggleAppt(this)">
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:12px;font-weight:600;color:#94a3b8;">#${appts.length - i}</span>
                <span style="font-size:13px;font-weight:600;color:#1e293b;">${a.date}</span>
                <span style="font-size:12px;color:#64748b;">${a.time} น.</span>
                ${a.concern ? `<span style="font-size:12px;color:#64748b;">เรื่อง</span>${concernBadge(a.concern)}` : ''}
                <span style="font-size:12px;color:#64748b;">โดย</span>
                <span style="padding:2px 8px;background:${cCol}18;color:${cCol};border-radius:99px;font-size:11px;font-weight:600;">${a.counselorName || '—'}</span>
              </div>
              <div style="display:flex;align-items:center;gap:6px;">
                <span style="padding:2px 8px;background:${sc.bg};color:${sc.color};border-radius:99px;font-size:12px;font-weight:500;">${sl}</span>
                <i data-lucide="chevron-down" style="width:14px;height:14px;color:#94a3b8;transition:transform .15s;" class="chevron-icon"></i>
              </div>
            </div>
            <div class="appt-detail">
              <div><strong>นักจิตวิทยา:</strong> ${a.counselorName || '—'}</div>
              <div><strong>รูปแบบ:</strong> ${typeLabel}</div>
              <div><strong>ระยะเวลา:</strong> ${a.duration || 60} นาที</div>
              ${a.concern ? `<div><strong>เรื่องที่ต้องการความช่วยเหลือ:</strong> ${concernBadge(a.concern)}</div>` : ''}
              ${a.note ? `<div><strong>หมายเหตุ:</strong> ${a.note}</div>` : ''}
            </div>
          </div>`
      }).join('')
    }

    const do_ = document.getElementById('detailOverlay')
    do_.style.display = 'block'
    requestAnimationFrame(() => do_.classList.add('open'))
    document.getElementById('detailPanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }

  function toggleAppt(row) {
    const expanded = row.classList.toggle('expanded')
    const icon = row.querySelector('.chevron-icon')
    if (icon) icon.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0)'
  }

  function closeDetail() {
    const do_ = document.getElementById('detailOverlay')
    do_.classList.remove('open')
    document.getElementById('detailPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { do_.style.display = 'none' }, 200)
  }

  function openBookFromDetail() {
    closeDetail()
    setTimeout(() => { if (detailClient) openBook(detailClient) }, 220)
  }

  // ── Transfer modal ────────────────────────────────────────────────────────────
  function openTransferFromDetail() {
    closeDetail()
    setTimeout(() => { if (detailClient) openTransfer(detailClient) }, 220)
  }

  function openTransfer(client) {
    document.getElementById('transferPanelSub').textContent = 'สำหรับ ' + client.name
    document.getElementById('transferForm').action = '/admin/clients/' + client.id + '/transfer'

    const movable = ALL_APPOINTMENTS.filter(a =>
      a.clientId === client.id && (a.status === 'pending' || a.status === 'confirmed')
    ).sort((a, b) => a.date.localeCompare(b.date) || a.time.localeCompare(b.time))

    const rows  = document.getElementById('transferRows')
    const empty = document.getElementById('transferEmpty')
    const submitBtn = document.getElementById('transferSubmitBtn')

    if (!movable.length) {
      rows.innerHTML = ''
      empty.style.display = 'block'
      submitBtn.disabled = true
      submitBtn.style.opacity = '.5'
      submitBtn.style.cursor = 'not-allowed'
    } else {
      empty.style.display = 'none'
      submitBtn.disabled = false
      submitBtn.style.opacity = '1'
      submitBtn.style.cursor = 'pointer'
      rows.innerHTML = movable.map(a => `
        <div style="border:1px solid #e2e8f0;border-radius:10px;padding:12px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
          <div style="min-width:0;">
            <div style="font-size:13px;font-weight:600;color:#1e293b;">${a.date} · ${a.time} น.</div>
            <div style="font-size:11px;color:#94a3b8;margin-top:2px;">ปัจจุบัน: ${a.counselorName || '—'}</div>
          </div>
          <div style="display:flex;align-items:center;gap:6px;">
            <input type="hidden" name="appointmentId[]" value="${a.id}">
            <select name="counselorId[]" class="inp" style="min-width:180px;">
              ${COUNSELORS.map(c => `<option value="${c.id}" ${c.id === a.counselorId ? 'selected' : ''}>${c.name}</option>`).join('')}
            </select>
          </div>
        </div>`
      ).join('')
    }

    const ov = document.getElementById('transferOverlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('transferPanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }

  function closeTransfer() {
    const ov = document.getElementById('transferOverlay')
    ov.classList.remove('open')
    document.getElementById('transferPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }

  function submitTransfer() {
    document.getElementById('transferForm').submit()
  }

  document.querySelectorAll('.transfer-client-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openTransfer(JSON.parse(btn.dataset.rec))
    })
  })

  // ── Book modal ────────────────────────────────────────────────────────────────
  let bCounselor = null, bTime = null

  document.querySelectorAll('.book-client-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openBook(JSON.parse(btn.dataset.rec))
    })
  })

  function openBook(client) {
    document.getElementById('bookClientId').value         = client.id
    document.getElementById('bookPanelSub').textContent   = 'สำหรับ ' + client.name

    bCounselor = null; bTime = null
    document.getElementById('bDateInput').disabled = true
    document.getElementById('bDateInput').value    = ''
    document.getElementById('bDateHint').style.display = 'block'
    document.getElementById('bAvailableDays').style.display = 'none'
    document.getElementById('bSlotSection').style.display = 'none'
    document.getElementById('bSummary').style.display    = 'none'
    document.querySelectorAll('#bCounselorList .counselor-card').forEach(el => el.classList.remove('selected'))
    document.querySelectorAll('#bCounselorList input[name="counselorId"]').forEach(r => r.checked = false)

    const bo = document.getElementById('bookOverlay')
    bo.style.display = 'block'
    requestAnimationFrame(() => bo.classList.add('open'))
    document.getElementById('bookPanel').classList.add('open')
    document.body.style.overflow = 'hidden'

    // Counselor view: only one counselor (self) — pick it automatically, no click needed.
    if (IS_COUNSELOR_VIEW && COUNSELORS.length) {
      const me = COUNSELORS[0]
      bCounselor = { id: me.id, duration: me.sessionDuration, name: me.name }
      document.getElementById('bcard_' + me.id)?.classList.add('selected')
      document.getElementById('bDateInput').disabled = false
      document.getElementById('bDateHint').style.display = 'none'
      const mySched = SCHEDULES.filter(s => s.counselorId === me.id && s.isActive)
      document.getElementById('bDayBadges').innerHTML = mySched.map(s =>
        `<span style="padding:3px 10px; background:#dbeafe; color:#1e40af; border-radius:99px; font-size:12px;">${s.dayName} ${s.startTime}–${s.endTime}</span>`
      ).join('')
      document.getElementById('bAvailableDays').style.display = 'block'
    }
  }

  function closeBook() {
    const bo = document.getElementById('bookOverlay')
    bo.classList.remove('open')
    document.getElementById('bookPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { bo.style.display = 'none' }, 200)
  }

  function bOnCounselorChange(radio) {
    bCounselor = { id: radio.value, duration: parseInt(radio.dataset.duration), name: radio.dataset.name }
    document.querySelectorAll('#bCounselorList .counselor-card').forEach(el => {
      const r = el.querySelector('input[name="counselorId"]')
      el.classList.toggle('selected', r && r.value === radio.value)
    })
    document.getElementById('bDateInput').disabled = false
    document.getElementById('bDateInput').value    = ''
    document.getElementById('bDateHint').style.display = 'none'
    const mySched = SCHEDULES.filter(s => s.counselorId===radio.value && s.isActive)
    document.getElementById('bDayBadges').innerHTML = mySched.map(s =>
      `<span style="padding:3px 10px; background:#dbeafe; color:#1e40af; border-radius:99px; font-size:12px;">${s.dayName} ${s.startTime}–${s.endTime}</span>`
    ).join('')
    document.getElementById('bAvailableDays').style.display = 'block'
    document.getElementById('bSlotSection').style.display = 'none'
    document.getElementById('bSummary').style.display = 'none'
    bTime = null; document.getElementById('bTimeInput').value = ''
  }

  async function bLoadSlots() {
    const date = document.getElementById('bDateInput').value
    if (!date || !bCounselor) return
    document.getElementById('bSlotSection').style.display = 'none'
    document.getElementById('bSlotLoading').style.display = 'block'
    const resp  = await fetch(`/admin/appointments/slots?counselorId=${bCounselor.id}&date=${date}`)
    const { slots } = await resp.json()
    document.getElementById('bSlotLoading').style.display = 'none'
    document.getElementById('bSlotSection').style.display = 'block'
    const grid = document.getElementById('bSlotGrid')
    const available = slots.filter(s => s.available)
    if (!available.length) { grid.innerHTML = `<div style="font-size:12px;color:#94a3b8;grid-column:1/-1;">${slots.length ? 'เวลาทั้งหมดถูกจองแล้วในวันนี้' : 'ไม่มีตารางเวลาในวันนี้'}</div>`; return }
    grid.innerHTML = available.map(s =>
      `<button type="button" class="slot-btn" onclick="bSelectSlot(this,'${s.time}')">${s.time}</button>`
    ).join('')
  }

  function bSelectSlot(btn, time) {
    bTime = time; document.getElementById('bTimeInput').value = time
    document.querySelectorAll('#bSlotGrid .slot-btn').forEach(b => b.classList.remove('selected'))
    btn.classList.add('selected')
    const date = document.getElementById('bDateInput').value
    const ds   = new Date(date).toLocaleDateString('th-TH', {weekday:'short',day:'numeric',month:'short',year:'numeric'})
    document.getElementById('bSummCounselor').textContent = bCounselor.name
    document.getElementById('bSummDateTime').textContent  = `${ds} ${time} น.`
    document.getElementById('bSummary').style.display = 'block'
  }

  function submitBook() {
    const form = document.getElementById('bookForm')
    if (!form.reportValidity()) return
    if (!bTime) { alert('กรุณาเลือกเวลานัดหมาย'); return }
    form.submit()
  }

  // ── Create/Edit panel ─────────────────────────────────────────────────────────
  function openPanel(mode, data) {
    document.getElementById('panelForm').reset()
    if (mode === 'create') {
      document.getElementById('panelTitle').textContent   = 'เพิ่มผู้รับบริการ'
      document.getElementById('panelSub').textContent     = 'กรอกข้อมูลให้ครบถ้วน'
      document.getElementById('panelIcon').setAttribute('data-lucide', 'user-plus')
      document.getElementById('submitLabel').textContent  = 'เพิ่มผู้รับบริการ'
      document.getElementById('panelForm').action        = '/admin/clients/create'
      document.getElementById('r_active').checked        = true
    } else {
      document.getElementById('panelTitle').textContent   = 'แก้ไขข้อมูล'
      document.getElementById('panelSub').textContent     = data.name
      document.getElementById('panelIcon').setAttribute('data-lucide', 'pencil')
      document.getElementById('submitLabel').textContent  = 'บันทึกการแก้ไข'
      document.getElementById('panelForm').action        = '/admin/clients/' + data.id + '/edit'
      document.getElementById('f_name').value            = data.name      || ''
      document.getElementById('f_studentId').value       = data.studentId || ''
      document.getElementById('f_email').value           = data.email     || ''
      document.getElementById('f_phone').value           = data.phone     || ''
      document.getElementById('f_age').value             = data.age       || ''
      document.getElementById('f_gender').value          = data.gender || 'unspecified'
      document.getElementById(data.status==='active' ? 'r_active' : 'r_inactive').checked = true
    }
    lucide.createIcons()
    const ov = document.getElementById('overlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('panel').classList.add('open')
    document.body.style.overflow = 'hidden'
  }
  function closePanel() {
    const ov = document.getElementById('overlay')
    ov.classList.remove('open')
    document.getElementById('panel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  function submitPanel() { const f=document.getElementById('panelForm'); if(f.reportValidity()) f.submit() }

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openPanel('edit', JSON.parse(btn.dataset.rec)))
  })
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closePanel(); closeBook(); closeDetail() }
  })
  lucide.createIcons()
</script>
</body>
</html>
