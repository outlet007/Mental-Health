<!-- ░░░ Book overlay ░░░ -->
<div id="bookOverlay" class="panel-overlay" onclick="closeBook()"></div>
<div id="bookPanel" class="panel-drawer" style="max-width:540px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:#3874FF;display:flex;align-items:center;justify-content:center;"><i data-lucide="calendar-plus" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#1e293b;">ทำนัดหมายใหม่</div>
        <div id="bookPanelSub" style="font-size:12px;color:#94a3b8;"></div>
      </div>
    </div>
    <button onclick="closeBook()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;">
    <form method="POST" action="/admin/appointments/create" id="bookForm">
      <input type="hidden" name="clientId" id="bookClientId">
      <!-- Step 1 -->
      <div style="padding:16px 20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#3874FF;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">1</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกนักจิตวิทยาให้คำปรึกษา</span>
        </div>
        <div style="display:grid;gap:8px;" id="bCounselorList">
          <%
            const _DAY_ABBR = { 0:'อา', 1:'จ', 2:'อ', 3:'พ', 4:'พฤ', 5:'ศ', 6:'ส' }
            const _cDays = {}
            schedules.forEach(s => {
              if (!s.isActive) return
              if (!_cDays[s.counselorId]) _cDays[s.counselorId] = []
              if (!_cDays[s.counselorId].includes(s.dayOfWeek)) _cDays[s.counselorId].push(s.dayOfWeek)
            })
            Object.keys(_cDays).forEach(k => _cDays[k].sort((a,b) => a-b))
          %>
          <% counselors.forEach(cn => { %>
          <% if (isCounselorView) { %>
          <div class="counselor-card selected" id="bcard_<%= cn.id %>" style="cursor:default;">
            <input type="hidden" name="counselorId" value="<%= cn.id %>">
          <% } else { %>
          <label class="counselor-card" id="bcard_<%= cn.id %>">
            <input type="radio" name="counselorId" value="<%= cn.id %>" data-duration="<%= cn.sessionDuration %>" data-name="<%= cn.name %>" style="accent-color:#3874FF;" onchange="bOnCounselorChange(this)" required>
          <% } %>
            <div style="width:36px;height:36px;border-radius:10px;overflow:hidden;background:#3874FF;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0;">
              <% if (cn.photo) { %>
                <img data-counselor-profile-photo="<%= cn.id %>" src="<%= cn.photo %>" alt="<%= cn.name %>" style="width:100%;height:100%;object-fit:cover;">
              <% } else { %>
                <%= cn.avatar||cn.name.slice(0,1) %>
              <% } %>
            </div>
            <div style="flex:1;min-width:0;">
              <div style="display:flex;align-items:center;flex-wrap:wrap;gap:3px;">
                <span style="font-weight:600;font-size:13px;color:#1e293b;"><%= cn.name %></span>
                <% (_cDays[cn.id] || []).forEach(dow => { %>
                <span style="width:20px;height:20px;border-radius:50%;background:#eaf1ff;border:1px solid #b9d0ff;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#3874FF;flex-shrink:0;" title="วัน<%= ['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'][dow] %>">
                  <%= _DAY_ABBR[dow] %>
                </span>
                <% }) %>
              </div>
              <div style="font-size:12px;color:#94a3b8;"><%= cn.title %></div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
              <div style="font-size:12px;font-weight:700;color:#3874FF;">นัดหมายรวม <%= counselorActiveCounts[cn.id] || 0 %> นัด</div>
              <div style="font-size:12px;color:#94a3b8;"><%= cn.sessionDuration %> นาที</div>
            </div>
          <% if (isCounselorView) { %>
          </div>
          <% } else { %>
          </label>
          <% } %>
          <% }) %>
        </div>
      </div>
      <!-- Step 2 -->
      <div style="padding:16px 20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#3874FF;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">2</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกวันที่และเวลา</span>
        </div>
        <div style="margin-bottom:12px;">
          <label class="lbl">วันที่นัดหมาย</label>
          <input type="date" name="date" id="bDateInput" min="<%= new Date().toISOString().split('T')[0] %>" class="inp" onchange="bLoadSlots()" required disabled>
          <div id="bDateHint" style="font-size:12px;color:#94a3b8;margin-top:5px;">กรุณาเลือกนักจิตวิทยาก่อน</div>
        </div>
        <div id="bAvailableDays" style="display:none;margin-bottom:12px;">
          <div style="font-size:12px;font-weight:500;color:#64748b;margin-bottom:6px;">วันที่เปิดรับนัด</div>
          <div id="bDayBadges" style="display:flex;flex-wrap:wrap;gap:6px;"></div>
        </div>
        <div id="bSlotLoading" style="display:none;font-size:13px;color:#94a3b8;padding:6px 0;">กำลังโหลดช่วงเวลา...</div>
        <div id="bSlotSection" style="display:none;">
          <label class="lbl">เลือกเวลา *</label>
          <div id="bSlotGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:6px;"></div>
          <input type="hidden" name="time" id="bTimeInput" required>
        </div>
      </div>
      <!-- Step 3 -->
      <div style="padding:16px 20px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#3874FF;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">3</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">รูปแบบและหมายเหตุ</span>
        </div>
        <div style="display:grid;gap:12px;">
          <div>
            <label class="lbl">รูปแบบ</label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #a5f3fc;border-radius:10px;cursor:pointer;background:#ecfeff;">
                <input type="radio" name="type" value="online" id="bTypeOnline" checked style="accent-color:#0891b2;"><i data-lucide="video" style="width:14px;height:14px;color:#0891b2;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">ออนไลน์</span>
              </label>
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">
                <input type="radio" name="type" value="onsite" id="bTypeOnsite" style="accent-color:#05967e;"><i data-lucide="map-pin" style="width:14px;height:14px;color:#05967e;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">เข้ารับบริการด้วยตนเอง</span>
              </label>
            </div>
          </div>
          <div>
            <label class="lbl">เรื่องที่ต้องการความช่วยเหลือ</label>
            <textarea name="concern" rows="2" class="inp" style="resize:none;" placeholder="เช่น ความเครียดจากการเรียน, ปัญหาความสัมพันธ์ ฯลฯ"></textarea>
          </div>
          <div>
            <label class="lbl">หมายเหตุ (ถ้ามี)</label>
            <textarea name="note" rows="2" class="inp" style="resize:none;" placeholder="เช่น ต่อเนื่องจากครั้งที่แล้ว..."></textarea>
          </div>
          <div id="bSummary" style="display:none;padding:12px;background:#eaf1ff;border:1px solid #b9d0ff;border-radius:12px;">
            <div style="font-size:12px;font-weight:600;color:#64748b;margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;">สรุป</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;"><span style="color:#64748b;">นักจิตวิทยา</span><span id="bSummCounselor" style="font-weight:500;color:#1e293b;"></span></div>
            <div style="display:flex;justify-content:space-between;font-size:13px;"><span style="color:#64748b;">วันเวลา</span><span id="bSummDateTime" style="font-weight:500;color:#1e293b;"></span></div>
          </div>
        </div>
      </div>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closeBook()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
    <button onclick="submitBook()" class="act-btn ab-violet" style="flex:1;justify-content:center;"><i data-lucide="calendar-check" style="width:14px;height:14px;"></i> ยืนยันนัดหมาย</button>
  </div>
</div>

