<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — MindWell Admin</title>
  <%- include('../partials/head') %>
  <style>
    .tbl{width:100%;border-collapse:collapse}.tbl thead{background:#f8fafc}.tbl th{padding:10px 14px;text-align:left;font-size:12px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #f1f5f9;white-space:nowrap}.tbl td{padding:12px 14px;font-size:14px;color:#334155;border-bottom:1px solid #f8fafc;vertical-align:middle}.tbl tbody tr:hover{background:#f8fafc}.tbl tbody tr:last-child td{border-bottom:none}
    .act-btn{display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;border:none;transition:all .15s;text-decoration:none;white-space:nowrap}
    .ab-primary{background:#05967e;color:#fff}.ab-primary:hover{background:#067866}
    .ab-secondary{background:#fff;color:#05967e;border:1px solid #a0f3e1}.ab-secondary:hover{background:#ecfdf9}
    .ab-ghost{background:transparent;color:#64748b}.ab-ghost:hover{background:#f1f5f9}
    .ab-danger{background:#ef4444;color:#fff}.ab-danger:hover{background:#dc2626}
    .ab-violet{background:linear-gradient(135deg,#7c3aed,#6366f1);color:#fff}.ab-violet:hover{opacity:.9}
    .panel-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:40;display:none;backdrop-filter:blur(2px);opacity:0;transition:opacity .2s ease}.panel-overlay.open{opacity:1}
    .panel-drawer{position:fixed;top:50%;left:50%;width:calc(100% - 48px);max-width:480px;max-height:90vh;background:#fff;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.18);z-index:50;display:flex;flex-direction:column;transform:translate(-50%,-50%) scale(.94);opacity:0;transition:transform .22s cubic-bezier(.34,1.56,.64,1),opacity .18s ease;pointer-events:none}.panel-drawer.open{transform:translate(-50%,-50%) scale(1);opacity:1;pointer-events:auto}
    .inp{width:100%;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;color:#334155;outline:none;font-family:inherit;box-sizing:border-box}.inp:focus{border-color:#2dd4b4;box-shadow:0 0 0 3px rgba(45,212,180,.15)}
    .lbl{display:block;font-size:12px;font-weight:500;color:#64748b;margin-bottom:5px}
    .counselor-card{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:12px;cursor:pointer;transition:all .15s}.counselor-card:hover{border-color:#2dd4b4;background:#ecfdf9}.counselor-card.selected{border-color:#7c3aed;background:#f3e8ff}
    .slot-btn{padding:7px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:12px;font-weight:500;color:#334155;cursor:pointer;background:#fff;transition:all .15s}.slot-btn:hover:not(:disabled){border-color:#7c3aed;background:#f3e8ff}.slot-btn.selected{border-color:#7c3aed;background:#7c3aed;color:#fff}.slot-btn:disabled{opacity:.4;cursor:not-allowed;text-decoration:line-through}
    .appt-row{padding:10px 12px;border:1px solid #f1f5f9;border-radius:10px;margin-bottom:6px;cursor:pointer;transition:background .15s}.appt-row:hover{background:#f8fafc}
    .appt-detail{display:none;padding:10px 12px;background:#f8fafc;border-radius:8px;margin-top:6px;font-size:12px;color:#64748b;line-height:1.8}
    .appt-row.expanded .appt-detail{display:block}
  </style>
</head>
<body style="background:#f8fafc;margin:0;">
<%- include('../partials/admin-sidebar') %>

<div style="margin-left:256px;min-height:100vh;display:flex;flex-direction:column;">

  <div style="height:56px;background:#fff;border-bottom:1px solid #f1f5f9;padding:0 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:20;">
    <h1 style="font-size:15px;font-weight:600;color:#1e293b;margin:0;"><%= title %></h1>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="font-size:12px;color:#94a3b8;"><% const d=new Date(); %><%= d.toLocaleDateString('th-TH',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %></span>
      <a href="/" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;border:1px solid #e2e8f0;background:#fff;font-size:12px;font-weight:500;color:#475569;text-decoration:none;">
        <i data-lucide="external-link" style="width:13px;height:13px;"></i>
        ดูหน้าเว็บหลัก
      </a>
    </div>
  </div>

  <div style="padding:14px 24px;background:#fff;border-bottom:2px solid #f1f5f9;display:flex;justify-content:flex-end;">
    <button onclick="openPanel('create')" style="display:inline-flex;align-items:center;gap:10px;padding:11px 22px;background:linear-gradient(135deg,#05967e,#06b6d4);color:#fff;border:none;border-radius:12px;font-size:14px;font-weight:600;cursor:pointer;box-shadow:0 2px 8px rgba(5,150,126,.30);transition:all .15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(5,150,126,.45)';this.style.transform='translateY(-1px)'" onmouseout="this.style.boxShadow='0 2px 8px rgba(5,150,126,.30)';this.style.transform='translateY(0)'">
      <i data-lucide="user-plus" style="width:18px;height:18px;"></i>
      + เพิ่มผู้รับบริการ
    </button>
  </div>

  <div style="padding:24px;">

    <!-- Alerts -->
    <% if (query.created) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:12px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> เพิ่มผู้รับบริการสำเร็จ</div>
    <% } if (query.updated) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#ecfeff;border:1px solid #a5f3fc;border-radius:12px;color:#155e75;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="check-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อัปเดตข้อมูลสำเร็จ</div>
    <% } if (query.deleted) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:12px;color:#475569;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="trash-2" style="width:16px;height:16px;flex-shrink:0;"></i> ลบผู้รับบริการออกจากระบบแล้ว</div>
    <% } if (query.booked) { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#ecfdf9;border:1px solid #a0f3e1;border-radius:12px;color:#065f46;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="calendar-check" style="width:16px;height:16px;flex-shrink:0;"></i> สร้างนัดหมายสำเร็จ</div>
    <% } if (query.error==='duplicate_email') { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#fef2f2;border:1px solid #fca5a5;border-radius:12px;color:#991b1b;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> อีเมลนี้มีในระบบแล้ว กรุณาใช้อีเมลอื่น</div>
    <% } if (query.error==='conflict') { %>
    <div style="margin-bottom:16px;padding:12px 16px;background:#fef2f2;border:1px solid #fca5a5;border-radius:12px;color:#991b1b;font-size:13px;display:flex;align-items:center;gap:8px;"><i data-lucide="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> ช่วงเวลานี้ถูกจองแล้ว กรุณาเลือกเวลาอื่น</div>
    <% } %>

    <!-- Filter -->
    <form method="GET" style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;padding:16px;margin-bottom:16px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;">
      <div style="flex:1;min-width:200px;">
        <label class="lbl">ค้นหา</label>
        <div style="position:relative;"><i data-lucide="search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:#94a3b8;"></i>
          <input name="search" value="<%= query.search||'' %>" class="inp" style="padding-left:32px;" placeholder="ชื่อ, อีเมล, เบอร์โทร">
        </div>
      </div>
      <div>
        <label class="lbl">สถานะ</label>
        <select name="status" class="inp" style="width:150px;">
          <option value="">ทั้งหมด</option>
          <option value="active" <%=query.status==='active'?'selected':''%>>ใช้งาน</option>
          <option value="inactive" <%=query.status==='inactive'?'selected':''%>>ไม่ได้ใช้งาน</option>
        </select>
      </div>
      <button type="submit" class="act-btn ab-primary"><i data-lucide="filter" style="width:13px;height:13px;"></i> กรอง</button>
      <a href="/admin/clients" class="act-btn ab-ghost">ล้าง</a>
    </form>

    <!-- Table -->
    <div style="background:#fff;border:1px solid #f1f5f9;border-radius:16px;overflow:hidden;">
      <div style="padding:14px 16px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
        <span style="font-size:13px;font-weight:600;color:#334155;">รายชื่อผู้รับบริการ</span>
        <span style="font-size:12px;color:#94a3b8;">ทั้งหมด <%= clients.length %> คน</span>
      </div>
      <div style="overflow-x:auto;">
        <table class="tbl">
          <thead>
            <tr>
              <th>ผู้รับบริการ</th>
              <th>ข้อมูลติดต่อ</th>
              <th>อายุ / เพศ</th>
              <th>นัดหมาย</th>
              <th>รับบริการล่าสุด</th>
              <th>สถานะ</th>
              <th>การจัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% clients.forEach(c => {
              const clientAppts = appointments.filter(a => a.clientId === c.id)
              const lastAppt    = clientAppts.sort((a,b)=>b.date.localeCompare(a.date))[0]
            %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:10px;">
                  <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#06b6d4,#05967e);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:12px;flex-shrink:0;"><%= c.name.slice(-2) %></div>
                  <div>
                    <div style="font-weight:600;color:#1e293b;font-size:13px;"><%= c.name %></div>
                    <div style="font-size:11px;color:#94a3b8;">ลงทะเบียน <%= c.registeredAt %></div>
                  </div>
                </div>
              </td>
              <td>
                <div style="font-size:13px;"><%= c.email %></div>
                <div style="font-size:11px;color:#94a3b8;"><%= c.phone %></div>
              </td>
              <td style="font-size:13px;"><%= c.age %> ปี / <%= c.gender %></td>
              <td>
                <div style="display:flex;align-items:center;gap:5px;">
                  <i data-lucide="calendar-check" style="width:13px;height:13px;color:#05967e;"></i>
                  <span style="font-weight:600;font-size:14px;color:#1e293b;"><%= clientAppts.length %></span>
                  <span style="font-size:11px;color:#94a3b8;">ครั้ง</span>
                </div>
              </td>
              <td style="font-size:12px;color:#64748b;"><%= lastAppt ? lastAppt.date : '—' %></td>
              <td>
                <% if (c.status==='active') { %>
                <span style="padding:3px 10px;background:#d1fae5;color:#065f46;border-radius:99px;font-size:11px;font-weight:500;">ใช้งาน</span>
                <% } else { %>
                <span style="padding:3px 10px;background:#fee2e2;color:#991b1b;border-radius:99px;font-size:11px;font-weight:500;">ไม่ได้ใช้งาน</span>
                <% } %>
              </td>
              <td>
                <div style="display:flex;align-items:center;gap:5px;flex-wrap:wrap;">
                  <button class="act-btn ab-secondary view-btn" data-id="<%= c.id %>" title="ดูข้อมูล">
                    <i data-lucide="eye" style="width:13px;height:13px;"></i> ดูข้อมูล
                  </button>
                  <button class="act-btn ab-secondary edit-btn" data-rec="<%= JSON.stringify(c) %>" title="แก้ไข">
                    <i data-lucide="pencil" style="width:13px;height:13px;"></i> แก้ไข
                  </button>
                  <form method="POST" action="/admin/clients/<%= c.id %>/delete" onsubmit="return confirm('ลบ <%= c.name %>?\nข้อมูลจะหายถาวร')" style="margin:0;">
                    <button type="submit" class="act-btn ab-danger" title="ลบ"><i data-lucide="trash-2" style="width:12px;height:12px;"></i></button>
                  </form>
                  <button class="act-btn ab-violet book-client-btn" data-rec="<%= JSON.stringify(c) %>" title="ทำนัดหมายใหม่">
                    <i data-lucide="calendar-plus" style="width:13px;height:13px;"></i> นัด
                  </button>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if (clients.length===0) { %>
            <tr><td colspan="7" style="text-align:center;padding:48px 16px;color:#94a3b8;">
              <i data-lucide="users" style="width:36px;height:36px;display:block;margin:0 auto 10px;opacity:.3;"></i>ไม่พบข้อมูลผู้รับบริการ
            </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ░░░ Detail overlay ░░░ -->
<div id="detailOverlay" class="panel-overlay" onclick="closeDetail()"></div>
<div id="detailPanel" class="panel-drawer" style="max-width:580px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div id="detailAvatar" style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#06b6d4,#05967e);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px;flex-shrink:0;"></div>
      <div>
        <div id="detailName" style="font-size:15px;font-weight:700;color:#1e293b;"></div>
        <div id="detailSub"  style="font-size:11px;color:#94a3b8;"></div>
      </div>
    </div>
    <button onclick="closeDetail()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;">
    <!-- Info section -->
    <div style="padding:16px 20px;border-bottom:1px solid #f8fafc;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;" id="detailInfoGrid"></div>
    </div>
    <!-- Appointments section -->
    <div style="padding:16px 20px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <div style="font-size:13px;font-weight:600;color:#1e293b;display:flex;align-items:center;gap:6px;">
          <i data-lucide="calendar-check" style="width:15px;height:15px;color:#05967e;"></i>
          ประวัติการนัดหมาย
          <span id="detailApptCount" style="padding:2px 8px;background:#d1fae5;color:#065f46;border-radius:99px;font-size:11px;font-weight:600;"></span>
        </div>
        <button id="detailBookBtn" class="act-btn ab-violet" onclick="openBookFromDetail()">
          <i data-lucide="calendar-plus" style="width:13px;height:13px;"></i> ทำนัดหมายใหม่
        </button>
      </div>
      <div id="detailApptList"></div>
    </div>
  </div>
</div>

<!-- ░░░ Book overlay ░░░ -->
<div id="bookOverlay" class="panel-overlay" onclick="closeBook()"></div>
<div id="bookPanel" class="panel-drawer" style="max-width:540px;">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#7c3aed,#6366f1);display:flex;align-items:center;justify-content:center;"><i data-lucide="calendar-plus" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div style="font-size:14px;font-weight:600;color:#1e293b;">ทำนัดหมายใหม่</div>
        <div id="bookPanelSub" style="font-size:11px;color:#94a3b8;"></div>
      </div>
    </div>
    <button onclick="closeBook()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;">
    <form method="POST" action="/admin/appointments/create" id="bookForm">
      <input type="hidden" name="clientId" id="bookClientId">
      <!-- Step 1 -->
      <div style="padding:16px 20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#7c3aed;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">1</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกนักจิตวิทยาให้คำปรึกษา</span>
        </div>
        <div style="display:grid;gap:8px;" id="bCounselorList">
          <% counselors.forEach(cn => { %>
          <label class="counselor-card" id="bcard_<%= cn.id %>">
            <input type="radio" name="counselorId" value="<%= cn.id %>" data-duration="<%= cn.sessionDuration %>" data-name="<%= cn.name %>" style="accent-color:#7c3aed;" onchange="bOnCounselorChange(this)" required>
            <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#2dd4b4,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0;"><%= cn.avatar||cn.name.slice(0,1) %></div>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:600;font-size:13px;color:#1e293b;"><%= cn.name %></div>
              <div style="font-size:11px;color:#94a3b8;"><%= cn.title %></div>
            </div>
            <div style="font-size:11px;color:#94a3b8;flex-shrink:0;"><%= cn.sessionDuration %> นาที</div>
          </label>
          <% }) %>
        </div>
      </div>
      <!-- Step 2 -->
      <div style="padding:16px 20px;border-bottom:1px solid #f8fafc;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#7c3aed;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">2</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">เลือกวันที่และเวลา</span>
        </div>
        <div style="margin-bottom:12px;">
          <label class="lbl">วันที่นัดหมาย</label>
          <input type="date" name="date" id="bDateInput" min="<%= new Date().toISOString().split('T')[0] %>" class="inp" onchange="bLoadSlots()" required disabled>
          <div id="bDateHint" style="font-size:11px;color:#94a3b8;margin-top:5px;">กรุณาเลือกนักจิตวิทยาก่อน</div>
        </div>
        <div id="bSlotLoading" style="display:none;font-size:13px;color:#94a3b8;padding:6px 0;">กำลังโหลดช่วงเวลา...</div>
        <div id="bSlotSection" style="display:none;">
          <label class="lbl">เลือกเวลา *</label>
          <div id="bSlotGrid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:6px;"></div>
          <input type="hidden" name="time" id="bTimeInput" required>
        </div>
      </div>
      <!-- Step 3 -->
      <div style="padding:16px 20px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <div style="width:22px;height:22px;border-radius:50%;background:#7c3aed;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;">3</div>
          <span style="font-size:13px;font-weight:600;color:#1e293b;">รูปแบบและหมายเหตุ</span>
        </div>
        <div style="display:grid;gap:12px;">
          <div>
            <label class="lbl">รูปแบบ</label>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #a5f3fc;border-radius:10px;cursor:pointer;background:#ecfeff;">
                <input type="radio" name="type" value="online" id="bTypeOnline" checked style="accent-color:#0891b2;"><i data-lucide="video" style="width:14px;height:14px;color:#0891b2;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">ออนไลน์</span>
              </label>
              <label style="display:flex;align-items:center;gap:8px;padding:10px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">
                <input type="radio" name="type" value="onsite" id="bTypeOnsite" style="accent-color:#05967e;"><i data-lucide="map-pin" style="width:14px;height:14px;color:#05967e;flex-shrink:0;"></i><span style="font-size:13px;font-weight:500;">เข้ารับบริการด้วยตนเอง</span>
              </label>
            </div>
          </div>
          <div>
            <label class="lbl">หมายเหตุ (ถ้ามี)</label>
            <textarea name="note" rows="2" class="inp" style="resize:none;" placeholder="เช่น ต่อเนื่องจากครั้งที่แล้ว..."></textarea>
          </div>
          <div id="bSummary" style="display:none;padding:12px;background:#f3e8ff;border:1px solid #ddd6fe;border-radius:12px;">
            <div style="font-size:11px;font-weight:600;color:#64748b;margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em;">สรุป</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px;"><span style="color:#64748b;">นักจิตวิทยา</span><span id="bSummCounselor" style="font-weight:500;color:#1e293b;"></span></div>
            <div style="display:flex;justify-content:space-between;font-size:13px;"><span style="color:#64748b;">วันเวลา</span><span id="bSummDateTime" style="font-weight:500;color:#1e293b;"></span></div>
          </div>
        </div>
      </div>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closeBook()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
    <button onclick="submitBook()" class="act-btn ab-violet" style="flex:1;justify-content:center;"><i data-lucide="calendar-check" style="width:14px;height:14px;"></i> ยืนยันนัดหมาย</button>
  </div>
</div>

<!-- ░░░ Create/Edit overlay ░░░ -->
<div id="overlay" class="panel-overlay" onclick="closePanel()"></div>
<div id="panel" class="panel-drawer">
  <div style="padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#06b6d4,#05967e);display:flex;align-items:center;justify-content:center;"><i id="panelIcon" data-lucide="user-plus" style="width:15px;height:15px;color:#fff;"></i></div>
      <div>
        <div id="panelTitle" style="font-size:14px;font-weight:600;color:#1e293b;">เพิ่มผู้รับบริการ</div>
        <div id="panelSub"   style="font-size:11px;color:#94a3b8;">กรอกข้อมูลให้ครบถ้วน</div>
      </div>
    </div>
    <button onclick="closePanel()" style="background:none;border:none;cursor:pointer;padding:6px;border-radius:8px;color:#94a3b8;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
  </div>
  <div style="flex:1;overflow-y:auto;padding:20px;">
    <form id="panelForm" method="POST" action="/admin/clients/create">
      <div style="display:grid;gap:16px;">
        <div>
          <label class="lbl">ชื่อ-นามสกุล *</label>
          <input type="text" name="name" id="f_name" class="inp" required placeholder="นายสมชาย ใจดี">
        </div>
        <div>
          <label class="lbl">รหัสนักศึกษา</label>
          <input type="text" name="studentId" id="f_studentId" class="inp" placeholder="เช่น 6501234567">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label class="lbl">อายุ</label>
            <input type="number" name="age" id="f_age" class="inp" min="1" max="120" placeholder="25">
          </div>
          <div>
            <label class="lbl">เพศ</label>
            <select name="gender" id="f_gender" class="inp">
              <option value="ชาย">ชาย</option>
              <option value="หญิง">หญิง</option>
              <option value="ไม่ระบุ">ไม่ระบุ</option>
            </select>
          </div>
        </div>
        <div>
          <label class="lbl">อีเมล *</label>
          <input type="email" name="email" id="f_email" class="inp" required placeholder="example@email.com">
        </div>
        <div>
          <label class="lbl">เบอร์โทรศัพท์</label>
          <input type="tel" name="phone" id="f_phone" class="inp" placeholder="08X-XXX-XXXX">
        </div>
        <div>
          <label class="lbl">สถานะบัญชี</label>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <label style="display:flex;align-items:flex-start;gap:10px;padding:12px;border:1.5px solid #a0f3e1;border-radius:10px;cursor:pointer;background:#ecfdf9;">
              <input type="radio" name="status" value="active" id="r_active" checked style="margin-top:2px;accent-color:#05967e;">
              <div><div style="font-size:13px;font-weight:500;color:#1e293b;">ใช้งาน</div><div style="font-size:11px;color:#64748b;">เข้าสู่ระบบได้</div></div>
            </label>
            <label style="display:flex;align-items:flex-start;gap:10px;padding:12px;border:1.5px solid #e2e8f0;border-radius:10px;cursor:pointer;">
              <input type="radio" name="status" value="inactive" id="r_inactive" style="margin-top:2px;accent-color:#ef4444;">
              <div><div style="font-size:13px;font-weight:500;color:#1e293b;">ไม่ได้ใช้งาน</div><div style="font-size:11px;color:#64748b;">ระงับชั่วคราว</div></div>
            </label>
          </div>
        </div>
      </div>
    </form>
  </div>
  <div style="padding:16px 20px;border-top:1px solid #f1f5f9;display:flex;gap:10px;">
    <button onclick="closePanel()" class="act-btn ab-secondary" style="flex:1;justify-content:center;">ยกเลิก</button>
    <button onclick="submitPanel()" class="act-btn ab-primary" style="flex:1;justify-content:center;"><i data-lucide="save" style="width:14px;height:14px;"></i> <span id="submitLabel">บันทึก</span></button>
  </div>
</div>

<script>
  const ALL_APPOINTMENTS = <%- JSON.stringify(appointments) %>
  const SCHEDULES        = <%- JSON.stringify(schedules) %>

  const STATUS_LABEL = { pending:'รอยืนยัน', confirmed:'ยืนยันแล้ว', completed:'เสร็จสิ้น', cancelled:'ยกเลิก' }
  const STATUS_COLOR = {
    pending:   {bg:'#fef3c7',color:'#92400e'},
    confirmed: {bg:'#dbeafe',color:'#1e40af'},
    completed: {bg:'#d1fae5',color:'#065f46'},
    cancelled: {bg:'#fee2e2',color:'#991b1b'},
  }

  // ── Detail modal ──────────────────────────────────────────────────────────────
  let detailClient = null

  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id
      openDetail(id)
    })
  })

  function openDetail(id) {
    const rowBtn  = document.querySelector(`.book-client-btn[data-rec]`)
    // find client data from book-client-btn with matching id
    let client = null
    document.querySelectorAll('.book-client-btn').forEach(b => {
      const c = JSON.parse(b.dataset.rec)
      if (c.id === id) client = c
    })
    if (!client) return
    detailClient = client

    document.getElementById('detailAvatar').textContent = client.name.slice(-2)
    document.getElementById('detailName').textContent   = client.name
    document.getElementById('detailSub').textContent    = client.email || client.phone

    const statusLabel = client.status === 'active' ? 'ใช้งาน' : 'ไม่ได้ใช้งาน'
    document.getElementById('detailInfoGrid').innerHTML = [
      ['อีเมล',       client.email  || '—'],
      ['โทรศัพท์',   client.phone  || '—'],
      ['อายุ',        (client.age   || '—') + ' ปี'],
      ['เพศ',         client.gender || '—'],
      ['สถานะ',       statusLabel],
      ['ลงทะเบียน',  client.registeredAt || '—'],
    ].map(([k,v]) => `
      <div>
        <div style="font-size:11px;color:#94a3b8;margin-bottom:2px;">${k}</div>
        <div style="font-size:13px;color:#1e293b;font-weight:500;">${v}</div>
      </div>`
    ).join('')

    const appts = ALL_APPOINTMENTS
      .filter(a => a.clientId === id)
      .sort((a, b) => b.date.localeCompare(a.date))

    document.getElementById('detailApptCount').textContent = appts.length + ' ครั้ง'

    if (appts.length === 0) {
      document.getElementById('detailApptList').innerHTML =
        '<div style="text-align:center;padding:24px;color:#94a3b8;font-size:13px;">ยังไม่มีประวัติการนัดหมาย</div>'
    } else {
      document.getElementById('detailApptList').innerHTML = appts.map((a, i) => {
        const sc = STATUS_COLOR[a.status] || {bg:'#f1f5f9',color:'#64748b'}
        const sl = STATUS_LABEL[a.status] || a.status
        const typeLabel = a.type === 'online' ? 'ออนไลน์' : 'เข้ารับบริการด้วยตนเอง'
        return `
          <div class="appt-row" onclick="toggleAppt(this)">
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:11px;font-weight:600;color:#94a3b8;">#${appts.length - i}</span>
                <span style="font-size:13px;font-weight:600;color:#1e293b;">${a.date}</span>
                <span style="font-size:12px;color:#64748b;">${a.time} น.</span>
              </div>
              <div style="display:flex;align-items:center;gap:6px;">
                <span style="padding:2px 8px;background:${sc.bg};color:${sc.color};border-radius:99px;font-size:11px;font-weight:500;">${sl}</span>
                <i data-lucide="chevron-down" style="width:14px;height:14px;color:#94a3b8;transition:transform .15s;" class="chevron-icon"></i>
              </div>
            </div>
            <div class="appt-detail">
              <div><strong>นักจิตวิทยา:</strong> ${a.counselorName || '—'}</div>
              <div><strong>รูปแบบ:</strong> ${typeLabel}</div>
              <div><strong>ระยะเวลา:</strong> ${a.duration || 60} นาที</div>
              ${a.note ? `<div><strong>หมายเหตุ:</strong> ${a.note}</div>` : ''}
            </div>
          </div>`
      }).join('')
    }

    const do_ = document.getElementById('detailOverlay')
    do_.style.display = 'block'
    requestAnimationFrame(() => do_.classList.add('open'))
    document.getElementById('detailPanel').classList.add('open')
    document.body.style.overflow = 'hidden'
    lucide.createIcons()
  }

  function toggleAppt(row) {
    const expanded = row.classList.toggle('expanded')
    const icon = row.querySelector('.chevron-icon')
    if (icon) icon.style.transform = expanded ? 'rotate(180deg)' : 'rotate(0)'
  }

  function closeDetail() {
    const do_ = document.getElementById('detailOverlay')
    do_.classList.remove('open')
    document.getElementById('detailPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { do_.style.display = 'none' }, 200)
  }

  function openBookFromDetail() {
    closeDetail()
    setTimeout(() => { if (detailClient) openBook(detailClient) }, 220)
  }

  // ── Book modal ────────────────────────────────────────────────────────────────
  let bCounselor = null, bTime = null

  document.querySelectorAll('.book-client-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      openBook(JSON.parse(btn.dataset.rec))
    })
  })

  function openBook(client) {
    document.getElementById('bookClientId').value         = client.id
    document.getElementById('bookPanelSub').textContent   = 'สำหรับ ' + client.name

    bCounselor = null; bTime = null
    document.getElementById('bDateInput').disabled = true
    document.getElementById('bDateInput').value    = ''
    document.getElementById('bDateHint').style.display = 'block'
    document.getElementById('bSlotSection').style.display = 'none'
    document.getElementById('bSummary').style.display    = 'none'
    document.querySelectorAll('#bCounselorList .counselor-card').forEach(el => el.classList.remove('selected'))
    document.querySelectorAll('#bCounselorList input[name="counselorId"]').forEach(r => r.checked = false)

    const bo = document.getElementById('bookOverlay')
    bo.style.display = 'block'
    requestAnimationFrame(() => bo.classList.add('open'))
    document.getElementById('bookPanel').classList.add('open')
    document.body.style.overflow = 'hidden'
  }

  function closeBook() {
    const bo = document.getElementById('bookOverlay')
    bo.classList.remove('open')
    document.getElementById('bookPanel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { bo.style.display = 'none' }, 200)
  }

  function bOnCounselorChange(radio) {
    bCounselor = { id: radio.value, duration: parseInt(radio.dataset.duration), name: radio.dataset.name }
    document.querySelectorAll('#bCounselorList .counselor-card').forEach(el => {
      const r = el.querySelector('input[name="counselorId"]')
      el.classList.toggle('selected', r && r.value === radio.value)
    })
    document.getElementById('bDateInput').disabled = false
    document.getElementById('bDateInput').value    = ''
    document.getElementById('bDateHint').style.display = 'none'
    document.getElementById('bSlotSection').style.display = 'none'
    document.getElementById('bSummary').style.display = 'none'
    bTime = null; document.getElementById('bTimeInput').value = ''
  }

  async function bLoadSlots() {
    const date = document.getElementById('bDateInput').value
    if (!date || !bCounselor) return
    document.getElementById('bSlotSection').style.display = 'none'
    document.getElementById('bSlotLoading').style.display = 'block'
    const resp  = await fetch(`/admin/appointments/slots?counselorId=${bCounselor.id}&date=${date}`)
    const { slots } = await resp.json()
    document.getElementById('bSlotLoading').style.display = 'none'
    document.getElementById('bSlotSection').style.display = 'block'
    const grid = document.getElementById('bSlotGrid')
    if (!slots.length) { grid.innerHTML = '<div style="font-size:12px;color:#94a3b8;grid-column:1/-1;">ไม่มีตารางเวลาในวันนี้</div>'; return }
    grid.innerHTML = slots.map(s =>
      `<button type="button" class="slot-btn" onclick="bSelectSlot(this,'${s.time}')" ${!s.available?'disabled':''}>${s.time}</button>`
    ).join('')
  }

  function bSelectSlot(btn, time) {
    bTime = time; document.getElementById('bTimeInput').value = time
    document.querySelectorAll('#bSlotGrid .slot-btn').forEach(b => b.classList.remove('selected'))
    btn.classList.add('selected')
    const date = document.getElementById('bDateInput').value
    const ds   = new Date(date).toLocaleDateString('th-TH', {weekday:'short',day:'numeric',month:'short',year:'numeric'})
    document.getElementById('bSummCounselor').textContent = bCounselor.name
    document.getElementById('bSummDateTime').textContent  = `${ds} ${time} น.`
    document.getElementById('bSummary').style.display = 'block'
  }

  function submitBook() {
    const form = document.getElementById('bookForm')
    if (!form.reportValidity()) return
    if (!bTime) { alert('กรุณาเลือกเวลานัดหมาย'); return }
    form.submit()
  }

  // ── Create/Edit panel ─────────────────────────────────────────────────────────
  function openPanel(mode, data) {
    document.getElementById('panelForm').reset()
    if (mode === 'create') {
      document.getElementById('panelTitle').textContent   = 'เพิ่มผู้รับบริการ'
      document.getElementById('panelSub').textContent     = 'กรอกข้อมูลให้ครบถ้วน'
      document.getElementById('panelIcon').setAttribute('data-lucide', 'user-plus')
      document.getElementById('submitLabel').textContent  = 'เพิ่มผู้รับบริการ'
      document.getElementById('panelForm').action        = '/admin/clients/create'
      document.getElementById('r_active').checked        = true
    } else {
      document.getElementById('panelTitle').textContent   = 'แก้ไขข้อมูล'
      document.getElementById('panelSub').textContent     = data.name
      document.getElementById('panelIcon').setAttribute('data-lucide', 'pencil')
      document.getElementById('submitLabel').textContent  = 'บันทึกการแก้ไข'
      document.getElementById('panelForm').action        = '/admin/clients/' + data.id + '/edit'
      document.getElementById('f_name').value            = data.name      || ''
      document.getElementById('f_studentId').value       = data.studentId || ''
      document.getElementById('f_email').value           = data.email     || ''
      document.getElementById('f_phone').value           = data.phone     || ''
      document.getElementById('f_age').value             = data.age       || ''
      document.getElementById('f_gender').value          = data.gender || 'ไม่ระบุ'
      document.getElementById(data.status==='active' ? 'r_active' : 'r_inactive').checked = true
    }
    lucide.createIcons()
    const ov = document.getElementById('overlay')
    ov.style.display = 'block'
    requestAnimationFrame(() => ov.classList.add('open'))
    document.getElementById('panel').classList.add('open')
    document.body.style.overflow = 'hidden'
  }
  function closePanel() {
    const ov = document.getElementById('overlay')
    ov.classList.remove('open')
    document.getElementById('panel').classList.remove('open')
    document.body.style.overflow = ''
    setTimeout(() => { ov.style.display = 'none' }, 200)
  }
  function submitPanel() { const f=document.getElementById('panelForm'); if(f.reportValidity()) f.submit() }

  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => openPanel('edit', JSON.parse(btn.dataset.rec)))
  })
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closePanel(); closeBook(); closeDetail() }
  })
  lucide.createIcons()
</script>
</body>
</html>
