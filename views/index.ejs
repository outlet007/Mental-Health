<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MindCare — ระบบจองนัดหมายการให้คำปรึกษาทางจิตใจ</title>
  <%- include('./partials/head') %>
  <style>
    [data-animate]{opacity:0;transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1);}
    [data-animate="fade-up"]   {transform:translateY(36px);}
    [data-animate="fade-down"] {transform:translateY(-22px);}
    [data-animate="fade-right"]{transform:translateX(-44px);}
    [data-animate="fade-left"] {transform:translateX(44px);}
    [data-animate="zoom-in"]   {transform:scale(.86);}
    [data-animate].is-visible  {opacity:1;transform:none;}
    .section-bg-motion { transform-origin:center; will-change:transform; }
    @media (prefers-reduced-motion: reduce) {
      .section-bg-motion { animation:none !important; transform:none; }
    }
  </style>
</head>
<body class="bg-white">
<%
const _bgs = content.backgrounds || {}
const featureContent = content.features || {}
const featureDefaults = [
  { icon:'shield-check', text:'นักให้คำปรึกษาผ่านการตรวจสอบและรับรองคุณสมบัติ' },
  { icon:'lock', text:'ข้อมูลทุกอย่างเป็นความลับตาม PDPA' },
  { icon:'clock', text:'จองนัดได้ตลอด 24 ชั่วโมง ทุกวัน' },
  { icon:'video', text:'รองรับทั้งการพบออนไลน์และเข้ารับบริการด้วยตนเอง' },
  { icon:'bell', text:'แจ้งเตือนก่อนนัดหมาย ไม่ลืมแน่นอน' },
]
const featureItems = Array.isArray(featureContent.items) && featureContent.items.length
  ? featureContent.items.map((text, idx) => ({ icon: featureDefaults[idx] ? featureDefaults[idx].icon : 'check-circle', text }))
  : featureDefaults
const enFeatureContent = (content.en && content.en.features) || {}
const enFeatureDefaults = [
  'Counselors verified and certified',
  'All information is confidential under PDPA',
  'Book appointments 24 hours a day, every day',
  'Supports both online and in-person sessions',
  'Appointment reminders so you never miss a session',
]
const enFeatureItems = Array.isArray(enFeatureContent.items) && enFeatureContent.items.length ? enFeatureContent.items : enFeatureDefaults
const concernDefaults = ['ความวิตกกังวล / ความเครียด', 'ภาวะซึมเศร้า', 'ปัญหาความสัมพันธ์', 'ปัญหาครอบครัว', 'ความเศร้าโศก / การสูญเสีย', 'อื่นๆ']
const concernItems = Array.isArray(content.book && content.book.concernOptions) && content.book.concernOptions.length ? content.book.concernOptions : concernDefaults
const enConcernDefaults = ['Anxiety / Stress', 'Depression', 'Relationship Issues', 'Family Problems', 'Grief / Loss', 'Other']
const enBookContent = (content.en && content.en.book) || {}
const enConcernItems = Array.isArray(enBookContent.concernOptions) && enBookContent.concernOptions.length ? enBookContent.concernOptions : enConcernDefaults
const bookFormTexts = (content.book && content.book.formTexts) || {}
const enBookFormTexts = enBookContent.formTexts || {}
function bookText(texts, key, fallback) {
  return texts[key] || fallback
}
function _featureText(items, idx, fallback) {
  return items[idx] || fallback
}
function _hexToRgba(hex, a) {
  if (!hex || !/^#[0-9A-Fa-f]{6}$/.test(hex)) return null
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16)
  return 'rgba('+r+','+g+','+b+','+a+')'
}
// Returns inline color style for a specific text element in a section
function _tc(sec, field) {
  const bg = _bgs[sec] || {}
  const c = (bg.textColors || {})[field]
  return (c && /^#[0-9A-Fa-f]{6}$/.test(c)) ? 'color:' + c + ';' : ''
}
// Generates HTML for absolutely-positioned bg layer divs inside a section
// Layer order (bottom→top): image → color overlay → content (z-index:2 on content wrapper)
function _bgLayers(sec) {
  const bg = _bgs[sec] || {}
  if (!bg.image && !bg.color) return ''
  const colorOp = typeof bg.opacity    === 'number' ? bg.opacity    : 1
  const imgOp   = typeof bg.imgOpacity === 'number' ? bg.imgOpacity : 1
  const motionEnabled = bg.motionEnabled !== false
  const motionDuration = typeof bg.motionDuration === 'number' ? bg.motionDuration : 38
  const motionScale = typeof bg.motionScale === 'number' ? bg.motionScale : 1.12
  let html = ''
  if (bg.image) {
    if (motionEnabled) {
      const kfName = '_bgzm_' + sec
      html += '<style>@keyframes ' + kfName + '{from{transform:scale(1)}to{transform:scale(' + motionScale + ')}}</style>'
      html += '<div aria-hidden="true" class="section-bg-motion" style="position:absolute;inset:0;background-image:url(\'' + bg.image + '\');background-size:cover;background-position:center;background-repeat:no-repeat;opacity:' + imgOp + ';animation:' + kfName + ' ' + motionDuration + 's ease-in-out infinite alternate;pointer-events:none;z-index:0;"></div>'
    } else {
      html += '<div aria-hidden="true" style="position:absolute;inset:0;background-image:url(\'' + bg.image + '\');background-size:cover;background-position:center;background-repeat:no-repeat;opacity:' + imgOp + ';pointer-events:none;z-index:0;"></div>'
    }
  }
  if (bg.color) {
    const rgba = _hexToRgba(bg.color, colorOp) || bg.color
    html += '<div aria-hidden="true" style="position:absolute;inset:0;background-color:'+rgba+';pointer-events:none;z-index:1;"></div>'
  }
  return html
}
%>

