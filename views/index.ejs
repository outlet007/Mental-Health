<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MindCare — ระบบจองนัดหมายการให้คำปรึกษาทางจิตใจ</title>
  <% if (content.branding && content.branding.faviconImage) { %>
  <link rel="icon" href="<%= content.branding.faviconImage %>">
  <% } %>
  <%- include('./partials/head') %>
  <style>
    [data-animate]{opacity:0;transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1);}
    [data-animate="fade-up"]   {transform:translateY(36px);}
    [data-animate="fade-down"] {transform:translateY(-22px);}
    [data-animate="fade-right"]{transform:translateX(-44px);}
    [data-animate="fade-left"] {transform:translateX(44px);}
    [data-animate="zoom-in"]   {transform:scale(.86);}
    [data-animate].is-visible  {opacity:1;transform:none;}
    .section-bg-motion { transform-origin:center; will-change:transform; }
    .section-bg-blend { position:absolute; left:0; right:0; pointer-events:none; z-index:1; }
    .section-bg-blend-bottom { bottom:0; }
    .turnstile-wrap {
      width:100%;
      margin:18px 0;
      display:flex;
      justify-content:center;
    }
    .turnstile-wrap .cf-turnstile {
      width:100%;
      max-width:574px;
    }
    @media (prefers-reduced-motion: reduce) {
      .section-bg-motion { animation:none !important; transform:none; }
    }
  </style>
  <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
</head>
<body class="bg-white">
<%
const _bgs = content.backgrounds || {}
const _sectionVisibility = content.sectionVisibility || {}
function sectionVisible(key) {
  return _sectionVisibility[key] !== false
}
const _defaultSectionOrder = ['hero', 'counselors', 'features', 'book', 'faq', 'footer']
const _savedSectionOrder = Array.isArray(content.sectionOrder) ? content.sectionOrder : []
const _sectionOrder = _savedSectionOrder
  .filter((key, index) => _defaultSectionOrder.includes(key) && _savedSectionOrder.indexOf(key) === index)
  .concat(_defaultSectionOrder.filter(key => !_savedSectionOrder.includes(key)))
function sectionOrderValue(key) {
  return _sectionOrder.indexOf(key)
}
const featureContent = content.features || {}
const featureDefaults = [
  { icon:'shield-check', text:'นักให้คำปรึกษาผ่านการตรวจสอบและรับรองคุณสมบัติ' },
  { icon:'lock', text:'ข้อมูลทุกอย่างเป็นความลับตาม PDPA' },
  { icon:'clock', text:'จองนัดได้ตลอด 24 ชั่วโมง ทุกวัน' },
  { icon:'video', text:'รองรับทั้งการพบออนไลน์และเข้ารับบริการด้วยตนเอง' },
  { icon:'bell', text:'แจ้งเตือนก่อนนัดหมาย ไม่ลืมแน่นอน' },
]
const featureItems = Array.isArray(featureContent.items) && featureContent.items.length
  ? featureContent.items.map((text, idx) => ({ icon: featureDefaults[idx] ? featureDefaults[idx].icon : 'check-circle', text }))
  : featureDefaults
const enFeatureContent = (content.en && content.en.features) || {}
const enFeatureDefaults = [
  'Counselors verified and certified',
  'All information is confidential under PDPA',
  'Book appointments 24 hours a day, every day',
  'Supports both online and in-person sessions',
  'Appointment reminders so you never miss a session',
]
const enFeatureItems = Array.isArray(enFeatureContent.items) && enFeatureContent.items.length ? enFeatureContent.items : enFeatureDefaults
const concernDefaults = ['ความวิตกกังวล / ความเครียด', 'ภาวะซึมเศร้า', 'ปัญหาความสัมพันธ์', 'ปัญหาครอบครัว', 'ความเศร้าโศก / การสูญเสีย', 'อื่นๆ']
const concernItems = Array.isArray(content.book && content.book.concernOptions) && content.book.concernOptions.length ? content.book.concernOptions : concernDefaults
const enConcernDefaults = ['Anxiety / Stress', 'Depression', 'Relationship Issues', 'Family Problems', 'Grief / Loss', 'Other']
const enBookContent = (content.en && content.en.book) || {}
const enConcernItems = Array.isArray(enBookContent.concernOptions) && enBookContent.concernOptions.length ? enBookContent.concernOptions : enConcernDefaults
const facultyItems = typeof facultyOptions !== 'undefined' && Array.isArray(facultyOptions) ? facultyOptions : []
const bookFormTexts = (content.book && content.book.formTexts) || {}
const enBookFormTexts = enBookContent.formTexts || {}
const audienceFieldDefaults = { studentId:true, faculty:true, phone:true, email:true, concern:true, sessionType:true }
const configuredAudienceFields = (content.book && content.book.audienceFields) || {}
const registrationAudienceFields = {
  student: { ...audienceFieldDefaults, ...(configuredAudienceFields.student || {}) },
  staff: { ...audienceFieldDefaults, ...(configuredAudienceFields.staff || {}) },
}
function bookText(texts, key, fallback) {
  return texts[key] || fallback
}
function sessionTypeEnabled(bookData, key) {
  const settings = (bookData && bookData.sessionTypes) || {}
  return settings[key] !== false
}
const sessionTypeMeta = [
  { key:'online', icon:'video', textKey:'onlineLabel', i18n:'form-type-online', fallback:'ออนไลน์', enFallback:'Online' },
  { key:'phone', icon:'phone', textKey:'phoneSessionLabel', i18n:'form-type-phone', fallback:'โทรศัพท์', enFallback:'Phone call' },
  { key:'onsite', icon:'map-pin', textKey:'onsiteLabel', i18n:'form-type-onsite', fallback:'เข้ารับบริการด้วยตนเอง', enFallback:'In-Person' },
]
const enabledSessionTypes = sessionTypeMeta.filter(item => sessionTypeEnabled(content.book || {}, item.key))
const enabledEnSessionTypes = sessionTypeMeta.filter(item => sessionTypeEnabled(enBookContent || {}, item.key))
function _featureText(items, idx, fallback) {
  return items[idx] || fallback
}
function _hexToRgba(hex, a) {
  if (!hex || !/^#[0-9A-Fa-f]{6}$/.test(hex)) return null
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16)
  return 'rgba('+r+','+g+','+b+','+a+')'
}
// Returns inline color style for a specific text element in a section
function _tc(sec, field) {
  const bg = _bgs[sec] || {}
  const c = (bg.textColors || {})[field]
  return (c && /^#[0-9A-Fa-f]{6}$/.test(c)) ? 'color:' + c + ';' : ''
}
// For elements with a Tailwind hover: color class — inline style would always win over
// :hover (higher specificity), permanently killing the hover effect. Use a plain class
// selector instead: it has lower specificity than the hover pseudo-class rule, so hover
// still overrides it on mouseover while still applying the custom color at rest.
function _tcClass(sec, field) {
  const bg = _bgs[sec] || {}
  const c = (bg.textColors || {})[field]
  return (c && /^#[0-9A-Fa-f]{6}$/.test(c)) ? ('tc-custom-' + sec + '-' + field) : ''
}
function _tcStyleTag(sec, field) {
  const cls = _tcClass(sec, field)
  if (!cls) return ''
  const bg = _bgs[sec] || {}
  const c = (bg.textColors || {})[field]
  // Must join Tailwind's own "utilities" layer — CSS cascade layers always lose to
  // unlayered styles regardless of specificity, so an unlayered rule here would
  // permanently beat (and break) the hover:text-* utility rule.
  return '<style>@layer utilities{.' + cls + '{color:' + c + ';}}</style>'
}
// Generates HTML for absolutely-positioned bg layer divs inside a section
// Layer order (bottom→top): image → color overlay → content (z-index:2 on content wrapper)
function _bgLayers(sec) {
  const bg = _bgs[sec] || {}
  const blendSize = typeof bg.blend === 'number' ? Math.max(0, Math.min(220, bg.blend)) : 0
  if (!bg.image && !bg.color && !blendSize) return ''
  const colorOp = typeof bg.opacity    === 'number' ? bg.opacity    : 1
  const imgOp   = typeof bg.imgOpacity === 'number' ? bg.imgOpacity : 1
  const motionEnabled = bg.motionEnabled !== false
  const motionDuration = typeof bg.motionDuration === 'number' ? bg.motionDuration : 38
  const motionScale = typeof bg.motionScale === 'number' ? bg.motionScale : 1.12
  const motionStyle = bg.motionStyle === 'float' ? 'float' : 'zoom'
  let html = ''
  if (bg.image) {
    if (motionEnabled) {
      const kfName = '_bgzm_' + sec
      const keyframes = motionStyle === 'float'
        ? '@keyframes ' + kfName + '{from{transform:translateY(0)}to{transform:translateY(-18px)}}'
        : '@keyframes ' + kfName + '{from{transform:scale(1)}to{transform:scale(' + motionScale + ')}}'
      html += '<style>' + keyframes + '</style>'
      html += '<div aria-hidden="true" class="section-bg-motion" style="position:absolute;inset:0;background-image:url(\'' + bg.image + '\');background-size:cover;background-position:center;background-repeat:no-repeat;opacity:' + imgOp + ';animation:' + kfName + ' ' + motionDuration + 's ease-in-out infinite alternate;pointer-events:none;z-index:0;"></div>'
    } else {
      html += '<div aria-hidden="true" style="position:absolute;inset:0;background-image:url(\'' + bg.image + '\');background-size:cover;background-position:center;background-repeat:no-repeat;opacity:' + imgOp + ';pointer-events:none;z-index:0;"></div>'
    }
  }
  if (bg.color) {
    const rgba = _hexToRgba(bg.color, colorOp) || bg.color
    html += '<div aria-hidden="true" style="position:absolute;inset:0;background-color:'+rgba+';pointer-events:none;z-index:1;"></div>'
  }
  if (blendSize > 0) {
    const blendColor = /^#[0-9A-Fa-f]{6}$/.test(bg.blendColor || '') ? bg.blendColor : (/^#[0-9A-Fa-f]{6}$/.test(bg.color || '') ? bg.color : '#ffffff')
    const blendSolid = _hexToRgba(blendColor, 1)
    const blendClear = _hexToRgba(blendColor, 0)
    html += '<div aria-hidden="true" class="section-bg-blend section-bg-blend-bottom" style="height:' + blendSize + 'px;background:linear-gradient(to top,' + blendSolid + ',' + blendClear + ');"></div>'
  }
  return html
}
// Returns {styleTag, animStyleFor(frameIndex)} to animate whole frame elements (not just the photo
// inside them) driven by content[obj][prefix+'Motion*'] fields. Each frame index gets a staggered
// negative animation-delay so the frames float/zoom out of sync with each other instead of in unison.
function _photoMotion(obj, prefix, uid) {
  const o = obj || {}
  const enabled = o[prefix + 'MotionEnabled'] !== false
  if (!enabled) return { styleTag: '', animStyleFor: function () { return '' } }
  const duration = typeof o[prefix + 'MotionDuration'] === 'number' ? o[prefix + 'MotionDuration'] : 38
  const scale = typeof o[prefix + 'MotionScale'] === 'number' ? o[prefix + 'MotionScale'] : 1.12
  const style = o[prefix + 'MotionStyle'] === 'float' ? 'float' : 'zoom'
  const kfName = '_pm_' + prefix + '_' + uid
  const keyframes = style === 'float'
    ? '@keyframes ' + kfName + '{from{transform:translateY(0)}to{transform:translateY(-14px)}}'
    : '@keyframes ' + kfName + '{from{transform:scale(1)}to{transform:scale(' + scale + ')}}'
  return {
    styleTag: '<style>' + keyframes + '</style>',
    animStyleFor: function (frameIndex) {
      const delay = -(duration * ((frameIndex % 4) / 4))
      return 'animation:' + kfName + ' ' + duration + 's ease-in-out ' + delay + 's infinite alternate;'
    },
  }
}
%>

  <!-- Navbar -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur border-b border-slate-100 shadow-[0_1px_2px_rgba(15,23,42,0.06),0_8px_20px_rgba(15,23,42,0.12)]">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="<%= sectionVisible('hero') ? '#home' : '/' %>" class="flex items-center gap-2.5 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-300 focus-visible:ring-offset-2" aria-label="MindCare home">
        <% if (content.branding && content.branding.headerLogoImage) { %>
        <img src="<%= content.branding.headerLogoImage %>" alt="MindCare" class="h-8 w-auto">
        <% } else { %>
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-500 to-ocean-500 flex items-center justify-center">
          <i data-lucide="heart-handshake" class="w-4.5 h-4.5 text-white"></i>
        </div>
        <% } %>
        <% if (!(content.branding && content.branding.headerLogoImage)) { %>
        <span class="font-bold text-slate-800 text-lg">MindCare</span>
        <% } %>
      </a>
      <div id="main-nav-links" class="hidden md:flex items-center gap-1 relative rounded-full p-0.5 ml-auto mr-3">
        <span id="main-nav-indicator" class="pointer-events-none absolute left-0 top-0.5 h-[calc(100%-4px)] rounded-full bg-brand-50 shadow-sm opacity-0 transition-all duration-300 ease-out"></span>
        <% if (sectionVisible('book')) { %><a href="#book" class="btn-ghost text-sm relative z-10" data-i18n="nav-register">ลงทะเบียนเพื่อขอรับบริการ</a><% } %>
        <% if (sectionVisible('counselors')) { %><a href="#counselors" class="btn-ghost text-sm relative z-10" data-i18n="nav-counselors">นักให้คำปรึกษา</a><% } %>
        <% if (sectionVisible('faq')) { %><a href="#faq" class="btn-ghost text-sm relative z-10" data-i18n="nav-faq">คำถามที่พบบ่อย</a><% } %>
      </div>
      <div class="hidden md:flex items-center gap-2">
