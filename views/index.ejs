    // Counselor Carousel
    (function () {
      const inner = document.getElementById('c-inner');
      const slides = Array.from(inner.querySelectorAll('.c-slide'));
      const prevBtn = document.getElementById('c-prev');
      const nextBtn = document.getElementById('c-next');
      const dotsEl = document.getElementById('c-dots');
      let current = 0;
      const GAP = 24;

      function pv() { return window.innerWidth >= 768 ? 3 : 1; }
      function maxIdx() { return Math.max(0, slides.length - pv()); }
      function sw() { return slides[0].offsetWidth + GAP; }

      function buildDots() {
        dotsEl.innerHTML = '';
        for (let i = 0; i <= maxIdx(); i++) {
          const d = document.createElement('button');
          d.className = 'w-2 h-2 rounded-full transition-colors ' + (i === current ? 'bg-brand-500' : 'bg-slate-300');
          d.addEventListener('click', () => goTo(i));
          dotsEl.appendChild(d);
        }
      }

      function updateDots() {
        dotsEl.querySelectorAll('button').forEach((d, i) => {
          d.className = 'w-2 h-2 rounded-full transition-colors ' + (i === current ? 'bg-brand-500' : 'bg-slate-300');
        });
      }

      function goTo(i) {
        current = Math.max(0, Math.min(i, maxIdx()));
        inner.style.transform = 'translateX(-' + (current * sw()) + 'px)';
        updateDots();
      }

      function setWidths() {
        const track = document.getElementById('c-track');
        const w = (track.offsetWidth - (pv() - 1) * GAP) / pv();
        slides.forEach(s => { s.style.width = w + 'px'; });
        current = Math.min(current, maxIdx());
        goTo(current);
        buildDots();
      }

      prevBtn.addEventListener('click', () => goTo(current - 1));
      nextBtn.addEventListener('click', () => goTo(current + 1));
      window.addEventListener('resize', setWidths);
      setWidths();
    })();

