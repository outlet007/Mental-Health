        'form-tab-staff': 'Faculty/Staff',
        'form-label-name': <%- JSON.stringify(bookText(enBookFormTexts, 'nameLabel', 'Full Name')) %>,
        'form-label-studentid': <%- JSON.stringify(bookText(enBookFormTexts, 'studentIdLabel', 'Student ID')) %>,
        'form-label-faculty': <%- JSON.stringify(bookText(enBookFormTexts, 'facultyLabel', 'Faculty / School')) %>,
        'form-label-phone': <%- JSON.stringify(bookText(enBookFormTexts, 'phoneLabel', 'Phone Number')) %>,
        'form-label-email': <%- JSON.stringify(bookText(enBookFormTexts, 'emailLabel', 'Email')) %>,
        'form-ph-name': <%- JSON.stringify(bookText(enBookFormTexts, 'namePlaceholder', 'Enter your name')) %>,
        'form-ph-studentid': <%- JSON.stringify(bookText(enBookFormTexts, 'studentIdPlaceholder', 'e.g. 1680123456')) %>,
        'faculty-placeholder': <%- JSON.stringify(bookText(enBookFormTexts, 'facultyPlaceholder', '-- Select faculty / school --')) %>,
        <% facultyItems.forEach((item, idx) => { %>
        'faculty-<%= idx %>': <%- JSON.stringify(item.en) %>,
        <% }) %>
        'form-ph-phone': <%- JSON.stringify(bookText(enBookFormTexts, 'phonePlaceholder', '08X-XXX-XXXX')) %>,
        'form-ph-email': <%- JSON.stringify(bookText(enBookFormTexts, 'emailPlaceholder', 'your@email.com')) %>,
        'form-label-concern': <%- JSON.stringify(bookText(enBookFormTexts, 'concernLabel', 'What would you like help with?')) %>,
        'concern-0': '-- Select Type --',
        <% enConcernItems.forEach((item, idx) => { %>
        'concern-<%= idx + 1 %>': <%- JSON.stringify(item) %>,
        <% }) %>
        'form-label-type': <%- JSON.stringify(bookText(enBookFormTexts, 'typeLabel', 'Preferred Format')) %>,
        <% enabledEnSessionTypes.forEach(item => { %>
        '<%= item.i18n %>': <%- JSON.stringify(bookText(enBookFormTexts, item.textKey, item.enFallback)) %>,
        <% }) %>
        'pdpa-heading': <%- JSON.stringify(bookText(enBookFormTexts, 'pdpaHeading', 'Data Disclosure Consent')) %>,
        'pdpa-text': <%- JSON.stringify(bookText(enBookFormTexts, 'pdpaText', "I agree and consent to the University collecting, using, processing, and disclosing my personal information — both appearing in this document and gathered from other persons — for the purpose of scheduling medical appointments or for University operations. I acknowledge that the University has the right to collect, use, process, and disclose my personal data in accordance with the University's Personal Data Protection Policy as currently published or as may be amended in the future. Details are available in the Personal Data Protection Policy on the website.")) %>,
        'pdpa-checkbox': <%- JSON.stringify(bookText(enBookFormTexts, 'pdpaCheckbox', 'I have read and accept the data disclosure consent.')) %>,
        'form-submit': <%- JSON.stringify(bookText(enBookFormTexts, 'submitLabel', 'Submit Registration Request')) %>,
        'faq-heading': 'Frequently Asked Questions',
        'faq-items': <%- JSON.stringify((content.en && content.en.faqs) || []) %>,
        'footer-desc': <%- JSON.stringify((content.en && content.en.contact && content.en.contact.description) || 'Mental health counseling appointment system — connecting those who need help with trusted experts.') %>,
        'footer-services': 'Services',
        'footer-link-1': 'Our Counselors',
        'footer-link-2': 'Register for Services',
        'footer-contact': 'Contact',
        'footer-line': <%- JSON.stringify((content.en && content.en.contact && content.en.contact.lineLabel) || 'LINE @bucare') %>,
        'footer-line-url': <%- JSON.stringify((content.en && content.en.contact && content.en.contact.lineUrl) || (content.contact && content.contact.lineUrl) || 'https://page.line.me/bucare?openQrModal=true') %>,
        'footer-hours': <%- JSON.stringify((content.en && content.en.contact && content.en.contact.hours) || 'Mon–Sat 08:30–17:00 (excl. public holidays)') %>,
        'footer-copyright': <%- JSON.stringify((content.en && content.en.contact && content.en.contact.copyright) || '© 2024 MindCare · All information is protected under PDPA') %>,
        'cookie-consent-text': <%- JSON.stringify('We use cookies on this website for site administration and to improve your experience. You can review our cookie policy <a href="https://www.bu.ac.th/en/cookies" target="_blank" rel="noopener" class="underline text-brand-400 hover:text-brand-300">here</a>.') %>,
        'cookie-consent-accept': 'Accept',
      }
    };

    function setLang(lang) {
      localStorage.setItem(LANG_KEY, lang);
      currentLang = lang;
      const T = TRANSLATIONS[lang];

      // Update flag button display
      document.getElementById('lang-flag-display').innerHTML = FLAGS[lang];
      document.getElementById('lang-code-display').textContent = lang.toUpperCase();
      document.querySelectorAll('[id^="lang-option-"]').forEach(option => {
        const isActive = option.id === `lang-option-${lang}`;
        option.classList.toggle('bg-slate-50', isActive);
        option.classList.toggle('text-brand-600', isActive);
        option.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      ['th', 'en'].forEach(code => {
        const option = document.getElementById(`mobile-lang-${code}`);
        if (!option) return;
        const isActive = code === lang;
        option.classList.toggle('bg-slate-100', isActive);
        option.classList.toggle('text-slate-900', isActive);
        option.classList.toggle('text-slate-500', !isActive);
        option.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
      // Close dropdown after selection
      document.getElementById('lang-menu').classList.add('hidden');
      document.getElementById('lang-btn').setAttribute('aria-expanded', 'false');
      document.getElementById('lang-chevron').style.transform = '';

      // Text content
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.dataset.i18n;
        if (T[key] !== undefined) el.textContent = T[key];
      });

      // innerHTML (for <br> etc.)
      document.querySelectorAll('[data-i18n-html]').forEach(el => {
        const key = el.dataset.i18nHtml;
        if (T[key] !== undefined) el.innerHTML = T[key];
      });

      // Hrefs
      document.querySelectorAll('[data-i18n-href]').forEach(el => {
        const key = el.dataset.i18nHref;
        if (T[key] !== undefined) el.href = T[key];
      });

      // Placeholders
      document.querySelectorAll('[data-i18n-ph]').forEach(el => {
        const key = el.dataset.i18nPh;
        if (T[key] !== undefined) el.placeholder = T[key];
      });

      // Select options
      document.querySelectorAll('[data-i18n-opt]').forEach(el => {
        const key = el.dataset.i18nOpt;
        if (T[key] !== undefined) el.textContent = T[key];
      });

      // FAQ items
      const faqItems = T['faq-items'] || [];
      document.querySelectorAll('[data-faq-idx]').forEach(el => {
        const idx = parseInt(el.getAttribute('data-faq-idx'));
        if (faqItems[idx]) {
          const qEl = el.querySelector('[data-faq-q]');
          const aEl = el.querySelector('[data-faq-a]');
          if (qEl) qEl.innerHTML = faqItems[idx].q;
          if (aEl) aEl.innerHTML = faqItems[idx].a;
        }
      });

      // Page title + html lang
      if (T['page-title']) document.title = T['page-title'];
      document.documentElement.lang = lang === 'en' ? 'en' : 'th';

      applyAudienceLabel();
    }

    // Registration form audience tabs (นักศึกษา / อาจารย์-บุคลากร) — swaps only
    // the studentId field's visible label + placeholder; the field name and
    // data storage stay exactly the same (still submitted/stored as studentId).
    function applyAudienceLabel() {
      const labelEl = document.querySelector('[data-i18n="form-label-studentid"]');
      const inputEl = document.querySelector('input[name="studentId"]');
      if (labelEl && inputEl) {
        if (currentAudience === 'staff') {
          const staffText = AUDIENCE_STAFF_TEXT[currentLang] || AUDIENCE_STAFF_TEXT.th;
          labelEl.textContent = staffText.label;
          inputEl.placeholder = staffText.placeholder;
        } else {
          const T = TRANSLATIONS[currentLang] || TRANSLATIONS.th;
          labelEl.textContent = T['form-label-studentid'];
          inputEl.placeholder = T['form-ph-studentid'];
        }
      }

      const emailInputEl = document.querySelector('input[name="email"]');
      if (emailInputEl) {
        emailInputEl.placeholder = AUDIENCE_EMAIL_PLACEHOLDER[currentAudience] || AUDIENCE_EMAIL_PLACEHOLDER.student;
      }
      applyAudienceFields();
    }

    function applyAudienceFields() {
      const settings = AUDIENCE_FIELD_VISIBILITY[currentAudience] || AUDIENCE_FIELD_VISIBILITY.student || {};
      const audienceInput = document.getElementById('registrationAudience');
      if (audienceInput) audienceInput.value = currentAudience;

      document.querySelectorAll('[data-registration-field]').forEach(wrapper => {
        const field = wrapper.dataset.registrationField;
        const visible = settings[field] !== false;
        wrapper.hidden = !visible;
        wrapper.querySelectorAll('input, select, textarea').forEach(control => {
          if (!control.dataset.baseRequired) control.dataset.baseRequired = control.required ? 'true' : 'false';
          control.disabled = !visible;
          control.required = visible && control.dataset.baseRequired === 'true';
        });
      });

      document.querySelectorAll('[data-registration-row]').forEach(row => {
        const visibleChildren = Array.from(row.children).filter(child => !child.hidden);
        Array.from(row.children).forEach(child => { child.style.gridColumn = ''; });
        if (visibleChildren.length === 1) visibleChildren[0].style.gridColumn = '1 / -1';
      });
    }

    function setAudience(audience) {
      currentAudience = audience;
      document.querySelectorAll('[data-audience-tab]').forEach(btn => {
        const isActive = btn.dataset.audienceTab === audience;
        btn.classList.toggle('bg-brand-600', isActive);
        btn.classList.toggle('shadow-md', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('font-semibold', isActive);
        btn.classList.toggle('text-slate-500', !isActive);
        btn.classList.toggle('font-medium', !isActive);
        btn.classList.toggle('hover:text-slate-700', !isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      applyAudienceLabel();
    }

    function toggleLangMenu() {
      const menu = document.getElementById('lang-menu');
      const btn = document.getElementById('lang-btn');
      const chevron = document.getElementById('lang-chevron');
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
    }

    document.addEventListener('click', function (e) {
      const wrap = document.getElementById('lang-wrap');
      if (wrap && !wrap.contains(e.target)) {
        document.getElementById('lang-menu').classList.add('hidden');
        document.getElementById('lang-btn').setAttribute('aria-expanded', 'false');
        document.getElementById('lang-chevron').style.transform = '';
      }
    });

    function openMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const btn = document.getElementById('mobile-menu-btn');
      if (!menu) return;
      menu.classList.remove('hidden');
      menu.setAttribute('aria-hidden', 'false');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      lucide.createIcons();
    }

    function closeMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const btn = document.getElementById('mobile-menu-btn');
      if (!menu) return;
      menu.classList.add('hidden');
      menu.setAttribute('aria-hidden', 'true');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMobileMenu();
    });

    // Initialize from saved preference
    (function () {
      const saved = localStorage.getItem(LANG_KEY) || 'th';
      setLang(saved);
    })();

    // ── Scroll animations ────────────────────────────────────────────────────
    ;(function(){
      // Apply per-element transition delays from data-delay attribute
      document.querySelectorAll('[data-animate]').forEach(function(el){
        if(el.dataset.delay) el.style.transitionDelay = el.dataset.delay;
      });

      function reveal(el){ el.classList.add('is-visible'); }

      // Hero: trigger on page load (already in viewport)
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){
          document.querySelectorAll('#home [data-animate]').forEach(reveal);
        });
      });

      // All other sections: trigger when element enters viewport
      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            if(e.isIntersecting){ reveal(e.target); io.unobserve(e.target); }
          });
        },{ threshold: 0.12, rootMargin: '0px 0px -48px 0px' });

        document.querySelectorAll('[data-animate]').forEach(function(el){
          if(!el.closest('#home')) io.observe(el);
        });
      }
    })();
  </script>
</body>
</html>
