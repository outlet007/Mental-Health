            </button>
          </div>
        </div>
        <div class="w-px h-6 bg-gray-300 self-center" aria-hidden="true"></div>
        <% if (sectionVisible('book')) { %><a href="#book" class="btn-primary text-sm"><i data-lucide="calendar-plus" class="w-5 h-5"></i> <span data-i18n="nav-btn-register">ลงทะเบียน</span></a><% } %>
        <a href="/admin/login" class="btn-secondary text-sm">
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span data-i18n="nav-staff">สำหรับเจ้าหน้าที่</span>
        </a>
      </div>
      <button id="mobile-menu-btn" onclick="openMobileMenu()" type="button"
        class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-700 hover:bg-slate-100 transition-colors"
        aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden fixed inset-0 z-[1000] bg-white md:hidden" aria-hidden="true">
      <div class="h-12 bg-brand-600 flex items-center justify-end px-5">
        <button onclick="closeMobileMenu()" type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full text-white hover:bg-white/10 transition-colors"
          aria-label="Close menu">
          <i data-lucide="x" class="w-6 h-6"></i>
        </button>
      </div>

      <div class="min-h-[calc(100vh-3rem)] flex flex-col px-5 py-4">
        <div class="grid <%= sectionVisible('book') ? 'grid-cols-2' : 'grid-cols-1' %> gap-3 mb-7">
          <% if (sectionVisible('book')) { %>
          <a href="#book" onclick="closeMobileMenu()" class="btn-primary justify-center text-sm">
            <span data-i18n="nav-btn-register">ลงทะเบียน</span>
          </a>
          <% } %>
          <a href="/admin/login" class="btn-secondary justify-center text-sm">
            <span data-i18n="nav-staff">สำหรับเจ้าหน้าที่</span>
          </a>
        </div>

        <div class="flex flex-col text-slate-800">
          <% if (sectionVisible('hero')) { %><a href="#home" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="mobile-home">หน้าแรก</span>
          </a><% } %>
          <% if (sectionVisible('book')) { %><a href="#book" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="mobile-services">บริการของเรา</span>
            <i data-lucide="chevron-down" class="w-5 h-5 text-slate-600"></i>
          </a><% } %>
          <% if (sectionVisible('counselors')) { %><a href="#counselors" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="nav-counselors">นักให้คำปรึกษา</span>
          </a><% } %>
          <% if (sectionVisible('faq')) { %><a href="#faq" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="nav-faq">คำถามที่พบบ่อย</span>
            <i data-lucide="chevron-down" class="w-5 h-5 text-slate-600"></i>
          </a><% } %>
        </div>

        <div class="mt-auto pb-1">
          <div class="inline-flex items-center rounded-full border border-slate-300 bg-white p-0.5 text-sm font-semibold text-slate-500">
            <button id="mobile-lang-th" onclick="setLang('th')" type="button" class="rounded-full px-3 py-1 transition-colors">TH</button>
            <span class="text-slate-300">|</span>
            <button id="mobile-lang-en" onclick="setLang('en')" type="button" class="rounded-full px-3 py-1 transition-colors">EN</button>
          </div>
        </div>
      </div>
  </div>

  <div id="public-sections" style="display:flex;flex-direction:column;">
  <!-- Hero -->
  <% if (sectionVisible('hero')) { %>
  <section id="home" class="pt-32 pb-24 bg-gradient-to-br from-brand-50 via-ocean-50 to-white" style="position:relative;overflow:hidden;order:<%= sectionOrderValue('hero') %>;">
    <%- _bgLayers('hero') %>
    <% if (content.hero.visualImage) { %>
    <!-- Full-bleed hero visual replacing the right-side object entirely -->
    <div aria-hidden="true" class="hidden md:block" style="position:absolute;top:0;right:0;bottom:0;width:52%;z-index:1;overflow:hidden;pointer-events:none;">
      <img src="<%= content.hero.visualImage %>" alt="" style="width:100%;height:100%;object-fit:cover;object-position:center;">
      <%
        const _heroBg = _bgs.hero || {}
        const _heroBlend = typeof _heroBg.blend === 'number' ? _heroBg.blend : 0
      %>
      <% if (_heroBlend > 0) { %>
      <%
        const _heroBlendColor = /^#[0-9A-Fa-f]{6}$/.test(_heroBg.blendColor || '') ? _heroBg.blendColor : '#ffffff'
        const _heroBlendSolid = _hexToRgba(_heroBlendColor, 1)
        const _heroBlendClear = _hexToRgba(_heroBlendColor, 0)
      %>
      <div aria-hidden="true" style="position:absolute;left:0;right:0;bottom:0;height:<%= _heroBlend %>px;background:linear-gradient(to top,<%= _heroBlendSolid %>,<%= _heroBlendClear %>);"></div>
      <% } %>
    </div>
    <% } %>
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center" style="position:relative;z-index:2;">
      <div>
        <span data-animate="fade-down" class="inline-flex items-center gap-2 px-3 py-1 bg-brand-100 text-brand-700 text-sm font-medium rounded-full mb-6">
          <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
          <span data-i18n="hero-badge"><%= content.hero.badge %></span>
        </span>
        <h1 data-animate="fade-up" data-delay="120ms" class="text-4xl md:text-5xl font-bold text-slate-800 leading-tight mb-6" style="<%- _tc('hero','heading') %>">
          <span data-i18n-html="hero-h1"><%- content.hero.heading1 %></span><br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-ocean-500" data-i18n-html="hero-h2"><%- content.hero.heading2 %></span>
        </h1>
        <p data-animate="fade-up" data-delay="240ms" class="text-slate-500 text-lg leading-relaxed mb-8" data-i18n-html="hero-subtext" style="<%- _tc('hero','subtext') %>">
          <%- content.hero.subtext %>
        </p>
        <div data-animate="fade-up" data-delay="360ms" class="flex flex-wrap gap-3">
          <% if (sectionVisible('book')) { %>
          <a href="#book" class="btn-primary px-7 py-3 text-base">
            <i data-lucide="calendar-plus" class="w-5 h-5"></i>
            <span data-i18n="hero-cta-main"><%= content.hero.ctaMain %></span>
          </a>
          <% } %>
          <% if (sectionVisible('counselors')) { %>
          <a href="#counselors" class="btn-secondary px-7 py-3 text-base">
            <i data-lucide="users" class="w-5 h-5"></i>
            <span data-i18n="hero-cta-sub"><%= content.hero.ctaSub %></span>
          </a>
          <% } %>
        </div>
      </div>

      <% if (!content.hero.visualImage) { %>
      <!-- Hero visual (default illustration, shown only when no custom image is set) -->
      <div data-animate="fade-left" data-delay="180ms" class="hidden md:block">
        <div class="relative">
          <div class="w-80 h-80 mx-auto rounded-3xl bg-gradient-to-br from-brand-400 to-ocean-500 flex items-center justify-center shadow-xl">
            <i data-lucide="heart-handshake" class="w-40 h-40 text-white/80"></i>
          </div>
          <!-- Floating cards -->
          <div data-animate="zoom-in" data-delay="500ms" class="absolute -top-4 -left-6 card shadow-lg max-w-[200px]">
            <div class="flex items-center gap-2 mb-1">
              <i data-lucide="check-circle" class="w-4 h-4 text-brand-500"></i>
              <span class="text-xs font-semibold text-slate-700" data-i18n="hero-card-confirmed">ยืนยันนัดแล้ว</span>
            </div>
            <p class="text-xs text-slate-500" data-i18n="hero-card-date">พุธ 18 มิ.ย. — 10:00 น.</p>
            <p class="text-xs text-brand-600 font-medium mt-0.5" data-i18n="hero-card-name">ดร.สุภาพร เมธาวี</p>
          </div>
          <div data-animate="zoom-in" data-delay="640ms" class="absolute -bottom-4 -right-6 card shadow-lg max-w-[180px]">
            <div class="flex items-center gap-1 mb-1">
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
            </div>
            <p class="text-xs text-slate-600" data-i18n="hero-card-review">"รู้สึกดีขึ้นมากหลังจากได้คุย ขอบคุณมากครับ"</p>
          </div>
        </div>
      </div>
      <% } else { %>
      <!-- Custom hero visual is rendered full-bleed via the absolute panel above; keep the grid column as empty spacer -->
      <div class="hidden md:block"></div>
      <% } %>
    </div>
  </section>
  <% } %>


  <!-- Counselors -->
  <% if (sectionVisible('counselors')) { %>
  <section id="counselors" class="py-20" style="position:relative;overflow:hidden;background:#eef1ff;order:<%= sectionOrderValue('counselors') %>;">
    <%- _bgLayers('counselors') %>
    <div class="max-w-6xl mx-auto px-6" style="position:relative;z-index:2;">
      <div data-animate="fade-up" class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-800 mb-2" data-i18n-html="counselors-heading" style="<%- _tc('counselors','heading') %>"><%- content.counselors.heading %></h2>
        <p class="text-slate-500" data-i18n-html="counselors-subtext" style="<%- _tc('counselors','subtext') %>"><%- content.counselors.subtext %></p>
      </div>

      <div data-animate="fade-up" data-delay="120ms" class="relative">
        <button id="c-prev" class="absolute -left-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-md border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition-colors">
          <i data-lucide="chevron-left" class="w-5 h-5"></i>
        </button>

        <div id="c-track" class="overflow-hidden rounded-3xl pb-8">
          <div id="c-inner" class="flex gap-6" style="transition:transform 0.45s cubic-bezier(.4,0,.2,1);">
            <% counselors.forEach(c => { %>
            <div class="c-slide flex-none">
              <div class="relative rounded-[28px] overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 bg-[#f4f6fb]" style="height:460px;">

                <% const cardLangs = (c.languages || []).map(l => String(l || '').trim().toLowerCase()) %>
                <% const hasThai = cardLangs.some(l => l === 'ไทย' || l === 'thai' || l === 'th') %>
                <% const hasEnglish = cardLangs.some(l => l === 'อังกฤษ' || l === 'english' || l === 'en') %>
                <% if (hasThai || hasEnglish) { %>
                <div class="absolute right-5 top-5 z-10 flex items-center gap-2">
                  <% if (hasThai) { %>
                  <span class="lang-flag-display inline-flex h-[30px] w-[30px] items-center justify-center rounded-full bg-white/90 shadow-md ring-1 ring-slate-200" title="ไทย" aria-label="ไทย">
                    <svg viewBox="0 0 24 24" width="30" height="30" style="border-radius:999px;box-shadow:0 0 0 1px rgba(148,163,184,.35);clip-path:circle(50%);" aria-hidden="true">
                      <rect width="24" height="24" fill="#da291c"></rect>
                      <rect y="4" width="24" height="16" fill="#fff"></rect>
                      <rect y="8" width="24" height="8" fill="#2d2a4a"></rect>
                    </svg>
                  </span>
                  <% } %>
                  <% if (hasEnglish) { %>
                  <span class="lang-flag-display inline-flex h-[30px] w-[30px] items-center justify-center rounded-full bg-white/90 shadow-md ring-1 ring-slate-200" title="อังกฤษ" aria-label="อังกฤษ">
                    <svg viewBox="0 0 60 60" width="30" height="30" style="border-radius:999px;box-shadow:0 0 0 1px rgba(148,163,184,.35);clip-path:circle(50%);" aria-hidden="true">
                      <rect width="60" height="36" fill="#012169"></rect>
                      <rect y="36" width="60" height="24" fill="#012169"></rect>
                      <path d="M0 0l60 60M60 0L0 60" stroke="#fff" stroke-width="12"></path>
                      <path d="M0 0l60 60M60 0L0 60" stroke="#c8102e" stroke-width="7"></path>
                      <path d="M30 0v60M0 30h60" stroke="#fff" stroke-width="20"></path>
                      <path d="M30 0v60M0 30h60" stroke="#c8102e" stroke-width="12"></path>
                    </svg>
                  </span>
                  <% } %>
                </div>
                <% } %>

                <!-- Photo / Avatar background -->
                <% if (c.photo) { %>
                <img src="<%= c.photo %>" alt="<%= c.name %>" class="absolute inset-0 h-full w-full object-cover object-top">
                <% } else { %>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-36 h-36 rounded-full flex items-center justify-center text-white font-bold text-5xl shadow-xl" style="background:linear-gradient(135deg,#6366f1,#06b6d4);">
                    <%= c.avatar %>
                  </div>
                </div>
                <% } %>

                <!-- White info panel -->
                <div class="absolute left-6 right-6 bottom-6 bg-white/80 backdrop-blur-md rounded-[22px] px-7 py-4 shadow-[0_18px_40px_rgba(15,23,42,0.14)] ring-1 ring-white/70">
                  <p class="font-semibold text-sm mb-2" style="color:#334155;"><%= c.title %></p>
                  <h3 class="font-bold text-slate-800 text-2xl leading-tight mb-3"><%= c.name %></h3>
                  <p class="text-slate-500 text-sm leading-relaxed" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= c.bio || c.specialties.join(' · ') %></p>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <button id="c-next" class="absolute -right-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-md border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition-colors">
          <i data-lucide="chevron-right" class="w-5 h-5"></i>
        </button>
      </div>

      <div id="c-dots" class="flex justify-center gap-2 mt-8"></div>
    </div>
  </section>
  <% } %>

  <!-- Features -->
  <% if (sectionVisible('features')) { %>
  <section id="features" class="py-20 bg-gradient-to-r from-brand-600 to-ocean-600" style="position:relative;overflow:hidden;order:<%= sectionOrderValue('features') %>;">
    <%- _bgLayers('features') %>
    <div class="max-w-6xl mx-auto px-6" style="position:relative;z-index:2;">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div data-animate="fade-right" class="text-white">
          <h2 class="text-3xl font-bold mb-4" data-i18n-html="features-heading" style="<%- _tc('features','heading') %>"><%- featureContent.heading || 'ทำไมต้องเลือก MindCare?' %></h2>
          <p class="text-brand-100 mb-8 leading-relaxed" data-i18n-html="features-subtext" style="<%- _tc('features','subtext') %>"><%- featureContent.subtext || 'เราเชื่อว่าทุกคนมีสิทธิ์ได้รับการดูแลสุขภาพจิตที่ดี ในสภาพแวดล้อมที่ปลอดภัยและไว้วางใจได้' %></p>
          <% const features = featureItems %>
          <ul class="space-y-3">
            <% features.forEach((f, idx) => { %>
            <li data-animate="fade-right" data-delay="<%= idx * 90 %>ms" class="flex items-center gap-3 text-brand-50">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <i data-lucide="<%= f.icon %>" class="w-4 h-4"></i>
              </div>
              <span class="text-sm" data-i18n-html="feature-<%= idx %>" style="<%- _tc('features','subtext') %>"><%- f.text %></span>
            </li>
            <% }) %>
          </ul>
        </div>
        <% if (content.features && content.features.collagePhoto1) { %>
        <% const _cm = _photoMotion(content.features, 'collage', 'features') %>
        <div class="relative hidden md:block" data-animate="fade-left" data-delay="120ms" style="height:440px;">
          <%- _cm.styleTag %>
          <img src="<%= content.features.collagePhoto1 %>" alt="" class="absolute rounded-3xl object-cover shadow-2xl" style="left:8%;top:0;width:60%;height:78%;border:4px solid #fff;<%- _cm.animStyleFor(0) %>">
          <% if (content.features.collagePhoto2) { %>
          <img src="<%= content.features.collagePhoto2 %>" alt="" class="absolute rounded-2xl object-cover shadow-xl" style="right:0;top:0;width:34%;height:34%;border:4px solid #fff;<%- _cm.animStyleFor(1) %>">
          <% } %>
          <% if (content.features.collagePhoto3) { %>
          <img src="<%= content.features.collagePhoto3 %>" alt="" class="absolute rounded-2xl object-cover shadow-xl" style="left:0;bottom:8%;width:32%;height:36%;border:4px solid #fff;<%- _cm.animStyleFor(2) %>">
          <% } %>
          <% if (content.features.collagePhoto4) { %>
          <img src="<%= content.features.collagePhoto4 %>" alt="" class="absolute rounded-2xl object-cover shadow-xl" style="right:0;bottom:20%;width:30%;height:34%;border:4px solid #fff;<%- _cm.animStyleFor(3) %>">
          <% } %>
          <div class="absolute inline-flex items-center gap-2 bg-white rounded-full shadow-lg px-4 py-2.5" style="right:2%;top:32%;max-width:220px;width:max-content;">
            <div class="w-8 h-8 rounded-full bg-brand-500 flex items-center justify-center flex-shrink-0"><i data-lucide="clock" class="w-4 h-4 text-white"></i></div>
            <span class="text-xs font-semibold text-slate-700 leading-tight" style="min-width:0;"><%- content.features.badge1Text || 'พร้อมซัพพอร์ตคุณในทุกช่วงเวลา' %></span>
          </div>
          <div class="absolute inline-flex items-center gap-2 bg-white rounded-full shadow-lg px-4 py-2.5" style="left:14%;bottom:2%;max-width:200px;width:max-content;">
            <div class="w-8 h-8 rounded-full bg-ocean-500 flex items-center justify-center flex-shrink-0"><i data-lucide="shield-check" class="w-4 h-4 text-white"></i></div>
            <span class="text-xs font-semibold text-slate-700 leading-tight" style="min-width:0;"><%- content.features.badge2Text || 'ปลอดภัย เป็นความลับ' %></span>
          </div>
          <div class="absolute inline-flex items-center gap-2 bg-white rounded-full shadow-lg px-4 py-2.5" style="right:0;bottom:14%;max-width:200px;width:max-content;">
            <div class="w-8 h-8 rounded-full bg-ocean-400 flex items-center justify-center flex-shrink-0"><i data-lucide="heart" class="w-4 h-4 text-white"></i></div>
            <span class="text-xs font-semibold text-slate-700 leading-tight" style="min-width:0;"><%- content.features.badge3Text || 'พื้นที่ที่เข้าใจและไม่ตัดสิน' %></span>
          </div>
        </div>
        <% } else { %>
        <div class="grid grid-cols-2 gap-4">
          <%
            const liveAverageRating = typeof counselorRatingAverage !== 'undefined' && counselorRatingAverage ? counselorRatingAverage : '4.8'
            const metrics = [
              { icon:'users', num:'500+', label:'ผู้รับบริการ' },
              { icon:'user-check', num:'20+', label:'นักให้คำปรึกษา' },
              { icon:'calendar-check', num:'1,200+', label:'นัดหมายสำเร็จ' },
              { icon:'star', num: liveAverageRating, label:'คะแนนเฉลี่ย' },
            ]
          %>
          <% metrics.forEach((m, idx) => { %>
          <div data-animate="zoom-in" data-delay="<%= idx * 80 %>ms" class="bg-white/10 backdrop-blur rounded-2xl p-6 text-white text-center">
            <i data-lucide="<%= m.icon %>" class="w-7 h-7 mx-auto mb-3 text-brand-200"></i>
            <p class="text-3xl font-bold"><%= m.num %></p>
            <p class="text-sm text-brand-200 mt-1" data-i18n="metric-<%= idx %>"><%= m.label %></p>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- CTA / Book -->
  <% if (sectionVisible('book')) { %>
  <section id="book" class="py-20 bg-white" style="position:relative;overflow:hidden;order:<%= sectionOrderValue('book') %>;">
    <%- _bgLayers('book') %>
    <div class="max-w-2xl mx-auto px-6 text-center" style="position:relative;z-index:2;">
      <h2 data-animate="fade-up" data-delay="100ms" class="text-3xl font-bold text-slate-800 mb-4" data-i18n-html="book-heading" style="<%- _tc('book','heading') %>"><%- content.book.heading %></h2>
      <p data-animate="fade-up" data-delay="200ms" class="text-slate-500 mb-8 leading-relaxed" data-i18n-html="book-subtext" style="<%- _tc('book','subtext') %>"><%- content.book.subtext %></p>
      <% if (query && query.sent) { %>
      <div data-animate="fade-up" data-delay="300ms" class="card rounded-[28px] shadow-md text-center py-10">
        <div class="w-16 h-16 rounded-full bg-brand-50 flex items-center justify-center mx-auto mb-4">
          <i data-lucide="circle-check" class="w-8 h-8 text-brand-500"></i>
        </div>
        <h3 class="font-semibold text-slate-800 text-lg mb-2" data-i18n-html="book-success-heading"><%- bookText(bookFormTexts, 'successHeading', 'ส่งคำขอสำเร็จแล้ว!') %></h3>
        <p class="text-slate-500 text-sm leading-relaxed" data-i18n-html="book-success-text"><%- bookText(bookFormTexts, 'successText', 'ทีมงานจะติดต่อกลับหาคุณภายใน 1 วันทำการ<br>ขอบคุณที่ไว้วางใจ MindCare') %></p>
      </div>
      <% } else { %>
      <div data-animate="fade-up" data-delay="300ms" class="card rounded-[28px] shadow-md text-left">
        <h3 class="font-semibold text-slate-700 mb-4 flex items-center gap-2">
          <i data-lucide="send" class="w-4 h-4 text-brand-500"></i>
          <span data-i18n-html="form-heading" style="<%- _tc('book','formHeading') %>"><%- content.book.formHeading %></span>
        </h3>
        <% if (query && query.error) { %>
        <div class="flex items-center gap-2 mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm">
          <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
          <span data-i18n-html="form-error"><%- bookText(bookFormTexts, 'errorText', 'กรุณากรอกข้อมูลที่จำเป็นให้ครบทุกช่อง') %></span>
        </div>
        <% } %>
        <form method="POST" action="/contact" class="space-y-4">
          <input type="hidden" name="form_token" value="<%= typeof publicFormToken !== 'undefined' ? publicFormToken : '' %>">
          <input type="hidden" name="audience" id="registrationAudience" value="student">
          <div aria-hidden="true" style="position:fixed;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
            <label for="company_website">Company website</label>
            <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off">
          </div>
          <div class="flex gap-2.5 p-1.5 mb-6 bg-slate-100 rounded-2xl" role="tablist" aria-label="ประเภทผู้ลงทะเบียน">
            <button type="button" data-audience-tab="student" onclick="setAudience('student')" class="flex-1 py-3.5 rounded-xl text-base transition-colors flex items-center justify-center gap-2 bg-brand-600 shadow-md text-white font-semibold" role="tab" aria-selected="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="graduation-cap" aria-hidden="true" class="lucide lucide-graduation-cap w-5 h-5"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg>
              <span data-i18n="form-tab-student">นักศึกษา</span>
            </button>
