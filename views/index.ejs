<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MindWell — ระบบจองนัดหมายการให้คำปรึกษาทางจิตใจ</title>
  <%- include('./partials/head') %>
</head>
<body class="bg-white">

  <!-- Navbar -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-500 to-ocean-500 flex items-center justify-center">
          <i data-lucide="heart-handshake" class="w-4.5 h-4.5 text-white"></i>
        </div>
        <span class="font-bold text-slate-800 text-lg">MindWell</span>
      </div>
      <div class="hidden md:flex items-center gap-1">
        <a href="#book" class="btn-ghost text-sm" data-i18n="nav-register">ลงทะเบียนเพื่อขอรับบริการ</a>
        <a href="#counselors" class="btn-ghost text-sm" data-i18n="nav-counselors">นักให้คำปรึกษา</a>
        <a href="#faq" class="btn-ghost text-sm" data-i18n="nav-faq">คำถามที่พบบ่อย</a>
      </div>
      <div class="hidden md:flex items-center gap-2">
        <!-- Language toggle -->
        <div class="relative" id="lang-wrap">
          <button id="lang-btn" onclick="toggleLangMenu()" type="button"
            class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-2 py-1.5 text-sm font-semibold text-slate-900 transition-colors hover:text-brand-600 focus:outline-none"
            aria-haspopup="menu" aria-expanded="false">
            <span id="lang-flag-display"></span>
            <span id="lang-code-display" class="ml-1.5">TH</span>
            <svg xmlns="http://www.w3.org/2000/svg" id="lang-chevron" width="14" height="14" viewBox="0 0 256 256" class="ml-0.5 text-slate-700 transition-transform duration-200">
              <path fill="currentColor" d="m213.66 101.66l-80 80a8 8 0 0 1-11.32 0l-80-80a8 8 0 0 1 11.32-11.32L128 164.69l74.34-74.35a8 8 0 0 1 11.32 11.32"/>
            </svg>
          </button>
          <div id="lang-menu" class="hidden absolute right-0 top-full mt-1 w-36 rounded-xl border border-slate-100 bg-white py-1.5 shadow-[0_12px_30px_rgba(15,23,42,0.16)] z-[999]">
            <button id="lang-option-th" onclick="setLang('th')" type="button"
              class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 64 64" style="font-size:20px" aria-hidden="true"><path fill="#ed4c5c" d="M52.4 10C47 5 39.9 2 32 2s-15 3-20.4 8zM11.6 54c5.4 5 12.5 8 20.4 8s15-3 20.4-8z"/><path fill="#2a5f9e" d="M2 32c0 4.3.9 8.3 2.5 12h55c1.6-3.7 2.5-7.7 2.5-12s-.9-8.3-2.5-12h-55C2.9 23.7 2 27.7 2 32"/><path fill="#f9f9f9" d="M11.6 54h40.7c3-2.8 5.5-6.2 7.1-10h-55c1.8 3.8 4.2 7.2 7.2 10m40.8-44H11.6c-3 2.8-5.5 6.2-7.1 10h55c-1.7-3.8-4.1-7.2-7.1-10"/></svg>
              <span>TH</span>
            </button>
            <button id="lang-option-en" onclick="setLang('en')" type="button"
              class="w-full flex items-center gap-2.5 px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 64 64" style="font-size:22px" aria-hidden="true"><path fill="#ed4c5c" d="M48 6.6C43.3 3.7 37.9 2 32 2v4.6z"/><path fill="#fff" d="M32 11.2h21.6C51.9 9.5 50 7.9 48 6.6H32z"/><path fill="#ed4c5c" d="M32 15.8h25.3c-1.1-1.7-2.3-3.2-3.6-4.6H32z"/><path fill="#fff" d="M32 20.4h27.7c-.7-1.6-1.5-3.2-2.4-4.6H32z"/><path fill="#ed4c5c" d="M32 25h29.2c-.4-1.6-.9-3.1-1.5-4.6H32z"/><path fill="#fff" d="M32 29.7h29.9c-.1-1.6-.4-3.1-.7-4.6H32z"/><path fill="#ed4c5c" d="M61.9 29.7H32V32H2c0 .8 0 1.5.1 2.3h59.8c.1-.8.1-1.5.1-2.3s0-1.6-.1-2.3"/><path fill="#fff" d="M2.8 38.9h58.4c.4-1.5.6-3 .7-4.6H2.1c.1 1.5.4 3.1.7 4.6"/><path fill="#ed4c5c" d="M4.3 43.5h55.4c.6-1.5 1.1-3 1.5-4.6H2.8c.4 1.6.9 3.1 1.5 4.6"/><path fill="#fff" d="M6.7 48.1h50.6c.9-1.5 1.7-3 2.4-4.6H4.3c.7 1.6 1.5 3.1 2.4 4.6"/><path fill="#ed4c5c" d="M10.3 52.7h43.4c1.3-1.4 2.6-3 3.6-4.6H6.7c1 1.7 2.3 3.2 3.6 4.6"/><path fill="#fff" d="M15.9 57.3h32.2c2.1-1.3 3.9-2.9 5.6-4.6H10.3c1.7 1.8 3.6 3.3 5.6 4.6"/><path fill="#ed4c5c" d="M32 62c5.9 0 11.4-1.7 16.1-4.7H15.9c4.7 3 10.2 4.7 16.1 4.7"/><path fill="#428bc1" d="M16 6.6c-2.1 1.3-4 2.9-5.7 4.6c-1.4 1.4-2.6 3-3.6 4.6c-.9 1.5-1.8 3-2.4 4.6c-.6 1.5-1.1 3-1.5 4.6c-.4 1.5-.6 3-.7 4.6c-.1.8-.1 1.6-.1 2.4h30V2c-5.9 0-11.3 1.7-16 4.6"/><path fill="#fff" d="m25 3l.5 1.5H27l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm4 6l.5 1.5H31l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm-8 0l.5 1.5H23l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm4 6l.5 1.5H27l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm-8 0l.5 1.5H19l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm-8 0l.5 1.5H11l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm20 6l.5 1.5H31l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm-8 0l.5 1.5H23l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm-8 0l.5 1.5H15l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm12 6l.5 1.5H27l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm-8 0l.5 1.5H19l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm-8 0l.5 1.5H11l-1.2 1l.4 1.5l-1.2-.9l-1.2.9l.4-1.5l-1.2-1h1.5zm2.8-14l1.2-.9l1.2.9l-.5-1.5l1.2-1h-1.5L13 9l-.5 1.5h-1.4l1.2.9zm-8 12l1.2-.9l1.2.9l-.5-1.5l1.2-1H5.5L5 21l-.5 1.5h-1c0 .1-.1.2-.1.3l.8.6z"/></svg>
              <span>EN</span>
            </button>
          </div>
        </div>
        <div class="w-px h-6 bg-gray-300 self-center" aria-hidden="true"></div>
        <a href="#book" class="btn-primary text-sm"><i data-lucide="calendar-plus" class="w-5 h-5"></i> <span data-i18n="nav-btn-register">ลงทะเบียน</span></a>
        <a href="/admin/login" class="btn-secondary text-sm">
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span data-i18n="nav-staff">สำหรับเจ้าหน้าที่</span>
        </a>
      </div>
      <button id="mobile-menu-btn" onclick="openMobileMenu()" type="button"
        class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-700 hover:bg-slate-100 transition-colors"
        aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
        <i data-lucide="menu" class="w-6 h-6"></i>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden fixed inset-0 z-[1000] bg-white md:hidden" aria-hidden="true">
      <div class="h-12 bg-brand-600 flex items-center justify-end px-5">
        <button onclick="closeMobileMenu()" type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full text-white hover:bg-white/10 transition-colors"
          aria-label="Close menu">
          <i data-lucide="x" class="w-6 h-6"></i>
        </button>
      </div>

      <div class="min-h-[calc(100vh-3rem)] flex flex-col px-5 py-4">
        <div class="grid grid-cols-2 gap-3 mb-7">
          <a href="#book" onclick="closeMobileMenu()" class="btn-primary justify-center text-sm">
            <span data-i18n="nav-btn-register">ลงทะเบียน</span>
          </a>
          <a href="/admin/login" class="btn-secondary justify-center text-sm">
            <span data-i18n="nav-staff">สำหรับเจ้าหน้าที่</span>
          </a>
        </div>

        <div class="flex flex-col text-slate-800">
          <a href="#" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="mobile-home">หน้าแรก</span>
          </a>
          <a href="#book" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="mobile-services">บริการของเรา</span>
            <i data-lucide="chevron-down" class="w-5 h-5 text-slate-600"></i>
          </a>
          <a href="#counselors" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="nav-counselors">นักให้คำปรึกษา</span>
          </a>
          <a href="#faq" onclick="closeMobileMenu()" class="flex items-center justify-between py-4 text-base font-medium">
            <span data-i18n="nav-faq">คำถามที่พบบ่อย</span>
            <i data-lucide="chevron-down" class="w-5 h-5 text-slate-600"></i>
          </a>
        </div>

        <div class="mt-auto pb-1">
          <div class="inline-flex items-center rounded-full border border-slate-300 bg-white p-0.5 text-sm font-semibold text-slate-500">
            <button id="mobile-lang-th" onclick="setLang('th')" type="button" class="rounded-full px-3 py-1 transition-colors">TH</button>
            <span class="text-slate-300">|</span>
            <button id="mobile-lang-en" onclick="setLang('en')" type="button" class="rounded-full px-3 py-1 transition-colors">EN</button>
          </div>
        </div>
      </div>
  </div>

  <!-- Hero -->
  <section class="pt-32 pb-24 bg-gradient-to-br from-brand-50 via-ocean-50 to-white">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
      <div>
        <span class="inline-flex items-center gap-2 px-3 py-1 bg-brand-100 text-brand-700 text-sm font-medium rounded-full mb-6">
          <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
          <span data-i18n="hero-badge"><%= content.hero.badge %></span>
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-800 leading-tight mb-6">
          <span data-i18n="hero-h1"><%= content.hero.heading1 %></span><br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-ocean-500" data-i18n="hero-h2"><%= content.hero.heading2 %></span>
        </h1>
        <p class="text-slate-500 text-lg leading-relaxed mb-8" data-i18n="hero-subtext">
          <%= content.hero.subtext %>
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#book" class="btn-primary px-7 py-3 text-base">
            <i data-lucide="calendar-plus" class="w-5 h-5"></i>
            <span data-i18n="hero-cta-main"><%= content.hero.ctaMain %></span>
          </a>
          <a href="#counselors" class="btn-secondary px-7 py-3 text-base">
            <i data-lucide="users" class="w-5 h-5"></i>
            <span data-i18n="hero-cta-sub"><%= content.hero.ctaSub %></span>
          </a>
        </div>
      </div>

      <!-- Hero visual -->
      <div class="hidden md:block">
        <div class="relative">
          <div class="w-80 h-80 mx-auto rounded-3xl bg-gradient-to-br from-brand-400 to-ocean-500 flex items-center justify-center shadow-xl">
            <i data-lucide="heart-handshake" class="w-40 h-40 text-white/80"></i>
          </div>
          <!-- Floating cards -->
          <div class="absolute -top-4 -left-6 card shadow-lg max-w-[200px]">
            <div class="flex items-center gap-2 mb-1">
              <i data-lucide="check-circle" class="w-4 h-4 text-brand-500"></i>
              <span class="text-xs font-semibold text-slate-700" data-i18n="hero-card-confirmed">ยืนยันนัดแล้ว</span>
            </div>
            <p class="text-xs text-slate-500" data-i18n="hero-card-date">พุธ 18 มิ.ย. — 10:00 น.</p>
            <p class="text-xs text-brand-600 font-medium mt-0.5" data-i18n="hero-card-name">ดร.สุภาพร เมธาวี</p>
          </div>
          <div class="absolute -bottom-4 -right-6 card shadow-lg max-w-[180px]">
            <div class="flex items-center gap-1 mb-1">
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
            </div>
            <p class="text-xs text-slate-600" data-i18n="hero-card-review">"รู้สึกดีขึ้นมากหลังจากได้คุย ขอบคุณมากครับ"</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Counselors -->
  <section id="counselors" class="py-20" style="background:#eef1ff;">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-800 mb-2" data-i18n="counselors-heading"><%= content.counselors.heading %></h2>
        <p class="text-slate-500" data-i18n="counselors-subtext"><%= content.counselors.subtext %></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% counselors.forEach(c => { %>
        <div class="relative rounded-3xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer" style="height:440px;">

          <!-- Photo / Avatar background -->
          <% if (c.photo) { %>
          <img src="<%= c.photo %>" alt="<%= c.name %>" class="absolute inset-0 w-full h-full object-cover object-top">
          <% } else { %>
          <div class="absolute inset-0 flex items-center justify-center" style="background:linear-gradient(145deg,#e0e7ff 0%,#c7d2fe 50%,#ddd6fe 100%); padding-bottom:160px;">
            <div class="w-36 h-36 rounded-full flex items-center justify-center text-white font-bold text-5xl shadow-xl" style="background:linear-gradient(135deg,#6366f1,#06b6d4);">
              <%= c.avatar %>
            </div>
          </div>
          <% } %>

          <!-- White info panel -->
          <div class="absolute left-4 right-4 bottom-4 bg-white rounded-2xl p-6 shadow-lg">
            <p class="font-semibold text-sm mb-1" style="color:#6366f1;"><%= c.title %></p>
            <h3 class="font-bold text-slate-800 text-xl leading-tight mb-2"><%= c.name %></h3>
            <p class="text-slate-500 text-sm leading-relaxed" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= c.bio || c.specialties.join(' · ') %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-gradient-to-r from-brand-600 to-ocean-600">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white">
          <h2 class="text-3xl font-bold mb-4" data-i18n="features-heading">ทำไมต้องเลือก MindWell?</h2>
          <p class="text-brand-100 mb-8 leading-relaxed" data-i18n="features-subtext">เราเชื่อว่าทุกคนมีสิทธิ์ได้รับการดูแลสุขภาพจิตที่ดี ในสภาพแวดล้อมที่ปลอดภัยและไว้วางใจได้</p>
          <% const features = [
            { icon:'shield-check', text:'นักให้คำปรึกษาผ่านการตรวจสอบและรับรองคุณสมบัติ' },
            { icon:'lock', text:'ข้อมูลทุกอย่างเป็นความลับตาม PDPA' },
            { icon:'clock', text:'จองนัดได้ตลอด 24 ชั่วโมง ทุกวัน' },
            { icon:'video', text:'รองรับทั้งการพบออนไลน์และเข้ารับบริการด้วยตนเอง' },
            { icon:'bell', text:'แจ้งเตือนก่อนนัดหมาย ไม่ลืมแน่นอน' },
          ] %>
          <ul class="space-y-3">
            <% features.forEach((f, idx) => { %>
            <li class="flex items-center gap-3 text-brand-50">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <i data-lucide="<%= f.icon %>" class="w-4 h-4"></i>
              </div>
              <span class="text-sm" data-i18n="feature-<%= idx %>"><%= f.text %></span>
            </li>
            <% }) %>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <% const metrics = [
            { icon:'users', num:'500+', label:'ผู้รับบริการ' },
            { icon:'user-check', num:'20+', label:'นักให้คำปรึกษา' },
            { icon:'calendar-check', num:'1,200+', label:'นัดหมายสำเร็จ' },
            { icon:'star', num:'4.8', label:'คะแนนเฉลี่ย' },
          ] %>
          <% metrics.forEach((m, idx) => { %>
          <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-white text-center">
            <i data-lucide="<%= m.icon %>" class="w-7 h-7 mx-auto mb-3 text-brand-200"></i>
            <p class="text-3xl font-bold"><%= m.num %></p>
            <p class="text-sm text-brand-200 mt-1" data-i18n="metric-<%= idx %>"><%= m.label %></p>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA / Book -->
  <section id="book" class="py-20 bg-white">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-400 to-ocean-500 flex items-center justify-center mx-auto mb-6">
        <i data-lucide="calendar-heart" class="w-8 h-8 text-white"></i>
      </div>
      <h2 class="text-3xl font-bold text-slate-800 mb-4" data-i18n="book-heading"><%= content.book.heading %></h2>
      <p class="text-slate-500 mb-8 leading-relaxed" data-i18n="book-subtext"><%= content.book.subtext %></p>
      <% if (query && query.sent) { %>
      <div class="card border-2 border-brand-100 text-center py-10">
        <div class="w-16 h-16 rounded-full bg-brand-50 flex items-center justify-center mx-auto mb-4">
          <i data-lucide="circle-check" class="w-8 h-8 text-brand-500"></i>
        </div>
        <h3 class="font-semibold text-slate-800 text-lg mb-2" data-i18n="book-success-heading">ส่งคำขอสำเร็จแล้ว!</h3>
        <p class="text-slate-500 text-sm leading-relaxed" data-i18n-html="book-success-text">ทีมงานจะติดต่อกลับหาคุณภายใน 1 วันทำการ<br>ขอบคุณที่ไว้วางใจ MindWell</p>
      </div>
      <% } else { %>
      <div class="card border-2 border-brand-100 text-left">
        <h3 class="font-semibold text-slate-700 mb-4 flex items-center gap-2">
          <i data-lucide="send" class="w-4 h-4 text-brand-500"></i>
          <span data-i18n="form-heading"><%= content.book.formHeading %></span>
        </h3>
        <% if (query && query.error === 'missing') { %>
        <div class="flex items-center gap-2 mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm">
          <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
