  <script>
    // Counselor Carousel
    (function () {
      const inner   = document.getElementById('c-inner');
      const slides  = Array.from(inner.querySelectorAll('.c-slide'));
      const prevBtn = document.getElementById('c-prev');
      const nextBtn = document.getElementById('c-next');
      const dotsEl  = document.getElementById('c-dots');
      const trackEl = document.getElementById('c-track');
      if (!slides.length) return;
      let current = 0;
      let moving = false;
      let autoplayTimer = null;
      const GAP = 24;
      const ANIM_MS = 650;
      const AUTOPLAY_MS = 4200;

      function pv()     { return window.innerWidth >= 768 ? 3 : 1; }
      function maxIdx() { return Math.max(0, slides.length - 1); }
      function sw()     { return slides[0].offsetWidth + GAP; }
      function loopIdx(i) {
        const max = maxIdx();
        if (max === 0) return 0;
        if (i < 0) return max;
        if (i > max) return 0;
        return i;
      }
      function renderSlides() {
        const ordered = [];
        for (let i = 0; i < slides.length; i++) {
          ordered.push(slides[(current + i) % slides.length]);
        }
        ordered.forEach(slide => inner.appendChild(slide));
        inner.style.transform = 'translateX(0)';
      }
      function resetTrack() {
        inner.style.transition = 'none';
        inner.style.transform = 'translateX(0)';
        inner.offsetHeight;
        inner.style.transition = 'transform ' + ANIM_MS + 'ms cubic-bezier(.4,0,.2,1)';
      }

      function buildDots() {
        dotsEl.innerHTML = '';
        const total = maxIdx() + 1;
        if (total <= 1) return;
        for (let i = 0; i < total; i++) {
          const d = document.createElement('button');
          d.className = 'transition-all duration-300 rounded-full ' + (i === current ? 'w-6 h-2 bg-brand-500' : 'w-2 h-2 bg-slate-300');
          d.addEventListener('click', () => jumpTo(i));
          dotsEl.appendChild(d);
        }
      }

      function updateDots() {
        dotsEl.querySelectorAll('button').forEach((d, i) => {
          d.className = 'transition-all duration-300 rounded-full ' + (i === current ? 'w-6 h-2 bg-brand-500' : 'w-2 h-2 bg-slate-300');
        });
      }

      function goTo(i) {
        if (moving) return;
        const dir = i > current ? 1 : -1;
        moving = true;
        if (dir < 0) {
          current = loopIdx(current - 1);
          renderSlides();
          inner.style.transition = 'none';
          inner.style.transform = 'translateX(-' + sw() + 'px)';
          inner.offsetHeight;
          inner.style.transition = 'transform ' + ANIM_MS + 'ms cubic-bezier(.4,0,.2,1)';
          inner.style.transform = 'translateX(0)';
        } else {
          inner.style.transform = 'translateX(-' + sw() + 'px)';
        }
        window.setTimeout(() => {
          if (dir > 0) current = loopIdx(current + 1);
          renderSlides();
          resetTrack();
          updateDots();
          moving = false;
        }, ANIM_MS + 20);
      }

      function jumpTo(i) {
        current = loopIdx(i);
        renderSlides();
        resetTrack();
        updateDots();
      }

      function setWidths() {
        const w = (trackEl.offsetWidth - (pv() - 1) * GAP) / pv();
        slides.forEach(s => { s.style.width = w + 'px'; });
        current = loopIdx(current);
        jumpTo(current);
        buildDots();
      }

      function stopAutoplay() {
        if (autoplayTimer) window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      }

      function startAutoplay() {
        stopAutoplay();
        if (slides.length <= 1 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        autoplayTimer = window.setInterval(() => {
          if (!moving) goTo(current + 1);
        }, AUTOPLAY_MS);
      }

      function restartAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      prevBtn.addEventListener('click', () => {
        goTo(current - 1);
        restartAutoplay();
      });
      nextBtn.addEventListener('click', () => {
        goTo(current + 1);
        restartAutoplay();
      });
      if (trackEl) {
        trackEl.addEventListener('mouseenter', stopAutoplay);
        trackEl.addEventListener('mouseleave', startAutoplay);
        trackEl.addEventListener('focusin', stopAutoplay);
        trackEl.addEventListener('focusout', startAutoplay);
      }
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });
      window.addEventListener('resize', setWidths);
      setWidths();
      startAutoplay();
    })();

    lucide.createIcons();

    // Smooth section navigation
    (function () {
      const nav = document.getElementById('main-nav-links');
      const indicator = document.getElementById('main-nav-indicator');
      const navLinks = nav ? Array.from(nav.querySelectorAll('a[href^="#"]')) : [];
      const sections = Array.from(document.querySelectorAll('#home, #counselors, #book, #faq'));
      let activeLock = '';
      let activeLockTimer = null;
      let ticking = false;

      function navOffset() {
        const bar = document.querySelector('nav');
        return (bar ? bar.offsetHeight : 0) + 14;
      }

      function getTarget(hash) {
        const id = String(hash || '').replace('#', '');
        return id ? document.getElementById(id) : null;
      }

      function moveIndicator(link) {
        if (!nav || !indicator || !link) {
          if (indicator) indicator.style.opacity = '0';
          return;
        }
        const navRect = nav.getBoundingClientRect();
        const linkRect = link.getBoundingClientRect();
        indicator.style.width = linkRect.width + 'px';
        indicator.style.transform = 'translateX(' + (linkRect.left - navRect.left) + 'px)';
        indicator.style.opacity = '1';
      }

      function setActive(hash) {
        const active = navLinks.find(link => link.getAttribute('href') === hash);
        navLinks.forEach(link => {
          const isActive = link === active;
          link.classList.toggle('is-active', isActive);
          link.setAttribute('aria-current', isActive ? 'page' : 'false');
        });
        moveIndicator(active);
      }

      function scrollToSection(hash) {
        const target = getTarget(hash);
        if (!target) return;
        const top = Math.max(0, window.scrollY + target.getBoundingClientRect().top - navOffset());
        activeLock = hash;
        if (activeLockTimer) window.clearTimeout(activeLockTimer);
        activeLockTimer = window.setTimeout(() => {
          activeLock = '';
          requestSync();
        }, 1200);
        window.scrollTo({ top, behavior: 'smooth' });
        if (history.pushState) history.pushState(null, '', hash);
        setActive(hash);
      }

      document.querySelectorAll('a[href^="#"]').forEach(link => {
        link.addEventListener('click', event => {
          const hash = link.getAttribute('href');
          if (!hash || hash === '#') return;
          if (!getTarget(hash)) return;
          event.preventDefault();
          scrollToSection(hash);
        });
      });

      function syncActiveFromScroll() {
        ticking = false;
        if (activeLock) {
          const target = getTarget(activeLock);
          const distance = target ? Math.abs(target.getBoundingClientRect().top - navOffset()) : 0;
          if (target && distance > 16) return;
          activeLock = '';
          if (activeLockTimer) window.clearTimeout(activeLockTimer);
          activeLockTimer = null;
        }
        const scanY = window.scrollY + navOffset() + 70;
        let current = sections[0];
        sections.forEach(section => {
          if (section.offsetTop <= scanY) current = section;
        });
        setActive(current && current.id !== 'home' ? '#' + current.id : '');
      }

      function requestSync() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(syncActiveFromScroll);
      }

      window.addEventListener('scroll', requestSync, { passive: true });
      window.addEventListener('resize', requestSync);
      if (window.location.hash && getTarget(window.location.hash)) {
        window.setTimeout(() => scrollToSection(window.location.hash), 80);
      } else {
        requestSync();
      }
    })();

