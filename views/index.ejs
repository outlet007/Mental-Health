<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MindWell — ระบบจองนัดหมายการให้คำปรึกษาทางจิตใจ</title>
  <%- include('./partials/head') %>
</head>
<body class="bg-white">

  <!-- Navbar -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-500 to-ocean-500 flex items-center justify-center">
          <i data-lucide="heart-handshake" class="w-4.5 h-4.5 text-white"></i>
        </div>
        <span class="font-bold text-slate-800 text-lg">MindWell</span>
      </div>
      <div class="hidden md:flex items-center gap-1">
        <a href="#book" class="btn-ghost text-sm" data-i18n="nav-register">ลงทะเบียนเพื่อขอรับบริการ</a>
        <a href="#counselors" class="btn-ghost text-sm" data-i18n="nav-counselors">นักให้คำปรึกษา</a>
        <a href="#faq" class="btn-ghost text-sm" data-i18n="nav-faq">คำถามที่พบบ่อย</a>
      </div>
      <div class="flex items-center gap-2">
        <!-- Language toggle -->
        <div class="flex items-center gap-0.5 bg-slate-100 rounded-lg p-0.5">
          <button id="lang-th" onclick="setLang('th')" class="px-2 py-1 rounded-md text-xs font-semibold transition-colors bg-white shadow text-brand-600">TH</button>
          <button id="lang-en" onclick="setLang('en')" class="px-2 py-1 rounded-md text-xs font-semibold transition-colors text-slate-500 hover:text-slate-700">EN</button>
        </div>
        <a href="#book" class="btn-primary text-sm"><i data-lucide="calendar-plus" class="w-5 h-5"></i> <span data-i18n="nav-btn-register">ลงทะเบียน</span></a>
        <a href="/admin/login" class="btn-ghost text-sm">
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span data-i18n="nav-staff">สำหรับเจ้าหน้าที่</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="pt-32 pb-24 bg-gradient-to-br from-brand-50 via-ocean-50 to-white">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
      <div>
        <span class="inline-flex items-center gap-2 px-3 py-1 bg-brand-100 text-brand-700 text-sm font-medium rounded-full mb-6">
          <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
          <span data-i18n="hero-badge"><%= content.hero.badge %></span>
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-800 leading-tight mb-6">
          <span data-i18n="hero-h1"><%= content.hero.heading1 %></span><br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-ocean-500" data-i18n="hero-h2"><%= content.hero.heading2 %></span>
        </h1>
        <p class="text-slate-500 text-lg leading-relaxed mb-8" data-i18n="hero-subtext">
          <%= content.hero.subtext %>
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#book" class="btn-primary px-7 py-3 text-base">
            <i data-lucide="calendar-plus" class="w-5 h-5"></i>
            <span data-i18n="hero-cta-main"><%= content.hero.ctaMain %></span>
          </a>
          <a href="#counselors" class="btn-secondary px-7 py-3 text-base">
            <i data-lucide="users" class="w-5 h-5"></i>
            <span data-i18n="hero-cta-sub"><%= content.hero.ctaSub %></span>
          </a>
        </div>
      </div>

      <!-- Hero visual -->
      <div class="hidden md:block">
        <div class="relative">
          <div class="w-80 h-80 mx-auto rounded-3xl bg-gradient-to-br from-brand-400 to-ocean-500 flex items-center justify-center shadow-xl">
            <i data-lucide="heart-handshake" class="w-40 h-40 text-white/80"></i>
          </div>
          <!-- Floating cards -->
          <div class="absolute -top-4 -left-6 card shadow-lg max-w-[200px]">
            <div class="flex items-center gap-2 mb-1">
              <i data-lucide="check-circle" class="w-4 h-4 text-brand-500"></i>
              <span class="text-xs font-semibold text-slate-700" data-i18n="hero-card-confirmed">ยืนยันนัดแล้ว</span>
            </div>
            <p class="text-xs text-slate-500" data-i18n="hero-card-date">พุธ 18 มิ.ย. — 10:00 น.</p>
            <p class="text-xs text-brand-600 font-medium mt-0.5" data-i18n="hero-card-name">ดร.สุภาพร เมธาวี</p>
          </div>
          <div class="absolute -bottom-4 -right-6 card shadow-lg max-w-[180px]">
            <div class="flex items-center gap-1 mb-1">
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
              <i data-lucide="star" class="w-3.5 h-3.5 text-amber-400 fill-amber-400"></i>
            </div>
            <p class="text-xs text-slate-600" data-i18n="hero-card-review">"รู้สึกดีขึ้นมากหลังจากได้คุย ขอบคุณมากครับ"</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Counselors -->
  <section id="counselors" class="py-20 bg-gradient-to-b from-slate-50 to-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-800 mb-2" data-i18n="counselors-heading"><%= content.counselors.heading %></h2>
        <p class="text-slate-500" data-i18n="counselors-subtext"><%= content.counselors.subtext %></p>
      </div>

      <div class="relative">
        <button id="c-prev" class="absolute -left-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-md border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition-colors">
          <i data-lucide="chevron-left" class="w-5 h-5"></i>
        </button>

        <div id="c-track" class="overflow-hidden">
          <div id="c-inner" class="flex gap-6" style="transition: transform 0.5s ease;">
            <% counselors.forEach(c => { %>
            <div class="c-slide flex-none">
              <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 text-center hover:shadow-md transition-shadow">
                <div class="w-20 h-20 rounded-full mx-auto mb-5 overflow-hidden flex-shrink-0">
                  <% if (c.photo) { %>
                  <img src="<%= c.photo %>" alt="<%= c.name %>" class="w-full h-full object-cover">
                  <% } else { %>
                  <div class="w-full h-full bg-gradient-to-br from-brand-400 to-ocean-500 flex items-center justify-center text-white font-bold text-2xl">
                    <%= c.avatar %>
                  </div>
                  <% } %>
                </div>
                <h3 class="font-semibold text-slate-800 text-lg leading-tight mb-1"><%= c.name %></h3>
                <p class="text-sm text-brand-600 font-medium mb-4"><%= c.title %></p>
                <div class="flex flex-wrap gap-1.5 justify-center">
                  <% c.specialties.forEach(sp => { %>
                  <span class="badge-blue text-[11px]"><%= sp %></span>
                  <% }) %>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <button id="c-next" class="absolute -right-5 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-md border border-slate-200 flex items-center justify-center text-slate-500 hover:text-brand-600 hover:border-brand-300 transition-colors">
          <i data-lucide="chevron-right" class="w-5 h-5"></i>
        </button>
      </div>

      <div id="c-dots" class="flex justify-center gap-2 mt-8"></div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-gradient-to-r from-brand-600 to-ocean-600">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="text-white">
          <h2 class="text-3xl font-bold mb-4" data-i18n="features-heading">ทำไมต้องเลือก MindWell?</h2>
          <p class="text-brand-100 mb-8 leading-relaxed" data-i18n="features-subtext">เราเชื่อว่าทุกคนมีสิทธิ์ได้รับการดูแลสุขภาพจิตที่ดี ในสภาพแวดล้อมที่ปลอดภัยและไว้วางใจได้</p>
          <% const features = [
            { icon:'shield-check', text:'นักให้คำปรึกษาผ่านการตรวจสอบและรับรองคุณสมบัติ' },
            { icon:'lock', text:'ข้อมูลทุกอย่างเป็นความลับตาม PDPA' },
            { icon:'clock', text:'จองนัดได้ตลอด 24 ชั่วโมง ทุกวัน' },
            { icon:'video', text:'รองรับทั้งการพบออนไลน์และเข้ารับบริการด้วยตนเอง' },
            { icon:'bell', text:'แจ้งเตือนก่อนนัดหมาย ไม่ลืมแน่นอน' },
          ] %>
          <ul class="space-y-3">
            <% features.forEach((f, idx) => { %>
            <li class="flex items-center gap-3 text-brand-50">
              <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center flex-shrink-0">
                <i data-lucide="<%= f.icon %>" class="w-4 h-4"></i>
              </div>
              <span class="text-sm" data-i18n="feature-<%= idx %>"><%= f.text %></span>
            </li>
            <% }) %>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <% const metrics = [
            { icon:'users', num:'500+', label:'ผู้รับบริการ' },
            { icon:'user-check', num:'20+', label:'นักให้คำปรึกษา' },
            { icon:'calendar-check', num:'1,200+', label:'นัดหมายสำเร็จ' },
            { icon:'star', num:'4.8', label:'คะแนนเฉลี่ย' },
          ] %>
          <% metrics.forEach((m, idx) => { %>
          <div class="bg-white/10 backdrop-blur rounded-2xl p-6 text-white text-center">
            <i data-lucide="<%= m.icon %>" class="w-7 h-7 mx-auto mb-3 text-brand-200"></i>
            <p class="text-3xl font-bold"><%= m.num %></p>
            <p class="text-sm text-brand-200 mt-1" data-i18n="metric-<%= idx %>"><%= m.label %></p>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA / Book -->
  <section id="book" class="py-20 bg-white">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-400 to-ocean-500 flex items-center justify-center mx-auto mb-6">
        <i data-lucide="calendar-heart" class="w-8 h-8 text-white"></i>
      </div>
      <h2 class="text-3xl font-bold text-slate-800 mb-4" data-i18n="book-heading"><%= content.book.heading %></h2>
      <p class="text-slate-500 mb-8 leading-relaxed" data-i18n="book-subtext"><%= content.book.subtext %></p>
      <% if (query && query.sent) { %>
      <div class="card border-2 border-brand-100 text-center py-10">
        <div class="w-16 h-16 rounded-full bg-brand-50 flex items-center justify-center mx-auto mb-4">
          <i data-lucide="circle-check" class="w-8 h-8 text-brand-500"></i>
        </div>
        <h3 class="font-semibold text-slate-800 text-lg mb-2" data-i18n="book-success-heading">ส่งคำขอสำเร็จแล้ว!</h3>
        <p class="text-slate-500 text-sm leading-relaxed" data-i18n-html="book-success-text">ทีมงานจะติดต่อกลับหาคุณภายใน 1 วันทำการ<br>ขอบคุณที่ไว้วางใจ MindWell</p>
      </div>
      <% } else { %>
      <div class="card border-2 border-brand-100 text-left">
        <h3 class="font-semibold text-slate-700 mb-4 flex items-center gap-2">
          <i data-lucide="send" class="w-4 h-4 text-brand-500"></i>
          <span data-i18n="form-heading"><%= content.book.formHeading %></span>
        </h3>
        <% if (query && query.error === 'missing') { %>
        <div class="flex items-center gap-2 mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm">
          <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
          <span data-i18n="form-error">กรุณากรอกข้อมูลที่จำเป็นให้ครบทุกช่อง</span>
        </div>
        <% } %>
        <form method="POST" action="/contact" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="form-label"><span data-i18n="form-label-name">ชื่อ-นามสกุล</span> <span class="text-red-400">*</span></label>
              <input type="text" name="name" class="form-input" placeholder="กรอกชื่อของคุณ" data-i18n-ph="form-ph-name" required>
            </div>
            <div>
              <label class="form-label"><span data-i18n="form-label-studentid">รหัสนักศึกษา</span> <span class="text-red-400">*</span></label>
              <input type="text" name="studentId" class="form-input" placeholder="เช่น 1680123456" data-i18n-ph="form-ph-studentid" required>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="form-label"><span data-i18n="form-label-phone">เบอร์โทรศัพท์</span> <span class="text-red-400">*</span></label>
              <input type="tel" name="phone" class="form-input" placeholder="08X-XXX-XXXX" required>
            </div>
            <div>
              <label class="form-label"><span data-i18n="form-label-email">อีเมล</span> <span class="text-red-400">*</span></label>
              <input type="email" name="email" class="form-input" placeholder="your@email.com" required>
            </div>
          </div>
          <div>
            <label class="form-label" data-i18n="form-label-concern">คุณต้องการความช่วยเหลือเรื่องอะไร?</label>
            <select name="concern" class="form-select">
              <option value="" data-i18n-opt="concern-0">-- เลือกประเภท --</option>
              <option data-i18n-opt="concern-1">ความวิตกกังวล / ความเครียด</option>
              <option data-i18n-opt="concern-2">ภาวะซึมเศร้า</option>
              <option data-i18n-opt="concern-3">ปัญหาความสัมพันธ์</option>
              <option data-i18n-opt="concern-4">ปัญหาครอบครัว</option>
              <option data-i18n-opt="concern-5">ความเศร้าโศก / การสูญเสีย</option>
              <option data-i18n-opt="concern-6">อื่นๆ</option>
            </select>
          </div>
          <div>
            <label class="form-label" data-i18n="form-label-type">รูปแบบที่ต้องการ</label>
            <div class="grid grid-cols-2 gap-3">
              <label class="flex items-center gap-2 p-3 border border-slate-200 rounded-xl cursor-pointer hover:border-brand-300 hover:bg-brand-50 transition-colors">
                <input type="radio" name="type" value="online" checked class="accent-brand-600">
                <i data-lucide="video" class="w-4 h-4 text-brand-500"></i>
                <span class="text-sm font-medium" data-i18n="form-type-online">ออนไลน์</span>
              </label>
              <label class="flex items-center gap-2 p-3 border border-slate-200 rounded-xl cursor-pointer hover:border-brand-300 hover:bg-brand-50 transition-colors">
                <input type="radio" name="type" value="onsite" class="accent-brand-600">
                <i data-lucide="map-pin" class="w-4 h-4 text-brand-500"></i>
                <span class="text-sm font-medium" data-i18n="form-type-onsite">เข้ารับบริการด้วยตนเอง</span>
              </label>
            </div>
          </div>
          <div class="bg-gradient-to-r from-brand-50 to-emerald-50 rounded-2xl border border-brand-100" style="padding:15px">
            <div class="flex items-center gap-2 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="w-5 h-5 text-brand-500 flex-shrink-0"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
              <h4 class="font-semibold text-slate-800 text-base"><span data-i18n="pdpa-heading">การยินยอมเปิดเผยข้อมูล</span> <span class="text-red-400">*</span></h4>
            </div>
            <div class="text-sm text-slate-600 leading-relaxed mb-4">
              <p data-i18n="pdpa-text">ข้าพเจ้า ตกลงและยินยอมให้มหาวิทยาลัยเก็บรวบรวม ใช้ ประมวลผล และเปิดเผยข้อมูลส่วนบุคคลของข้าพเจ้า ทั้งที่ปรากฏในเอกสารฉบับนี้ หรือที่มหาวิทยาลัยรวบรวมจากบุคคลอื่น เพื่อวัตถุประสงค์ในการนัดพบแพทย์ หรือเพื่อใช้ประโยชน์ในกิจการของมหาวิทยาลัย ทั้งนี้ข้าพเจ้ารับทราบ ตกลงและยินยอมว่า มหาวิทยาลัยมีสิทธิ์เก็บรวบรวม ใช้ประมวลผลและเปิดเผยข้อมูลส่วนบุคคลของข้าพเจ้า โดยเป็นไปตามนโยบายคุ้มครองข้อมูลส่วนบุคคลของมหาวิทยาลัย ที่ประกาศใช้ในปัจจุบันหรืออาจเปลี่ยนแปลงแก้ไขในภายหลัง รายละเอียดปรากฏตาม นโยบายคุ้มครองข้อมูลส่วนบุคคล ในเว็บไซต์</p>
            </div>
            <label class="flex items-start gap-3 cursor-pointer group">
              <input type="checkbox" name="pdpa_consent" class="mt-0.5 w-4 h-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500 cursor-pointer" required="">
              <span class="text-sm text-slate-700 group-hover:text-slate-900 transition-colors" data-i18n="pdpa-checkbox">ข้าพเจ้าได้อ่านและยอมรับการยินยอมเปิดเผยข้อมูลแล้ว</span>
            </label>
          </div>
          <button type="submit" class="btn-primary w-full justify-center py-3 text-base">
            <i data-lucide="send" class="w-5 h-5"></i>
            <span data-i18n="form-submit">ส่งคำขอจองนัดหมาย</span>
          </button>
        </form>
      </div>
      <% } %>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-slate-800 text-center mb-10" data-i18n="faq-heading">คำถามที่พบบ่อย</h2>
      <div class="space-y-3">
        <% content.faqs.forEach((f, i) => { %>
        <details class="card group cursor-pointer" data-faq-idx="<%= i %>" open="<%= i===0 %>">
          <summary class="font-medium text-slate-700 flex items-center justify-between list-none">
            <span data-faq-q><%= f.q %></span>
            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 flex-shrink-0 group-open:rotate-180 transition-transform"></i>
          </summary>
          <p class="mt-3 text-sm text-slate-500 leading-relaxed" data-faq-a><%- f.a %></p>
        </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-800 text-slate-400 py-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-4 gap-8 mb-8">
        <div class="md:col-span-2">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-brand-500 to-ocean-500 flex items-center justify-center">
              <i data-lucide="heart-handshake" class="w-4 h-4 text-white"></i>
            </div>
            <span class="font-bold text-white">MindWell</span>
          </div>
