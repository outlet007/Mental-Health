<% /* Shown at the top of every counselor-accessible page. Relies on
     res.locals.currentCounselor / res.locals.myTodayApts set globally
     by src/middleware/auth.js for userType === 'counselor'. */ %>
<% if (typeof currentCounselor !== 'undefined' && currentCounselor) { %>
<div style="margin-bottom:20px; padding:20px 24px; background:linear-gradient(135deg, #05967e 0%, #458caa 100%); border-radius:16px; display:flex; align-items:center; gap:16px;">
  <div style="width:52px;height:52px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:#fff;flex-shrink:0; letter-spacing:-1px;overflow:hidden;">
    <% if (currentCounselor.photo) { %>
      <img data-counselor-profile-photo="<%= currentCounselor.id %>" src="<%= currentCounselor.photo %>" alt="<%= currentCounselor.name %>" style="width:100%;height:100%;object-fit:cover;">
    <% } else { %>
      <%= currentCounselor.avatar || (currentCounselor.name||'?').slice(0,2).toUpperCase() %>
    <% } %>
  </div>
  <div style="flex:1; min-width:0;">
    <p style="font-size:18px;font-weight:700;color:#fff;line-height:1.3;">ยินดีต้อนรับ, <%= currentCounselor.name %></p>
    <p style="font-size:13px;color:rgba(255,255,255,.75);margin-top:2px;"><%= currentCounselor.title || 'นักจิตวิทยาให้คำปรึกษา' %></p>
  </div>
  <div style="text-align:right;flex-shrink:0;">
    <% const _wbDate = new Date(); %>
    <p style="font-size:12px;color:rgba(255,255,255,.7);margin-bottom:4px;"><%= _wbDate.toLocaleDateString('th-TH',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %></p>
    <p style="font-size:26px;font-weight:700;color:#fff;line-height:1;"><%= typeof myTodayApts !== 'undefined' ? myTodayApts : 0 %><span style="font-size:13px;font-weight:400;margin-left:4px;">นัดวันนี้</span></p>
  </div>
</div>
<% } %>
